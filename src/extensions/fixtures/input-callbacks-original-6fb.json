    {
      "script": "const input=new Input(),events=[];input.onSubmit=function(value){events.push([this===input,value]);return 17};input.onEscape=function(){events.push([this===input,'escape']);return 19};input.handleInput('abc');const submit=input.handleInput('\\r'),escape=input.handleInput('\\x1b');return{events,submit:submit===undefined,escape:escape===undefined,value:input.getValue()}",
      "result": {
        "events": [
          [
            true,
            "abc"
          ],
          [
            true,
            "escape"
          ]
        ],
        "submit": true,
        "escape": true,
        "value": "abc"
      }
    },
    {
      "script": "const original={},input=new Input();input.onSubmit=()=>{throw original};try{input.handleInput('\\r')}catch(e){return e===original}return false",
      "result": true
    },
    {
      "script": "const original={},input=new Input();input.onEscape=()=>{throw original};try{input.handleInput('\\x1b')}catch(e){return e===original}return false",
