    {
      "script": "const events=[];class Derived extends Input{insertCharacter(text){events.push(text);super.insertCharacter(text)}}const input=new Derived();input.handleInput('ab');return{value:input.getValue(),events,instance:input instanceof Input}",
      "result": {
        "value": "ab",
