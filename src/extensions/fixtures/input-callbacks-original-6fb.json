      "script": "const input=new Input();input.handleInput('abc');const snapshot=input.undoStack.stack[0];input.handleInput(' ');return{same:input.undoStack.stack[0]===snapshot,undoName:input.undoStack.constructor.name,killName:input.killRing.constructor.name,undoMethods:Object.getOwnPropertyNames(Object.getPrototypeOf(input.undoStack)),killMethods:Object.getOwnPropertyNames(Object.getPrototypeOf(input.killRing))}",
