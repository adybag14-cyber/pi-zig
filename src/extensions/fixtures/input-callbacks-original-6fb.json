        ],
        "value": "abc "
      }
    },
    {
      "script": "const input=new Input(),events=[];input.handleInput('abc');input.killRing={push(text,options){events.push([text,options])}};input.deleteToLineStart();return{events,value:input.getValue(),cursor:input.cursor}",
      "result": {
