    {
      "script": "const object={value:'abcd',cursor:3};Input.prototype.setValue.call(object,'x');return{value:Input.prototype.getValue.call(object),cursor:object.cursor}",
      "result": {
        "value": "x",
        "cursor": 1
      }
    },
    {
      "script": "const input=new Input(),events=[];input.undoStack={push(state){events.push([state.value,state.cursor])}};input.handleInput('ab');input.handleInput('c');input.handleInput(' ');return{events,value:input.getValue()}",
      "result": {
        "events": [
