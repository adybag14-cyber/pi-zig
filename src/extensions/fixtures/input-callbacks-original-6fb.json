      "script": "const input=new Input(),events=[];input.onSubmit=function(value){events.push([this===input,value,input.isInPaste,input.pasteBuffer])};input.handleInput('\\x1b[200~a\\r');input.handleInput('\\nb\\x1b[20');input.handleInput('1~\\r');return{events,value:input.getValue(),buffer:input.pasteBuffer,inPaste:input.isInPaste}",
