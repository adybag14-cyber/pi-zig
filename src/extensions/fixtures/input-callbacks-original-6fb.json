    {
      "script": "const original={},saved=globalThis.structuredClone,input=new Input();globalThis.structuredClone=function(){if(this!==undefined)throw Error('receiver');throw original};try{input.handleInput('x');return false}catch(e){return e===original}finally{globalThis.structuredClone=saved}",
      "result": true
    },
    {
      "script": "const saved=getKeybindings(),calls=[];setKeybindings({matches(data,action){calls.push(action);return false}});try{const input=new Input();input.handleInput('a');return{calls,value:input.getValue()}}finally{setKeybindings(saved)}",
      "result": {
