  "script": "const file=root+'/themes/custom.json',write=color=>fs.writeFileSync(file,JSON.stringify({...base,name:'custom',colors:{...base.colors,accent:color}}));write('#112233');const oldSet=globalThis.setTimeout,oldClear=globalThis.clearTimeout,timers=new Map(),timerEvents=[],observations=[];let id=0,changes=0;globalThis.setTimeout=(callback,delay)=>{const current=++id;timers.set(current,callback);timerEvents.push(['timeout',current,delay]);return current};globalThis.clearTimeout=current=>{timers.delete(current);timerEvents.push(['clear',current])};const observe=stage=>observations.push({stage,name:api.theme.name,accent:api.theme.colors.accent,changes,watchers:watchers.map(w=>({closed:w.closed})),pending:[...timers.keys()],timerEvents:timerEvents.splice(0)}),fire=()=>{const entries=[...timers];timers.clear();for(const[,callback]of entries)callback()};try{api.onThemeChange(()=>changes++);api.initTheme('custom',true);observe('initial');watchers[0].listener('change','other.json');observe('other-filename');watchers[0].listener('rename',undefined);observe('missing-filename');watchers[0].listener('change','custom.json');observe('debounced');write('#010203');fire();observe('valid-reload');fs.writeFileSync(file,'{invalid');watchers[0].listener('change','custom.json');fire();observe('invalid-retains');fs.unlinkSync(file);watchers[0].listener('rename','custom.json');fire();observe('missing-retains');write('#334455');watchers[0].listener('change','custom.json');api.setTheme('dark',false);observe('switch-without-watcher');fire();observe('stale-timer');api.initTheme('custom',true);watchers[1].listener('change','custom.json');watchers[1].error();observe('watch-error-pending');fire();observe('watch-error-pending-reload');api.setThemeInstance(api.getThemeByName('dark'));observe('instance-stops');api.initTheme('custom',true);watchers[2].listener('change','custom.json');api.stopThemeWatcher();observe('stop-clears');fire();observe('stopped-no-reload');return observations}finally{api.stopThemeWatcher();api.onThemeChange(undefined);globalThis.setTimeout=oldSet;globalThis.clearTimeout=oldClear}",
