  "originalBody": "const cases=['login-api-key','login-oauth','logout','login-missing','login-store-reject','logout-store-reject','login-preabort','logout-preabort'],rows=[],raw=[];\r\nfor(const name of cases){const events=[],credentials=new InMemoryCredentialStore(),controller=new AbortController(),signal=controller.signal,cause=new Error('fixture-'+name),credential={type:name==='login-oauth'?'oauth':'api_key',key:'fixture-key',access:'fixture-access',refresh:'fixture-refresh',expires:123},interaction={signal,onProgress:async()=>{},fixture:'interaction'},options={fixture:'options'},originalModify=credentials.modify.bind(credentials),originalDelete=credentials.delete.bind(credentials);credentials.modify=(id,fn,options)=>{events.push({type:'modify',id,signalSame:options.signal===signal});return name==='login-store-reject'?Promise.reject(cause):originalModify(id,fn,options)};credentials.delete=(id,options)=>{events.push({type:'delete',id,signalSame:options.signal===signal});return name==='logout-store-reject'?Promise.reject(cause):originalDelete(id,options)};\r\nconst login=async(got,received)=>{events.push({type:'login',keys:Object.keys(got),signalSame:got.signal===signal,progressSame:got.onProgress===interaction.onProgress,optionsSame:received===options});return credential},models=A.createModels({credentials});models.setProvider(A.createProvider({id:'fixture',name:'Fixture',models:[],auth:{apiKey:{name:'Fixture',resolve:async()=>undefined,...name==='login-missing'?{}:{login}},oauth:{login,toAuth:()=>({apiKey:'fixture'}),refresh:async current=>current}},api:{stream(){throw Error('unused')},streamSimple(){throw Error('unused')}}}));if(name==='logout')await originalModify('fixture',async()=>credential);if(name.endsWith('preabort'))controller.abort(cause);let value,error,same=false;const start=Date.now();try{value=name.startsWith('logout')?await models.logout('fixture',{signal}):await models.login('fixture',name==='login-oauth'?'oauth':'api_key',interaction,options)}catch(thrown){same=thrown===cause;error={name:thrown.name,code:thrown.code,message:thrown.message,causeSame:thrown.cause===cause,reasonSame:same}}\r\nconst stored=await credentials.read('fixture'),end=Date.now();rows.push({name,value,valueType:typeof value,stored,returnedIdentity:value===credential,storedIdentity:stored===credential,error,events,start,end});raw.push({name,value,stored,error,events,start,end})}\r\n",
