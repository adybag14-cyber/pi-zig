  "originalBody": "rows.push({name:'initial',exists:fs.existsSync(file),text:text(),missingType:typeof await store.read('fixture'),list:await store.list()});\r\nconst credential={type:'api_key',key:'fixture-literal-key',env:{REGION:'fixture-region'},extra:{retained:true}},written=await store.modify('fixture',async()=>credential),read=await store.read('fixture');rows.push({name:'write-key-env-extra',writtenIdentity:written===credential,readIdentity:read===credential,value:read,text:text(),list:await store.list()});\r\nconst second=AuthStorage.create(file),oauth={type:'oauth',access:'fixture-access',refresh:'fixture-refresh',expires:1700000000000,extra:'preserved'};await second.modify('oauth',async()=>oauth);rows.push({name:'second-store-read-latest',value:await store.read('oauth'),text:text(),list:await store.list()});\r\nlet current;const fileBefore=text(),kept=await store.modify('fixture',async value=>{current=value;return undefined});rows.push({name:'undefined-keeps-current',returnedIdentity:kept===current,value:kept,unchangedBytes:fileBefore===text()});\r\nfs.writeFileSync(file,'\\ufeff'+JSON.stringify({fixture:{type:'api_key',key:'external-fixture-key',env:{ZONE:'new'}},oauth}));rows.push({name:'external-bom-reload',value:await store.read('fixture'),second:await second.read('fixture'),list:await store.list()});\r\nfs.writeFileSync(file,'{');const fallback=await store.read('fixture');let failure;try{await store.read('fixture',{signal:new AbortController().signal})}catch(error){failure={name:error.name,message:error.message}}rows.push({name:'malformed-best-effort-vs-signalled',fallback,failure});\r\nfs.writeFileSync(file,JSON.stringify({fixture:credential,oauth},null,2));store.reload();await store.delete('fixture');rows.push({name:'delete-preserves-sibling',missingType:typeof await store.read('fixture'),sibling:await store.read('oauth'),text:text(),list:await store.list()});\r\nconst controller=new AbortController(),reason={fixture:'preabort'};controller.abort(reason);const original=text(),errors=[];for(const method of['read','list','modify','delete'])try{if(method==='read')await store.read('oauth',{signal:controller.signal});else if(method==='list')await store.list({signal:controller.signal});else if(method==='modify')await store.modify('oauth',async()=>{throw Error('preaborted callback invoked')},{signal:controller.signal});else await store.delete('oauth',{signal:controller.signal});throw Error('missing cancellation')}catch(error){if(error!==reason)throw error;errors.push(method)}rows.push({name:'preabort-no-writes',errors,unchangedBytes:original===text()});raw.push(...rows);\r\n",
