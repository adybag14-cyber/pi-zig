@@ -0,0 +1,78 @@
+import assert from "node:assert/strict";
+
+const callbacks = new Map();
+function encodeProvider(name, config) {
+  return ((root) => {
+    const seen = new WeakMap();
+    const walk = (value, path, owner) => {
+      if (typeof value === "function") {
+        const callable = owner == null ? value : value.bind(owner);
+        let ordinal = callbacks.size;
+        let callbackId;
+        do {
+          callbackId = "provider:" + String(name) + ":" + path.join(".") + ":" + String(ordinal);
+          ordinal += 1;
+        } while (callbacks.has(callbackId));
+        callbacks.set(callbackId, callable);
+        return {
+          __pi_callback_id: String(callbackId),
+          __pi_callback_kind: "provider_method",
+          __pi_callback_path: path.join("."),
+        };
+      }
+      if (Array.isArray(value)) return value.map((item, index) => walk(item, path.concat(String(index)), value));
+      if (value && typeof value === "object") {
+        if (seen.has(value)) return seen.get(value);
+        const copy = {};
+        seen.set(value, copy);
+        for (const key of Object.keys(value)) copy[key] = walk(value[key], path.concat(key), value);
+        return copy;
+      }
+      return value;
+    };
+    return walk(root, [], null);
+  })(config);
+}
+
+const secret = "closure-preserved";
+const provider = {
+  baseUrl: "https://example.invalid/v1",
+  api: "openai-completions",
+  oauth: {
+    login: async (callbacksArg) => ({ token: `${secret}:${callbacksArg.code}` }),
+    refreshToken: async (credentials) => ({ ...credentials, refreshed: true }),
+    getApiKey(credentials) { return `${this.prefix}:${credentials.token}`; },
+    prefix: "bound",
+  },
+  transforms: [
+    (request) => ({ ...request, transformed: true }),
+  ],
+};
+
+const encoded = encodeProvider("demo", provider);
+const wire = JSON.stringify(encoded);
+assert.ok(!wire.includes("closure-preserved"), "function bodies must not leak into the manifest");
+const manifest = JSON.parse(wire);
+assert.equal(manifest.baseUrl, provider.baseUrl);
+assert.deepEqual(manifest.oauth.login, {
+  __pi_callback_id: "provider:demo:oauth.login:0",
+  __pi_callback_kind: "provider_method",
+  __pi_callback_path: "oauth.login",
+});
+assert.equal(manifest.oauth.refreshToken.__pi_callback_path, "oauth.refreshToken");
+assert.equal(manifest.oauth.getApiKey.__pi_callback_path, "oauth.getApiKey");
+assert.equal(manifest.transforms[0].__pi_callback_path, "transforms.0");
+assert.equal(callbacks.size, 4);
+assert.deepEqual(await callbacks.get(manifest.oauth.login.__pi_callback_id)({ code: "abc" }), {
+  token: "closure-preserved:abc",
+});
+assert.deepEqual(await callbacks.get(manifest.oauth.refreshToken.__pi_callback_id)({ token: "t" }), {
+  token: "t",
+  refreshed: true,
+});
+assert.equal(callbacks.get(manifest.oauth.getApiKey.__pi_callback_id)({ token: "key" }), "bound:key");
+assert.deepEqual(callbacks.get(manifest.transforms[0].__pi_callback_id)({ prompt: "p" }), {
+  prompt: "p",
+  transformed: true,
+});
+console.log("provider method manifest bridge: ok");
