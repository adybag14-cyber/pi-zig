+fn resourceCwdBody(s: *Scope, roots: []const c.JSValue, cwd: c.JSValue) anyerror!c.JSValue {
+    return normalizeBody(s, resourceRoot(roots, .canonicalize), resourceRoot(roots, .resolve), cwd);
