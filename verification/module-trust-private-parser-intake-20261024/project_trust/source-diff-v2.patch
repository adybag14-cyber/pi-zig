+    if (h.truthy(engine, try h.expression(engine, includeSessionBody, .{options_value})))
+        try h.statement(engine, pushOptionBody, .{
+            frame.get(.trust_options), frame.get(.trust_path), frame.get(.parent_path), .trust_session,
+        });
