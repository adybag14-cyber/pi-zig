  "controls": {
    "root": "src/native_node_format_with_options_test.zig",
    "source_declared_controls": 24,
    "names": [
      "native format options exposes genuine callable shape and shares the completed private owners",
      "native format options allows arrays objects and revoked object proxies without option enumeration on literal return",
      "native format options rejects primitives and functions with the actual hidden argument error before formatting",
      "native format options numeric separator uses explicit values and only nullish shared defaults",
      "native format options reads numeric separator after each original value conversion",
      "native format options nonnumeric placeholders do not consult numeric separator",
      "native format options string placeholder copies options then overrides compact colors and depth",
      "native format options hidden placeholder preserves own key descriptor Get order before overrides",
      "native format options ordinary placeholder forwards the actual options without eager spreading",
      "native format options trailing objects use the same options and trailing strings stay uninspected",
      "native format options performs nullish default lookup after the live separator getter",
      "native format options preserves ordinary getter failures and suppresses later argument work",
      "native format options retains independent option frames across recursive getter calls",
      "native validateObject preserves all three original flags and actual hidden error identity",
      "native validateObject performs three independent bit coercions with original short circuit points",
      "native validateObject preserves primitive flag conversion failures and original thrown values",
      "native validateObject uses the captured real ArrayIsArray including revoked proxy behavior",
      "native format options uses original numeric String and Apply primordials after guest mutation",
      "native format options spread defines actual own symbol data without inherited setter calls",
      "native format options current native getter fatal stops later placeholders with first reason",
      "native format options retires the separator temporary before the next placeholder",
      "native format options retires overwritten spread values before entering inspect",
      "native format options accepts flagged error values as data without an actual pending event",
      "native format options requires the actual errors bootstrap and reuses its original inspector function"
    ],
