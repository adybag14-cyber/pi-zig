+    const state = try scope.object();
+    const levels = try scope.object();
+    inline for (.{ .{ "off", 0 }, .{ "error", 200 }, .{ "warn", 300 }, .{ "info", 400 }, .{ "debug", 500 } }) |entry| try scope.put(levels, entry[0], c.JS_NewInt32(engine.context, entry[1]));
