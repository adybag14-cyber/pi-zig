+    const nulls = try scope.own(try v.js.builtin(engine, "Set", &.{}));
+    for (sources) |layer| {
+        const seen = try scope.own(try v.js.builtin(engine, "Set", &.{}));
+        const source = switch (layer) {
+            .plain => |value| value,
+            .nullable => |prepared| {
