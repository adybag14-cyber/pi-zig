+        engine.freeValue(retained);
+        return err;
+    };
+}
+fn context(scope: *Scope) !c.JSValue {
+    try initialize(scope.engine);
+    return scope.engine.native_module_values.get(key).?;
+}
+pub fn loggerFor(scope: *Scope, client: c.JSValue) !c.JSValue {
