+				host: hostNamed(host),
+				variants: { main: { methods: { ping: method() } } },
+			});
+		assert.notEqual(at("server").fingerprint, at("session:S1").fingerprint);
+		const host = createHost({ name: "server", self: "host", onError: () => {} });
+		const facet = (version: number, place: string): Facet => ({
+			name: "moved",
+			setup: (api) =>
+				api.serve(
+					remote("t.moved", {
