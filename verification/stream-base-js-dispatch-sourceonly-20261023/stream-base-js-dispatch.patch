+    try expectInt(&f.base, try fd(&f.base, f.base.primary_wrapper.?), descriptor);
+    // A closing FileHandle remains alive: ReadStart's original UV_EOF must pass
+    // through. Only a completed AfterClose selects JSMethod's UV_EINVAL guard.
+    try expectInt(&f.base, try call(&f.base, .read_start, &.{}), support.physical.UV_EOF);
