C=Path(R['control']);P=Path(R['proof']);M=Path(r'C:\Users\adyba\pi-zig\main')
seen={};digest_cache={}
def digest(p):
 p=str(p)
 if p in digest_cache:return digest_cache[p]
 h=hashlib.sha256()
 with Path(p).open('rb') as stream:
  for b in iter(lambda:stream.read(1048576),b''):h.update(b)
 digest_cache[p]=h.hexdigest().upper();return digest_cache[p]
def pin(p):
 p=Path(p);q=dict(path=str(p),bytes=p.stat().st_size,sha256=digest(p));seen[str(p)]=q;return q
def read(p):pin(p);return json.loads(Path(p).read_bytes())
def ticks(v):
 m=re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(Z|[+-]\d\d:\d\d)',v);assert m,v
 d=datetime.datetime.fromisoformat(m[1]+('+00:00' if m[3]=='Z' else m[3]))-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
 return (d.days*86400+d.seconds)*10000000+int((m[2] or '').ljust(7,'0'))
def normalized(v):
 if isinstance(v,dict):return {k:ticks(x) if k.endswith('_utc') and isinstance(x,str) else normalized(x) for k,x in v.items()}
 if isinstance(v,list):return [normalized(x) for x in v]
 return v
