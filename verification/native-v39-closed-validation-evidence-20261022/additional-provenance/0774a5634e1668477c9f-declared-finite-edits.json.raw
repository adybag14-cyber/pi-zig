quire(runtime_result[\"status\"]==\"passed_selected_native_batch\" and runtime_result[\"mode\"]==\"RuntimeOnly\" and runtime_result[\"candidate_head\"]==HEAD,\"original strict runtime success\")\n    require([g[\"group\"] for g in runtime_result[\"groups\"]]==groups and runtime_result[\"errors\"]==[],\"whole original runtime result\")\n    flags(runtime_result,true=(\"postseal\",\"controller_environment_restored\",\"runtime_requested\",\"all_groups_closed\"),false=(\"product_qualified\",\"cache_seeded\"))\n    for number,group in enumerate(groups):\n        accepted = metadata[\"groups\"][number]\n        observed = runtime[\"observed_groups\"][number]\n        gp = rp/\"groups\"/group\n        canonical = doc(gp/\"runtime.results.json\")\n        require(observed[\"started\"]==observed[\"completed\"]==counts[number] and observed[\"failed\"]==0,\"accepted per-group runtime counts\")\n        require(canonical[\"expected\"]==canonical[\"started\"]==canonical[\"completed\"]==counts[number] and canonical[\"failed_or_skipped_or_logged_or_leaked\"]==0 and canonical[\"status\"]==\"passed\",\"canonical all-positive original counts\")\n        require(canonical[\"results\"]==[{\"index\":i,\"flags\":0,\"passed\":True} for i in range(counts[number])],\"exact canonical zero flags\")\n        require(observed[\"results\"]==[dict(row,name=accepted[\"tests\"][i]) for i,row in enumerate(canonical[\"results\"])],\"all actual names and original observations\")\n        require(raw(gp/\"runtime.stderr.log\")==b\"\",\"original strict empty stderr retained\")\n    require(rt[\"runtime_auditor\"]==selected_observed(\"new4_runtime_auditor\") and\n            rt[\"runtime_auditor\"][\"sha256\"]==\"73C0D2B7209504A4EE0AA419EC936EED84F02753372B87C3F03651FBDE9D3484\" and\n            rt[\"runtime_constructor_source_review\"]==selected_observed(\"new4_execution_source_review\") and\n            rt[\"runtime_constructor_source_review\"][\"sha256\"]==\"5056C7EB01BC3DBC3931030A7753423CE2AAD1EDC9A