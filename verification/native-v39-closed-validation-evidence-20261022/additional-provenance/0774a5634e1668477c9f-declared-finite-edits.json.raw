dent-observed-job-status.json\")[\"data\"][\"id\"]==\"job-op-0af09191232645d299b3a160fa99dbfcf72b88e9c63ebbc206811067b50a9965\",\n            \"the accepted original new4 strict runtime job, no synthesized rerun field\")\n    return {\n      \"batch\":batch,\"source_head\":HEAD,\"groups\":groups,\"declared_groups\":count,\"declared_controls\":declared,\n      \"actual_metadata_count\":actual,\"actual_group_counts\":counts,\n      \"buildquery\":{\"status\":build[\"status\"],\"root_acceptance\":bq_pin,\"closure\":bq[\"independent_closure\"],\n                   \"metadata_acceptance\":bq[\"metadata_acceptance\"],\"result\":bq[\"build_result\"],\n                   \"native_owner_count\":2*count,\"actual_tests_started\":0,\"runtime_qualification\":False},\n      \"runtime\":{\"status\":runtime[\"status\"],\"root_acceptance\":rt_pin,\"closure\":rt[\"independent_runtime_closure\"],\n                 \"result\":rt[\"runtime_result\"],\"observed_started\":actual,\"observed_completed\":actual,\n                 \"observed_failed\":0,\"not_started\":0,\"native_owner_count\":count,\n                 \"selected_native_runtime_accepted\":True,\"product_qualification\":False},\n      \"metadata_transferred_to_another_head\":False,\"source_mutation_hold_released\":False,\n    }\n\n\n"
