      "old": "PHASES = (\"new4-buildquery\",\"new4-runtime\",\"existing63-buildquery\",\n          \"existing63-runtime-prelaunch\",\"existing63-runtime\")\nCOMPRESSIBLE_PHASES = tuple(p for p in PHASES if p!=\"existing63-runtime-prelaunch\")\nORIGINAL63_COUNTS = [15,12,34,28,10,20,18,14,13,32,19,22,20,15,11,12,26,30,16,17,9,23,21,20,25,13,29,16,19,18,25,19,14,11,24,9,12,18,13,23,31,19,18,31,26,31,21,24,19,20,27,26,29,38,35,17,30,7,22,23,15,18,13]\nORIGINAL63_SUFFIXES = (\"20261021-153711\",\"20261022-133427\",\"20261022-134223\")\n",
