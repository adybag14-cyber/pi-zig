      "new": "def check_new3_prelaunch():\n    cohort = copy_plan[\"cohorts\"][\"new3\"]\n    require(set(cohort)=={\"prelaunch_root_negative\",\"compile_root_negative\"},\"two distinct observed new3 negatives\")\n    root_pin = selected_observed(\"new3_prelaunch_root\")\n    require(cohort[\"prelaunch_root_negative\"]==root_pin and\n            root_pin==plan[\"known_new3\"][\"prelaunch_root_acceptance\"],\"exact initial new3 negative authority\")\n    root = document(root_pin)\n    require(root[\"status\"]==\"root_accepted_original_v39_new3_prelaunch_admission_negative\" and\n            root[\"reviewer\"]==\"Root\" and root[\"candidate_head\"]==HEAD and root[\"batch\"]==\"new3\",\"Root original new3 prelaunch rejection\")\n    reason = \"Initial grant must be within300seconds before first child launch\"\n    flags(root,true=(\"negative_accepted\",\"all_original_inputs_and_negative_preserved\",\n                     \"current_complete_directory_inventories_verified\",\"current_original_runner_launcher_outer_instances_absent\",\n                     \"full_precision_process_intervals_preserved_in_original_file\"),\n          false=(\"complete_buildquery_accepted\",\"native_execution_authorized\",\"runtime_execution_authorized\",\n                 \"source_mutation_hold_released\",\"qualification\"))\n    require(root[\"reason\"]==reason and root[\"granted_groups\"]==3 and root[\"attempted_groups\"]==1 and\n            root[\"unstarted_groups\"]==2 and root[\"native_owner_count\"]==root[\"actual_metadata_count\"]==root[\"actual_tests_started\"]==0,\n            \"initial new3 admission negative counts remain zero\")\n    require(root[\"grant_age_at_first_compile_admission_ticks\"]==3212625218,\"original full100ns stale admission preserved\")\n    require(root[\"independent_closure\"]==selected_observed(\"new3_prelaunch_closure\"),\"exact independent initial closure\")\n    closure = document(root[\"independent_closure\"])\n    require(closure[\"status\"]==\"independ