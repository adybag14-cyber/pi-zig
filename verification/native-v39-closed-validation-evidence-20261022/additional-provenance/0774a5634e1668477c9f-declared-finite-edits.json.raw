    {
      "label": "exact current immutable progress/history basis",
      "kind": "semantic",
      "old": "frozen_ref()\nold_raw = git(\"cat-file\",\"blob\",HEAD+\":\"+PROGRESS)\nrequire(len(old_raw)==554689 and sha(old_raw)==BASIS_SHA,\"exact immutable Git progress basis\")\nrequire(hashlib.sha1(b\"blob \"+str(len(old_raw)).encode()+b\"\\0\"+old_raw).hexdigest()==\"ec7a71bd873c789fcb42918501816357c599d2a6\",\"raw Git blob identity\")\nold = decode(old_raw)\nrequire(encode(old)==old_raw,\"full old progress exact JSON roundtrip\")\nrequire(old[\"status\"]==\"active_incomplete\" and old[\"schema\"]==1,\"old progress schema\")\nflags(old,false=(\"application_qualification\",\"production_bridge_removed\",\"published_release\"))\nrequire(old[\"next_native_batch\"]==old[\"current_execution_checkpoint\"][\"next_validation\"],\"old duplicate next-plan equality\")\nrequire(old[\"current_execution_checkpoint\"][\"schema\"]==8,\"old checkpoint schema8\")\nrequire(sha(encode(old[\"current_execution_checkpoint\"]))==\"2BE50BC332A1C14FA9217364AAE9885CABB8C61B320DA6D48D9F8CEC63E666DE\",\"complete old checkpoint\")\nold_lengths = {\"integrated_source_units\":65,\"preserved_attempts\":38,\"retained_recent_native_negatives\":14,\"execution_checkpoint_history\":14}\nrequire({k:len(old[k]) for k in old_lengths}==old_lengths==plan[\"preserved_top_level_history_lengths\"],\"four exact history lengths\")\nhistory_basis = [{\"path\":list(p),\"length\":len(v),\"canonical_sha256\":sha(encode(v))} for p,v in list_paths(old)]\nrequire(history_basis==plan[\"nested_history_prefix_basis\"] and len(history_basis)==181,\"entire historical list basis\")\nexisting63 = old[\"next_native_batch\"][\"retained63_group_order\"]\nrequire(len(existing63)==len(set(existing63))==63 and set(existing63).isdisjoint(NEW4),\"complete disjoint original63\")\nrequire(old[\"next_native_batch\"][\"status\"]==\"preparing_fresh_v38_complete_disjoint_batches\",\"frozen next plan status\")\n",
      "new": "frozen_ref()\nold_raw = git(\"cat-file\",\"blob\",HEAD+\":\"+PROGRESS)\nrequire(len(old_raw)==678718 and sha(old_raw)==BASIS_SHA,\"exact immutable Git progress basis\")\nrequire(hashlib.sha1(b\"blob \"+str(len(old_raw)).encode()+b\"\\0\"+old_raw).hexdigest()==\"d6f15c2abca52ff7e12969bfd7c3a8f6fb615aef\",\"raw Git blob identity\")\nold = decode(old_raw)\nrequire(encode(old)==old_raw,\"full old progress exact JSON roundtrip\")\nrequire(old[\"status\"]==\"active_incomplete\" and old[\"schema\"]==1,\"old progress schema\")\nflags(old,false=(\"application_qualification\",\"production_bridge_removed\",\"published_release\"))\nrequire(old[\"next_native_batch\"]==old[\"current_execution_checkpoint\"][\"next_validation\"],\"old duplicate next-plan equality\")\nrequire(old[\"current_execution_checkpoint\"][\"schema\"]==9,\"actual old checkpoint schema9\")\nrequire(sha(encode(old[\"current_execution_checkpoint\"]))==\"82F7B47958B79C86407B4E0465C83180494A3DD89B7E2BF3035358D400983456\",\"complete old checkpoint\")\nrequire(sha(encode(old[\"integrated_source_units\"]))==\"D5A71F6FF379447A90171FC30A219FA54BD43DDEF4067B5A26D56E4BFEFBF772\",\"all65 existing source units unchanged\")\nold_lengths = {\"integrated_source_units\":65,\"preserved_attempts\":45,\"retained_recent_native_negatives\":15,\"execution_checkpoint_history\":15}\nrequire({k:len(old[k]) for k in old_lengths}==old_lengths==plan[\"preserved_top_level_history_lengths\"],\"four exact history lengths\")\nhistory_basis = [{\"path\":list(p),\"length\":len(v),\"canonical_sha256\":sha(encode(v))} for p,v in list_paths(old)]\nrequire(history_basis==plan[\"nested_history_prefix_basis\"] and len(history_basis)==222,\"entire historical list basis\")\nexisting63 = old[\"next_native_batch\"][\"retained63_group_order\"]\nrequire(len(existing63)==len(set(existing63))==63 and set(existing63).isdisjoint(NEW4+NEW3),\"complete disjoint original63 source selection\")\nrequire(old[\"next_native_batch\"][\"status\"]==\"v38_buildquery_accepted_original63_partial_runtime_negative_closed_awaiting_separate_root_next_scope\",\"frozen old recorded next-plan status\")\n"
    },
    {
      "label": "whole four-closed-phase admission with actual directory identities",
      "kind": "semantic",
      "old": "membership = copy_plan[\"observed_phase_membership\"]\nrequire([m[\"phase\"] for m in membership]==list(PHASES),\"five exact observed phase scopes\")\nfor index,m in enumerate(membership):\n    batch = \"new4\" if index<2 else \"existing63\"\n    is_build = m[\"phase\"].endswith(\"-buildquery\")\n    groups = NEW4 if index<2 else existing63[:1] if index==3 else existing63[:17] if index==4 else existing63\n    proof,control = inside(m[\"proof\"]),inside(m[\"control\"])\n    require(proof.parent==control.parent==E,\"phase roots directly under evidence\")\n    cp = \"root-native-foundation-\"+(\"fresh-\" if is_build else \"\")+\"v38-\"+batch+(\"-control-\" if is_build else \"-runtime-control-\")\n    require(re.fullmatch(re.escape(cp)+r\"\\d{8}-\\d{6}\",control.name),\"actual phase control identity\")\n    require(proof.name==control.name.replace(\"-control-\",\"-buildquery-\" if is_build else \"-\",1),\"actual phase proof identity\")\n    if index>=2:\n        require(control.name==cp+ORIGINAL63_SUFFIXES[index-2],\"exact original63 observed phase instance\")\n    require(m[\"proof_top_level_files\"]==[\"before.json\",\"final.json\",\"result.json\"]==names(proof),\"whole original proof membership\")\n    require(m[\"control_top_level_files\"]==names(control) and names(control,True)==[],\"whole original control membership\")\n    require(set(m[\"group_files\"])==set(groups) and names(proof/\"groups\",True)==sorted(groups),\"all original group directories\")\n    require(names(proof,True)==sorted([\"groups\"]+m[\"excluded_subdirectories\"]),\"explicit excluded phase directories\")\n    require(set(m[\"excluded_subdirectories\"])==({\"cache\",\"global-cache\"} if is_build else set()),\"only original caches excluded\")\n    for group in groups:\n        gd = proof/\"groups\"/group\n        require(m[\"group_files\"][group]==names(gd),\"all original group receipts\")\n        require(names(gd,True)==sorted(m[\"excluded_group_subdirectories\"][group]),\"all original group subdirectories\")\n        require(set(m[\"excluded_group_subdirectories\"][group])==({\"installed\"} if is_build else set()),\"only installed binaries excluded\")\n        for name in m[\"group_files\"][group]:\n            archived_pin(gd/name)\n    for name in m[\"proof_top_level_files\"]:\n        archived_pin(proof/name)\n    for name in m[\"control_top_level_files\"]:\n        archived_pin(control/name)\n    if index<2:\n        prior = inventory[\"observed_phase_membership\"][index]\n        for key in (\"phase\",\"proof\",\"control\",\"proof_top_level_files\",\"excluded_subdirectories\",\"excluded_group_subdirectories\"):\n            require(m[key]==prior[key],\"known phase identity\")\n        require(set(prior[\"control_top_level_files\"])<=set(m[\"control_top_level_files\"]),\"all known original controls retained\")\n        for group in groups:\n            require(set(prior[\"group_files\"][group])<=set(m[\"group_files\"][group]),\"all known group receipts retained\")\n\n",
      "new": "membership = copy_plan[\"observed_phase_membership\"]\nrequire([m[\"phase\"] for m in membership]==list(PHASES),\"only four exact closed phase scopes\")\nrequire(membership==inventory[\"observed_phase_membership\"],\"complete immutable closed phase membership, no current63 additions\")\nfor index,m in enumerate(membership):\n    batch = \"new3\" if index<2 else \"new4\"\n    is_build = index<3\n    groups = NEW3[:1] if index<2 else NEW4\n    proof,control = inside(m[\"proof\"]),inside(m[\"control\"])\n    require(proof.parent==control.parent==E,\"phase roots directly under evidence\")\n    cp = \"root-native-foundation-\"+(\"fresh-\" if is_build else \"\")+\"v39-\"+batch+(\"-control-\" if is_build else \"-runtime-control-\")\n    require(control.name==cp+CLOSED_SUFFIXES[index],\"exact actual closed phase instance\")\n    require(proof.name==control.name.replace(\"-control-\",\"-buildquery-\" if is_build else \"-\",1),\"actual phase proof identity\")\n    require(m[\"proof_top_level_files\"]==[\"before.json\",\"final.json\",\"result.json\"]==names(proof),\"whole original proof membership\")\n    require(m[\"control_top_level_files\"]==names(control) and names(control,True)==[],\"whole original control membership\")\n    require(set(m[\"group_files\"])==set(groups) and names(proof/\"groups\",True)==sorted(groups),\"all original closed group directories\")\n    require(names(proof,True)==sorted([\"groups\"]+m[\"excluded_subdirectories\"]),\"explicit excluded phase directories\")\n    require(set(m[\"excluded_subdirectories\"])<=({\"cache\",\"global-cache\"} if is_build else set()),\"only actual original caches excluded\")\n    for group in groups:\n        gd=proof/\"groups\"/group\n        require(m[\"group_files\"][group]==names(gd),\"all original group receipts\")\n        require(names(gd,True)==sorted(m[\"excluded_group_subdirectories\"][group]),\"all original group subdirectories\")\n        require(set(m[\"excluded_group_subdirectories\"][group])<=({\"installed\"} if is_build else set()),\"only actual installed binaries excluded\")\n        for name in m[\"group_files\"][group]:\n            archived_pin(gd/name)\n    for name in m[\"proof_top_level_files\"]:\n        archived_pin(proof/name)\n    for name in m[\"control_top_level_files\"]:\n        archived_pin(control/name)\n\n"
    },
    {
      "label": "actual complete V39 new4 positive schema adapter",
      "kind": "semantic",
      "old": "def check_positive(batch,groups,declared,index):\n    cohort = copy_plan[\"cohorts\"][batch]\n    require(set(cohort)=={\"buildquery_root_acceptance\",\"runtime_root_acceptance\"},\"exact final cohort authorities\")\n    bq_pin,rt_pin = cohort[\"buildquery_root_acceptance\"],cohort[\"runtime_root_acceptance\"]\n    if batch==\"new4\":\n        require(bq_pin==plan[\"known_new4\"][\"buildquery_root_acceptance\"] and\n                rt_pin==plan[\"known_new4\"][\"runtime_root_acceptance\"],\"unchanged accepted new4 authorities\")\n    bq,rt = document(bq_pin),document(rt_pin)\n    count = len(groups)\n    require(bq[\"status\"]==\"root_accepted_complete_fresh_v38_\"+batch+\"_buildquery\",\"Root complete BQ only\")\n    require(rt[\"status\"]==\"root_accepted_complete_strict_v38_\"+batch+\"_runtime\",\"Root complete strict runtime only\")\n    for value in (bq,rt):\n        require(value[\"reviewer\"]==\"Root\" and value[\"candidate_head\"]==HEAD and value[\"batch\"]==batch,\"accepted original cohort identity\")\n        require(value[\"groups\"]==groups and value[\"declared_groups\"]==count and value[\"declared_controls\"]==declared,\"accepted complete source cohort\")\n        require(type(value[\"actual_metadata_count\"]) is int and value[\"actual_metadata_count\"]>0,\"observed positive metadata count\")\n        require(len(value[\"actual_group_counts\"])==count and all(type(n) is int and n>0 for n in value[\"actual_group_counts\"]),\"complete observed group counts\")\n        require(sum(value[\"actual_group_counts\"])==value[\"actual_metadata_count\"],\"observed metadata sum\")\n        flags(value,false=(\"source_mutation_hold_released\",))\n    actual,counts = bq[\"actual_metadata_count\"],bq[\"actual_group_counts\"]\n    require(rt[\"actual_metadata_count\"]==actual and rt[\"actual_group_counts\"]==counts,\"BQ/runtime same actual cohort\")\n    flags(bq,true=(\"complete_buildquery_accepted\",\"complete_source_and_current_directory_seals\",\"all_original_terminal0_owner_gates_passed\"),\n          false=(\"runtime_started\",\"runtime_execution_authorized\",\"qualification\"))\n    flags(rt,true=(\"strict_native_runtime_accepted\",\"whole_bookends_unchanged\",\n                   \"complete_source_and_current_directory_seals\",\n                   \"all_original_strict_empty_stderr_and_all_tests_passing_gates_passed\",\n                   \"selected_native_runtime_qualification\"),false=(\"product_qualification\",))\n    require(bq[\"native_owner_count\"]==2*count and bq[\"actual_process_intervals_closed\"]==2*count+3 and bq[\"actual_tests_started\"]==0,\"complete original BQ owners\")\n    require(rt[\"runtime_owner_count\"]==count and rt[\"actual_process_intervals_closed\"]==count+3,\"complete original runtime owners\")\n    require(rt[\"observed_started\"]==rt[\"observed_completed\"]==actual and rt[\"observed_failed\"]==rt[\"not_started\"]==0,\"complete positive runtime counts\")\n    bm,rm = membership[index],membership[index+1]\n    bp,bc,rp,rc = Path(bm[\"proof\"]),Path(bm[\"control\"]),Path(rm[\"proof\"]),Path(rm[\"control\"])\n    role_paths = {\n      \"build_result\":bp/\"result.json\",\"build_final\":bp/\"final.json\",\n      \"metadata_acceptance\":bc/\"independent-metadata-acceptance.json\",\n      \"independent_closure\":bc/\"independent-current-seals-and-owners.json\",\n    }\n    for key,path in role_paths.items():\n        require(bq[key]==archived_pin(path),\"Root BQ exact original \"+key)\n    require(rt[\"runtime_result\"]==archived_pin(rp/\"result.json\") and rt[\"runtime_final\"]==archived_pin(rp/\"final.json\"),\"Root exact original runtime result/seal\")\n    require(rt[\"independent_runtime_closure\"]==archived_pin(rc/\"independent-positive-runtime-closure.json\"),\"Root positive runtime closure\")\n    require(rt[\"root_buildquery_acceptance\"]==bq_pin and rt[\"metadata_acceptance\"]==bq[\"metadata_acceptance\"] and\n            rt[\"independent_build_closure\"]==bq[\"independent_closure\"],\"runtime exact accepted parent\")\n    build,metadata = document(bq[\"independent_closure\"]),document(bq[\"metadata_acceptance\"])\n    runtime = document(rt[\"independent_runtime_closure\"])\n    build_result,runtime_result = doc(bp/\"result.json\"),doc(rp/\"result.json\")\n    require(build[\"status\"]==\"independently_closed_complete_fresh_build_query\" and build[\"candidate_head\"]==HEAD,\"accepted positive independent BQ\")\n    flags(build,true=COMMON_TRUE+(\"all_original_terminal0_owner_gates_passed\",),\n          false=(\"runtime_started\",\"qualification\",\"cache_seeded\",\"source_mutation_hold_released\"))\n    require(build[\"granted_groups\"]==build[\"attempted_groups\"]==count and build[\"unstarted_groups\"]==0,\"all BQ groups closed\")\n    require(build[\"native_owner_count\"]==2*count and len(build[\"actual_process_intervals\"])==2*count+3 and build[\"actual_tests_started\"]==0,\"all actual BQ process intervals\")\n    require(build[\"actual_metadata_count\"]==actual and [g[\"group\"] for g in build[\"groups\"]]==groups and\n            [g[\"actual_metadata_count\"] for g in build[\"groups\"]]==counts,\"closure actual metadata\")\n    require(metadata[\"status\"]==\"independently_accepted_combined_native_batch_metadata\" and metadata[\"accepted\"] is True and metadata[\"candidate_head\"]==HEAD,\"accepted raw metadata\")\n    flags(metadata,false=(\"runtime_started\",\"runtime_qualification\"))\n    require([g[\"group\"] for g in metadata[\"groups\"]]==groups and [g[\"actual_count\"] for g in metadata[\"groups\"]]==counts,\"all accepted actual groups\")\n    require(build[\"metadata_acceptance\"]==bq[\"metadata_acceptance\"] and\n            metadata[\"build_result_sha256\"]==bq[\"build_result\"][\"sha256\"] and\n            metadata[\"build_source_seal_sha256\"]==bq[\"build_final\"][\"sha256\"],\"actual metadata/source linkage\")\n    require(build_result[\"status\"]==\"passed_build_query_batch\" and build_result[\"mode\"]==\"BuildQuery\" and build_result[\"candidate_head\"]==HEAD,\"original BQ success\")\n    require([g[\"group\"] for g in build_result[\"groups\"]]==groups and\n            all(g[\"status\"]==\"passed_build_query\" for g in build_result[\"groups\"]),\"complete BQ results\")\n    require(runtime[\"status\"]==\"independently_closed_positive_strict_runtime\" and runtime[\"candidate_head\"]==HEAD and runtime[\"batch\"]==batch,\"accepted positive independent runtime\")\n    flags(runtime,true=COMMON_TRUE+(\"all_original_strict_empty_stderr_and_all_tests_passing_gates_passed\",\"runtime_qualification\"),\n          false=(\"product_qualification\",\"source_mutation_hold_released\"))\n    require(runtime[\"metadata_acceptance\"]==bq[\"metadata_acceptance\"] and runtime[\"independent_build_closure\"]==bq[\"independent_closure\"],\"runtime independent parent links\")\n    require(runtime[\"declared_groups\"]==count and runtime[\"declared_controls\"]==declared and runtime[\"accepted_cohort\"]==actual,\"complete independent runtime cohort\")\n    require(runtime[\"observed_started\"]==runtime[\"observed_completed\"]==actual and runtime[\"observed_failed\"]==runtime[\"not_started\"]==0,\"independent all-positive counts\")\n    require(runtime[\"runtime_owner_count\"]==count and len(runtime[\"actual_process_intervals\"])==count+3,\"all runtime intervals\")\n    require([g[\"group\"] for g in runtime[\"observed_groups\"]]==groups,\"all independent runtime groups\")\n    require(runtime_result[\"status\"]==\"passed_selected_native_batch\" and runtime_result[\"mode\"]==\"RuntimeOnly\" and runtime_result[\"candidate_head\"]==HEAD,\"original strict runtime success\")\n    require([g[\"group\"] for g in runtime_result[\"groups\"]]==groups and runtime_result[\"errors\"]==[],\"whole original runtime result\")\n    flags(runtime_result,true=(\"postseal\",\"controller_environment_restored\",\"runtime_requested\",\"all_groups_closed\"),false=(\"product_qualified\",\"cache_seeded\"))\n    for number,group in enumerate(groups):\n        accepted = metadata[\"groups\"][number]\n        observed = runtime[\"observed_groups\"][number]\n        gp = rp/\"groups\"/group\n        canonical = doc(gp/\"runtime.results.json\")\n        require(observed[\"started\"]==observed[\"completed\"]==counts[number] and observed[\"failed\"]==0,\"accepted per-group runtime counts\")\n        require(canonical[\"expected\"]==canonical[\"started\"]==canonical[\"completed\"]==counts[number] and canonical[\"failed_or_skipped_or_logged_or_leaked\"]==0 and canonical[\"status\"]==\"passed\",\"canonical all-positive original counts\")\n        require(canonical[\"results\"]==[{\"index\":i,\"flags\":0,\"passed\":True} for i in range(counts[number])],\"exact canonical zero flags\")\n        require(observed[\"results\"]==[dict(row,name=accepted[\"tests\"][i]) for i,row in enumerate(canonical[\"results\"])],\"all actual names and original observations\")\n        require(raw(gp/\"runtime.stderr.log\")==b\"\",\"original strict empty stderr retained\")\n    require(rt[\"auditor\"][\"sha256\"]==\"A73ACCCD565E4B3D66C993F061F63DFA8C92B238EE979778D48CCA562643D102\" and\n            rt[\"auditor_source_acceptance\"][\"sha256\"]==\"12D45623A19BB66517FF8DF2C47CD69F32A167361572A0313D651505528A8F49\",\"accepted corrected auditor source\")\n    document(rt[\"auditor_source_acceptance\"])\n    require(archived_pin(rt[\"auditor\"][\"path\"])==rt[\"auditor\"],\"exact accepted auditor retained\")\n    audit_cfg = document(rt[\"audit_configuration\"])\n    require(audit_cfg[\"auditor_sha256\"]==rt[\"auditor\"][\"sha256\"] and audit_cfg[\"batch\"]==batch and audit_cfg[\"actual_metadata_count\"]==actual,\"actual positive audit configuration\")\n    for control in (bc,rc):\n        job = doc(control/\"independent-observed-job-status.json\")[\"data\"]\n        require(job[\"status\"]==\"succeeded\" and job[\"exitCode\"]==0 and job[\"runnerAlive\"] is False and\n                type(job[\"runnerProcessInstance\"]) is str and re.fullmatch(r\"[0-9]+\",job[\"runnerProcessInstance\"]),\"original successful job and exact decimal100ns identity\")\n    prep = E/(\"combined-native-batch-v38-\"+(\"new4\" if batch==\"new4\" else \"regression63\")+\"-prepared-20261021\")\n    review,matrix = doc(prep/\"preparation-review.json\"),doc(prep/\"groups.json\")\n    require(review[\"candidate_head\"]==HEAD and review[\"selected_group_names\"]==groups and review[\"selected_groups\"]==count and review[\"selected_declarations\"]==declared,\"accepted exact prepared cohort\")\n    require(review[\"actual_metadata_count\"] is None and archived_pin(prep/\"groups.json\")[\"sha256\"]==MATRIX_SHA,\"source declarations never predict metadata\")\n    require(len(matrix[\"groups\"])==117 and sum(len(g[\"required_named\"]) for g in matrix[\"groups\"])==2013 and len(matrix[\"whole_tree_dependency_pins\"])==576,\"complete shared catalog\")\n    if batch==\"new4\":\n        require(counts==[19,4,24,14] and actual==61 and rt[\"original_runtime_rerun\"] is False,\"unchanged already accepted original new4 run\")\n    else:\n        require(count==63 and declared==1249,\"original63 source-only constants\")\n        # Original63 needs no invented F846 failure or auditor-config adaptation.\n    return {\n      \"batch\":batch,\"source_head\":HEAD,\"groups\":groups,\"declared_groups\":count,\"declared_controls\":declared,\n      \"actual_metadata_count\":actual,\"actual_group_counts\":counts,\n      \"buildquery\":{\"status\":build[\"status\"],\"root_acceptance\":bq_pin,\"closure\":bq[\"independent_closure\"],\n                   \"metadata_acceptance\":bq[\"metadata_acceptance\"],\"result\":bq[\"build_result\"],\n                   \"native_owner_count\":2*count,\"actual_tests_started\":0,\"runtime_qualification\":False},\n      \"runtime\":{\"status\":runtime[\"status\"],\"root_acceptance\":rt_pin,\"closure\":rt[\"independent_runtime_closure\"],\n                 \"result\":rt[\"runtime_result\"],\"observed_started\":act