  "source_authority_mapping": [
    "Pinned node_file.cc541-665: actual ReadWrap constructor, ReadStart/ReadStop, inner trigger/local scopes, freelist and completion ownership/ordering, live range clipping and live restart.",
    "Pinned node_file.cc726-730: genuine FSReqCallback constructor CHECK, realm BindingData and strict IsTrue.",
    "Pinned node_file.cc3931-3947: real callback template inheritance and the stored fst->InstanceTemplate path used for ReadWrap, without inventing a callback constructor invocation.",
    "The prior seven-file source peer includes the original node_file-inl.h42-49/77-83 and original FSReqBase/FSReqCallback header ownership mapping. This control peer retains that exact production snapshot and inspects the selected actual owner paths."
  ],
  "control_matrix": [
    {
      "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\src\\native_node_file_handle_read_test.zig",
      "sha256": "FFAEE39E71868A92884A855B886D296686558C955EA700C0D735F68DB8D2777D",
      "filter": "native FileHandle",
      "declared_controls": 14,
      "review": [
        {
          "name": "native FileHandle read closed and closing return EOF before read admission",
          "finding": "Both original closed/closing guards return real UV_EOF before setting up a request; assertions cover no allocation, trace or waiting admission.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle zero length emits actual stream EOF without allocating a request",
          "finding": "The zero-length branch emits real EOF through StreamBase and its native JS callback scopes without acquiring a ReadWrap or buffer.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle first read bypasses FSReqCallback construction and retains the real ReadWrap",
          "finding": "A first read uses the stored actual FSReqCallback instance template and detached actual ReadWrap. Same brand/provider does not permit Request.unwrap because the derived owner differs. Native references, cleanup/reset, 65536-to-8 backing shrink and freelist retention match the actual callback path.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle repeated start and ReadStop preserve the accepted completion",
          "finding": "Repeated starts see the same current_read. ReadStop changes reading only, so an accepted read still completes and releases its managed span; no cancellation or synthetic completion is introduced.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle bounded offset advances by emitted bytes before inline EOF",
          "finding": "The physical file read at offset 2 with length 3 yields CDE, advances the actual offset to 5 and length to 0, then takes inline EOF after the listener leaves reading enabled.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle completion uses the live length and preserves the raw trace result",
          "finding": "Reducing the live read_length after an accepted 8-byte read clips emission and offset/length arithmetic to 2 while the trace observes the native result 8; StreamBase performs the real 8-to-2 shrink.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle unbounded restart recycles the same native request through actual EOF",
          "finding": "An unbounded read restarts through the real freelist until the actual native zero result becomes UV_EOF; the pointer is reused with a fresh AsyncReset identity and original -1 offset/length semantics.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle reentrant onread restarts before old Wrapper and event retirement",
          "finding": "Reentrant onread restarts after current_read moved to a local and after Reset/freelist insertion but before the old Wrapper entitlement retires. The test checks the same actual request and the overlap reference count.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle reuse creates a fresh resource and restores the default trigger",
          "finding": "Freelist reuse creates a fresh actual resource object, uses the cached handle key and real request wrapper, assigns the original handle trigger ID and restores the caller default trigger 77.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle ignored resource Set exception continues reset and real admission",
          "finding": "An ordinary resource Set exception is retained while original void constructor/AsyncReset continuation still admits the request. The test removes its injected setter before delivery and checks the real accepted completion and exact pending reason.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle ordinary onread reason survives restart and the actual second completion",
          "finding": "An ordinary onread exception is retained across the original live-reading restart; the second accepted native request is later pumped to actual EOF. The test observes both queue ownership and the original exception.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle full freelist releases the completed local after EmitRead",
          "finding": "Filling the real 100-entry freelist while one read is pending forces the completed Source local to retire after EmitRead. Only the retained JS wrapper is inspected afterward; no freed native pointer is dereferenced.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle joined service drains the accepted buffer after JavaScript is disabled",
          "finding": "Shutdown disables JS, joins/drains the real shared controller before cleanup, and delivers the accepted native callback sufficiently to clean/reset/recycle the request and return its backing without invoking the JS listener.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FileHandle AfterClose shares the actual flags and emits EOF through StreamBase",
          "finding": "The fixture closes the real descriptor before calling the actual afterClose transition. Tests assert closed/nonclosing/fd=-1, selected reading EOF emission and later start guard; no full production close owner is claimed.",
          "concrete_source_blocker": false
        }
      ]
    },
    {
      "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\src\\native_node_fs_callback_template_test.zig",
      "sha256": "1DC90343E1BB318344F4C9652C73610B8098AA50D6A3F8B3E9EC0C17BECA8BCC",
      "filter": "native FSReqCallback",
      "declared_controls": 11,
      "review": [
        {
          "name": "native FSReqCallback no argument initializes the actual selected FSReqBase defaults",
          "finding": "Default construction checks the real selected FSReqBase fields, inline capacity, provider/queue and absent promise; it does not synthesize general FS continuation behavior.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback IsTrue accepts only literal true and never coerces an argument",
          "finding": "Only actual primitive true selects use_bigint. False, numbers, strings, null, undefined, Boolean objects and a throwing coercion candidate stay false without coercion.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback caller local owns a weak actual request and one BindingData pointer",
          "finding": "The constructor starts as the actual weak caller-local object with zero native pointers, one real Registry Entry and a retained BindingData owner; unassigned actual UV storage supports Reset before dispatch.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback weak finalization removes its actual Entry and releases BindingData",
          "finding": "Dropping the weak local retires the actual Request, queue Entry and one BindingData native entitlement without disturbing the realm BindingData owner.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback stored InstanceTemplate creates a real blank brand without calling its constructor",
          "finding": "The stored InstanceTemplate operation creates distinct branded JS instances while bypassing the callback and therefore allocates no native Request, request queue node, async ID or BindingData entitlement.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback stored brand distinguishes the actual FileHandleReadWrap native allocation",
          "finding": "Actual detached ReadWrap construction uses the same FSReqCallback brand/provider but its own derived owner; Request.unwrap rejects it and ownership remains the real detached pointer.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback inherits actual AsyncWrap methods and constructor descriptors",
          "finding": "Constructor name/length, prototype constructor descriptor and AsyncWrap methods are checked through actual native template/property APIs.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback subclass prototype is selected before its genuine native constructor",
          "finding": "Reflect.construct with a Derived newTarget uses the actual Derived prototype and still selects the true constructor field.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback throwing new target prototype preserves the reason before native allocation",
          "finding": "A newTarget prototype getter failure preserves the exact sentinel before State/native allocation, leaving async ID, native BindingData count and request queue unchanged.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback configuration retains the actual shared Controller once and rejects retired Hub entry",
          "finding": "Configuring the same real shared Controller twice retains it once. After Hub shutdown, the template-owned reference remains alive and the stopping guard rejects further configuration before dereferencing retired Hub state.",
          "concrete_source_blocker": false
        },
        {
          "name": "native FSReqCallback generic storage admits the actual read and retires through the real Wrapper",
          "finding": "The generic-storage control first rejects invalid spans/path synchronously, then submits a real raw read through the actual shared Controller and Entry. The observer checks the real UV result/cleanup and Wrapper state, records only the actual result on the JS wrapper, and confirms final Request/BindingData retirement. It is not a fake FSReqBase settlement callback.",
          "concrete_source_blocker": false
        }
      ]
    }
  ],
  "shared_fixture": {
    "source": {
      "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\src\\native_node_file_handle_read_test_support.zig",
      "bytes": 23302,
      "sha256": "F72A583ED548F7BE10477B0AEFD0F77E3D035FB48F2708324AF2E92EB6CA90EC"
    },
    "finding": "No concrete lifetime or actual-API blocker in the selected fixture scope.",
    "weak_binding_data_setup": [
      "BindingData.create returns the actual weak realm owner. bootstrap duplicates and stores its actual target JS value before the local bootstrap scope ends.",
      "assemble initializes the actual Handle State while that target remains rooted, then calls data.retainNative and stores the same pointer on the actual derived Handle.",
      "Only after assembly does init drop the setup-only target duplicate; the real Handle entitlement now keeps BindingData alive.",
      "The fixture preserves the earlier uncorrected setup source in SDK original snapshots; it does not claim a production FileHandle constructor implementation."
    ],
    "teardown": [
      "File.deinit first calls Fixture.stopIo, which disables JS and performs actual native environment join/drain before descriptor close, local JS roots or realm owners retire.",
      "The real Environment Realm cleanup walks its current head instead of retaining a next pointer across destructor effects. BindingData with a live Handle entitlement detaches first and completes retirement when Handle derived retirement releases it.",
      "Handle derived retirement requires current_read empty, invokes StreamBase.deinit and releases its actual BindingData native entitlement before base State cleanup.",
      "BindingData retirement releases the real freelist native ReadWrap pointers. ReadWrap derived destruction only retires Entry/UV storage and does not dereference its borrowed FileHandle pointer.",
      "StreamBase initialized=false protects the partial assembly error path. Fixture init error cleanup retains the setup target until ordinary cleanup can release actual attached owners.",
      "Templates retain the actual Controller separately from the Hub; post-stop test observations use that live entitlement. Controller.enter checks stopping before touching a possibly retired Hub."
    ],
    "actual_dependencies": [
      "Actual Engine, Environment, native State/Registry, StreamBase, BindingData, callback Scope, shared filesystem Controller, uv_fs request storage and native completion queue.",
      "Trace probes observe actual request pointer/async ID/count/cleanup state only.",
      "The selected allocation fixture uses the actual first-success native ArrayBuffer backing allocation and fails explicitly otherwise; production retry/GC policy is not replaced.",
      "The generic-storage callback observes the actual Entry/UV result and records it on the actual wrapper. It does not imitate general FSReqBase Init/Resolve/Reject/stat behavior."
    ],
