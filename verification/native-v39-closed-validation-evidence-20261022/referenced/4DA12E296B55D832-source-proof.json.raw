  "source_excerpts": [
    {
      "source": "src/extensions/native_node_stream_base.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\src\\extensions\\native_node_stream_base.zig",
        "bytes": 12321,
        "sha256": "F85721695F41998E3676C196B4791D295EA62C8DE89FD83159F05BACDEF7716E"
      },
      "start": 77,
      "end": 91,
      "bytes": 617,
      "sha256": "775F8E762E8C6D877BB040A89C62380193803E12CBA199A8D8216BF451BF29C3",
      "utf8": "    pub fn init(self: *Base, environment: *callbacks.Environment,\n        virtuals: Virtuals, operations: Operations) !void\n    {\n        const engine = try environment.requireEngine();\n        self.* = .{\n            .resource = resources.Resource.init(engine),\n            .environment = environment,\n            .default_listener = .{ .read_methods = &default_read_methods,\n                .after_shutdown = shutdown.reportAfterShutdown },\n            .virtuals = virtuals,\n            .operations = operations,\n            .initialized = true,\n        };\n        self.resource.push(&self.default_listener);\n    }\n"
    },
    {
      "source": "src/extensions/native_node_file_handle_owner.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\src\\extensions\\native_node_file_handle_owner.zig",
        "bytes": 17650,
        "sha256": "F2672292FBEBEEF74B35C32C38203E3D1E1D259052E7AB5AFB34DA29840B544D"
      },
      "start": 41,
      "end": 57,
      "bytes": 706,
      "sha256": "AB71878E337A90D02E599488F5EFE9BDA459A23E4DABED1C172B74A45E4E9B19",
      "utf8": "    pub const ShutdownReq = shutdown_request.Type(@This());\n\n    // Original bases and native members. The single Reader.State supplies all\n    // fd/closed/closing/reading/offset/length/current_read_ members.\n    wrap: native.State = undefined,\n    stream: stream_base.Base = undefined,\n    read_state: Reader.State = .{ .fd = -1 },\n    binding_data: ?*binding.BindingData = null,\n\n    // Actual retained native infrastructure, not another handle/request graph.\n    controller: *io.Controller,\n    immediate_queue: *immediates.Queue,\n    handle_string: c.JSValue,\n    read_trace: read.Trace,\n    close_trace: close_request.Trace,\n    stream_operations: stream_base.Operations,\n    attached: bool = false,\n"
    },
    {
      "source": "src/extensions/native_node_file_handle_owner.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\src\\extensions\\native_node_file_handle_owner.zig",
        "bytes": 17650,
        "sha256": "F2672292FBEBEEF74B35C32C38203E3D1E1D259052E7AB5AFB34DA29840B544D"
      },
      "start": 154,
      "end": 193,
      "bytes": 1625,
      "sha256": "718793ADCFEE5DE49B74339AC224546B933AD936258EFABEC8E9D6CF08593D60",
      "utf8": "        if (failure) |err| return err;\n    }\n    fn releaseInfrastructure(self: *Handle, s: *Scope) void {\n        s.boundary.release(&self.handle_string);\n        self.immediate_queue.release();\n        self.controller.release();\n    }\n    fn destroy(wrap: *native.State) void {\n        wrap.registry.environment.allocator().destroy(fromWrap(wrap));\n    }\n    const derived: native.Derived = .{\n        .mark = mark, .retire = retire, .destroy = destroy,\n    };\n\n    fn initialize(self: *Handle, s: *Scope, data: *binding.BindingData,\n        wrapper: c.JSValue, descriptor: c_int) !void\n    {\n        self.wrap.initialize(data.registry, wrapper, derived,\n            native.Provider.filehandle, -1) catch |err|\n        {\n            self.attached = data.registry.unwrap(wrapper) == &self.wrap;\n            record(s, err);\n            // Native AsyncWrap calls void AsyncReset: a completed ordinary\n            // init rethrow does not skip StreamBase or derived construction.\n            if (!self.attached or !self.wrap.init_hook_ran or\n                !canContinue(s, err)) return err;\n        };\n        self.attached = true;\n        try self.stream.init(data.environment,\n            .{ .get_async_wrap = streamWrap,\n                .create_shutdown = createShutdown, .do_shutdown = doShutdown },\n            self.stream_operations);\n        self.stream_initialized = true;\n        self.read_state.fd = descriptor;\n        try data.retainNative();\n        self.binding_data = data;\n        try self.wrap.makeWeak();\n        try self.stream.attachToObject(data.registry, wrapper);\n        self.constructed = true;\n    }\n"
    },
    {
      "source": "src/native_node_file_handle_owner_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_owner_test_support.zig",
        "bytes": 33411,
        "sha256": "DAAFD9A8B6FFFC0FD3971749F8A9515EA066BE81AEA90B44ADA397A70E76488B",
        "git_blob": "715f662079efe62d704b8f4ab97e8ebc1fa86ee6",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 308,
      "end": 338,
      "bytes": 1585,
      "sha256": "2968206348E8426100ACEA5FDBA102D1BD9D8810D9B13EAA673362B389211970",
      "utf8": "    pub fn init(self: *Fixture) !void {\n        self.* = .{ .native_environment = .init(std.testing.allocator) };\n        errdefer self.deinit();\n        self.engine = try em.Engine.init(std.testing.allocator, .{});\n        self.engine_alive = true;\n        self.engine.host_control_context = self;\n        try @import(\"extensions/native_process.zig\").install(self.engine,\n            std.testing.io, &self.native_environment, &.{\"native-filehandle-owner\"});\n        const outer_resource = try a.expression(self.engine, bootstrap, .{self});\n        defer self.engine.freeValue(outer_resource);\n        try self.engine.bindFunction(\"actualOwnerWarningFlag\", warningFlag, 0);\n        self.controller = switch (try fs_io.acquire(self.engine, self.env())) {\n            .ready => |actual| actual,\n            .failed => return error.ConcreteFileHandleServiceAdmissionFailed,\n        };\n        try templates.configureFSReqCallback(self.engine, self.template_owner.?, self.controller.?);\n        try phase.install(self.engine);\n        self.queue = try phase.acquireNative(self.engine, immediate_hooks);\n        self.outer.initialized = false;\n        self.outer.init(self.env(), outer_resource,\n            .{ .async_id = 0, .trigger_async_id = 0 },\n            .{ .skip_async_hooks = true, .skip_task_queues = true },\n            c.pi_js_undefined()) catch |err| {\n            if (self.outer.initialized) {\n                self.outer.markFailed();\n                self.outer.deinit() catch {};\n            }\n            return err;\n        };\n        self.outer_initialized = true;\n    }\n"
    },
    {
      "source": "src/native_node_file_handle_owner_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_owner_test_support.zig",
        "bytes": 33411,
        "sha256": "DAAFD9A8B6FFFC0FD3971749F8A9515EA066BE81AEA90B44ADA397A70E76488B",
        "git_blob": "715f662079efe62d704b8f4ab97e8ebc1fa86ee6",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 339,
      "end": 370,
      "bytes": 2084,
      "sha256": "803C06AF2CBDFDB436CA5CE5D294F1FB56E9F0DA29366C1AE1E1D91B4E7FF9F7",
      "utf8": "    fn bootstrap(s: *a.Scope, self: *Fixture) !c.JSValue {\n        const global_object = try s.checked(c.JS_GetGlobalObject(s.engine.context));\n        const process = try s.get(global_object, \"process\");\n        const generation = try s.beforeAllocation();\n        const symbol = try s.checkedAllocation(c.JS_NewSymbol(\n            s.engine.context, \"node:resource_symbol\", false), generation);\n        self.environment = try callbacks.Environment.create(s.engine, .{\n            .provider_names = providers.names(false), .resource_symbol = symbol,\n            .process_object = process, .async_context_frame = true,\n            .operations = operations,\n        });\n        self.env().markBootstrapComplete();\n        self.template_owner = try templates.acquire(s.engine, self.env());\n        self.registry_owner = try templates.registry(s.engine, self.template_owner.?);\n        const object = try s.get(global_object, \"Object\");\n        const object_prototype = try s.get(object, \"prototype\");\n        const async_constructor = try s.own(try templates.constructor(\n            s.engine, self.template_owner.?, .async_wrap));\n        self.prototype = a.duplicate(s.engine, try s.get(async_constructor, \"prototype\"));\n        self.handle_key = a.duplicate(s.engine, try s.text(\"handle\"));\n        const shape = try binding.TargetTemplate.create(s);\n        const target = try shape.newInstance(s, object_prototype);\n        self.binding_target = a.duplicate(s.engine, target);\n        _ = try binding.BindingData.create(s, shape, target,\n            self.template_owner.?, try s.text(\"promise\"));\n        const class_generation = try s.beforeAllocation();\n        if (c.JS_NewClassID(s.engine.runtime, &self.marker_class) == 0) return error.OutOfMemory;\n        const definition: c.JSClassDef = .{ .class_name = \"Concrete FileHandle observation\" };\n        if (c.JS_NewClass(s.engine.runtime, self.marker_class, &definition) < 0)\n            return error.OutOfMemory;\n        try s.boundary.checkPendingSince(class_generation);\n        return a.duplicate(s.engine, try s.object());\n"
    },
    {
      "source": "src/native_node_file_handle_owner_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_owner_test_support.zig",
        "bytes": 33411,
        "sha256": "DAAFD9A8B6FFFC0FD3971749F8A9515EA066BE81AEA90B44ADA397A70E76488B",
        "git_blob": "715f662079efe62d704b8f4ab97e8ebc1fa86ee6",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 392,
      "end": 422,
      "bytes": 1948,
      "sha256": "626FA7342B3155434D1F7EA4025BC08707ACA7526AAA725B2089EE0BB388C2E1",
      "utf8": "    pub fn create(self: *Fixture, descriptor: c_int, offset: ?f64, length: ?f64) !*Handle {\n        const args = [_]c.JSValue{\n            c.JS_NewInt32(self.engine.context, descriptor),\n            if (offset) |offset_value| c.JS_NewFloat64(self.engine.context, offset_value) else c.pi_js_undefined(),\n            if (length) |length_value| c.JS_NewFloat64(self.engine.context, length_value) else c.pi_js_undefined(),\n        };\n        return self.createArgs(&args);\n    }\n    pub fn createArgs(self: *Fixture, args: []const c.JSValue) !*Handle {\n        if (self.primary_wrapper != null) return error.ConcreteFileHandlePreviousWrapperRequiredGone;\n        const constructor_result = try a.expression(self.engine, createBody, .{ self, args });\n        self.engine.freeValue(constructor_result);\n        return self.handle();\n    }\n    fn createBody(s: *a.Scope, self: *Fixture, args: []const c.JSValue) !c.JSValue {\n        // The fixture supplies a genuine FileHandle internal-field class and\n        // parent prototype. It does not publish the missing complete template.\n        const wrapper = try self.registry().newInstance(s, .filehandle, self.prototype.?);\n        self.primary_wrapper = a.duplicate(s.engine, wrapper);\n        try Handle.construct(s, self.registry(), wrapper, args, true, self.inputs());\n        const generation = try s.beforeAllocation();\n        const marker = try s.checkedAllocation(c.JS_NewObjectClass(\n            s.engine.context, self.marker_class), generation);\n        _ = c.JS_SetOpaque(marker, self);\n        var roots = [_]c.JSValue{marker};\n        const function_generation = try s.beforeAllocation();\n        const function = try s.checkedAllocation(c.JS_NewCFunctionData2(\n            s.engine.context, onRead, \"concreteFileHandleOnRead\", 1, 0,\n            roots.len, &roots), function_generation);\n        try self.registry().setStreamOnRead(s, wrapper, function);\n        return c.pi_js_undefined();\n"
    },
    {
      "source": "src/native_node_file_handle_owner_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_owner_test_support.zig",
        "bytes": 33411,
        "sha256": "DAAFD9A8B6FFFC0FD3971749F8A9515EA066BE81AEA90B44ADA397A70E76488B",
        "git_blob": "715f662079efe62d704b8f4ab97e8ebc1fa86ee6",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 553,
      "end": 573,
      "bytes": 1228,
      "sha256": "B39FF0F514932D04CCEC9863996B590B0C443BE7A93CBC0B86AB5A72CC889D70",
      "utf8": "    pub fn installFsRead(self: *Fixture) !void {\n        const result = try a.expression(self.engine, struct {\n            fn body(s: *a.Scope, f: *Fixture) !c.JSValue {\n                const data = binding.get(f.registry()) orelse\n                    return error.ConcreteFSBeforeHookBindingDataRequired;\n                const factory = try s.own(try fs_promise.acquire(s.engine, data));\n                const generation = try s.beforeAllocation();\n                const marker = try s.checkedAllocation(c.JS_NewSymbol(\n                    s.engine.context, \"fs_use_promises\", false), generation);\n                const function = try s.own(try fs_read.create(s.engine, .{\n                    .controller = f.controller.?, .use_promises = marker,\n                    .request_factory = factory,\n                }));\n                const global_object = try s.checked(c.JS_GetGlobalObject(s.engine.context));\n                try s.define(global_object, \"actualOwnerFsRead\", function, c.JS_PROP_C_W_E);\n                try s.define(global_object, \"actualOwnerUsePromises\", marker, c.JS_PROP_C_W_E);\n                return c.pi_js_undefined();\n            }\n        }.body, .{self});\n        self.engine.freeValue(result);\n    }\n"
    },
    {
      "source": "src/native_node_file_handle_owner_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_owner_test_support.zig",
        "bytes": 33411,
        "sha256": "DAAFD9A8B6FFFC0FD3971749F8A9515EA066BE81AEA90B44ADA397A70E76488B",
        "git_blob": "715f662079efe62d704b8f4ab97e8ebc1fa86ee6",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 589,
      "end": 641,
      "bytes": 2439,
      "sha256": "5CFD41663F4EC6DAE99F28B7ADDC19074B5E70342DCA468AB359FC6D0335D77D",
      "utf8": "    pub fn stopIo(self: *Fixture) void {\n        if (self.io_stopped) return;\n        self.io_stopped = true;\n        if (self.primary_wrapper) |wrapper| {\n            if (self.registry_owner) |actual_registry| if (actual_registry.unwrap(wrapper)) |state| {\n                const handle_value: *Handle = @alignCast(@fieldParentPtr(\"wrap\", state));\n                _ = handle_value.readStop();\n            };\n        }\n        if (self.environment) |environment| environment.can_call_into_js = false;\n        if (self.engine_alive) if (self.engine.native_env_deinit) |stop| stop(self.engine);\n        self.controller = null;\n    }\n    fn drop(self: *Fixture, slot: *?c.JSValue) void {\n        if (slot.*) |owned_value| { slot.* = null; self.engine.freeValue(owned_value); }\n    }\n    pub fn deinit(self: *Fixture) void {\n        self.stopIo();\n        if (self.outer_initialized) {\n            self.outer_initialized = false;\n            self.outer.deinit() catch @panic(\"concrete FileHandle outer scope teardown failed\");\n        }\n        if (self.environment) |environment|\n            environment.cleanupRealmAfterIoJoin() catch @panic(\"concrete FileHandle realm cleanup failed\");\n        if (self.queue) |queue| {\n            queue.close(self.engine) catch @panic(\"concrete FileHandle native queue cleanup failed\");\n            self.queue = null;\n            queue.release();\n        }\n        if (self.environment) |environment|\n            environment.disarm() catch @panic(\"concrete FileHandle Environment disarm failed\");\n        self.registry_owner = null;\n        if (self.engine_alive) {\n            for (self.caught[0..self.caught_count]) |caught_value| self.engine.freeValue(caught_value);\n            self.caught_count = 0;\n            self.drop(&self.primary_wrapper);\n            self.drop(&self.selected_hook_reason);\n            self.drop(&self.binding_target);\n            self.drop(&self.prototype);\n            self.drop(&self.handle_key);\n            self.drop(&self.template_owner);\n            self.engine.host_control_context = null;\n        }\n        if (self.environment) |environment| {\n            self.environment = null;\n            environment.release();\n        }\n        if (self.engine_alive) { self.engine_alive = false; self.engine.deinit(); }\n        if (self.native_environment_alive) {\n            self.native_environment_alive = false;\n            self.native_environment.deinit();\n        }\n    }\n"
    },
    {
      "source": "src/native_node_file_handle_read_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_read_test_support.zig",
        "bytes": 23302,
        "sha256": "F72A583ED548F7BE10477B0AEFD0F77E3D035FB48F2708324AF2E92EB6CA90EC",
        "git_blob": "08fdbd4d43b975bc356e0c9d2b86a5e5f71d49c0",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 242,
      "end": 270,
      "bytes": 1502,
      "sha256": "324D7AD92936401F7CE35098213BDCB6BF4FFB8CBAB9D87526AD710404B79EC3",
      "utf8": "    pub fn init(self: *Fixture) !void {\n        self.* = .{ .native_environment = .init(std.testing.allocator) };\n        errdefer self.deinit();\n        self.engine = try em.Engine.init(std.testing.allocator, .{});\n        self.engine_alive = true;\n        try @import(\"extensions/native_process.zig\").install(\n            self.engine, std.testing.io, &self.native_environment,\n            &.{\"native-filehandle-read\"});\n        const initialized = try a.expression(self.engine, bootstrap, .{self});\n        self.engine.freeValue(initialized);\n        self.controller = switch (try fs_io.acquire(self.engine, self.env())) {\n            .ready => |controller| controller,\n            .failed => return error.ActualFileHandleReadServiceAdmissionFailed,\n        };\n        try templates.configureFSReqCallback(self.engine,\n            self.templates_owner.?, self.controller.?);\n        const assembled = try a.expression(self.engine, assemble, .{self});\n        self.engine.freeValue(assembled);\n        self.drop(&self.binding_target);\n        self.outer.initialized = false;\n        self.outer.init(self.env(), self.wrapper_value.?,\n            .{ .async_id = 0, .trigger_async_id = 0 },\n            .{ .skip_async_hooks = true, .skip_task_queues = true },\n            c.pi_js_undefined()) catch |err| {\n            if (self.outer.initialized and !self.outer.deinitialized) {\n                self.outer.markFailed();\n                self.outer.deinit() catch {};\n            }\n            return err;\n"
    },
    {
      "source": "src/native_node_file_handle_read_test_support.zig",
      "source_pin": {
        "relative_path": "src/native_node_file_handle_read_test_support.zig",
        "bytes": 23302,
        "sha256": "F72A583ED548F7BE10477B0AEFD0F77E3D035FB48F2708324AF2E92EB6CA90EC",
        "git_blob": "08fdbd4d43b975bc356e0c9d2b86a5e5f71d49c0",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 299,
      "end": 323,
      "bytes": 1308,
      "sha256": "AA0881BBCFD1ED01CEAB5F114CB29B78EC949A24390A7DA2CE981FCA82EA0F52",
      "utf8": "    fn assemble(s: *a.Scope, self: *Fixture) !c.JSValue {\n        const wrapper = try self.registry().newInstance(s, .filehandle, self.prototype.?);\n        self.wrapper_value = a.duplicate(s.engine, wrapper);\n        const node = try self.env().allocator().create(Handle);\n        node.* = .{\n            .fixture = self,\n            .inputs = .{ .controller = self.controller.?, .handle_string = self.handle_key.?,\n                .trace = .{ .raw = self, .begin_read = traceBegin, .end_read = traceEnd } },\n        };\n        node.stream.initialized = false;\n        self.handle = node;\n        errdefer if (self.registry().unwrap(wrapper) != &node.state) {\n            self.handle = null;\n            self.env().allocator().destroy(node);\n        };\n        try node.state.initialize(self.registry(), wrapper, Handle.derived,\n            native.Provider.filehandle, -1);\n        try self.data.?.retainNative();\n        node.data = self.data;\n        try node.stream.init(self.env(), .{ .get_async_wrap = Handle.getWrap }, .{\n            .allocation = .{ .raw = self, .new_backing_store = allocateFirst },\n            .trace = .{ .raw = self, .before = traceBefore, .after = traceAfter },\n            .heap_diagnostics = null,\n        });\n        try node.stream.attachToObject(self.registry(), wrapper);\n"
    },
    {
      "source": "src/native_node_stream_read_test.zig",
      "source_pin": {
        "relative_path": "src/native_node_stream_read_test.zig",
        "bytes": 33817,
        "sha256": "BF29DB0783C38D6FCA9161C5C5555F3C7666B10675E041B4FEFA23E2E0A43688",
        "git_blob": "20ebc547833c0146edb7abdc841c1ce0d85b114c",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 235,
      "end": 252,
      "bytes": 953,
      "sha256": "AE9480B2D3DBE5D2A4E6B53E3C22019A54199895B39BC9E96244BB59D92ECF74",
      "utf8": "    retired: usize = 0,\n    destroyed: usize = 0,\n    direct_empty: bool = false,\n\n    fn init(self: *Fixture) !void {\n        self.* = .{ .native_environment = .init(std.testing.allocator) };\n        for (&self.probes, 0..) |*probe, index| probe.* = .{ .fixture = self, .index = index };\n        errdefer self.deinit();\n        self.engine = try em.Engine.init(std.testing.allocator, .{});\n        self.engine_alive = true;\n        try @import(\"extensions/native_process.zig\").install(\n            self.engine, std.testing.io, &self.native_environment, &.{\"native-stream-read\"});\n        const ignored = try a.expression(self.engine, bootstrap, .{self});\n        self.engine.freeValue(ignored);\n        self.outer.initialized = false;\n        self.outer.init(self.env(), self.wrapper_value.?,\n            .{ .async_id = 0, .trigger_async_id = 0 },\n            .{ .skip_async_hooks = true, .skip_task_queues = true }, self.parent_frame.?) catch |err| {\n"
    },
    {
      "source": "src/native_node_stream_read_test.zig",
      "source_pin": {
        "relative_path": "src/native_node_stream_read_test.zig",
        "bytes": 33817,
        "sha256": "BF29DB0783C38D6FCA9161C5C5555F3C7666B10675E041B4FEFA23E2E0A43688",
        "git_blob": "20ebc547833c0146edb7abdc841c1ce0d85b114c",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 292,
      "end": 308,
      "bytes": 914,
      "sha256": "F1FCB78BC1C55BCDD5783A18F542B1B10E3FFE6B16EF6954E5AD81DB58428889",
      "utf8": "        const node = try self.env().allocator().create(Node);\n        node.* = .{ .fixture = self };\n        node.stream.initialized = false;\n        self.node = node;\n        errdefer if (self.registry().unwrap(self.wrapper_value.?) != &node.state) {\n            self.node = null;\n            self.env().allocator().destroy(node);\n        };\n        try node.state.initialize(self.registry(), self.wrapper_value.?,\n            Node.derived, wraps.Provider.filehandle, -1);\n        try node.stream.init(self.env(), .{ .get_async_wrap = Node.getWrap }, .{\n            .allocation = .{ .raw = self, .new_backing_store = firstSuccessfulAllocation },\n            .trace = .{ .raw = self, .before = traceBefore, .after = traceAfter },\n            .heap_diagnostics = null,\n        });\n        try node.stream.attachToObject(self.registry(), self.wrapper_value.?);\n        const callback = try makeCallback(s, self, 0);\n"
    },
    {
      "source": "src/extensions/native_node_stream_shutdown.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\production\\src\\extensions\\native_node_stream_shutdown.zig",
        "bytes": 11021,
        "sha256": "2BEE67EE76015C0549729F3F3B12CD4BBBF32C5DBF5A28D8CEE3F111E0C86D7E"
      },
      "start": 175,
      "end": 226,
      "bytes": 2483,
      "sha256": "731A3BA31F5A2C655573416F410BACE041A3EDC6F0F7FC422EBC11CC59DC1030",
      "utf8": "/// Exact reusable ReportWritesToJSStreamListener native callback. Derived\n/// listeners (including CustomBufferJSListener) select this operation rather\n/// than the base StreamListener's forward-to-previous implementation.\npub fn reportAfterShutdown(listener: *resources.Listener,\n    request: *requests.Shutdown, status: c_int) anyerror!void\n{\n    return reportAfterRequest(listener, &request.request, status);\n}\n\npub fn reportAfterRequest(listener: *resources.Listener,\n    request: *requests.Request, status: c_int) anyerror!void\n{\n    // Source static_cast<StreamBase*>(stream_): the installed listener must be\n    // attached to an actual Base resource, as in the original inheritance.\n    const resource = listener.stream orelse return error.ActualStreamListenerRequired;\n    const stream: *streams.Base = @fieldParentPtr(\"resource\", resource);\n    const environment = stream.environment;\n    if (!environment.canCallIntoJs()) return;\n    _ = environment.retain();\n    defer environment.release();\n    const engine = try environment.requireEngine();\n    const state = request.asyncWrap();\n    var locals = a.Scope.init(engine);\n    const ignored = try locals.finish(reportBody(&locals, stream, state, status));\n    engine.freeValue(ignored);\n}\n\nfn reportBody(s: *a.Scope, stream: *streams.Base, state: *wraps.State,\n    status: c_int) anyerror!c.JSValue\n{\n    const wrapper = state.object() orelse check.assertion(s.engine, .{\n        .file_line = \"src/stream_base.cc:763\",\n        .message = \"!async_wrap->persistent().IsEmpty()\",\n        .function = \"node::ReportWritesToJSStreamListener::OnStreamAfterReqFinished\",\n    });\n    const object = try s.own(a.duplicate(s.engine, wrapper));\n    const stream_object = stream.virtuals.get_object(stream) orelse\n        return error.ActualStreamObjectRequired;\n    var arguments = [_]c.JSValue{\n        c.JS_NewInt32(s.engine.context, status),\n        try s.own(a.duplicate(s.engine, stream_object)),\n        c.pi_js_undefined(),\n    };\n    const bindings = stream.operations.shutdown orelse\n        return error.ActualStreamShutdownBindingsRequired;\n    const diagnostics = stream.operations.heap_diagnostics;\n    if (stream.virtuals.error_string(stream)) |message| {\n        arguments[2] = try latin1.fromCString(s, message, diagnostics);\n        stream.virtuals.clear_error(stream);\n    }\n    // Has(...).FromJust() is the original native terminal policy, even when the\n    // proxy Has trap produced an ordinary pending reason.\n"
    },
    {
      "source": "src/extensions/native_node_stream_request.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\production\\src\\extensions\\native_node_stream_request.zig",
        "bytes": 6970,
        "sha256": "654816139FC110560BA21BDBBEA35744468B1E6C52154448D30CEDC3656A6E8B"
      },
      "start": 37,
      "end": 63,
      "bytes": 1377,
      "sha256": "AED1F52EDA25A29E591DFCB5019ABBB7752EED0C2E514E15411F18EA648A6937",
      "utf8": "    /// The optional error-string block owns its original HandleScope. A failed\n    /// Set returns before OnDone; otherwise its locals retire before OnDone.\n    pub fn done(self: *Request, status: c_int, error_string: ?[*:0]const u8) anyerror!void {\n        if (error_string) |text| {\n            const state = self.asyncWrap();\n            const environment = state.registry.environment.retain();\n            defer environment.release();\n            const engine = try environment.requireEngine();\n            var scope = a.Scope.init(engine);\n            const ignored = try scope.finish(setErrorBody(&scope, self, text));\n            engine.freeValue(ignored);\n        }\n        return self.on_done(self, status);\n    }\n\n    fn setErrorBody(s: *a.Scope, self: *Request, text: [*:0]const u8) anyerror!c.JSValue {\n        const stream = self.stream;\n        const bindings = stream.operations.shutdown orelse\n            return error.ActualStreamShutdownBindingsRequired;\n        const wrapper = self.object() orelse\n            return error.ActualStreamRequestObjectRequired;\n        const object_value = try s.own(a.duplicate(s.engine, wrapper));\n        const error_value = try latin1.fromCString(s, text,\n            stream.operations.heap_diagnostics);\n        try setError(s, object_value, bindings.error_string, error_value);\n        return c.pi_js_undefined();\n    }\n"
    },
    {
      "source": "src/extensions/native_node_one_byte_string.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\production\\src\\extensions\\native_node_one_byte_string.zig",
        "bytes": 2658,
        "sha256": "2387DDE54B2B079BC0F78490602E4CF150F4A1E46FFC3FC05D7EF3CB5CEE4507"
      },
      "start": 1,
      "end": 52,
      "bytes": 2658,
      "sha256": "2387DDE54B2B079BC0F78490602E4CF150F4A1E46FFC3FC05D7EF3CB5CEE4507",
      "utf8": "// Copyright Joyent, Inc. and other Node contributors. MIT; retained Node LICENSE.\n//! Selected node::OneByteString / NewFromOneByte(kNormal) operation over the\n//! real VM Latin-1 primitive. Bytes are never interpreted as UTF-8.\n//! Native V8 heap layout, its single-character cache and GC/retry machinery are\n//! not implemented by this raw VM primitive; allocation remains the real VM's.\nconst a = @import(\"native_node_argument_values.zig\");\nconst check = @import(\"native_node_check_failure.zig\");\nconst c = a.c;\nextern fn pi_node_one_byte_string_cstring_length(?*c.JSContext, [*c]const u8) c_int;\nextern fn pi_node_one_byte_string_empty_maybe_handle(?*c.JSContext) void;\n\n// v8::String::kMaxLength in the pinned v8-primitive.h, for the target pointer.\npub const max_length: c_int = if (@sizeOf(usize) == 4)\n    (1 << 28) - 16 else (1 << 29) - 24;\n\npub fn fromCString(s: *a.Scope, data: [*:0]const u8,\n    diagnostics: ?*const check.Diagnostics) anyerror!c.JSValue\n{\n    return fromOneByte(s, data, -1, diagnostics);\n}\n\n/// length is the original signed API argument. Negative values use strlen;\n/// zero needs no readable input byte; positive lengths preserve embedded NUL.\npub fn fromOneByte(s: *a.Scope, data: [*c]const u8, length: c_int,\n    diagnostics: ?*const check.Diagnostics) anyerror!c.JSValue\n{\n    try s.pending();\n    if (length > max_length)\n        check.fatal(s.engine, \"v8::ToLocalChecked\", \"Empty MaybeLocal\", diagnostics);\n\n    const actual_length = if (length < 0)\n        pi_node_one_byte_string_cstring_length(s.engine.context, data) else length;\n    if (actual_length > max_length) {\n        // Only an inferred C-string length can reach this factory branch.\n        // FactoryBase::NewRawStringWithMap first produces the invalid-length\n        // RangeError; the empty MaybeHandle then fails its real V8 CHECK.\n        const occurrence = c.JS_PiOutOfMemoryOccurrence(s.engine.runtime);\n        _ = c.JS_ThrowRangeError(s.engine.context, \"Invalid string length\");\n        if (c.JS_PiOutOfMemoryOccurrence(s.engine.runtime) != occurrence)\n            check.heapOutOfMemory(s.engine, diagnostics);\n        pi_node_one_byte_string_empty_maybe_handle(s.engine.context);\n        unreachable;\n    }\n    const generation = try s.beforeAllocation();\n    const occurrence = c.JS_PiOutOfMemoryOccurrence(s.engine.runtime);\n    const raw = c.JS_PiNewStringLatin1(s.engine.context, data,\n        @as(usize, @intCast(actual_length)));\n    if (c.JS_IsException(raw) and\n        c.JS_PiOutOfMemoryOccurrence(s.engine.runtime) != occurrence)\n        check.heapOutOfMemory(s.engine, diagnostics);\n    return s.checkedAllocation(raw, generation);\n}\n"
    },
    {
      "source": "src/native_node_one_byte_string_test.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\controls\\src\\native_node_one_byte_string_test.zig",
        "bytes": 5064,
        "sha256": "AC3E1AD12FB0F48905EC8B561094F54DD93653AD7C8DC5DD7CC0EBB54959C461"
      },
      "start": 3,
      "end": 14,
      "bytes": 531,
      "sha256": "DBDB67D4136AA70D917F9DDE252C3B62073553171F0943C0D85824AD74FD114C",
      "utf8": "const std = @import(\"std\");\nconst a = @import(\"extensions/native_node_argument_values.zig\");\nconst c = a.c;\nconst latin1 = @import(\"extensions/native_node_one_byte_string.zig\");\nconst Engine = a.v.em.Engine;\n\nfn create(engine: *Engine, bytes: [*c]const u8, length: c_int) !c.JSValue {\n    return a.expression(engine, struct {\n        fn body(s: *a.Scope, data: [*c]const u8, count: c_int) !c.JSValue {\n            return a.duplicate(s.engine, try latin1.fromOneByte(s, data, count, null));\n        }\n    }.body, .{bytes, length});\n"
    },
    {
      "source": "src/extensions/native_node_stream_resource.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\src\\extensions\\native_node_stream_resource.zig",
        "bytes": 6847,
        "sha256": "39255A86BA9631F95E9CBD13B85AE7264A30A015EF4454F10B2D64BD643F2D8A"
      },
      "start": 24,
      "end": 52,
      "bytes": 1322,
      "sha256": "BBD8D95BF41A1B741A7A49C512D69E7530CB56F6AEFC394D35B4468C03883BD0",
      "utf8": "pub const Listener = struct {\n    stream: ?*Resource = null,\n    previous_listener: ?*Listener = null,\n    on_destroy: *const fn (*Listener) void = defaultOnDestroy,\n    read_methods: ?*const ReadMethods = null,\n    after_shutdown: *const fn (*Listener, *requests.Shutdown, c_int) anyerror!void = forwardAfterShutdown,\n\n    fn forwardAfterShutdown(self: *Listener, request: *requests.Shutdown,\n        status: c_int) anyerror!void\n    {\n        const previous = self.previous_listener orelse check.assertion(\n            if (self.stream) |stream| stream.engine else null, .{\n                .file_line = \"src/stream_base.cc:808\",\n                .message = \"(previous_listener_) != nullptr\",\n                .function = \"node::StreamListener::OnStreamAfterShutdown\",\n            });\n        return previous.after_shutdown(previous, request, status);\n    }\n\n    // The original virtual default OnStreamDestroy() has an empty body.\n    fn defaultOnDestroy(_: *Listener) void {}\n\n    /// Actual StreamListener::~StreamListener. Call this before releasing the\n    /// listener's native storage. Removing an already unlinked listener is not\n    /// attempted; the owning Resource may still be in its destructor callback.\n    pub fn deinit(self: *Listener) void {\n        if (self.stream) |stream| stream.remove(self);\n    }\n};\n"
    },
    {
      "source": "src/extensions/native_node_stream_resource.zig",
      "source_pin": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\src\\extensions\\native_node_stream_resource.zig",
        "bytes": 6847,
        "sha256": "39255A86BA9631F95E9CBD13B85AE7264A30A015EF4454F10B2D64BD643F2D8A"
      },
      "start": 54,
      "end": 64,
      "bytes": 388,
      "sha256": "0D4CB1ED7917A3F59D85547022D5B64F69D54F8CCF08EC2DBB2A1C133099730E",
      "utf8": "pub const Resource = struct {\n    // A borrowed diagnostic context projects Node's current isolate into the\n    // genuine native CHECK bridge. It is not a JS root or another Env owner.\n    engine: *em.Engine,\n    listener: ?*Listener = null,\n    bytes_read: u64 = 0,\n    bytes_written: u64 = 0,\n\n    pub fn init(engine: *em.Engine) Resource {\n        return .{ .engine = engine };\n    }\n"
    },
    {
      "source": "src/native_node_stream_resource_test.zig",
      "source_pin": {
        "relative_path": "src/native_node_stream_resource_test.zig",
        "bytes": 7910,
        "sha256": "9FFEC85C655A092A86CA084F8FDA81048A02168363569EAE89D8E08752116222",
        "git_blob": "50c8a18f1472c9e3d372878f240b5462ba3e3be7",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 1,
      "end": 87,
      "bytes": 3431,
      "sha256": "5FAD639995C8E811B48089E2B9D316283124C9643A0414AB81DC14590C4CB2C6",
      "utf8": "//! Actual native StreamResource listener lifetime controls.\n//! The listeners are native records and callbacks; no JavaScript stand-in\n//! implements their list, destruction, allocation or reentrant mutations.\nconst std = @import(\"std\");\nconst em = @import(\"extensions/engine.zig\");\nconst streams = @import(\"extensions/native_node_stream_resource.zig\");\nconst ChargedAllocator = @import(\"extensions/native_env_charged_allocator.zig\").ChargedAllocator;\n\nconst Action = enum { observe, remove_self, remove_other, push_other, free_self };\nconst Record = struct {\n    allocator: std.mem.Allocator,\n    trace: [16]u8 = undefined,\n    length: usize = 0,\n    freed: usize = 0,\n    fn append(self: *Record, id: u8) void {\n        std.debug.assert(self.length < self.trace.len);\n        self.trace[self.length] = id;\n        self.length += 1;\n    }\n};\nconst Node = struct {\n    listener: streams.Listener = .{ .on_destroy = destroyed },\n    record: *Record,\n    id: u8,\n    action: Action = .observe,\n    other: ?*streams.Listener = null,\n\n    fn destroyed(listener: *streams.Listener) void {\n        const self: *Node = @alignCast(@fieldParentPtr(\"listener\", listener));\n        const record = self.record;\n        record.append(self.id);\n        const action = self.action;\n        self.action = .observe;\n        switch (action) {\n            .observe => {},\n            .remove_self => self.listener.deinit(),\n            .remove_other => self.listener.stream.?.remove(self.other),\n            .push_other => self.listener.stream.?.push(self.other),\n            .free_self => {\n                self.listener.deinit();\n                record.freed += 1;\n                // The actual native record is gone before Resource.deinit\n                // resumes. Only the saved address may be compared afterward.\n                record.allocator.destroy(self);\n            },\n        }\n    }\n};\nconst Fixture = struct {\n    engine: *em.Engine,\n    charged: ChargedAllocator,\n    resource: streams.Resource,\n    record: Record,\n    nodes: [4]Node,\n\n    fn init(self: *Fixture) !void {\n        const engine = try em.Engine.init(std.testing.allocator, .{});\n        self.* = .{\n            .engine = engine,\n            .charged = ChargedAllocator.init(engine),\n            .resource = streams.Resource.init(engine),\n            .record = undefined,\n            .nodes = undefined,\n        };\n        self.record = .{ .allocator = self.charged.allocator() };\n        for (&self.nodes, 0..) |*node, index|\n            node.* = .{ .record = &self.record, .id = @intCast(index) };\n    }\n    fn deinit(self: *Fixture) void {\n        // Teardown also owns any still-linked heap listener after a failed\n        // assertion. Callback records and the diagnostic Engine remain alive.\n        self.resource.deinit();\n        for (&self.nodes) |*node| node.listener.deinit();\n        self.charged.deinit();\n        self.engine.deinit();\n    }\n    fn push(self: *Fixture, index: usize) void {\n        self.resource.push(&self.nodes[index].listener);\n    }\n    fn expectTrace(self: *Fixture, expected: []const u8) !void {\n        try std.testing.expectEqualSlices(u8, expected, self.record.trace[0..self.record.length]);\n    }\n    fn expectUnlinked(self: *Fixture, index: usize) !void {\n        try std.testing.expect(self.nodes[index].listener.stream == null);\n        try std.testing.expect(self.nodes[index].listener.previous_listener == null);\n    }\n};\n"
    },
    {
      "source": "src/native_node_stream_resource_test.zig",
      "source_pin": {
        "relative_path": "src/native_node_stream_resource_test.zig",
        "bytes": 7910,
        "sha256": "9FFEC85C655A092A86CA084F8FDA81048A02168363569EAE89D8E08752116222",
        "git_blob": "50c8a18f1472c9e3d372878f240b5462ba3e3be7",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 89,
      "end": 178,
      "bytes": 4478,
      "sha256": "3170D2647404A7D4911D6E2C30048BBD64114F3F0C31A77E84925E04BF90FEF0",
      "utf8": "test \"native Node stream resource initializes the actual counters and publishes the native listener chain\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    try std.testing.expectEqual(@as(u64, 0), f.resource.bytes_read);\n    try std.testing.expectEqual(@as(u64, 0), f.resource.bytes_written);\n    try std.testing.expect(f.resource.listener == null);\n    f.push(0); f.push(1);\n    try std.testing.expect(f.resource.listener == &f.nodes[1].listener);\n    try std.testing.expect(f.nodes[1].listener.previous_listener == &f.nodes[0].listener);\n    try std.testing.expect(f.nodes[0].listener.previous_listener == null);\n    try std.testing.expect(f.nodes[0].listener.stream == &f.resource);\n    try std.testing.expect(f.nodes[1].listener.stream == &f.resource);\n    try f.expectTrace(&.{});\n}\ntest \"native Node stream resource removes a middle listener and clears both of its actual links\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0); f.push(1); f.push(2);\n    f.resource.remove(&f.nodes[1].listener);\n    try f.expectUnlinked(1);\n    try std.testing.expect(f.resource.listener == &f.nodes[2].listener);\n    try std.testing.expect(f.nodes[2].listener.previous_listener == &f.nodes[0].listener);\n    try std.testing.expect(f.nodes[0].listener.stream == &f.resource);\n    try f.expectTrace(&.{});\n    f.resource.deinit();\n    try f.expectTrace(&.{ 2, 0 });\n}\ntest \"native Node stream resource listener destruction unlinks once without invoking OnStreamDestroy\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0); f.push(1);\n    f.nodes[1].listener.deinit();\n    f.nodes[1].listener.deinit();\n    try f.expectUnlinked(1);\n    try std.testing.expect(f.resource.listener == &f.nodes[0].listener);\n    try f.expectTrace(&.{});\n    f.resource.deinit();\n    try f.expectTrace(&.{0});\n}\ntest \"native Node stream resource destruction visits the original native head order and clears each link\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0); f.push(1); f.push(2);\n    f.resource.deinit();\n    try f.expectTrace(&.{ 2, 1, 0 });\n    try std.testing.expect(f.resource.listener == null);\n    for (0..3) |index| try f.expectUnlinked(index);\n}\ntest \"native Node stream resource callback can unlink and free its actual charged native record\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0);\n    const self_deleting = try f.record.allocator.create(Node);\n    self_deleting.* = .{ .record = &f.record, .id = 9, .action = .free_self };\n    f.resource.push(&self_deleting.listener);\n    // Resource now owns the actual callback route to this allocation's free.\n    // Fixture.deinit reaches it even if a later assertion fails.\n    f.resource.deinit();\n    try f.expectTrace(&.{ 9, 0 });\n    try std.testing.expectEqual(@as(usize, 1), f.record.freed);\n    try std.testing.expect(f.resource.listener == null);\n    try f.expectUnlinked(0);\n}\ntest \"native Node stream resource destruction observes actual removal of a later listener\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0); f.push(1); f.push(2);\n    f.nodes[2].action = .remove_other;\n    f.nodes[2].other = &f.nodes[1].listener;\n    f.resource.deinit();\n    try f.expectTrace(&.{ 2, 0 });\n    for (0..3) |index| try f.expectUnlinked(index);\n}\ntest \"native Node stream resource destruction visits a newly pushed head before returning to its original listener\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0);\n    f.nodes[0].action = .push_other;\n    f.nodes[0].other = &f.nodes[1].listener;\n    f.resource.deinit();\n    // Original OnStreamDestroy has not unlinked itself. Once the new head is\n    // removed, the real while loop visits that original listener a second time.\n    try f.expectTrace(&.{ 0, 1, 0 });\n    try f.expectUnlinked(0); try f.expectUnlinked(1);\n}\ntest \"native Node stream resource preserves the embedded default listener member-before-base destruction\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    f.push(0); f.push(1);\n    // Actual StreamBase::default_listener_ is destroyed before its\n    // StreamResource base. Its StreamListener destructor only unlinks it.\n    f.nodes[0].listener.deinit();\n    try f.expectUnlinked(0);\n    try std.testing.expect(f.nodes[1].listener.previous_listener == null);\n    f.resource.deinit();\n    try f.expectTrace(&.{1});\n    try f.expectUnlinked(1);\n}\n"
    },
    {
      "source": "src/native_node_fs_before_hook_continuation_test.zig",
      "source_pin": {
        "relative_path": "src/native_node_fs_before_hook_continuation_test.zig",
        "bytes": 6578,
        "sha256": "D3F918F36D0E343332088E6925025559A68673A4A31E496A65AD2A678AC8AF92",
        "git_blob": "0d95f807ccd05568e0217f13540ab1dca0ff21f1",
        "mode": "100644",
        "basis": "raw_git_014062f2d139254acab4b985b4ae343db637166f"
      },
      "start": 40,
      "end": 115,
      "bytes": 4165,
      "sha256": "32B0BC845F428EA1DCE82BFD42C2345C114105A9E6E4249F92084FB99C853A49",
      "utf8": "test \"native FS before hook actual read fulfills after the same ordinary hook rethrow\" {\n    var file: File = undefined; try file.init(); defer file.deinit();\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    try f.installFsRead();\n    try f.installThrowingBeforeHook();\n    const promise = try read(&f, file.descriptor);\n    defer f.engine.freeValue(promise);\n    c.JS_PromiseMarkAsHandled(f.engine.context, promise);\n    const id = (try f.pendingFs()).wrap.async_id;\n    const actual = try retainStorage(&f);\n    defer uv.pi_uv_fs_request_release(actual);\n    try std.testing.expectEqual(c.JS_PROMISE_PENDING, c.JS_PromiseState(f.engine.context, promise));\n    try std.testing.expectEqual(@as(c_int, 1), f.env().requests.waiting);\n    try expectActualContinuation(&f, id, actual);\n    try std.testing.expectEqual(@as(i64, 4), uv.pi_uv_fs_request_info(actual).result);\n    try std.testing.expectEqual(c.JS_PROMISE_FULFILLED, c.JS_PromiseState(f.engine.context, promise));\n    const result = c.JS_PromiseResult(f.engine.context, promise);\n    defer f.engine.freeValue(result);\n    try std.testing.expect(c.JS_IsNumber(result));\n    var bytes: i32 = 0;\n    try std.testing.expectEqual(@as(c_int, 0), c.JS_ToInt32(f.engine.context, &bytes, result));\n    try std.testing.expectEqual(@as(i32, 4), bytes);\n    try std.testing.expectEqual(@as(c_int, 0), File.status(file.descriptor));\n}\n\ntest \"native FS before hook actual EBADF read rejects with UVException while the hook reason propagates separately\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    try f.installFsRead();\n    try f.installThrowingBeforeHook();\n    const promise = try read(&f, -1);\n    defer f.engine.freeValue(promise);\n    c.JS_PromiseMarkAsHandled(f.engine.context, promise);\n    const id = (try f.pendingFs()).wrap.async_id;\n    const actual = try retainStorage(&f);\n    defer uv.pi_uv_fs_request_release(actual);\n    try expectActualContinuation(&f, id, actual);\n    try std.testing.expectEqual(@as(i64, support.physical.UV_EBADF),\n        uv.pi_uv_fs_request_info(actual).result);\n    try std.testing.expectEqual(c.JS_PROMISE_REJECTED, c.JS_PromiseState(f.engine.context, promise));\n    const result = c.JS_PromiseResult(f.engine.context, promise);\n    defer f.engine.freeValue(result);\n    try std.testing.expect(!c.JS_IsStrictEqual(f.engine.context, result, f.selected_hook_reason.?));\n    try f.expose(\"ownerFsRejection\", result);\n    try f.expect(\"ownerFsRejection instanceof Error && ownerFsRejection.code === 'EBADF' && \" ++\n        \"ownerFsRejection.syscall === 'read'\");\n    try std.testing.expect(!c.JS_IsUncatchableError(result));\n}\n\ntest \"native FS before hook continuation performs the original live Promise Get before settlement\" {\n    var file: File = undefined; try file.init(); defer file.deinit();\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    try f.installFsRead();\n    try f.installThrowingBeforeHook();\n    const original = try read(&f, file.descriptor);\n    defer f.engine.freeValue(original);\n    const request = try f.pendingFs();\n    const id = request.wrap.async_id;\n    try f.expose(\"ownerFsRequest\", try request.object());\n    try f.evaluate(\n        \\\\globalThis.ownerReplacementPromise = new Promise(() => {});\n        \\\\globalThis.ownerLivePromiseGets = 0;\n        \\\\Object.defineProperty(ownerFsRequest, \"promise\", { configurable: true, get() {\n        \\\\  ++ownerLivePromiseGets;\n        \\\\  if (ownerBeforeIds.length !== 1) throw Error(\"live Get ran before real before hook\");\n        \\\\  return ownerReplacementPromise;\n        \\\\}});\n    );\n    const replacement = try f.global(\"ownerReplacementPromise\");\n    defer f.engine.freeValue(replacement);\n    const actual = try retainStorage(&f);\n    defer uv.pi_uv_fs_request_release(actual);\n    try expectActualContinuation(&f, id, actual);\n    try std.testing.expectEqual(c.JS_PROMISE_PENDING, c.JS_PromiseState(f.engine.context, original));\n    try std.testing.expectEqual(c.JS_PROMISE_FULFILLED, c.JS_PromiseState(f.engine.context, replacement));\n    try f.expect(\"ownerLivePromiseGets === 1\");\n    const retained = try f.global(\"ownerFsRequest\");\n"
    },
    {
      "source": "tools/build_native_vm_identity.zig",
