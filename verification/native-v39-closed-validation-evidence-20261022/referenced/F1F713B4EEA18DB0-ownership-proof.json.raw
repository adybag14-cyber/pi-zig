  "findings": [
    {
      "id": "cause",
      "finding": "All 18 stderr stacks traverse unselectedCheck -> pushBody invalid_resource -> Scope.init -> Fixture.init:329 before named test bodies. skip_async_hooks only bypasses EmitBefore; it does not bypass the actual present-resource check.",
      "boundary": "Production check and operation signatures remain exact."
    },
    {
      "id": "construction",
      "finding": "The existing bootstrap's successful return becomes a.duplicate(s.engine, try s.object()). Scope.object uses beforeAllocation and checkedAllocation on real JS_NewObject; the allocated local root and escaped duplicate have separate entitlements.",
      "boundary": "No constructor bridge, property lookup, fake owner, binding_target or FileHandle alias is introduced."
    },
    {
      "id": "expression_escape",
      "finding": "a.expression finishes the local scope. Boundary.retire releases local roots while Boundary.finish preserves the explicit escaped result on success; failureRoots releases it on failure.",
      "boundary": "The initializer owns exactly the returned local entitlement."
    },
    {
      "id": "scope_ownership",
      "finding": "The initializer defers freeValue(outer_resource), then passes it to the unchanged Scope.init. Scope.init retains Environment and duplicates the resource into stable scope storage before async-context push.",
      "boundary": "The local release after successful init leaves the independent Scope resource reference alive."
    },
    {
      "id": "error_unwind",
      "finding": "Bootstrap failure leaves no initialized outer_resource/defer; existing Fixture.init errdefer runs. Any later failure releases the local object via defer. If Scope.init initialized before failing, the unchanged catch marks failed and deinitializes it, retiring the independent Scope resource and Environment references before the local defer and enclosing cleanup.",
      "boundary": "No extra cleanup branch or swallowed error was introduced."
    },
    {
      "id": "weak_lifetime",
      "finding": "BindingData.makeWeak drops its strong wrapper; the new plain object has no properties linking to that target or to a FileHandle. The outer Scope therefore does not keep either object alive.",
      "boundary": "The owner fixture has no permanent FileHandle to use as a resource, unlike the existing read fixture."
    },
    {
      "id": "teardown",
      "finding": "The unchanged Fixture.deinit destroys the outer scope before dropping target/template roots and Engine. Scope.deinit restores scope/depth, releases prior_frame and resource, then releases Environment.",
      "boundary": "Complete fixture test bodies and production bytes remain unchanged."
    },
    {
      "id": "scope",
      "finding": "All four selected root files retain their exact bytes and qualified named control lists: 18 + 3 + 24 + 13 = 58. Only three non-import changes occur in this fixture; 16 Zig import literals plus std remain exact.",
      "boundary": "The existing conservative import graph topology is retained; no native metadata/runtime result is inferred."
    }
  ],
