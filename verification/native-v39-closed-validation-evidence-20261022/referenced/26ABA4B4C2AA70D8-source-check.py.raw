seen={};raws={}
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def pin(p,b):return dict(path=str(p),bytes=len(b),sha256=sha(b))
def take(r):
 p=Path(r["path"]);assert p.is_absolute()and B in p.parents and M not in p.resolve().parents and p.resolve()!=M
 b=p.read_bytes();assert len(b)==r["bytes"]and sha(b)==r["sha256"],r
 key=str(p).casefold();assert key not in seen or seen[key]==r
 seen[key]=r;return b
def exact(p,size,digest):r=dict(path=str(p),bytes=size,sha256=digest);take(r);return r
def doc(r):return json.loads(take(r).decode("utf-8-sig"))
def helpers(raw,tree):
 lines=raw.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno])for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}
def tokens(raw):
 text=raw.decode();lines=text.splitlines(keepends=True);starts=[];at=0
 for line in lines:starts.append(at);at+=len(line.encode())
 def off(pos):return starts[pos[0]-1]+len(lines[pos[0]-1][:pos[1]].encode())
 return [(t.type,t.string,off(t.start),off(t.end),t.start)for t in tokenize.generate_tokens(io.StringIO(text).readline)if t.type==tokenize.STRING]
def region(raw,start,end):
 assert raw.count(start)==1
 a=raw.index(start);z=len(raw)if end is None else raw.index(end,a)
 return raw[a:z]
def normalized(raw,bindings,old):
 tree=ast.parse(raw)
 values={x["before_value"if old else"after_value"]:"BOUND_"+x["binding"]for x in bindings}
 count=0
 for n in ast.walk(tree):
  if isinstance(n,ast.Constant)and isinstance(n.value,str)and n.value in values:
   n.value=values[n.value];count+=1
 assert count==len(bindings)
 return ast.dump(tree,include_attributes=False)
