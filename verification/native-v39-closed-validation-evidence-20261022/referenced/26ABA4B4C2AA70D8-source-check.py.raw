matrix=doc(catalog["matrix"]);assert catalog["matrix"]["sha256"]==MATRIX and matrix["source_head_at_preparation"]==HEAD
assert len(matrix["groups"])==120 and sum(len(g["required_named"])for g in matrix["groups"])==2051
for ref in catalog["preparation_reviews"]:
 review=doc(ref);assert review["candidate_head"]==HEAD and review["matrix"]["sha256"]==MATRIX and review["actual_metadata_count"]is None
 assert review["selected_group_names"]==catalog["selected_group_names"][review["batch"]]
 assert review["historical_source_rebindings"]==catalog["historical_source_rebindings"]
 assert review["historical_provenance_relationships"]==catalog["historical_provenance_relationships"]
 take(review["matrix"])
root=doc(receipt["unresolved_Root_source_review"]);contract=doc(receipt["binding_contract"])
assert root["source_accepted"]is True and root["all58_edits_and_full_inverses_read_and_replayed"]is True
