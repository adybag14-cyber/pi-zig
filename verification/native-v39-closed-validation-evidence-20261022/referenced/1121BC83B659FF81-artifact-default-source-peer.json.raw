          "text": "    const out_filename = std.zig.binNameAlloc(owner.allocator, .{\n        .root_name = name,\n        .target = target,\n        .output_mode = switch (options.kind) {\n            .lib => .Lib,\n            .obj, .test_obj => .Obj,\n            .exe, .@\"test\" => .Exe,\n        },\n        .link_mode = options.linkage,\n        .version = options.version,\n    }) catch @panic(\"OOM\");"
