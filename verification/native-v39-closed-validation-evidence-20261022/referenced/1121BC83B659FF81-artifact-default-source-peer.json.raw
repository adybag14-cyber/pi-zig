      "path": "C:\\Users\\adyba\\pi-zig\\toolchain\\zig-x86_64-windows-0.16.0\\lib\\std\\zig.zig",
      "sha256": "5445596331AD810FC60057FCE5555477E9317441FB36F69C632F37F0D1DA0824",
      "bytes": 44987,
      "quotes": [
        {
          "start_line": 156,
          "end_line": 161,
          "text": "pub fn binNameAlloc(allocator: Allocator, options: BinNameOptions) error{OutOfMemory}![]u8 {\n    const root_name = options.root_name;\n    const t = options.target;\n    switch (t.ofmt) {\n        .coff => switch (options.output_mode) {\n            .Exe => return std.fmt.allocPrint(allocator, \"{s}{s}\", .{ root_name, t.exeFileExt() }),"
        }
      ]
    },
    {
      "path": "C:\\Users\\adyba\\pi-zig\\toolchain\\zig-x86_64-windows-0.16.0\\lib\\std\\Target.zig",
      "sha256": "B830BAC98558E0E6B83AF9917F3FF492452F57F608C3C54F009384C793A6F345",
      "bytes": 117251,
      "quotes": [
        {
          "start_line": 100,
          "end_line": 111,
          "text": "        pub fn exeFileExt(tag: Tag, arch: Cpu.Arch) [:0]const u8 {\n            return switch (tag) {\n                .windows => \".exe\",\n                .uefi => \".efi\",\n                .plan9 => arch.plan9Ext(),\n                else => switch (arch) {\n                    .wasm32, .wasm64 => \".wasm\",\n                    else => \"\",\n                },\n            };\n        }\n"
        },
        {
          "start_line": 2119,
          "end_line": 2121,
          "text": "pub fn exeFileExt(target: *const Target) [:0]const u8 {\n    return target.os.tag.exeFileExt(target.cpu.arch);\n}"
        }
      ]
    }
