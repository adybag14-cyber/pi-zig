          "text": "pub const TestOptions = struct {\n    name: []const u8 = \"test\",\n    root_module: *Module,"
        },
        {
          "start_line": 881,
          "end_line": 888,
          "text": "pub fn addTest(b: *Build, options: TestOptions) *Step.Compile {\n    return .create(b, .{\n        .name = options.name,\n        .kind = if (options.emit_object) .test_obj else .@\"test\",\n        .root_module = options.root_module,\n        .max_rss = options.max_rss,\n        .filters = b.dupeStrings(options.filters),\n        .test_runner = options.test_runner,"
        }
      ]
    },
