  "source_declared_controls": 13,
  "named_declarations": [
    {
      "name": "native FileHandle transfer changes only the live closed member and retains the real descriptor",
      "line": 116
    },
    {
      "name": "native FileHandle transfer admission follows real ReadStart and ReadStop with the original pending request",
      "line": 160
    },
    {
      "name": "native FileHandle transfer rejects real closing and closed state without weakening the close request",
      "line": 194
    },
    {
      "name": "native FileHandle transfer admission excludes the real released descriptor state",
      "line": 218
    },
    {
      "name": "native FileHandle transfer packet move preserves one native allocation and closes once",
      "line": 233
    },
    {
      "name": "native FileHandle transfer packet survives actual sender GC and weak BindingData retirement",
      "line": 256
    },
    {
      "name": "native FileHandle transfer allocation alone retains its native memory domain after Engine teardown",
      "line": 273
    },
    {
      "name": "native FileHandle transfer abandoned on a real different thread closes after sender Engine retirement",
      "line": 303
    },
    {
      "name": "native FileHandle transfer destructor null admission masks and restores an outer real context",
      "line": 323
    },
    {
      "name": "native FileHandle transfer native member and destructor calls preserve an actual current exception",
      "line": 338
    },
    {
      "name": "native FileHandle transfer missing real BindingData consumes the packet and closes its descriptor",
      "line": 364
    },
    {
      "name": "native FileHandle transfer disowns before the explicit missing full template boundary without inventing a receiver",
      "line": 385
    },
    {
      "name": "native FileHandle transfer strong result edges clone and move over the same actual weak wrapper",
      "line": 417
    }
  ],
