        old_key = "v37_"+old_map["batch"]+"_"+old_map["role"]
        assert review["provenance"][old_key] == old_map["immutable_snapshot"]
        historical_provenance_relationships.append(dict(provenance_key="v38_"+key+"_"+old_key,
            mapping_index=old_mappings.index(old_map)))
    assert review["provenance"]["fixture_causal_owner"] == causal_original
    assert review["provenance"]["progress"] == dict(path=str(M/PROGRESS),
        bytes=554689,sha256=provenance["historical_v37_progress"]["sha256"])
    for role,row in review["provenance"].items():
        new_key = "v38_"+key+"_"+role
        assert set(row) == {"path","bytes","sha256"}
        if role == "fixture_causal_owner":
            replacement_pin = causal_snapshot
            historical_provenance_relationships.append(dict(provenance_key=new_key,
                mapping_index=2+list(OLDS).index(key)))
        elif role == "progress":
            replacement_pin = provenance["historical_v37_progress"]
            historical_progress_rebindings.append(dict(batch=key,role=role,
                recorded_reference=dict(recorded_path=row["path"],recorded_bytes=row["bytes"],recorded_sha256=row["sha256"]),
                immutable_snapshot=replacement_pin.copy(),raw_commit=PREVIOUS_HEAD,
                path=PROGRESS,exact_original_bytes=True))
        else:
            replacement_pin = row
        provenance[new_key] = exact(Path(replacement_pin["path"]),replacement_pin["sha256"],replacement_pin["bytes"])
assert len(historical_source_rebindings) == 4 and len(historical_provenance_relationships) == 6
assert len(historical_progress_rebindings) == 2

# Pin each actual V38 record referenced by the accepted, byte-exact checkpoint.
# This traversal only admits complete pin objects, and never follows arbitrary
# path strings or redirects an unavailable current path to a historical path.
def pin_tree(value, label):
    if isinstance(value,dict):
        if {"path","bytes","sha256"} <= set(value):
            assert set(value) == {"path","bytes","sha256"},label
            path = Path(value["path"])
            assert path.is_absolute() and path.resolve().is_relative_to(B.resolve()),label
            provenance[label] = exact(path,value["sha256"],value["bytes"])
        else:
            for key,item in value.items():
                pin_tree(item,label+"/"+str(key))
    elif isinstance(value,list):
        for index,item in enumerate(value):
            pin_tree(item,label+"/"+str(index))
