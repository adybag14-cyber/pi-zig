# Two strengthened, actual Git intakes are distinct from the semantic order
# archive→source. The reviewed adapter's record label remains "fixture".
# No intake/config/index mutation is performed by this read-only validation.
BYTE_CONTRACT = "pending20_exact_git_bytes_attributes_aliases_modes_v1"
ATTR_NAMES = ("text","eol","filter","working-tree-encoding","ident")
PHASE_KEYS = {"before_head","after_head","executor","manifest","release","preflight",
              "staged","receipt","root_acceptance","expected_path_count"}
def raw_blobs(refs):
    result = []
    for offset in range(0,len(refs),128):
        batch = refs[offset:offset+128]
        run = subprocess.run(["git","cat-file","--batch"],cwd=M,
            input=("\n".join(batch)+"\n").encode(),stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=True)
        assert not run.stderr
        data,pos = run.stdout,0
        for ref in batch:
            end = data.index(b"\n",pos)
            fields = data[pos:end].decode("ascii").split()
            assert len(fields)==3 and fields[1]=="blob",(ref,fields)
            size = int(fields[2]); pos=end+1
            raw=data[pos:pos+size];pos+=size
            assert len(raw)==size and data[pos:pos+1]==b"\n"
            pos+=1
            assert blob_id(raw)==fields[0]
            result.append(raw)
        assert pos==len(data)
    return result
def canonical(path):
    path=Path(path)
    assert path.is_absolute() and path.absolute()==path.resolve(),str(path)
    assert path.resolve().is_relative_to(B.resolve()),str(path)
    return path
def conversion_now(names):
    unsafe={"GIT_DIR","GIT_WORK_TREE","GIT_COMMON_DIR","GIT_INDEX_FILE","GIT_OBJECT_DIRECTORY",
        "GIT_ALTERNATE_OBJECT_DIRECTORIES","GIT_NAMESPACE","GIT_ATTR_NOSYSTEM","GIT_ATTR_SOURCE","GIT_CONFIG",
        "GIT_LITERAL_PATHSPECS","GIT_GLOB_PATHSPECS","GIT_NOGLOB_PATHSPECS","GIT_ICASE_PATHSPECS"}
    present=sorted(k for k in os.environ if k in unsafe or k.startswith("GIT_CONFIG_"))
    assert not present,present
    out=lambda *args:git(*args).decode().strip()
    assert Path(out("rev-parse","--show-toplevel")).resolve()==M.resolve()==M.absolute()
    assert out("rev-parse","--is-bare-repository")=="false"
    assert out("rev-parse","--is-inside-work-tree")=="true"
    repository=dict(canonical_root=str(M.resolve()),git_dir=out("rev-parse","--absolute-git-dir"),
        common_dir=out("rev-parse","--path-format=absolute","--git-common-dir"),
        object_format=out("rev-parse","--show-object-format"),git_version=out("--version"),
        rejected_override_names_present=present)
    assert repository["object_format"]=="sha1"
    pattern=r"^(core\.(autocrlf|eol|safecrlf|attributesfile|checkroundtripencoding|filemode|ignorecase|symlinks|protectntfs|protecthfs)|extensions\.objectformat)$"
    args=("config","--includes","--show-origin","--show-scope","--null","--get-regexp",pattern)
    run=subprocess.run(["git",*args],cwd=M,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False)
    assert run.returncode in (0,1)
    sources={}
    def add(path,role):
        p=Path(path)
        if not p.is_absolute():p=M/p
        key=str(p.absolute()).casefold()
        if key not in sources:sources[key]=dict(path=str(p.absolute()),roles=[])
        if role not in sources[key]["roles"]:sources[key]["roles"].append(role)
    for variable in ("GIT_ATTR_SYSTEM","GIT_ATTR_GLOBAL"):
        value=out("var",variable)
        assert value and "\n" not in value and "\r" not in value
        add(value,variable)
    add(out("rev-parse","--path-format=absolute","--git-path","info/attributes"),"repository_info_attributes")
    add(M/".gitattributes","root_attributes")
    for name in names:
        parts=PurePosixPath(name).parts
        for depth in range(1,len(parts)):
            add(M.joinpath(*parts[:depth])/".gitattributes","target_ancestor_attributes")
    files=[]
    for source in sorted(sources.values(),key=lambda x:x["path"].casefold()):
        path=Path(source["path"]);present=os.path.lexists(path)
        item={**source,"exists":present,"resolved_path":str(path.resolve())}
        if present:
            assert path.is_file()
            raw=path.read_bytes()
            item.update(bytes=len(raw),sha256=sha(raw),raw_base64=base64.b64encode(raw).decode("ascii"),
                is_symlink=path.is_symlink())
        files.append(item)
    configuration=dict(argv=list(args),exit_code=run.returncode,
        stdout_base64=base64.b64encode(run.stdout).decode("ascii"),stdout_sha256=sha(run.stdout),
        stderr_base64=base64.b64encode(run.stderr).decode("ascii"))
    return dict(repository=repository,configuration=configuration,attribute_sources=files)
def attributes_now(names):
    run=subprocess.run(["git","check-attr","-z","--stdin",*ATTR_NAMES],cwd=M,
        input=b"\0".join(n.encode() for n in names)+b"\0",
        stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=True)
    assert not run.stderr and run.stdout.endswith(b"\0")
    fields=run.stdout.split(b"\0")[:-1]
    assert len(fields)==len(names)*len(ATTR_NAMES)*3
    result={name:{} for name in names}
    for i in range(0,len(fields),3):
        name,key,value=(x.decode() for x in fields[i:i+3])
        assert name in result and key in ATTR_NAMES and key not in result[name]
        result[name][key]=value
    for values in result.values():
        assert set(values)==set(ATTR_NAMES)
        assert all(values[k] in ("unset","unspecified") for k in ("filter","working-tree-encoding","ident"))
    return result
def validate_phase(key,phase,before_head):
    assert set(phase)==PHASE_KEYS
    assert phase["before_head"]==before_head
    after=phase["after_head"]
    assert re.fullmatch(r"[0-9a-f]{40}",after) and after!=before_head
    assert git("show","-s","--format=%P",after).decode().strip().split()==[before_head]
    docs={}
    for role in ("manifest","release","preflight","staged","receipt","root_acceptance"):
        docs[role]=configured(key+"_"+role,phase[role])
    executable=phase["executor"]
    assert set(executable)=={"path","bytes","sha256"}
    provenance[key+"_executor"]=exact(canonical(executable["path"]),executable["sha256"],executable["bytes"])
    manifest,release,preflight,staged,receipt,accepted=(docs[x] for x in
        ("manifest","release","preflight","staged","receipt","root_acceptance"))
    assert receipt["status"]=="exact_source_intake_committed" and receipt["phase"]=="fixture"
    assert receipt["before_head"]==receipt["basis_main_head"]==before_head and receipt["after_head"]==after
    assert receipt["complete_commit_parents"]==[before_head]
    assert receipt["branch"]=="work/pi-zig-consolidated-20261016"
    assert receipt["clean_worktree"] is True
    assert receipt["native_execution_authorized"] is receipt["application_qualified"] is receipt["production_bridge_removed"] is False
    assert receipt["git_byte_preflight_contract"]==release["git_byte_preflight_contract"]==preflight["git_byte_preflight_contract"]==BYTE_CONTRACT
    assert receipt["all_raw_and_path_git_ids_equal"] is receipt["all_expected_modes_verified"] is True
    assert receipt["staged_and_committed_bytes_match"] is True
    assert release["basis_main_head"]==before_head and release["branch"]==receipt["branch"]
    assert release["source_intake_authorized"] is True and release["native_execution_authorized"] is False
    assert release["application_qualified"] is False and release["expected_git_object_format"]=="sha1"
    assert release["executor_sha256"]==receipt["executor_sha256"]==executable["sha256"]
    assert receipt["release_sha256"]==phase["release"]["sha256"]
    assert receipt["manifest"]==phase["manifest"]["path"] and receipt["manifest_sha256"]==phase["manifest"]["sha256"]
    assert receipt["path_count"]==phase["expected_path_count"]
    assert set(release["authorized_phases"])=={"fixture"}
    issued=release["authorized_phases"]["fixture"]
    assert issued["manifest_sha256"]==phase["manifest"]["sha256"]
    assert issued["total_commit_paths"]==phase["expected_path_count"]
    assert accepted["before_head"]==before_head and accepted["after_head"]==after
    assert accepted["complete_commit_parents"]==[before_head]
    assert accepted["path_count"]==phase["expected_path_count"] and accepted["native_execution_authorized"] is False
    for role in ("executor","manifest","release","receipt"):
        assert accepted[role]==phase[role]
    assert accepted["source_build_paths"]==(0 if key=="archive" else 21)
    target_manifest=relative(manifest.get("target_manifest",manifest.get("manifest_target")))
    original_rows=manifest["rows"]
    assert isinstance(original_rows,list)
    rows=copy.deepcopy(original_rows)+[dict(target=target_manifest,source=phase["manifest"]["path"],
        bytes=phase["manifest"]["bytes"],sha256=phase["manifest"]["sha256"],before=None,
        role="exact_intake_manifest",mode="100644")]
    assert len(rows)==phase["expected_path_count"]
    names=[relative(r["target"]) for r in rows]
    assert len(names)==len(set(names))==len({n.casefold() for n in names})
    assert changed(before_head,after)==set(names)
    spellings={}
    for name in tree(before_head):
        parts=name.split("/")
        for depth in range(1,len(parts)+1):
            prefix="/".join(parts[:depth]);folded=prefix.casefold()
            assert folded not in spellings or spellings[folded]==prefix
            spellings[folded]=prefix
    for name in names:
        parts=name.split("/")
        for depth in range(1,len(parts)+1):
            prefix="/".join(parts[:depth]);folded=prefix.casefold()
            assert folded not in spellings or spellings[folded]==prefix
            spellings[folded]=prefix
        assert not any("/".join(parts[:depth]).casefold() in {n.casefold() for n in names}
            for depth in range(1,len(parts)))
    physical={}
    for row in rows:
        assert set(row)=={"target","source","bytes","sha256","before","role","mode"}
        assert row["mode"]=="100644"
        name=row["target"];donor=canonical(row["source"])
        raw=donor.read_bytes()
        assert len(raw)==row["bytes"] and sha(raw)==row["sha256"]
        expected=("100644","blob",blob_id(raw))
        assert tree(after).get(name)==expected
        assert canonical(M/name).read_bytes()==raw
        pre=row["before"]
        if pre is None:
            assert name not in tree(before_head)
        else:
            assert set(pre)=={"bytes","sha256","mode"} and pre["mode"]=="100644"
            before_raw=git("cat-file","blob",before_head+":"+name)
            assert len(before_raw)==pre["bytes"] and sha(before_raw)==pre["sha256"]
            assert tree(before_head).get(name)==("100644","blob",blob_id(before_raw))
        physical[name]=(row,raw)
    committed_raw=raw_blobs([after+":"+name for name in names])
    assert committed_raw==[physical[name][1] for name in names]
    aliases=manifest["logical_donor_aliases"]
    assert len(aliases)==issued["logical_donor_alias_count"]==receipt["logical_alias_count_excluding_manifest"]
    alias_ids=set();alias_records=[]
    for alias in aliases:
        name=alias["target"]
        assert name in physical and name!=target_manifest
        donor=canonical(alias["source"]);raw=donor.read_bytes()
        assert raw==physical[name][1] and len(raw)==alias["bytes"] and sha(raw)==alias["sha256"]
        identity=(name,str(donor).casefold(),alias["bytes"],alias["sha256"])
        assert identity not in alias_ids
        alias_ids.add(identity)
        alias_records.append({**alias,"canonical_donor":str(donor),"same_physical_bytes":True})
    for row in original_rows:
        assert (row["target"],str(canonical(row["source"])).casefold(),row["bytes"],row["sha256"]) in alias_ids
    alias_records.append(dict(target=target_manifest,source=phase["manifest"]["path"],
        bytes=phase["manifest"]["bytes"],sha256=phase["manifest"]["sha256"],
        canonical_donor=str(canonical(phase["manifest"]["path"])),same_physical_bytes=True,synthetic_manifest=True))
    assert preflight["logical_donor_aliases"]==alias_records
    assert preflight["logical_alias_count_excluding_manifest"]==len(aliases)
    assert preflight["phase"]=="fixture" and preflight["before_head"]==preflight["basis_head"]==before_head
    assert preflight["path_count"]==len(rows) and preflight["rows"]==rows
    assert preflight["all_donors_live_preimages_and_committed_basis_verified"] is True
    assert preflight["native_execution_authorized"] is preflight["qualification"] is False
    for doc in (preflight,staged):
        assert doc["manifest_sha256"]==phase["manifest"]["sha256"]
        assert doc["executor_sha256"]==executable["sha256"] and doc["release_sha256"]==phase["release"]["sha256"]
    assert preflight["release"]==phase["release"]["path"] and preflight["manifest"]==phase["manifest"]["path"]
    assert staged["before_head"]==before_head and staged["path_count"]==len(rows)
    assert staged["exact_index_blob_bytes_verified"] is staged["exact_modes_and_preflight_ids_verified"] is True
    staged_rows=[];committed_rows=[]
    for name in names:
        row,raw=physical[name];oid=blob_id(raw)
        staged_rows.append(dict(target=name,mode="100644",oid=oid,stage=0,bytes=len(raw),sha256=sha(raw)))
        committed_rows.append(dict(target=name,mode="100644",type="blob",oid=oid,bytes=len(raw),sha256=sha(raw)))
    assert staged["rows"]==receipt["staged_rows"]==staged_rows
    assert receipt["committed_rows"]==committed_rows
    current_provenance=conversion_now(names)
    current_attributes=attributes_now(names)
    assert current_provenance==preflight["conversion_provenance"]
    assert current_attributes==preflight["effective_attributes"]
    assert receipt["repository"]==preflight["repository"]==current_provenance["repository"]
    assert len(preflight["byte_rows"])==len(rows)
    for item,name in zip(preflight["byte_rows"],names):
        row,raw=physical[name];oid=blob_id(raw)
        assert item==dict(target=name,donor=row["source"],bytes=len(raw),sha256=sha(raw),
            expected_mode="100644",object_format="sha1",computed_raw_blob=oid,
            git_raw_blob=oid,git_path_blob=oid,effective_attributes=current_attributes[name])
    conversion_sha=sha(json.dumps(current_provenance,sort_keys=True,separators=(",",":")).encode())
    for item,stage in ((preflight["before_copy_revalidation"],"all_hashes_complete_before_copy"),
        (staged["pre_commit_revalidation"],"after_staging_before_commit"),
        (receipt["final_conversion_revalidation"],"after_commit")):
        assert item==dict(stage=stage,effective_attributes_unchanged=True,
            conversion_provenance_unchanged=True,provenance_sha256=conversion_sha)
    return dict(phase=key,before_head=before_head,after_head=after,rows=rows,
        logical_donor_aliases=aliases,path_count=len(rows),manifest=phase["manifest"],
        receipt=phase["receipt"],root_acceptance=phase["root_acceptance"],
        complete_parent_and_raw_blobs_verified=True,complete_modes_attributes_and_aliases_verified=True)

