# The literal import/embed walker is unchanged from reviewed V35 CECC6473.
current_bytes = {}
def current(name):
    relative(name)
    if name not in current_bytes:
        current_bytes[name] = (M/name).read_bytes()
    return current_bytes[name]
def expected_pin(name, digest):
    raw = current(name)
    actual = sha(raw)
    if actual != digest:
        assert name in source_union and actual == source_union[name]["donor"]["sha256"], (name,digest,actual)
    return dict(path=name,sha256=actual)
def closure(root):
    modules, embeds, includes, anonymous = {},{},set(),[]
    todo = [root]
    while todo:
        name = todo.pop()
        if name in modules:
            continue
        raw = current(name)
        text = raw.decode("utf-8")
        hits = []
        for imported in IMPORT.findall(text):
            if imported in ("std","builtin"):
                continue
            if imported in NAMED:
                target = NAMED[imported]
            elif imported.endswith(".zig"):
                target = posixpath.normpath(posixpath.join(posixpath.dirname(name),imported))
            else:
                raise AssertionError(("unmapped named import",name,imported))
            relative(target)
            hits.append(target)
            todo.append(target)
        for operand in re.findall(r"@import\s*\(([^)]*)\)",text):
            assert re.fullmatch(r'\s*"[^"]+"\s*',operand), ("dynamic import operand",name,operand)
        for embedded in EMBED.findall(text):
            target = posixpath.normpath(posixpath.join(posixpath.dirname(name),embedded))
            raw_embed = current(target)
            embeds[target] = dict(relative_path=target,bytes=len(raw_embed),sha256=sha(raw_embed))
        includes.update(re.findall(r'@cInclude\s*\(\s*"([^"]+)"\s*\)',text))
        for line_no,line in enumerate(text.splitlines(),1):
            if re.match(r"\s*test\s*\{",line):
                anonymous.append(dict(relative_path=name,line=line_no))
        modules[name] = dict(relative_path=name,bytes=len(raw),sha256=sha(raw),literal_imports=sorted(set(hits)))
    return modules,embeds,sorted(includes),sorted(anonymous,key=lambda r:(r["relative_path"],r["line"]))
def anonymous_names(rows):
    assert len({r["relative_path"] for r in rows}) == len(rows)
    return {r["relative_path"].removeprefix("src/").removesuffix(".zig").replace("/",".")+".test_0" for r in rows}


# Reconcile every selected raw Git input independently with its immutable base.
# Checkout hashes come from the accepted whole-tree seals. Raw CRLF-normalized
# Git blobs are never substituted for those separately observed checkout bytes.
git_rows=observations["selected_git_source_versions"]
assert len(git_rows)==2145 and len({r["relative_path"] for r in git_rows})==2145
raw_versions=raw_blobs([PREVIOUS_HEAD+":"+r["relative_path"] for r in git_rows])
raw_distinctions={r["relative_path"]:r for r in observations["immutable_checkout_vs_raw_git_distinctions"]}
assert set(raw_distinctions)=={
    "src/extensions/native_node_operation_scope.zig","src/native_sdk_chalk_ignore_guest_guard_test.zig"}
for row,raw in zip(git_rows,raw_versions):
    name=relative(row["relative_path"])
    assert tree(PREVIOUS_HEAD)[name]==(row["mode"],"blob",row["git_blob"])
    assert len(raw)==row["bytes"] and sha(raw)==row["sha256"] and blob_id(raw)==row["git_blob"]
    assert name in old_sealed
    if row["sha256"]!=old_sealed[name]:
        difference=raw_distinctions[name]
        assert difference["raw_git_sha256"]==row["sha256"]
        assert difference["accepted_checkout_sha256"]==old_sealed[name]
        assert difference["raw_git_bytes"]==len(raw) and difference["git_blob"]==blob_id(raw)
    else:
        assert name not in raw_distinctions
    expected=source_union[name]["donor"]["sha256"] if name in source_union else old_sealed[name]
    assert sha(current(name))==expected,(name,expected)
for name,row in source_union.items():
    assert current(name)==Path(row["donor"]["path"]).read_bytes()
checked_current_versions={name:dict(relative_path=name,bytes=len(raw),sha256=sha(raw))
    for name,raw in current_bytes.items()}

# The concrete build recipe is itself an accepted donor. Recheck the full
# selected native-member block and all8 consumer link sites from actual bytes.
build_text=current("build.zig").decode()
library=membership["library_block"]
assert len(library["text"].encode())==library["bytes"] and sha(library["text"].encode())==library["sha256"]
assert build_text.count(library["text"])==1
assert current("build.zig")==Path(membership["build"]["path"]).read_bytes()
assert len(membership["consumers"])==8
linkage_basis=observations["linkage_basis"]
configured("selected_linkage_source_proof",linkage_basis["source_proof"])
trio=["src/extensions/native_node_diagnostic_context.c","src/extensions/native_v8_base_fatal.cpp",
      "src/extensions/native_node_one_byte_string_diagnostics.cpp"]
headers=["src/extensions/native_node_diagnostic_context.h","src/extensions/native_node_diagnostic_context.hpp",
         "src/extensions/native_v8_base_fatal.h","src/extensions/native_node_one_byte_string_diagnostics.h"]
required_native=trio+headers
assert '.linkage = .static' in library["text"]
assert '.link_libc = true' in library["text"] and '.link_libcpp = true' in library["text"]
for path in trio:
    assert library["text"].count('"'+path+'"')==1
for flag in ("-std=gnu11","-std=gnu++20","-fno-exceptions","-fno-rtti","-fno-strict-aliasing"):
    assert '"'+flag+'"' in library["text"]
actual_consumers=[]
for selected in linkage_basis["artifact_consumers"]:
    begin=build_text.index("const "+selected["variable"]+" = b.addTest(")
    end=build_text.index('b.step("'+selected["target"]+'"',begin)
    end=build_text.index("\n",end)
    block=build_text[begin:end]
    assert selected["root"] in block
    assert block.count(selected["variable"]+".root_module.linkLibrary(node_one_byte_diagnostics);")==1
    assert all('"'+path+'"' not in block for path in trio)
    expected=next(r for r in membership["consumers"] if r["name"]==selected["artifact_basename"])
    assert expected["root"]==selected["root"] and expected["reason"]==selected["reason"]
    assert expected["build_block"]==dict(bytes=len(block.encode()),sha256=sha(block.encode()))
    actual_consumers.append(expected)
assert actual_consumers==membership["consumers"]

# Exact current literal graph membership for all117 retained roots and new3.
# This is a conservative source closure; no compiler reachability is inferred.
module_info={r["relative_path"]:r for r in observations["prospective_module_information"]}
embed_info={r["relative_path"]:r for r in observations["prospective_embed_information"]}
graph_info={r["name"]:r for r in observations["graphs"]}
assert len(graph_info)==len(observations["graphs"])==120
graphs={}
catalog_graph_records=[]
for spec in observations["graphs"]:
    name,root=spec["name"],spec["root"]
    modules,embeds,includes,anonymous=closure(root)
    assert len(modules)==spec["prospective_literal_modules"]
    assert len(embeds)==spec["prospective_embeds"]
    assert sorted(modules)==spec["prospective_module_names"]
    assert sorted(embeds)==spec["prospective_embed_names"]
    assert not spec["removed_module_names"]
    assert anonymous==spec["anonymous_blocks"]
    assert sorted(anonymous_names(anonymous))==spec["prospective_anonymous_names"]
    for path,row in modules.items():
        original=module_info[path]
        expected={k:original[k] for k in ("relative_path","bytes","sha256","literal_imports")}
        if path==shutdown_name:
            expected["bytes"],expected["sha256"]=len(new_shutdown),sha(new_shutdown)
        elif path in raw_distinctions:
            assert original["sha256"]==raw_distinctions[path]["raw_git_sha256"]
            expected["bytes"],expected["sha256"]=len(current(path)),old_sealed[path]
        assert row==expected,(name,path)
    for path,row in embeds.items():
        assert row=={k:embed_info[path][k] for k in ("relative_path","bytes","sha256")}
    graphs[name]=(modules,embeds,includes,anonymous)
    catalog_graph_records.append(dict(name=name,source_root=root,
        conservative_module_count=len(modules),conservative_embed_count=len(embeds),
        module_names=sorted(modules),embed_names=sorted(embeds),
        c_include_names=includes,anonymous_source_blocks=anonymous,
        compiler_selected_reachability_claimed=False,compiler_executed=False,native_executed=False))

# Refresh only the observed65 source rows and82 supplemental rows. Every old
# row first reconciles to the actual V38 checkout seal, not a normalized blob.
matrix=copy.deepcopy(prior)
source_changes,dependency_changes=[],[]
pin_aliases={}
external_current_pins=[]
def matrix_current(name,expected):
    relative(name)
    assert name.casefold() not in pin_aliases or pin_aliases[name.casefold()]==name,name
    pin_aliases[name.casefold()]=name
    assert old_sealed[name]==expected,("accepted V38 checkout seal differs",name)
    actual=sha(current(name))
    selected=source_union[name]["donor"]["sha256"] if name in source_union else expected
    assert actual==selected,(name,expected,actual)
    return actual
# Derive the same conservative native support sets from the exact old catalog
# and four detailed inventories; never accept an unenumerated new recipe row.
old_by_name={g["name"]:g for g in prior["groups"]}
native_inventory=read(Path(prior_reviews["new4"]["source_dependency_inventory"]["path"]))
derived_templates={}
for name in ("native-node-file-handle-owner","native-vm-error-constructor-name"):
    row=next(r for r in native_inventory["roots"] if r["name"]==name)
    own={r["relative_path"] for kind in ("modules","embeds") for r in row[kind]}
    derived_templates[name]=dict(
        source_extras=[r for r in old_by_name[name]["source_pins"] if r["path"] not in own],
        dependency_extras=[r for r in prior["whole_tree_dependency_pins"] if r["group"]==name and r["path"] not in own])
assert derived_templates==membership["exact_native_templates"]
derived_source_additions=set()
derived_dependency_additions=set()
for name,info in graph_info.items():
    if info["role"]=="retained":
        derived_source_additions.update((name,p) for p in info["new_graph_members_missing_old_source_pins"])
        assert not info["new_graph_members_missing_old_supplemental_pins"]
for consumer in membership["consumers"]:
    if consumer["name"] in old_by_name:
        group=old_by_name[consumer["name"]]
        existing_source={r["path"] for r in group["source_pins"]}
        existing_dep={r["path"] for r in prior["whole_tree_dependency_pins"] if r["group"]==group["name"]}
        missing_source=[p for p in required_native if NARROW.fullmatch(p) and p not in existing_source]
        missing_dep=[p for p in required_native if not NARROW.fullmatch(p) and p not in existing_dep]
        assert consumer["missing_old_native_source_members"]==missing_source
        assert consumer["missing_old_native_supplemental_members"]==missing_dep
        derived_source_additions.update((group["name"],p) for p in missing_source)
        derived_dependency_additions.update((group["name"],p) for p in missing_dep)
assert [dict(group=g,path=p) for g,p in sorted(derived_source_additions)]==membership["retained_new_source_members"]
assert [dict(group=g,path=p) for g,p in sorted(derived_dependency_additions)]==membership["retained_new_supplemental_members"]

for gi,group in enumerate(matrix["groups"]):
    assert len({r["path"] for r in group["source_pins"]})==len(group["source_pins"])
    for ri,row in enumerate(group["source_pins"]):
        assert NARROW.fullmatch(row["path"]),row["path"]
        actual=matrix_current(row["path"],row["sha256"])
        if actual!=row["sha256"]:
            assert row["path"] in replacement
            source_changes.append(dict(group=group["name"],group_index=gi,row_index=ri,
                path=row["path"],before=row["sha256"],after=actual))
            row["sha256"]=actual
    for row in group["external_pins"]:
        path=canonical(row["path"])
        assert h(path)==row["sha256"]
        external_current_pins.append(pin(path))
for ri,row in enumerate(matrix["whole_tree_dependency_pins"]):
    actual=matrix_current(row["path"],row["sha256"])
    if actual!=row["sha256"]:
        assert row["path"] in replacement
        dependency_changes.append(dict(group=row["group"],row_index=ri,path=row["path"],
            before=row["sha256"],after=actual))
        row["sha256"]=actual
assert source_changes==observations["source_row_hash_substitutions"] and len(source_changes)==65
assert dependency_changes==observations["dependency_row_hash_substitutions"] and len(dependency_changes)==82

by_name={g["name"]:g for g in matrix["groups"]}
assert len(by_name)==117
added_retained_source=[]
for member in membership["retained_new_source_members"]:
    group,name=by_name[member["group"]],member["path"]
    assert NARROW.fullmatch(name) and name not in {r["path"] for r in group["source_pins"]}
    row=dict(path=name,sha256=sha(current(name)))
    added_retained_source.append(dict(group=group["name"],group_index=matrix["groups"].index(group),
        row_index=len(group["source_pins"]),row=row.copy()))
    group["source_pins"].append(row)
added_dependency_rows=[]
old_dependency_keys={(r["group"],r["path"]) for r in matrix["whole_tree_dependency_pins"]}
assert len(old_dependency_keys)==576
for member in membership["retained_new_supplemental_members"]:
    key=(member["group"],member["path"])
    assert key not in old_dependency_keys
    old_dependency_keys.add(key)
    row=dict(group=key[0],path=key[1],sha256=sha(current(key[1])))
    matrix["whole_tree_dependency_pins"].append(row)
    added_dependency_rows.append(row.copy())
assert len(added_retained_source)==45 and len(added_dependency_rows)==26
new_group_specs={g["name"]:g for g in old_plan["proposed_new_groups"]}
new_member_specs={g["name"]:g for g in membership["new_root_memberships"]}
for name,root,filters,count,module_count,embed_count in NEW_SPECS:
    spec=new_group_specs[name]
    modules,embeds,includes,anonymous=graphs[name]
    names=declared(current(root))
    assert len(names)==len(set(names))==count
    required=[Path(root).stem+".test."+n for n in names]
    assert required==spec["required_named"]
    assert all(any(text in n for text in filters) for n in names)
    assert len(modules)==module_count and len(embeds)==embed_count
    member=new_member_specs[name]
    template="native-vm-error-constructor-name" if name=="native-vm-array-buffer-view-data" else "native-node-file-handle-owner"
    template_rows=derived_templates[template]
    members=set(modules)|set(embeds)
    narrow={p for p in members if NARROW.fullmatch(p)}|{r["path"] for r in template_rows["source_extras"]}
    supplemental={p for p in members if not NARROW.fullmatch(p)}|{r["path"] for r in template_rows["dependency_extras"]}
    if template=="native-node-file-handle-owner":
        narrow|={p for p in required_native if NARROW.fullmatch(p)}
        supplemental|={p for p in required_native if not NARROW.fullmatch(p)}
    assert member["accepted_native_template"]==template
    assert sorted(narrow)==member["source_pin_names"] and sorted(supplemental)==member["supplemental_pin_names"]
    group=dict(name=name,target="build-"+name,artifact=name,source_root=root,
        required_named=required,historical_order=None,
        allowed_anonymous=spec["allowed_anonymous"].copy(),runtime_stderr_policy="empty",
        source_pins=[dict(path=p,sha256=sha(current(p))) for p in member["source_pin_names"]],
        external_pins=[])
    assert set(group)==set(prior["groups"][-1])
    assert len(group["source_pins"])==member["source_pin_count"]
    assert all(NARROW.fullmatch(row["path"]) for row in group["source_pins"])
    assert anonymous_names(anonymous)==set(group["allowed_anonymous"])
    assert not set(row["path"] for row in group["source_pins"]) & set(member["supplemental_pin_names"])
    matrix["groups"].append(group);by_name[name]=group
    for path in member["supplemental_pin_names"]:
        row=dict(group=name,path=path,sha256=sha(current(path)))
        assert (name,path) not in old_dependency_keys
        old_dependency_keys.add((name,path))
        matrix["whole_tree_dependency_pins"].append(row)
        added_dependency_rows.append(row.copy())
    assert len(member["supplemental_pin_names"])==member["supplemental_pin_count"]
assert len(matrix["groups"])==120 and sum(len(g["required_named"]) for g in matrix["groups"])==2051
assert len(added_dependency_rows)==189 and len(matrix["whole_tree_dependency_pins"])==765
assert len({(r["group"],r["path"]) for r in matrix["whole_tree_dependency_pins"]})==765
# The pre-existing narrow pins are retained. Complete old literal graphs are
# covered by unchanged whole-source/tree bookends; new graph members receive
# explicit additional group pins. The seven detailed inventories are complete.
for name,(modules,embeds,includes,anonymous) in graphs.items():
    group=by_name[name]
    covered={r["path"] for r in group["source_pins"]}|{r["path"] for r in matrix["whole_tree_dependency_pins"] if r["group"]==name}
    assert set(modules)|set(embeds)<=set(old_sealed)|set(source_union)
    required_new=set(graph_info[name]["added_module_names"])
    assert required_new<=covered,(name,sorted(required_new-covered))
    if name in {s[0] for s in SPECS}|{s[0] for s in NEW_SPECS}:
        assert set(modules)|set(embeds)<=covered,(name,sorted((set(modules)|set(embeds))-covered))
        assert anonymous_names(anonymous)<=set(group["allowed_anonymous"]),(name,anonymous)

selected_groups={"new3":[s[0] for s in NEW_SPECS],
    "new4":prior_reviews["new4"]["selected_group_names"].copy(),
    "regression63":prior_reviews["regression63"]["selected_group_names"].copy()}
assert selected_groups["new4"]==[s[0] for s in SPECS]
assert selected_groups=={("regression63" if row["role"]=="original63" else
    "new4" if row["role"]=="retained4" else "new3"):row["ordered_groups"] for row in observations["cohorts"]}
assert all(row["actual_metadata_count"] is None for row in observations["cohorts"])
for key in OUTS:
    assert len(selected_groups[key])==len(set(selected_groups[key]))==PARTITION[key]["groups"]<=64
    assert sum(len(by_name[name]["required_named"]) for name in selected_groups[key])==PARTITION[key]["declarations"]
assert all(set(selected_groups[a]).isdisjoint(selected_groups[b]) for a,b in
    (("new3","new4"),("new3","regression63"),("new4","regression63")))
assert len(set().union(*[set(v) for v in selected_groups.values()]))==70
# Complete raw inverse: delete only appended members/groups, restore every
# recorded hash, and leave all old order/names/policies/top-level fields exact.
inverse=copy.deepcopy(matrix)
del inverse["groups"][117:]
del inverse["whole_tree_dependency_pins"][576:]
for row in reversed(added_retained_source):
    target=inverse["groups"][row["group_index"]]["source_pins"]
    assert len(target)==row["row_index"]+1 and target.pop()==row["row"]
for row in source_changes:
    target=inverse["groups"][row["group_index"]]["source_pins"][row["row_index"]]
    assert target==dict(path=row["path"],sha256=row["after"])
    target["sha256"]=row["before"]
for row in dependency_changes:
    target=inverse["whole_tree_dependency_pins"][row["row_index"]]
    assert target==dict(group=row["group"],path=row["path"],sha256=row["after"])
    target["sha256"]=row["before"]
assert inverse==prior
assert (json.dumps(inverse,indent=2)+"\n").encode()==(OLDS["new4"]/"groups.json").read_bytes()


# Refresh the four retained detailed inventories and append three complete new
# inventories. Exact inverse records include changed import edges, not only SHA.
old_inventory_path=Path(prior_reviews["new4"]["source_dependency_inventory"]["path"])
old_inventory=read(old_inventory_path)
assert old_inventory_path.read_bytes()==Path(prior_reviews["regression63"]["source_dependency_inventory"]["path"]).read_bytes()
assert old_inventory["candidate_head"]==PREVIOUS_HEAD and old_inventory["named_controls"]==58
assert old_inventory["actual_metadata_count"] is None and old_inventory["source_only"] is True
assert old_inventory["native_execution"] is old_inventory["qualification"] is False
assert [r["name"] for r in old_inventory["roots"]]==selected_groups["new4"]
closure_inventory=copy.deepcopy(old_inventory)
inventory_edits=[]
def inventory_set(path,value):
    target=closure_inventory
    for key in path[:-1]:target=target[key]
    key=path[-1]
    before=copy.deepcopy(target[key])
    if before!=value:
        inventory_edits.append(dict(path=path,before=before,after=copy.deepcopy(value)))
        target[key]=copy.deepcopy(value)
def inventory_modules(index,modules):
    target=closure_inventory["roots"][index]["modules"]
    before_names=[r["relative_path"] for r in target]
    assert before_names==sorted(before_names)
    assert set(before_names)<=set(modules)
    for mi,row in enumerate(target.copy()):
        path=row["relative_path"]
        current_row=modules[path]
        if row!=current_row:
            assert path in replacement,(index,path)
            assert row["sha256"]==replacement[path]["preimage"]["sha256"]
            assert row["bytes"]==replacement[path]["preimage"]["bytes"]
            inventory_set(["roots",index,"modules",mi],current_row)
    for path in sorted(set(modules)-set(before_names)):
        mi=next((i for i,row in enumerate(target) if row["relative_path"]>path),len(target))
        row=copy.deepcopy(modules[path])
        inventory_edits.append(dict(path=["roots",index,"modules",mi],insert=row))
        target.insert(mi,row)
    assert target==[modules[path] for path in sorted(modules)]
for index,(name,root,filter_text,count,module_count) in enumerate(SPECS):
    expected=old_inventory["roots"][index]
    modules,embeds,includes,anonymous=graphs[name]
    assert (expected["name"],expected["source_root"],expected["filter"],expected["source_declared_controls"])==(name,root,filter_text,count)
    names=declared(current(root))
    assert len(names)==len(set(names))==count and names==expected["named_declarations"]
    assert all(filter_text in n for n in names)
    assert by_name[name]["required_named"]==[Path(root).stem+".test."+n for n in names]
    assert len(modules)==module_count
    assert len(embeds)==expected["conservative_embed_count"]==(0 if module_count==1 else 243)
    assert [embeds[p] for p in sorted(embeds)]==expected["embeds"]
    assert anonymous==expected["anonymous_source_blocks"]
    assert anonymous_names(anonymous)==set(expected["allowed_anonymous"])==set(by_name[name]["allowed_anonymous"])
    assert expected["named_import_owners"]==({} if module_count==1 else NAMED)
    assert expected["actual_metadata_count"] is None
    assert expected["compiler_selected_reachability_claimed"] is expected["compiler_executed"] is expected["native_executed"] is False
    inventory_modules(index,modules)
    inventory_set(["roots",index,"conservative_module_count"],len(modules))
    inventory_set(["roots",index,"c_include_names"],includes)
    inventory_set(["roots",index,"source_pins"],len(by_name[name]["source_pins"]))
    inventory_set(["roots",index,"additional_dependency_rows"],sum(r["group"]==name for r in matrix["whole_tree_dependency_pins"]))
for name,root,filters,count,module_count,embed_count in NEW_SPECS:
    modules,embeds,includes,anonymous=graphs[name]
    names=declared(current(root))
    inventory_row=dict(name=name,source_root=root,filter=None,build_filters=filters.copy(),
        source_declared_controls=count,named_declarations=names,
        conservative_module_count=len(modules),conservative_embed_count=len(embeds),
        modules=[modules[p] for p in sorted(modules)],embeds=[embeds[p] for p in sorted(embeds)],
        named_import_owners={} if module_count==1 else NAMED.copy(),c_include_names=includes,
        anonymous_source_blocks=anonymous,allowed_anonymous=by_name[name]["allowed_anonymous"].copy(),
        source_pins=len(by_name[name]["source_pins"]),
        additional_dependency_rows=sum(r["group"]==name for r in matrix["whole_tree_dependency_pins"]),
        actual_metadata_count=None,compiler_selected_reachability_claimed=False,
        compiler_executed=False,native_executed=False)
    closure_inventory["roots"].append(inventory_row)
assert len(closure_inventory["roots"])==7
assert sum(r["source_declared_controls"] for r in closure_inventory["roots"])==96
inventory_inverse=copy.deepcopy(closure_inventory)
del inventory_inverse["roots"][4:]
for edit in reversed(inventory_edits):
    target=inventory_inverse
    for key in edit["path"][:-1]:target=target[key]
    key=edit["path"][-1]
    if "insert" in edit:
        assert target.pop(key)==edit["insert"]
    else:
        assert target[key]==edit["after"]
        target[key]=copy.deepcopy(edit["before"])
assert inventory_inverse==old_inventory
assert (json.dumps(inventory_inverse,indent=2)+"\n").encode()==old_inventory_path.read_bytes()

# Current source identity is bound only after complete admission. Historical
# result/count fields remain segregated; future metadata is always null.
now=datetime.datetime.now(datetime.timezone.utc).isoformat()
matrix["source_head_at_preparation"]=HEAD
matrix["prepared_utc"]=now
closure_inventory["schema"]="pi-zig.v39-seven-root-conservative-source-inventories.v1"
closure_inventory["candidate_head"]=HEAD
closure_inventory["prepared_utc"]=now
closure_inventory["named_controls"]=96
closure_inventory["catalog_literal_graphs"]=catalog_graph_records
closure_inventory["catalog_literal_graph_count"]=120
closure_inventory["selected_descriptor_successor"]=descriptor["candidate"].copy()
closure_inventory["selected_source_plan"]=selection_ref
closure_inventory["source_inventory_count_is_not_actual_metadata"]=True
assert closure_inventory["actual_metadata_count"] is None

partition=dict(schema=1,candidate_head=HEAD,source_basis_head=PREVIOUS_HEAD,
    catalog_groups=120,catalog_declarations=2051,group_cap=64,
    batches={key:dict(selected_group_names=selected_groups[key],selected_groups=PARTITION[key]["groups"],
        selected_declarations=PARTITION[key]["declarations"],actual_metadata_count=None,
        preparation_directory=str(OUTS[key])) for key in OUTS},
    exact_previous4_and_original63_orders_preserved=True,
    pairwise_disjoint=True,union_groups=70,union_declarations=1345,
    all_selected_groups_present=True,all_named_controls_preserved=True,
    v38_progress_next_batch_retained_as_historical_4_plus63=True,
    native_execution_authorized=False,execution_authority=False,runtime_authority=False,qualification=False)

# Build each exact15-file output set in memory before opening any output.
# The driver/classifier and strict metadata audit remain byte-identical except
# for the auditor's one required preparation-directory literal.
outputs={}
for key,out in OUTS.items():
    old_key="regression63" if key=="regression63" else "new4"
    old=OLDS[old_key]
    files={}
    for name in ("Run-CombinedNativeBatch.ps1","Get-ModelsNativeCandidates.ps1",
                 "process-ancestry-peer-modules.json","combined-build-source-peer.json","uv-namespace-source-peer.json"):
        files[name]=(old/name).read_bytes()
    assert sha(files["Run-CombinedNativeBatch.ps1"])==DRIVER
    assert sha(files["Get-ModelsNativeCandidates.ps1"])==CLASSIFIER
    files["prior-v38-progress.json"]=progress_raw
    old_auditor=(old/"Audit-CombinedNativeBatch.py").read_bytes()
    old_literal=str(old.relative_to(B)).replace("\\","/").encode()
    new_literal=str(out.relative_to(B)).replace("\\","/").encode()
    assert old_auditor.count(old_literal)==1 and new_literal not in old_auditor
    auditor=old_auditor.replace(old_literal,new_literal,1)
    assert auditor.replace(new_literal,old_literal,1)==old_auditor
    files["Audit-CombinedNativeBatch.py"]=auditor
    def future_pin(name,raw):
        return dict(path=str(out/name),bytes=len(raw),sha256=sha(raw))
    def encode(value):
        return (json.dumps(value,indent=2)+"\n").encode()
    files["metadata-auditor-adaptation.json"]=encode(dict(
        schema=1,status="source_only_path_literal_adaptation",candidate_head=HEAD,
        baseline=prior_reviews[old_key]["auditor"],adapted=future_pin("Audit-CombinedNativeBatch.py",auditor),
        old_preparation_literal=old_literal.decode(),new_preparation_literal=new_literal.decode(),
        literal_substitutions=1,whole_raw_inverse=True,all_other_bytes_unchanged=True,
        strict_driver_sha256=DRIVER,classification_sha256=CLASSIFIER,
        executed=False,native_execution_authorized=False,qualification=False))
    files["groups.json"]=encode(matrix)
    files["matrix-refresh-adaptation.json"]=encode(dict(
        schema=1,candidate_head=HEAD,basis_head=PREVIOUS_HEAD,
        original=prior_reviews["new4"]["matrix"],adapted=future_pin("groups.json",files["groups.json"]),
        source_hash_substitutions=source_changes,dependency_hash_substitutions=dependency_changes,
        appended_retained_source_rows=added_retained_source,
        appended_dependency_rows=added_dependency_rows,
        appended_groups=matrix["groups"][117:],old_groups=117,new_groups=3,
        old_declarations=2013,new_declarations=38,old_dependency_rows=576,new_dependency_rows=189,
        inverse_identity_fields={k:prior[k] for k in ("source_head_at_preparation","prepared_utc")},
        complete_original_structural_and_raw_byte_inverse=True,
        old_names_order_policies_and_external_pins_unchanged=True,
        actual_metadata_count=None,execution_authority=False,runtime_authority=False,qualification=False))
    files["new-roots-source-inventory.json"]=encode(closure_inventory)
    files["source-inventory-refresh-adaptation.json"]=encode(dict(
        schema=1,candidate_head=HEAD,original=prior_reviews["new4"]["source_dependency_inventory"],
        adapted=future_pin("new-roots-source-inventory.json",files["new-roots-source-inventory.json"]),
        original_roots=4,added_roots=3,retained_root_edits=inventory_edits,
        appended_root_names=[s[0] for s in NEW_SPECS],
        original_identity_fields={k:old_inventory[k] for k in ("schema","candidate_head","prepared_utc","named_controls")},
        appended_top_level_fields=["catalog_literal_graphs","catalog_literal_graph_count",
            "selected_descriptor_successor","selected_source_plan","source_inventory_count_is_not_actual_metadata"],
        complete_original_structural_and_raw_byte_inverse=True,
        all120_literal_graphs_rederived=True,known_checkout_vs_raw_Git_distinctions=observations["immutable_checkout_vs_raw_git_distinctions"],
        actual_metadata_count=None,compiler_selected_reachability_claimed=False,
        compiler_executed=False,native_executed=False,qualification=False))
    files["exact-intake-source-inventory.json"]=encode(phase_inventory)
    files["complete-batch-partition.json"]=encode(partition)
    review=copy.deepcopy(prior_reviews[old_key])
    # Preserve every existing historical field; replace only current preparation
    # identity, counts, pin roles and the explicitly enumerated old-delta records.
    for field,value in dict(
        schema=1,status="source_only_fresh_batch_prepared",candidate_head=HEAD,batch=key,
        new_intake_commits=[ARCHIVE_HEAD,HEAD],prepared_utc=now,provenance=copy.deepcopy(provenance),
        source_pin_changes=source_changes,historical_source_rebindings=historical_source_rebindings,
        historical_progress_rebindings=historical_progress_rebindings,
        historical_provenance_relationships=historical_provenance_relationships,
        whole_dependency_pin_changes=dependency_changes,old_dependency_rows_retained=576,
        new_dependency_rows=189,new_groups=3,preserved_groups=117,preserved_declarations=2013,
        catalog_groups=120,catalog_declarations=2051,selected_groups=PARTITION[key]["groups"],
        selected_declarations=PARTITION[key]["declarations"],selected_group_names=selected_groups[key],
        partition_union_groups=70,partition_union_declarations=1345,actual_metadata_count=None,
        prior_metadata_transferred=False,old_catalog_complete_structural_and_byte_inverse=True,
        old_group_objects_except_reviewed_source_pin_hashes_exact=False,
        old_group_objects_except_reviewed_source_membership_and_hashes_exact=True,
        old_dependency_prefix_except_reviewed_hashes_exact=True,
        existing_named_control_lists_and_selected63_order_exact=True,
        all_driver_classifier_and_strict_gates_unchanged=True,
        selected_order_note="New3, retained4 and exact original63 are complete disjoint separately authorized selections. Names/declarations do not predict metadata.",
        auditor_change="Exactly one preparation-directory literal; all gates and all other bytes unchanged.",
        runtime_authority=False,execution_authority=False,qualification=False).items():
        review[field]=value
    review["prior_v38_intake_commits"]=prior_reviews[old_key]["new_intake_commits"].copy()
    review["semantic_intake_order"]=["archive","source"]
    review["actual_archive_head"]=ARCHIVE_HEAD
    review["selected_source_plan"]=selection_ref
    review["selected_current_source_roots"]=[
        dict(name=name,source_root=root,source_pin=dict(path=str(M/root),bytes=len(current(root)),sha256=sha(current(root))))
        for name,root,*_ in SPECS]
    review["prior_v38_observed"] = copy.deepcopy(record)
    review["prior_v38_progress_next_batch_preserved_as_history"]=copy.deepcopy(projected_progress["next_native_batch"])
    review["future_native_execution_requires_separate_exact_Root_grants"]=True
    review["complete_source_membership_additions"]=dict(retained_source_rows=45,retained_dependency_rows=26,new_group_dependency_rows=163)
    review["review"]="Source-only catalog preparation. Actual previous outcomes remain historical at014. No metadata, artifacts, process acceptance or runtime qualification transfers to this new source head."
    roles={"driver":"Run-CombinedNativeBatch.ps1","matrix":"groups.json","auditor":"Audit-CombinedNativeBatch.py",
        "classifier":"Get-ModelsNativeCandidates.ps1","combined_build_source_peer":"combined-build-source-peer.json",
        "metadata_auditor_adaptation":"metadata-auditor-adaptation.json","matrix_refresh_adaptation":"matrix-refresh-adaptation.json",
        "source_dependency_inventory":"new-roots-source-inventory.json","source_inventory_refresh_adaptation":"source-inventory-refresh-adaptation.json",
        "exact_intake_inventory":"exact-intake-source-inventory.json","complete_partition":"complete-batch-partition.json"}
    for role,name in roles.items():
        review[role]=future_pin(name,files[name])
    files["preparation-review.json"]=encode(review)
    assert set(files)==set(OUTPUT_NAMES) and len(files)==15
    outputs[key]=files

assert len({sha(files["groups.json"]) for files in outputs.values()})==1
assert len({sha(files["new-roots-source-inventory.json"]) for files in outputs.values()})==1
assert len({sha(files["complete-batch-partition.json"]) for files in outputs.values()})==1
# Complete final source/provenance bookend before the first create-only write.
state()
for row in provenance.values():
    assert exact(Path(row["path"]),row["sha256"],row["bytes"])==row
for name,raw in current_bytes.items():
    assert (M/name).read_bytes()==raw,name
for row in external_current_pins:
    exact(Path(row["path"]),row["sha256"],row["bytes"])
for phase in (archive_intake,source_intake):
    for row in phase["rows"]:
        assert Path(row["source"]).read_bytes()==(M/row["target"]).read_bytes()
assert all(not out.exists() for out in OUTS.values())
for key,out in OUTS.items():
    out.mkdir()
    for name in OUTPUT_NAMES:
        with (out/name).open("xb") as stream:
            stream.write(outputs[key][name])
    assert sorted(p.name for p in out.iterdir())==sorted(OUTPUT_NAMES)
    for name,raw in outputs[key].items():
        assert (out/name).read_bytes()==raw
state()
print(json.dumps(dict(status="source_only_v39_three_batch_catalog_prepared",
    candidate_head=HEAD,source_basis_head=PREVIOUS_HEAD,archive_head=ARCHIVE_HEAD,
    catalog_groups=120,catalog_declarations=2051,partition=PARTITION,
    outputs={key:{name:pin(out/name) for name in OUTPUT_NAMES} for key,out in OUTS.items()},
    actual_metadata_count=None,native_execution_authorized=False,qualification=False)))

