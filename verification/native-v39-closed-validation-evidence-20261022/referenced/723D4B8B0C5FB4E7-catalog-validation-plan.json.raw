      "source_declared_controls": 18,
      "required_named": [
        "native_node_stream_shutdown_test.test.native Stream shutdown actual constructor owns original null fields and independent empty slots",
        "native_node_stream_shutdown_test.test.native Stream shutdown genuine Simple wrapper clears request slot before last native pointer retirement",
        "native_node_stream_shutdown_test.test.native Stream shutdown physical close reports after trace end cleanup and AfterClose with borrowed handle",
        "native_node_stream_shutdown_test.test.native Stream shutdown real accepted bad descriptor still performs AfterClose and reports negative status",
        "native_node_stream_shutdown_test.test.native Stream shutdown closed fast path completes synchronously and restores the prior trigger",
        "native_node_stream_shutdown_test.test.native Stream shutdown closing fast path retires its own request while real first close stays queued",
        "native_node_stream_shutdown_test.test.native Stream shutdown nonfunction oncomplete yields undefined without invoking trace or callback",
        "native_node_stream_shutdown_test.test.native Stream shutdown absent oncomplete skips the ordinary Get and native callback",
        "native_node_stream_shutdown_test.test.native Stream shutdown throwing oncomplete getter preserves actual reason and still disposes native request",
        "native_node_stream_shutdown_test.test.native Stream shutdown real close callback exception survives actual Wrapper and event destruction",
        "native_node_stream_shutdown_test.test.native Stream shutdown disabled JavaScript returns before oncomplete getter while native close retires",
        "native_node_stream_shutdown_test.test.native Stream shutdown live listener head uses original predecessor forwarding into real reporter",
        "native_node_stream_shutdown_test.test.native StreamReq Done stores actual Latin1 error bytes then reports and clears request field",
        "native_node_stream_shutdown_test.test.native StreamReq Done failing ordinary error setter returns before OnDone and preserves both native slots",
        "native_node_stream_shutdown_test.test.native StreamReq Done false nonwritable Set still continues to OnDone",
        "native_node_stream_shutdown_test.test.native Stream shutdown reporter converts Latin1 error then clears original stream error",
        "native_node_stream_shutdown_test.test.native Stream shutdown missing caller object uses actual stored InstanceTemplate then real native close",
        "native_node_stream_shutdown_test.test.native Stream shutdown request init inherits actual handle async ID and restores prior trigger"
      ],
