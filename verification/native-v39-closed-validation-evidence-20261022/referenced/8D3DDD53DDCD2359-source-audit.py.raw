assert f["declarations"]==h["declared_edits"] and f["execution_provenance_contract"]==h["catalog_execution_contract"]
assert c["execution_provenance_contract"]==h["catalog_execution_contract"] and c["finite_adaptation"]==h["finite_source_adaptation"]
kinds=["buildquery_constructor","runtime_constructor","positive_buildquery_auditor","positive_runtime_auditor"]
assert [s["kind"] for s in h["sources"]]==[s["kind"] for s in f["sources"]]==[s["kind"] for s in decl["sources"]]==[s["kind"] for s in c["sources"]]==kinds
assert [s["edit_count"] for s in f["sources"]]==[12,14,14,18]
assert h["sources"][3]["baseline"]["sha256"]=="A73ACCCD565E4B3D66C993F061F63DFA8C92B238EE979778D48CCA562643D102"
expected_hashes=[
 ("5ACED5A1A0F22BFE1444B76A1323E2AACA107856E485C2DD121560E7F08B761B","1501B39CAE3466FEBC38E39DA5121D33064AECE3206BDBEF998A59BF26491EF3"),
 ("7832E8918FA494323688223208C877E01449D033DF7EF572E3053731767AA322","FEFA13F724061352D6A2DCFD87E10EAA23EC892E2F87531FC86066FF2EEF25DE"),
 ("6BCBE32702657CD2B5F62E8779CCF585B86D7A8CFFC04C2EB6FE25B4D6E41A9E","F200CD8E6DDCF56E3900D585C302BFFD97A47CC850DF31C81CD6FA63354DCB49"),
 ("A73ACCCD565E4B3D66C993F061F63DFA8C92B238EE979778D48CCA562643D102","82CA5B3712FF3898DD90AA70C2F4296523ED4F4C9EC2CA15A8E8DEF2970DD5D1")]
def functions(raw,tree):
 lines=raw.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno]) for n in tree.body if isinstance(n,ast.FunctionDef)}
def imports(tree): return [ast.dump(n,include_attributes=False) for n in tree.body if isinstance(n,(ast.Import,ast.ImportFrom))]
def v34(tree): return [n.value for n in ast.walk(tree) if isinstance(n,ast.Constant) and isinstance(n.value,str) and re.search("v34",n.value,re.I)]
def raw_region(data,start,end=None):
 assert data.count(start)==1,start
 at=data.index(start);stop=len(data) if end is None else data.index(end,at)
 return data[at:stop]
raws={};trees={};replays=[];helper_rows=[];markers=[];categories=collections.Counter()
for i,kind in enumerate(kinds):
 hs=h["sources"][i];fs=f["sources"][i];ds=decl["sources"][i];cs=c["sources"][i]
 assert hs["baseline"]==fs["baseline"]==ds["baseline"]==cs["baseline"]
 assert hs["candidate"]==fs["candidate"]==ds["candidate"]==cs["unresolved_candidate"]
 assert (hs["baseline"]["sha256"],hs["candidate"]["sha256"])==expected_hashes[i]
 old=read(hs["baseline"]);new=read(hs["candidate"])
 oldtree=ast.parse(old);newtree=ast.parse(new)
 raws[kind]=(old,new);trees[kind]=(oldtree,newtree)
 assert fs["edit_count"]==hs["edit_count"]==cs["finite_edit_count"]==len(fs["steps"])==len(ds["edits"])
 state=old;steps=[]
 for j,(row,drow) in enumerate(zip(fs["steps"],ds["edits"])):
  assert row["index"]==j
  for key in ("before","after","category","reason"): assert row[key]==drow[key]
  before=row["before"].encode();after=row["after"].encode()
  assert before!=after and state.count(before)==1,(kind,j)
  off=state.index(before);assert row["offset"]==off
  assert row["before_bytes"]==len(state) and row["before_sha256"]==sha(state)
  prefix=state[:off];suffix=state[off+len(before):]
  assert row["unchanged_prefix_bytes"]==len(prefix) and row["unchanged_prefix_sha256"]==sha(prefix)
  assert row["unchanged_suffix_bytes"]==len(suffix) and row["unchanged_suffix_sha256"]==sha(suffix)
  result=prefix+after+suffix
  assert row["after_bytes"]==len(result) and row["after_sha256"]==sha(result)
  assert result[:off]==prefix and result[off+len(after):]==suffix
  assert result[:off]+before+result[off+len(after):]==state
  steps.append(dict(index=j,category=row["category"],offset=off,before_bytes=len(state),before_sha256=sha(state),after_bytes=len(result),after_sha256=sha(result),prefix_bytes=len(prefix),prefix_sha256=sha(prefix),suffix_bytes=len(suffix),suffix_sha256=sha(suffix),local_raw_inverse=True))
  categories[row["category"]]+=1;state=result
 assert state==new
 for row in reversed(fs["steps"]):
  assert sha(state)==row["after_sha256"]
  off=row["offset"];before=row["before"].encode();after=row["after"].encode()
  assert state[off:off+len(after)]==after
  state=state[:off]+before+state[off+len(after):]
  assert sha(state)==row["before_sha256"]
 assert state==old and fs["whole_original_bytes_recovered"]==len(old) and fs["whole_original_sha256_recovered"]==sha(old)
 oh=functions(old,oldtree);nh=functions(new,newtree);assert list(oh)==list(nh)
 local=[]
 for name,body in oh.items():
  assert body==nh[name],(kind,name)
  row=dict(kind=kind,name=name,bytes=len(body),sha256=sha(body));local.append(row);helper_rows.append(row)
 assert local==fs["all_helpers_byte_identical"]
 assert imports(oldtree)==imports(newtree)
 assert v34(oldtree)==v34(newtree)==fs["all_historical_V34_literals_unchanged"]
 # AST constants and original byte ranges, not evaluation of target assignments.
 lines=new.splitlines(keepends=True)
 for node in ast.walk(newtree):
  if not isinstance(node,ast.Constant) or not isinstance(node.value,str) or not node.value.startswith("UNRESOLVED_"):continue
  binding=next(k for k,v in decl["markers"].items() if v==node.value)
  lo=sum(map(len,lines[:node.lineno-1]))+node.col_offset;hi=sum(map(len,lines[:node.end_lineno-1]))+node.end_col_offset
  markers.append(dict(kind=kind,binding=binding,path=hs["candidate"]["path"],token_start=lo,token_end=hi,token=new[lo:hi].decode(),decoded_length=len(node.value),value=node.value))
 replays.append(dict(kind=kind,baseline=hs["baseline"],candidate=hs["candidate"],steps=steps,complete_forward=True,complete_raw_inverse=True,unchanged_helpers=local,imports_AST_exact=True,all_V34_literals_exact=True))
markers.sort(key=lambda row:(kinds.index(row["kind"]),list(decl["markers"]).index(row["binding"])))
assert len(helper_rows)==27 and helper_rows==f["all27_helper_bodies_unchanged"]==a["unchanged_helpers"]
assert sum(len(s["steps"]) for s in replays)==58
assert markers==f["first_stage_unresolved_bindings"]==a["nine_future_binding_slots"]==c["bindings"]
assert collections.Counter(r["binding"] for r in markers)==dict(head=4,matrix=3,buildquery_constructor_sha256=1,runtime_constructor_sha256=1)
for row in markers:
 assert row["decoded_length"]==(40 if row["binding"]=="head" else 64)
 assert not re.fullmatch("[0-9a-fA-F]+",row["value"])
assert sum(len(re.findall(rb"UNRESOLVED_[A-Z0-9_]+",v[1])) for v in raws.values())==9
regions=[]
for spec in h["review_scope"]["unchanged_regions"]:
 old,new=raws[spec["kind"]]
 if "start" in spec:
  before=raw_region(old,spec["start"].encode(),None if spec["end"] is None else spec["end"].encode())
  after=raw_region(new,spec["start"].encode(),None if spec["end"] is None else spec["end"].encode())
  assert before==after
 else:
  before=raw_region(old,b"verify_pins(historical_snapshot)\n",b'verify_pins({key:value for key,value in review.items()')
  assert new.count(before)==1
 assert len(before)==spec["bytes"] and sha(before)==spec["sha256"]
 regions.append(dict(spec))
assert len(regions)==5 and regions==f["complete_unchanged_regions"]==a["unchanged_critical_regions"]
