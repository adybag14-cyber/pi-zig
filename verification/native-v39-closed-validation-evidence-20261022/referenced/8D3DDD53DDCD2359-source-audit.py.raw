versions={}
def sha(data): return hashlib.sha256(data).hexdigest().upper()
def pin(path,data): return dict(path=str(path),bytes=len(data),sha256=sha(data))
def read(row):
 p=Path(row["path"])
 assert p.is_absolute() and p.is_relative_to(B) and not p.is_relative_to(B/"main"),str(p)
 data=p.read_bytes()
 assert len(data)==row["bytes"] and sha(data)==row["sha256"],row
 k=str(p).casefold()
 if k in versions: assert versions[k]==row
 else: versions[k]=dict(row)
 return data
def fixed(path,size,digest): return read(dict(path=str(path),bytes=size,sha256=digest))
def doc(path,size,digest): return json.loads(fixed(path,size,digest))
def enc(value): return (json.dumps(value,indent=2,ensure_ascii=True)+"\n").encode()
