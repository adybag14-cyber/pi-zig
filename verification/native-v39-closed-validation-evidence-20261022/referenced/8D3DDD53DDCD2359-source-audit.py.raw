out=dict(schema=1,status="independent_static_v39_execution_source_peer_passed",
 reviewer="/root/sdk_environment_port",reviewed_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
 own_checker=pin(Path(__file__),Path(__file__).read_bytes()),author_handoff=versions[str(X/"handoff.json").casefold()],
 selected_current_catalog_contract=versions[str(V/"execution-provenance-contract-v3.json").casefold()],
 original_catalog_contract=versions[str(Path(h["catalog_execution_contract"]["path"])).casefold()],
 catalog_contract_change_only_preparer_pin=True,finite_sources=replays,finite_steps=58,
 finite_categories=dict(categories),helpers=helper_rows,helper_count=27,complete_regions=regions,
 bindings=markers,binding_count=9,historical_source_rebindings=maps,historical_provenance_relationships=relationships,
 raw_Git_observations=git,cohorts=c["cohorts"],configuration_requirements=c["configuration_requirements"],
 current_input_versions=list(versions.values()),current_input_count=len(versions),
 same_300_second_freshness_16GiB_admission_64_cap_and_protocols=True,
 original_V34_anchors_preserved=True,all_current_provenance_except_explicit_historical_table_remains_strict=True,
 source_read_scope="All four complete candidates, all58 edits, originalA73A and all changed cohort/history regions; helper and full strict-region bytes compared.",
 no_bounded_source_blocker_found=True,candidate_or_prefix_executed=False,author_checker_executed=False,
 constructors_or_auditors_executed=False,Main_accessed=False,Main_or_index_written=False,
 compiler_or_native_executed=False,execution_configuration_issued=False,native_execution_authorized=False,
 runtime_authority=False,qualification=False,source_mutation_hold_released=False)
target=D/"source-proof.json"
assert target.parent==D and not target.exists()
raw=enc(out)
with target.open("xb") as stream: stream.write(raw)
assert target.read_bytes()==raw
print(json.dumps(dict(proof=pin(target,raw),checker=out["own_checker"],steps=58,helpers=27,regions=5,bindings=9,current_inputs=len(versions),raw_Git_snapshots=2,no_bounded_source_blocker=True)))
