assert ast.dump(assign["historical_expected"],include_attributes=False)==ast.dump(ast.parse(expected_expr,mode="eval").body,include_attributes=False)
rels=assign["historical_relationships"];assert isinstance(rels,ast.List)
relationships=[dict_literals(n) for n in rels.elts]
assert maps==new_catalog["historical_source_rebindings"]==c["historical_source_rebindings"]==a["historical_source_rebindings"]
assert relationships==new_catalog["historical_provenance_relationships"]==c["historical_provenance_relationships"]==a["historical_provenance_relationships"]
assert len(maps)==4 and len(relationships)==6 and [r["mapping_index"] for r in relationships]==[0,1,2,0,1,3]
for s in ('require(historical_rows==historical_expected,','require(review["historical_provenance_relationships"]==historical_relationships,','require(all(review["provenance"][row["provenance_key"]]==historical_rows[row["mapping_index"]]["immutable_snapshot"] for row in historical_relationships),','verify_pins({key:value for key,value in review.items() if key!="historical_source_rebindings"})'):
 assert rr_text.count(s)==1,s
assert rr_text.index('digest(prep/"preparation-review.json")==')<rr_text.index('historical_original=')
def subcalls(tree):
 return collections.Counter(ast.dump(n,include_attributes=False) for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and isinstance(n.func.value,ast.Name) and n.func.value.id=="subprocess")
older,newer=map(subcalls,trees["positive_runtime_auditor"])
assert not (older-newer)
extra=ast.dump(ast.parse('subprocess.check_output(["git","--no-optional-locks","cat-file","blob",historical_owner_commit+":src/extensions/native_node_file_handle_owner.zig"],cwd=main)',mode="eval").body,include_attributes=False)
assert newer-older=={extra:1}
git=[]
for orig,snap,head,rel in ((original,snapshot,commit,"src/native_node_file_handle_owner_test.zig"),(owner_original,owner_snapshot,owner_commit,"src/extensions/native_node_file_handle_owner.zig")):
 data=read(snap)
 argv=["git","--no-optional-locks","-C",str(W),"cat-file","blob",head+":"+rel]
 q=subprocess.run(argv,capture_output=True,timeout=20)
 assert q.returncode==0 and q.stderr==b"" and q.stdout==data
 assert len(data)==orig["bytes"] and sha(data)==orig["sha256"]
 git.append(dict(commit=head,relative_path=rel,bytes=len(data),sha256=sha(data),immutable_snapshot=snap,exact_documentary_original=orig,raw_blob_equals_snapshot=True,argv=argv))
