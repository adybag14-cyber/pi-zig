rrtree=trees["positive_runtime_auditor"][1]
assign={n.targets[0].id:n.value for n in rrtree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
def dict_literals(node):
 assert isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id=="dict" and not node.args
 return {k.arg:ast.literal_eval(k.value) for k in node.keywords}
def source_pin(name):
 node=assign[name];assert isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id=="dict" and not node.args
 kw={k.arg:k.value for k in node.keywords};assert set(kw)=={"path","bytes","sha256"}
 s=kw["path"];assert isinstance(s,ast.Call) and isinstance(s.func,ast.Name) and s.func.id=="str" and len(s.args)==1 and not s.keywords
 p=s.args[0];assert isinstance(p,ast.BinOp) and isinstance(p.op,ast.Div) and isinstance(p.left,ast.Name)
 root={"main":B/"main","base":B}[p.left.id];relative=ast.literal_eval(p.right);assert not Path(relative).is_absolute()
 return dict(path=str(root/relative),bytes=ast.literal_eval(kw["bytes"]),sha256=ast.literal_eval(kw["sha256"]))
original=source_pin("historical_original");snapshot=source_pin("historical_snapshot")
owner_original=source_pin("historical_owner_original");owner_snapshot=source_pin("historical_owner_snapshot")
