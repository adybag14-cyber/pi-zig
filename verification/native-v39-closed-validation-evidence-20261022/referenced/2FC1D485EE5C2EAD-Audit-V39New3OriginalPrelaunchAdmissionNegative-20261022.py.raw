"""Root independent closure of the original V39 new3 admission failure. No native invocation."""
from pathlib import Path
import collections,datetime,hashlib,json,os,re,subprocess,sys
B=Path(r'C:\Users\adyba\pi-zig');E=B/'evidence';M=B/'main'
C=E/'root-native-foundation-fresh-v39-new3-control-20261022-163859'
P=E/'root-native-foundation-fresh-v39-new3-buildquery-20261022-163859'
PREP=E/'combined-native-batch-v39-new3-prepared-20261022'
