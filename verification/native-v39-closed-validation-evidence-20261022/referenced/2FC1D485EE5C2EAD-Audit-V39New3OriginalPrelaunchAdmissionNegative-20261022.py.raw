assert g['native_selected_tests_started'] is None and g['cached_executable'] is None and g['postseal'] is True
for k in ('runtime_requested','runtime_owner_launch_attempted','actual_runtime_owner_started'):assert g[k] is False
assert r['absence']==dict(native_roots=[],owners=[])
assert {p.name for p in (P/'groups').iterdir()if p.is_dir()}=={g['group']}
assert {p.name for p in gp.iterdir()if p.is_file()}=={'commands.json','compile-admission.json','result-provisional.json','result.json'}
assert not any(p.is_file() for p in (P/'cache').rglob('*')) and not any(p.is_file() for p in (P/'global-cache').rglob('*'))
assert not any(p.suffix.lower() in ('.exe','.pdb') or p.name in ('compile.json','metadata.json','runtime.json','selected-tests.json','build-artifacts.json') for p in P.rglob('*') if p.is_file())
assert len(r['admission_probes'])==1
probe=r['admission_probes'][0];age=ticks(probe['utc'])-ticks(grant['issued_utc'])
assert probe['phase']=='compile' and probe['native_roots']==0 and probe['native']==[] and probe['free_kib']>=probe['minimum_kib']==16777216 and age>3000000000
assert outer['status']=='failed' and outer['exit_code']==1 and outer['retained_handle']>0 and outer['timeout_seconds']==1800
assert outer['error']=='Owned terminal failed: C:\\Program Files\\PowerShell\\7\\pwsh.exe'
assert outer['executable_sha256']=='FA2C8BB1E35CDD62AD15CD06A1D8F2C5961E9725A9BFA1E7CFD2C322F49E9619'
assert outer['arguments']==['-NoLogo','-NoProfile','-NonInteractive','-File',str(PREP/'Run-CombinedNativeBatch.ps1'),'-RootGrant',str(C/'root-grant.json'),'-Mode','BuildQuery']
live=outer['live_identity']
assert live['pid']==outer['pid'] and ticks(live['created_utc'])==ticks(outer['created_utc']) and live['executable']==outer['executable'] and live['command_line']
assert absence['pid']==outer['pid'] and ticks(absence['created_utc'])==ticks(outer['created_utc']) and absence['currently_absent'] is True and absence['current_records']==[]
assert ticks(outer['completed_utc'])>=ticks(outer['created_utc']) and ticks(absence['observed_utc'])>=ticks(outer['completed_utc'])
assert subprocess.check_output(['git','--no-optional-locks','rev-parse','HEAD'],cwd=M,text=True).strip()==HEAD
assert subprocess.check_output(['git','--no-optional-locks','status','--porcelain'],cwd=M)==b''
roles=('source','tree','vendor','compiler','controls');allpins={}
for seal in (before,final):assert seal['candidate_head']==HEAD and seal['clean'] is True and seal['errors']==[]
for role in roles:
 assert before[role]==final[role],role
 counts=collections.Counter(row['relative'] for row in final[role])
 assert {k:v for k,v in counts.items()if v>1}==({r'C:\Program Files\PowerShell\7\pwsh.exe':2} if role=='controls' else {})
 for row in final[role]:
  p=Path(row['path']);assert p.is_relative_to(B) or str(p) in (r'C:\Program Files\PowerShell\7\pwsh.exe',r'C:\Program Files\PowerShell\7\pwsh.dll')
  assert str(p) not in allpins or allpins[str(p)]==row['sha256'];allpins[str(p)]=row['sha256']
assert len(final['vendor'])==1489 and len(final['compiler'])==19546
tracked=subprocess.check_output(['git','--no-optional-locks','ls-files','-z'],cwd=M).decode().split('\0')[:-1]
assert set(tracked)=={row['relative']for row in final['source']}
for role,root,excludes in (('tree',M,{'.git','.zig-cache','zig-out'}),('vendor',M/'vendor',set()),('compiler',B/'toolchain/zig-x86_64-windows-0.16.0',set())):
 paths=[]
 for directory,dirs,files in os.walk(root):
  if Path(directory)==root:dirs[:]=[n for n in dirs if n not in excludes]
  paths.extend(str(Path(directory)/n)for n in files if not(Path(directory)==root and n in excludes))
 assert set(paths)=={row['path']for row in final[role]},role
for path,expected in allpins.items():assert digest(path)==expected,path
classifier=PREP/'Get-ModelsNativeCandidates.ps1';assert digest(classifier)=='3413A2A50B4D4C3BFF8709E4EE08C76BE449AAB1EDCB1E0C5C167DC7A804E301'
command="$ErrorActionPreference='Stop'; . '"+str(classifier)+"'; $taskRows=@(Get-CimInstance Win32_Process -OperationTimeoutSec 5); $taskNative=@(Get-ModelsNativeCandidates -Rows $taskRows -Container '"+str(B)+"'); [ordered]@{observed_utc=[DateTimeOffset]::UtcNow.ToString('o');native_candidates=$taskNative;owner_records=@($taskRows | Where-Object {$_.ProcessId -in @(39468,29572,44604)} | Select-Object ProcessId,ParentProcessId,CreationDate,ExecutablePath,CommandLine)}|ConvertTo-Json -Depth 12 -Compress"
raw=subprocess.check_output([r'C:\Program Files\PowerShell\7\pwsh.exe','-NoLogo','-NoProfile','-NonInteractive','-Command',command],timeout=20)
snapshot=json.loads(raw.decode('utf-8-sig'));assert snapshot['native_candidates']==[]
bounds=[dict(role='runner',pid=job['runnerPid'],created=int(job['runnerProcessInstance'])-116444736000000000,completed=ticks(job['completedAtUtc'])),dict(role='launcher',pid=job['childPid'],created_lower_bound=ticks(job['createdAtUtc']),completed=ticks(job['completedAtUtc'])),dict(role='outer',pid=outer['pid'],created=ticks(outer['created_utc']),completed=ticks(outer['completed_utc']))]
reconciled=[]
for current in snapshot['owner_records']:
 prior=[b for b in bounds if b['pid']==current['ProcessId']]
 assert prior and all(ticks(current['CreationDate'])>b['completed']for b in prior)
 reconciled.append(dict(current_record=current,prior_terminal_intervals=prior,kind='later_process_reusing_retired_pid'))
for row in cfg['inputs'].values():assert pin(row['path'])==row
assert subprocess.check_output(['git','--no-optional-locks','status','--porcelain'],cwd=M)==b''
snap_path=C/'independent-prelaunch-negative-process-snapshot.json'
with snap_path.open('xb') as stream:stream.write(raw)
record=dict(schema=1,status='independently_closed_prelaunch_grant_age_negative',reviewer='Root independent Python original-input/source-directory/UTC100ns process closure',candidate_head=HEAD,batch='new3',reason=reason,grant_age_at_admission_ticks=age,grant_age_at_admission_seconds=str(age/10000000),granted_groups=3,attempted_groups=1,unstarted_groups=2,declared_controls=38,native_owner_count=0,actual_metadata_count=0,actual_tests_started=0,original_negative_preserved=True,current_all_sealed_inputs_rehashed=True,current_complete_directory_inventories_verified=True,whole_bookends_unchanged=True,seal_counts={k:len(final[k])for k in roles},distinct_current_files_rehashed=len(allpins),controller_environment_restored=True,actual_process_intervals=bounds,current_process_observation=pin(snap_path),current_process_instance_reconciliations=reconciled,current_actual_process_instances_absent=True,original_inputs=cfg['inputs'],audit_release=pin(release),auditor=pin(__file__),runtime_started=False,native_execution_authorized=False,source_mutation_hold_released=False,qualification=False,complete_buildquery_accepted=False)
