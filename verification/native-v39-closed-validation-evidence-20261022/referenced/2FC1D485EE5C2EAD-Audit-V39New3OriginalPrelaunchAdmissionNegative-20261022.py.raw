HEAD='e9f11afa56a923372d957e2fb227f453822c21bf'
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def digest(p):
 h=hashlib.sha256()
 with Path(p).open('rb') as stream:
  while data:=stream.read(1024*1024):h.update(data)
 return h.hexdigest().upper()
def pin(p):
 p=Path(p);return dict(path=str(p),bytes=p.stat().st_size,sha256=digest(p))
def read(p):return json.loads(Path(p).read_bytes().decode('utf-8-sig'))
def check(row):
 assert pin(row['path'])==row,row;return read(row['path'])
def put(p,data):
 raw=(json.dumps(data,indent=2)+'\n').encode()
 with p.open('xb') as stream:stream.write(raw)
 assert p.read_bytes()==raw
def ticks(s):
 m=re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(Z|[+-]\d\d:\d\d)',s);assert m,s
 dt=datetime.datetime.fromisoformat(m[1]+('+00:00' if m[3]=='Z' else m[3]))
 d=dt-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
 return (d.days*86400+d.seconds)*10000000+int((m[2]or'').ljust(7,'0'))
assert len(sys.argv)==3
release=Path(sys.argv[1]);assert pin(release)['sha256']==sys.argv[2]
cfg=read(release);assert cfg['reviewer']=='Root' and cfg['audit_execution_authorized'] is True and cfg['native_execution_authorized'] is False
assert cfg['auditor']==pin(__file__) and cfg['candidate_head']==HEAD
assert not OUT.exists() and not (C/'independent-prelaunch-negative-process-snapshot.json').exists()
for row in cfg['inputs'].values():assert pin(row['path'])==row
r=read(P/'result.json');before=read(P/'before.json');final=read(P/'final.json');grant=read(C/'root-grant.json')
outer=read(C/'outer.json');absence=read(C/'outer-absence.json');jobenv=read(C/'independent-observed-job-status.json');job=jobenv['data']
assert jobenv['ok'] is True and jobenv['truncated'] is False and job['status']=='failed' and job['exitCode']==1 and job['runnerAlive'] is False
assert job['id']==cfg['job_id']=='job-op-f6c3ae43152b319798cc6b102ce49dc0d4abb9334c9fafe3ff7ec3d0a44d5ca1'
assert isinstance(job['runnerProcessInstance'],str) and re.fullmatch('[0-9]{1,20}',job['runnerProcessInstance'])
assert (job['runnerPid'],job['childPid'],outer['pid'])==(39468,29572,44604)
reason='Initial grant must be within300seconds before first child launch'
assert r['status']=='failed' and r['mode']==grant['mode']=='BuildQuery' and r['candidate_head']==grant['candidate_head']==HEAD
assert r['errors']==[reason] and r['all_groups_closed'] is False
for k in ('postseal','controller_environment_restored','initial_cache_absence','qualification_requested','fresh_cache_reproduction'):assert r[k] is True,k
for k in ('runtime_requested','product_qualified','cache_seeded'):assert r[k] is False,k
assert r['cache_mode']=='fresh_batch' and r['source_seal_scope']=='whole_batch'
