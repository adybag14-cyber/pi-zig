assert grant['group_manifest_sha256']==r['group_manifest_sha256']==digest(PREP/'groups.json')=='5611B22186C7197516F88303A414707C26ADD17B731CFACA264B225CC8A27CDB'
assert grant['groups']==['native-node-stream-shutdown','native-node-one-byte-string','native-vm-array-buffer-view-data']
assert len(r['groups'])==1
g=r['groups'][0];gp=P/'groups'/g['group']
assert g==read(gp/'result.json') and g['group']==grant['groups'][0]
