def require(value,message):
 if not value:raise RuntimeError(message)
def sha(raw):return hashlib.sha256(raw).hexdigest().upper()
def encode(v):return (json.dumps(v,indent=2)+"\n").encode()
def pin_bytes(p,raw):return dict(path=str(p),bytes=len(raw),sha256=sha(raw))
def verify(row):
 require(set(row)=={"path","bytes","sha256"},"Exact three-field input pin")
 p=Path(row["path"])
 require(p.is_absolute() and p.resolve().is_relative_to(E.resolve()),"Evidence-only input")
 require(type(row["bytes"])is int and row["bytes"]>0 and re.fullmatch("[0-9A-F]{64}",row["sha256"])is not None,"Exact input length/hash")
 raw=p.read_bytes();require((len(raw),sha(raw))==(row["bytes"],row["sha256"]),"Pinned input changed: "+str(p))
 k=str(p.resolve()).casefold();require(k not in seen or seen[k]==row,"Conflicting input version")
 seen[k]=row
 return raw
def read(row):return json.loads(verify(row).decode("utf-8-sig"))
def equivalent_pin(a,b):
 return set(a)==set(b)=={"path","bytes","sha256"} and Path(a["path"])==Path(b["path"]) and a["bytes"]==b["bytes"] and a["sha256"]==b["sha256"]
def at(v,path):
 for key in path:v=v[key]
 return v
def set_at(v,path,value):
 for key in path[:-1]:v=v[key]
 v[path[-1]]=value
def leaves(v,path=()):
 if isinstance(v,dict):
  for key,value in v.items():yield from leaves(value,path+(key,))
 elif isinstance(v,list):
  for index,value in enumerate(v):yield from leaves(value,path+(index,))
 else:yield path,v
def change_json(name,edits,raws):
 old=raws[name];obj=json.loads(old);require(encode(obj)==old,"Exact original JSON serialization: "+name)
 current=copy.deepcopy(obj);steps=[]
 for index,(path,value) in enumerate(edits):
  path=tuple(path);before_value=copy.deepcopy(at(current,path))
  require(before_value!=value,"No-op field edit: "+name+str(path))
  before=encode(current);set_at(current,path,copy.deepcopy(value));after=encode(current)
  steps.append(dict(index=index,keys=list(path),before=before_value,after=value,before_bytes=len(before),before_sha256=sha(before),after_bytes=len(after),after_sha256=sha(after)))
 raw=encode(current);inverse=copy.deepcopy(current)
 for step in reversed(steps):
  require(at(inverse,step["keys"])==step["after"],"Exact inverse field value")
  set_at(inverse,step["keys"],copy.deepcopy(step["before"]))
  require((len(encode(inverse)),sha(encode(inverse)))==(step["before_bytes"],step["before_sha256"]),"Exact intermediate JSON inverse")
 require(encode(inverse)==old,"Complete raw JSON inverse: "+name)
 return raw,dict(member=name,kind="finite_JSON_leaf_relocation",steps=steps,complete_raw_forward_and_inverse=True)
require(len(sys.argv)==3,"Exact separately issued Root configuration path and hash required")
