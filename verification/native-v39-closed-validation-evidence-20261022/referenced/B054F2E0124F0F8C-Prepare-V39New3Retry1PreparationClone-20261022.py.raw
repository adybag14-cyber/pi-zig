new=old.replace(a,b,1);require(new.replace(b,a,1)==old,"Complete metadata auditor raw inverse")
old_ast=ast.parse(old);new_ast=ast.parse(new)
class NormalizeLiteral(ast.NodeTransformer):
 def visit_Constant(self,n):
  if n.value==NEW_LITERAL:n.value=OLD_LITERAL
  return n
require(ast.dump(old_ast,include_attributes=False)==ast.dump(NormalizeLiteral().visit(new_ast),include_attributes=False),"Only one metadata source constant changed")
outputs["Audit-CombinedNativeBatch.py"]=new
proofs.append(dict(member="Audit-CombinedNativeBatch.py",kind="one_source_path_literal",before=OLD_LITERAL,after=NEW_LITERAL,offset=old.index(a),baseline=pin_bytes(OLD/"Audit-CombinedNativeBatch.py",old),adapted=pin_bytes(NEW/"Audit-CombinedNativeBatch.py",new),all_other_bytes_unchanged=True,whole_raw_inverse=True))
ma=json.loads(raws["metadata-auditor-adaptation.json"]);baseline=verify(ma["baseline"])
require(ma["adapted"]==pin_bytes(OLD/"Audit-CombinedNativeBatch.py",old) and ma["new_preparation_literal"]==OLD_LITERAL and ma["literal_substitutions"]==1,"Exact preserved metadata adaptation")
old_baseline_literal=ma["old_preparation_literal"].encode()
require(baseline.count(old_baseline_literal)==1 and baseline.replace(old_baseline_literal,b,1)==new and new.replace(b,old_baseline_literal,1)==baseline,"Retained V38 baseline one-literal full inverse")
metadata_edits=[(["adapted","path"],str(NEW/"Audit-CombinedNativeBatch.py")),(["adapted","bytes"],len(new)),(["adapted","sha256"],sha(new)),(["new_preparation_literal"],NEW_LITERAL)]
