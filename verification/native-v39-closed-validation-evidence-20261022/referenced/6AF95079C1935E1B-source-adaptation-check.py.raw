def literal_pin(name):
 node=assign[name];assert isinstance(node,ast.Call)and isinstance(node.func,ast.Name)and node.func.id=="dict"and not node.args
 kw={x.arg:x.value for x in node.keywords};assert set(kw)=={"path","bytes","sha256"}
 path=kw["path"];assert isinstance(path,ast.Call)and isinstance(path.func,ast.Name)and path.func.id=="str"and len(path.args)==1
 term=path.args[0];assert isinstance(term,ast.BinOp)and isinstance(term.op,ast.Div)and isinstance(term.left,ast.Name)
 root={"main":B/"main","base":B}[term.left.id];relative=ast.literal_eval(term.right)
 assert isinstance(relative,str) and not Path(relative).is_absolute()
 return {"path":str(root/relative),"bytes":ast.literal_eval(kw["bytes"]),"sha256":ast.literal_eval(kw["sha256"])}
