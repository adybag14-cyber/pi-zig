def sha(b):return hashlib.sha256(b).hexdigest().upper()
def enc(v):return (json.dumps(v,indent=2,ensure_ascii=False)+"\n").encode()
def pin(p,b):return {"path":str(p),"bytes":len(b),"sha256":sha(b)}
def read(row):
 p=Path(row["path"]);assert p.is_absolute() and str(p).casefold().startswith(str(B).casefold()+"\\")
 assert not str(p).casefold().startswith(str(B/"main").casefold()+"\\"),str(p)
 b=p.read_bytes();assert len(b)==row["bytes"] and sha(b)==row["sha256"],row
 key=str(p).casefold()
 if key in inputs:assert inputs[key]["bytes"]==row["bytes"] and inputs[key]["sha256"]==row["sha256"]
 else:inputs[key]=row
 return b
