finite=[];helper_records=[];marker_records=[];trees={};raws={};all_categories=collections.Counter()
def helpers(raw,tree):
 lines=raw.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno])for n in tree.body if isinstance(n,ast.FunctionDef)}
def span(raw,node):
 lines=raw.splitlines(keepends=True)
 return sum(map(len,lines[:node.lineno-1]))+node.col_offset,sum(map(len,lines[:node.end_lineno-1]))+node.end_col_offset
def source_region(raw,start,end=None):
 assert raw.count(start)==1
 at=raw.index(start)
 stop=len(raw) if end is None else raw.index(end,at)
 return raw[at:stop]
for entry in decl["sources"]:
 kind=entry["kind"];old=read(entry["baseline"]);new=read(entry["candidate"])
 old_tree=ast.parse(old);new_tree=ast.parse(new);trees[kind]=(old_tree,new_tree);raws[kind]=(old,new)
 state=old;steps=[]
 for index,edit in enumerate(entry["edits"]):
  before=edit["before"].encode();after=edit["after"].encode();assert before!=after and state.count(before)==1,(kind,index)
  at=state.index(before);prior=state;state=prior[:at]+after+prior[at+len(before):]
  assert state[:at]==prior[:at] and state[at+len(after):]==prior[at+len(before):]
  steps.append({"index":index,"category":edit["category"],"reason":edit["reason"],"offset":at,"before":edit["before"],"after":edit["after"],
   "before_bytes":len(prior),"before_sha256":sha(prior),"after_bytes":len(state),"after_sha256":sha(state),
   "unchanged_prefix_bytes":at,"unchanged_prefix_sha256":sha(prior[:at]),"unchanged_suffix_bytes":len(prior)-at-len(before),"unchanged_suffix_sha256":sha(prior[at+len(before):])})
  all_categories[edit["category"]]+=1
 assert state==new,(kind,"complete_forward")
 for step in reversed(steps):
  at=step["offset"];before=step["before"].encode();after=step["after"].encode()
  assert len(state)==step["after_bytes"] and sha(state)==step["after_sha256"] and state[at:at+len(after)]==after
  state=state[:at]+before+state[at+len(after):]
  assert len(state)==step["before_bytes"] and sha(state)==step["before_sha256"]
 assert state==old,(kind,"complete_raw_inverse")
 oh=helpers(old,old_tree);nh=helpers(new,new_tree);assert set(oh)==set(nh)
 local_helpers=[]
 for name,b in oh.items():
  assert b==nh[name],(kind,name)
  row={"kind":kind,"name":name,"bytes":len(b),"sha256":sha(b)}
  helper_records.append(row);local_helpers.append(row)
 old_imports=[ast.dump(n,include_attributes=False)for n in old_tree.body if isinstance(n,(ast.Import,ast.ImportFrom))]
 new_imports=[ast.dump(n,include_attributes=False)for n in new_tree.body if isinstance(n,(ast.Import,ast.ImportFrom))]
 assert old_imports==new_imports
 old_v34=[n.value for n in ast.walk(old_tree)if isinstance(n,ast.Constant)and isinstance(n.value,str)and ("v34" in n.value or "V34" in n.value)]
 new_v34=[n.value for n in ast.walk(new_tree)if isinstance(n,ast.Constant)and isinstance(n.value,str)and ("v34" in n.value or "V34" in n.value)]
 assert old_v34==new_v34,(kind,"unchanged_all_historical_V34_literals")
 newtext=new.decode()
 assert 'batch in ("new3","new4","existing63")' in newtext
 assert '(3,38) if batch=="new3" else (4,58) if batch=="new4" else (63,1249)' in newtext
 for expected in (b"<=64",b"16777216",b"19546",b"1489"):
  assert old.count(expected)==new.count(expected),(kind,expected)
 for key,value in decl["markers"].items():
  for node in ast.walk(new_tree):
   if isinstance(node,ast.Constant)and node.value==value:
    a,z=span(new,node);marker_records.append({"kind":kind,"binding":key,"path":entry["candidate"]["path"],"token_start":a,"token_end":z,"token":new[a:z].decode(),"decoded_length":len(value),"value":value})
 finite.append({"kind":kind,"baseline":entry["baseline"],"candidate":entry["candidate"],"edit_count":len(steps),"steps":steps,"all_step_untouched_fragments_exact":True,
  "complete_forward_and_raw_inverse":True,"whole_original_bytes_recovered":len(old),"whole_original_sha256_recovered":sha(old),
  "all_helpers_byte_identical":local_helpers,"imports_AST_unchanged":True,"all_historical_V34_literals_unchanged":old_v34})
