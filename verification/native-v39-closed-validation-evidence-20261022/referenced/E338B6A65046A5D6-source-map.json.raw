      "sha256": "8F0FF479A860E7E4E6342FA36CB7B30164919085ADF5254A67A64DB505443B22",
      "text": "        const engine = try self.wrap.registry.environment.requireEngine();\n        try self.controller.beginCall(engine);\n        defer self.controller.endCall();\n        return a.expression(engine, closeBody, .{self});\n",
      "claim": "ClosePromise retains Controller busy admission across the synchronous body, including the trace observer."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_node_fs_request_io.zig",
        "bytes": 15469,
        "sha256": "B6792DCB053DDC2CFBC26350D9AD580CC5419CF3BDBEB595AF1F19B0922AF996"
      },
      "first_line": 43,
      "last_line": 59,
      "bytes": 825,
      "sha256": "7D0C47E118EDE17403CE04C261CB3F1BEFBAA5D31D87D1DB8F2C08EBA12A6A24",
      "text": "    pub fn beginCall(self: *Controller, engine: *Engine) !void { return self.enter(engine); }\n    pub fn endCall(self: *Controller) void { self.leave(); }\n\n    fn enter(self: *Controller, engine: *Engine) !void {\n        // A retained actual binding can outlive the Hub. Never dereference\n        // that retired Hub after its native resource has been stopped.\n        if (self.stopping) return error.NativeEnvClosed;\n        try self.hub.assertOwner();\n        if ((try self.environment.requireEngine()) != engine or self.hub.engine != engine)\n            return error.ActualFSRequestEnvironmentMismatch;\n        if (self.stopping or self.hub.stopping) return error.NativeEnvClosed;\n        self.busy += 1;\n    }\n    fn leave(self: *Controller) void {\n        std.debug.assert(self.busy != 0);\n        self.busy -= 1;\n    }\n",
      "claim": "Controller.enter verifies the actual Hub dispatch thread before incrementing busy."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_env_io.zig",
        "bytes": 8014,
        "sha256": "4BC66694AB6B22FC9A51A0943192BDCD61F0213C6846B0A69E0B459C26EF120E"
      },
      "first_line": 45,
      "last_line": 56,
      "bytes": 415,
      "sha256": "E277BB24D3CC9B2CEC53B68CE1B74481665C87B34F265562AFCED9BA3E8EEE85",
      "text": "pub const Hub = struct {\n    engine: *js.Engine,\n    io: std.Io,\n    owner: std.Thread.Id,\n    group: std.Io.Group = .init,\n    tasks: std.ArrayList(*Task) = .empty,\n    resources: std.ArrayList(Resource) = .empty,\n    stopping: bool = false,\n    pumping: bool = false,\n    pub fn assertOwner(self: *Hub) !void {\n        if (std.Thread.getCurrentId() != self.owner) return error.NativeEnvOwnerThreadRequired;\n    }\n",
      "claim": "Hub.assertOwner compares the current native thread ID with the concrete owner."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_node_file_handle_close_request.zig",
        "bytes": 15879,
        "sha256": "C2016812A084329BCFC9DC113485F2732B2CC095C9ED6B8B21A18158205C443A"
      },
      "first_line": 99,
      "last_line": 122,
      "bytes": 1213,
      "sha256": "107786676B2DBDCDB886B5112D827018A54171998D1E99981ABDF9F012692786",
      "text": "        fn initialize(self: *CloseReq, s: *Scope, registry: *native.Registry,\n            wrapper: c.JSValue, promise: c.JSValue, reference: c.JSValue) !void\n        {\n            self.wrap.initialize(registry, wrapper, derived,\n                native.Provider.filehandleclosereq, -1) catch |err|\n            {\n                self.attached = registry.unwrap(wrapper) == &self.wrap;\n                record(s, err);\n                // ReqWrap construction follows the completed void AsyncReset,\n                // including an ordinary init-hook rethrow.\n                if (!self.attached or !self.wrap.init_hook_ran or\n                    !canContinue(s, err)) return err;\n            };\n            self.attached = true;\n            try self.entry.initialize(&self.wrap, cancel);\n            self.entry_initialized = true;\n            try self.wrap.makeWeak();\n            self.entry.reset();\n            if (uv.pi_uv_fs_request_reset(self.actual.?) != 0)\n                return error.ActualFileHandleCloseInitialResetRequired;\n            self.promise = try globals.Global.create(s, promise);\n            self.reference = try globals.Global.create(s, reference);\n            self.constructed = true;\n        }\n",
      "claim": "Completed CloseReq construction initializes its queue entry, resets the native storage and installs both actual Globals."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_node_request_state.zig",
        "bytes": 5818,
        "sha256": "6FACD1ACF162570BF3435E4F962BAB5CA8BAF4237673CD04D66A708F4CC371AF"
      },
      "first_line": 59,
      "last_line": 108,
      "bytes": 2334,
      "sha256": "0A987D72656D3D703065F4E5B9D99F840ABD92B7BC87DFC9DF94F41599FDA97E",
      "text": "pub const Entry = struct {\n    wrap: *wraps.State,\n    cancel_native: Cancel,\n    original_callback: ?NativeCallback = null,\n    queue: ?*Registry = null,\n    previous: ?*Entry = null,\n    next: ?*Entry = null,\n    dispatched: bool = false,\n    counted: bool = false,\n\n    /// ReqWrapBase construction follows AsyncWrap initialization and precedes\n    /// MakeWeak/Reset and the derived FSReqBase member initialization.\n    pub fn initialize(self: *Entry, wrap: *wraps.State, cancel_native: Cancel) !void {\n        const environment = wrap.registry.environment;\n        _ = try environment.requireEngine();\n        if (!environment.has_run_bootstrapping_code)\n            return environment.operations.native_check_failure(environment, .request_before_bootstrap);\n        self.* = .{ .wrap = wrap, .cancel_native = cancel_native };\n        environment.requests.append(self);\n    }\n    /// The real derived destructor removes ReqWrapBase's ListNode before the\n    /// AsyncWrap base destructor. There is no independently owned queue root.\n    pub fn deinit(self: *Entry) void {\n        if (self.queue) |queue| queue.remove(self);\n    }\n    pub fn reset(self: *Entry) void {\n        std.debug.assert(!self.counted);\n        self.original_callback = null;\n        self.dispatched = false;\n    }\n    /// Source Dispatched() precedes the actual uv request initialization call.\n    pub fn dispatchStarted(self: *Entry) void {\n        self.dispatched = true;\n    }\n    /// MakeLibuvRequestCallback::For follows Dispatched and precedes the real\n    /// libuv call. Reset clears this same field before a reused Dispatch.\n    pub fn setCallback(self: *Entry, callback: NativeCallback) !void {\n        if (self.original_callback != null) {\n            const environment = self.wrap.registry.environment;\n            return environment.operations.native_check_failure(environment, .request_callback_already_set);\n        }\n        self.original_callback = callback;\n    }\n    /// Call only after successful real admission. A negative native Dispatch\n    /// result neither strengthens the persistent nor increments this counter.\n    pub fn dispatchAccepted(self: *Entry) !void {\n        const environment = self.wrap.registry.environment;\n        try self.wrap.clearWeak();\n        environment.requests.waiting += 1;\n        self.counted = true;\n",
      "claim": "Actual Entry defaults and Reset leave dispatched/count false; only later admission sets them."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_uv_tcp.c",
        "bytes": 46648,
        "sha256": "8BFEFBB59ADCD7414A8C9358CA2422989784043B3BF651D8006D1C86DED261B2"
      },
      "first_line": 856,
      "last_line": 881,
      "bytes": 1372,
      "sha256": "5425C903B1886358F1346DBA4C97F987F415A59330627D0A7AC99A1912C3B575",
      "text": "int pi_uv_fs_request_reset(PiUvFsRequest *request) {\n    if (!request) return UV_EINVAL;\n    /* Initial ReqWrap::Reset has no completed native operation to clean. */\n    if (!request->submitted)\n        return atomic_load_explicit(&request->cleaned, memory_order_acquire)\n            ? UV_EBUSY : 0;\n    if (!atomic_load_explicit(&request->completed, memory_order_acquire) ||\n        !atomic_load_explicit(&request->cleaned, memory_order_acquire) ||\n        atomic_load_explicit(&request->event_queued, memory_order_acquire))\n        return UV_EBUSY;\n    assert(request->previous == NULL && request->next == NULL);\n    assert(request->backing.owner == NULL);\n    /* The prior event was taken from the FIFO. Its independent entitlement\n     * may still be alive in the host callback, but release reads only stable\n     * service/storage/allocation/source fields. Do not reinitialize that event\n     * or clear its next link: a new completion can already occupy the FIFO\n     * when the prior event entitlement is finally retired. */\n    request->uv.data = NULL;\n    request->submitted = 0;\n    request->entered = 0;\n    request->accepted = 0;\n    request->event.info.status = 0;\n    request->event.info.length = 0;\n    atomic_store_explicit(&request->completed, 0, memory_order_release);\n    atomic_store_explicit(&request->cleaned, 0, memory_order_release);\n    return 0;\n",
      "claim": "Initial request_reset checks cleaned and returns without setting completed or accepted."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_uv_fs.h",
        "bytes": 6334,
        "sha256": "23B85BBB1BD8395D1D5085BE0797F06CE2C323DAACF366F5CF3B587D06EACA6D"
      },
      "first_line": 15,
      "last_line": 27,
      "bytes": 366,
      "sha256": "AF1982C3E383297E52C04645BB9CAD3E13E3473D99B162CFACE877F2D8A9BC77",
      "text": "typedef struct PiUvFsInfo {\n    int kind;\n    int64_t result; /* actual uv_fs_t::result, never a synthesized Promise value */\n    const char *path; /* borrowed until request_cleanup */\n    int accepted;\n    int cleaned;\n} PiUvFsInfo;\ntypedef struct PiUvFsPreparationInfo {\n    int kind;\n    int accepted;\n    int cleaned;\n    int completed;\n} PiUvFsPreparationInfo;\n",
      "claim": "The existing preparation ABI contains only kind and accepted/cleaned/completed integers."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_node_uv_service.zig",
        "bytes": 8937,
        "sha256": "CDA7A2AEBD9B752E38521E72A33F4BEE3A7A7453AA8DA38F33F04A61D0E369D5"
      },
      "first_line": 4,
      "last_line": 12,
      "bytes": 448,
      "sha256": "92A74E73E4BDBE51F70B0B8346CB48557EDE7FF0C8985125D2D7091F5B8CE48F",
      "text": "const std = @import(\"std\");\nconst em = @import(\"engine.zig\");\nconst a = @import(\"native_node_argument_values.zig\");\nconst env = @import(\"native_env_io.zig\");\nconst wake = @import(\"native_owner_wake.zig\");\nconst completion_wake = @import(\"native_owner_completion.zig\");\nconst Completion = @import(\"native_sdk_owned_completion.zig\").Completion;\nconst c = em.c;\npub const uv = @cImport({ @cInclude(\"native_uv_tcp.h\"); @cInclude(\"native_uv_fs.h\"); });\n",
      "claim": "Controller.uv is the canonical shared cImport of native_uv_fs.h; no new ABI owner or type is introduced."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_node_fs_request_io.zig",
        "bytes": 15469,
        "sha256": "B6792DCB053DDC2CFBC26350D9AD580CC5419CF3BDBEB595AF1F19B0922AF996"
      },
      "first_line": 5,
      "last_line": 15,
      "bytes": 570,
      "sha256": "04AF824384602BADB381E304FAAE2BAF9D86E014CF09DBCA8F5099F9DCC519FF",
      "text": "const a = @import(\"native_node_argument_values.zig\");\nconst callbacks = @import(\"native_node_callback_scope.zig\");\nconst request_state = @import(\"native_node_request_state.zig\");\nconst requests = @import(\"native_node_fs_request_promise.zig\");\nconst after_scope = @import(\"native_node_fs_after_scope.zig\");\nconst shared_service = @import(\"native_node_uv_service.zig\");\nconst env_io = @import(\"native_env_io.zig\");\nconst Completion = @import(\"native_sdk_owned_completion.zig\").Completion;\nconst c = a.c;\npub const uv = shared_service.uv;\npub const Engine = a.v.em.Engine;\n",
      "claim": "FS request I/O exports that shared canonical UV namespace."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\extensions\\native_node_file_handle_close_request.zig",
        "bytes": 15879,
        "sha256": "C2016812A084329BCFC9DC113485F2732B2CC095C9ED6B8B21A18158205C443A"
      },
      "first_line": 237,
      "last_line": 245,
      "bytes": 641,
      "sha256": "04D28A664F207BF64B4E26EE64C07B2AD371D64CC4C6228192EE741D50A4E745",
      "text": "        /// Runs only through the real Controller/ReqWrap callback wrapper.\n        /// That wrapper already holds one native pointer and decremented the\n        /// Environment's waiting count before entering this original callback.\n        pub fn completed(entry: *requests.Entry, actual_raw: *anyopaque) !void {\n            const self = fromEntry(entry);\n            const actual: *uv.PiUvFsRequest = @ptrCast(@alignCast(actual_raw));\n            const info = uv.pi_uv_fs_request_info(actual);\n            self.trace.end_async(self.trace.raw, self, @truncate(info.result));\n            const environment = self.wrap.registry.environment;\n",
      "claim": "The unchanged genuine completion callback reads completion info only after actual callback-wrapper admission."
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\main\\src\\native_node_file_handle_owner_test.zig",
        "bytes": 28378,
        "sha256": "93D00DE989F6F675E862A61FB93BE2EF91FD6FC7D85CC59FC769CB4842543422"
      },
      "first_line": 141,
      "last_line": 168,
      "bytes": 1709,
      "sha256": "4F2DF95587DB237485EB8E0B5D801B97311F6FB81FEC2E74F3D4713D4EED0D3A",
      "text": "test \"native FileHandle owner explicit close keeps one Promise and one actual CLOSE request through cleanup\" {\n    var file: File = undefined; try file.init(); defer file.deinit();\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    const descriptor = file.take();\n    const handle = try f.create(descriptor, null, null);\n    const promise = try handle.closePromise();\n    defer f.engine.freeValue(promise);\n    const again = try handle.closePromise();\n    defer f.engine.freeValue(again);\n    try std.testing.expect(c.JS_IsStrictEqual(f.engine.context, promise, again));\n    try std.testing.expectEqual(c.JS_PROMISE_PENDING, c.JS_PromiseState(f.engine.context, promise));\n    try std.testing.expect(handle.read_state.closing and !handle.read_state.closed);\n    try std.testing.expectEqual(@as(c_int, 1), f.env().requests.waiting);\n    try std.testing.expectEqual(@as(usize, 1), f.queueCount());\n    try std.testing.expectEqual(@as(usize, 1), f.close_begins);\n    try std.testing.expectEqual(@as(u32, 5), f.close_begin_provider);\n    try std.testing.expectEqual(@as(c_int, uv.PI_UV_FS_CLOSE), f.close_begin_kind);\n    try std.testing.expect(f.close_begin_unsubmitted and f.close_begin_globals);\n    const actual = try retainCloseStorage(&f);\n    defer uv.pi_uv_fs_request_release(actual);\n    try f.pumpIo();\n    try expectClosed(&f, descriptor);\n    try expectDrainedClose(&f, actual);\n    try std.testing.expectEqual(c.JS_PROMISE_FULFILLED, c.JS_PromiseState(f.engine.context, promise));\n    const result = c.JS_PromiseResult(f.engine.context, promise);\n    defer f.engine.freeValue(result);\n    try std.testing.expect(c.JS_IsUndefined(result));\n    const after = try handle.closePromise();\n",
      "claim": "Existing named control still asserts typed CLOSE, unsubmitted entry and Globals, then actual completion/result and cleanup."
    }
  ],
  "causal_conclusion": "The trace-begin call is synchronous after owned typed CLOSE construction and its initial Reset, before first dispatch. The caller's retained Controller has verified the owner thread. Native allocation zeros accepted, completed and cleaned; initial Reset preserves them. Existing preparation-info is valid at this retained unsubmitted cutpoint and exposes those actual flags without uv.result/path, mutation or entitlement. Completion-info still requires completed and remains unchanged at endAsyncClose.",
  "original_policy_scope": "Original Node calls trace begin before Dispatch. The added assertions are fixture observations of the host storage/entry phase, not added original Node policy.",
  "native_ABI_changed": false,
  "production_source_changed": false
}
