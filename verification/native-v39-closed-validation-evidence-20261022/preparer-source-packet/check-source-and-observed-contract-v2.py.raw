def sha(raw):return hashlib.sha256(raw).hexdigest().upper()
def enc(v):return (json.dumps(v,indent=2,ensure_ascii=False)+"\n").encode()
def read(row):
 p=Path(row["path"]);assert p.is_relative_to(E) or (p.is_relative_to(B/"worktrees") and "verification" in p.parts)
 assert not any(x in ("cache","global-cache","installed",".zig-cache","zig-out") for x in p.parts)
 assert p.suffix.lower() not in (".exe",".dll",".pdb")
 raw=p.read_bytes();q={"path":str(p),"bytes":len(raw),"sha256":sha(raw)};assert q==row
 k=str(p).casefold();assert k not in seen or seen[k]==q;seen[k]=q
 return raw
def doc(row):return json.loads(read(row))
def pin(p):
 raw=p.read_bytes();return {"path":str(p),"bytes":len(raw),"sha256":sha(raw)}
def put(name,value):
 p=R/name;raw=enc(value)
 with p.open("xb") as f:f.write(raw)
 assert p.read_bytes()==raw
 return pin(p)
