l\"] is None and closure[\"missing_original_records_not_reconstructed\"] is True,\n            \"current Root closure does not reconstruct absent original postseal/restoration\")\n    require(proof[\"Root_current_source_and_process_closure\"][\"receipt\"]==root[\"root_current_closure\"] and\n            peer[\"Root_current_source_and_process_closure\"]==proof[\"Root_current_source_and_process_closure\"] and\n            root[\"current_process_observation\"]==closure[\"current_process_observation\"] and\n            root[\"current_process_observation\"]==archived_pin(pc/\"root-current-owner-instance-absence.json\"),\n            \"original-only peer and separate current authority are not conflated\")\n    outer,absence,job=doc(pc/\"outer.json\"),doc(pc/\"outer-absence.json\"),doc(pc/\"independent-observed-job-status.json\")[\"data\"]\n    require(outer[\"status\"]==\"timeout\" and outer[\"timeout_seconds\"]==root[\"outer_timeout_seconds\"]==1800 and\n            outer[\"pid\"]==49640 and outer[\"exit_code\"]==root[\"outer_exit_code\"]==-1 and\n            outer[\"termination_verified\"] is True and absence[\"currently_absent\"] is True and absence[\"current_records\"]==[],\n            \"original timed-out outer and termination observation retained\")\n    require(job==closure[\"original_job\"] and job[\"id\"]==root[\"durable_job_id\"]==\n            \"job-op-68e7e3262f296a6d0fb4a275f57024fff8c8df3219ed4e23930d2f6588032394\" and\n            job[\"status\"]==\"failed\" and job[\"exitCode\"]==root[\"durable_job_exit_code\"]==1 and job[\"runnerAlive\"] is False and\n            job[\"runnerProcessInstance\"]==closure[\"runner_process_instance_string_preserved\"]==proof[\"runner_process_instance\"]==\n            \"134371646432880998\",\"original failed job with exact decimal100ns runner instance\")\n    require(closure[\"first_child_grant_age_100ns\"]==proof[\"first_child_grant_age100ns\"]==\"663316294\",\n            \"actual admitted first child met unchanged freshness gate\")\n    require(raw(pc/\"outer.stdout.bin\")==\"\".join(\"Group \"+g+\" completed actual BuildQuery phases; awaiting whole-batch closure\\r\\n\"\n            for g in existing63[:50]).encode() and raw(pc/\"outer.stderr.log\")==b\"\",\"exact50 original controller progress lines, no final result\")\n    grant=doc(pc/\"root-grant.json\")\n    require(grant[\"candidate_head\"]==HEAD and grant[\"groups\"]==existing63 and grant[\"mode\"]==\"BuildQuery\" and\n            grant[\"actual_metadata_count\"] is None and grant[\"outer_controller_seconds\"]==1800 and\n            grant[\"driver_sha256\"]==DRIVER_SHA,\"original strict complete63 grant retained\")\n    require(len(proof[\"owner_intervals\"])==len(closure[\"observed_owners\"])==101 and\n            [v[\"group\"] for v in proof[\"group_observations\"]]==existing63[:51],\"all101 exact observed intervals\")\n    for record,observed in zip(proof[\"owner_intervals\"],closure[\"observed_owners\"]):\n        require(all(record[k]==observed[k] for k in (\"group\",\"phase\",\"owner\",\"pid\",\"created_utc\",\"completed_utc\",\"exit_code\")),\n                \"same native owner identities and full timestamp strings across independent inspections\")\n        owner=document(record[\"owner\"])\n        require(owner[\"pid\"]==record[\"pid\"] and owner[\"retained_handle\"]==record[\"retained_handle\"] and\n                owner[\"created_utc\"]==record[\"created_utc\"] and owner[\"completed_utc\"]==record[\"completed_utc\"] and\n                owner[\"status\"]==\"passed\" and owner[\"exit_code\"]==0 and owner[\"timeout_seconds\"]==record[\"deadline_seconds\"],\n                \"every original native owner remains terminal0, distinct from outer timeout\")\n        a=document(record[\"original_absence\"])\n        require(a[\"status\"]==\"closed\" and a[\"global_native\"]==[] and a[\"evidence\"][\"valid\"] is True and\n                a[\"evidence\"][\"current_owner_pid_present\"]==0 and a[\"evidence\"][\"current_owned_descendants\"]==[] and\n                a[\"evidence\"][\"absence_error\"] is None,\"original101 phase absence records preserved\")\n    for index,group in enumerate(existing63[:50]):\n        gd=pp/\"groups\"/group\n        provisional=doc(gd/\"result-provisional.json\")\n        require(provisional[\"status\"]==\"awaiting_batch_closure\" and provisional[\"postseal\"] is False and\n                provisional[\"attempted_phases\"]==provisional[\"owned_started_phases\"]==[\"compile\",\"metadata\"] and\n                provisional[\"native_selected_tests_started\"] is None,\"all50 provisional negative closure flags\")\n        flags(provisional,false=(\"runtime_requested\",\"runtime_owner_launch_attempted\",\"actual_runtime_owner_started\"))\n        for phase in (\"compile\",\"metadata\"):\n            q=provisional[\"phases\"][phase]\n            require(q[\"failure\"] is None and q[\"original_execution_failure\"] is None and q[\"owner_binding\"][\"status\"]==\"passed\" and\n                    q[\"postchecks\"][\"source_sealed\"] is False,\"phase terminal0 cannot substitute for missing batch source closure\")\n        selected=doc(gd/\"selected-tests.json\");observed=proof[\"group_observations\"][index]\n        require(selected[\"tests\"]==observed[\"metadata_names\"] and selected[\"actual_count\"]==counts[index] and\n                observed[\"metadata_raw\"]==archived_pin(gd/\"metadata.stdout.bin\") and raw(gd/\"metadata.stderr.log\")==b\"\",\n                \"exact independently decoded partial metadata retained with original bytes\")\n        require(not (gd/\"result.json\").exists(),\"no synthesized final group result\")\n    last=pp/\"groups\"/existing63[50]\n    require(not (last/\"metadata.json\").exists() and not (last/\"selected-tests.json\").exists() and\n            not (last/\"result-provisional.json\").exists() and not (last/\"result.json\").exists(),\n            \"group51 remains compile-only with no invented query or provisional record\")\n    require(root[\"preserved_Root_inspector_provenance\"]==peer[\"retained_Root_inspector_provenance\"]==\n            proof[\"retained_Root_inspector_provenance\"] and root[\"preserved_Root_inspector_provenance\"][\"native_attempt\"] is False,\n            \"Root inspector assumption/correction remains separate non-native provenance\")\n    return {\"name\":\"V39 existing63 original outer-timeout BuildQuery negative\",\"status\":root[\"status\"],\"source_head\":HEAD,\n      \"batch\":\"existing63\",\"negative_kind\":root[\"negative_kind\"],\"root_acceptance\":root_pin,\n      \"root_current_closure\":root[\"root_current_closure\"],\"independent_original_evidence_peer\":roles[\"independent_peer\"],\n      \"independent_original_evidence_proof\":roles[\"independent_proof\"],\"historical_checkpoint\":roles[\"historical_checkpoint\"],\n      \"granted_groups\":copy.deepcopy(existing63),\"declared_groups\":63,\"declared_controls\":1249,\n      \"attempted_groups\":51,\"unstarted_groups\":copy.deepcopy(existing63[51:]),\"compile_owners\":51,\"metadata_owners\":50,\"runtime_owners\":0,\n      \"native_owner_failures\":0,\"native_validation_negative\":True,\"provisional_groups\":50,\"complete_groups_accepted\":0,\n      \"observed_partial_metadata_records\":985,\"observed_partial_group_counts\":copy.deepcopy(counts),\"accepted_metadata_count\":None,\n      \"actual_metadata_count\":None,\"selected_tests_started\":0,\"runtime_configuration_issued\":False,\n      \"original_before\":root[\"original_before\"],\"original_final\":None,\"original_result\":None,\n      \"original_source_postseal\":None,\"original_environment_restoration\":None,\"original_source_bookends_raw_equal\":None,\n      \"original_missing_closure_not_reconstructed\":True,\"original_provisional_negative_flags_preserved\":True,\n      \"outer_timeout_seconds\":1800,\"outer_exit_code\":-1,\"durable_job_exit_code\":1,\n      \"Root_current_source_and_process_closure_separate\":True,\"distinct_current_files_rehashe