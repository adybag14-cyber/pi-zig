    {
      "label": "actual accepted timeout outcome validator replaces unresolved stop",
      "old": "def require_unresolved_existing63():\n    slot = copy_plan[\"cohorts\"][\"existing63\"]\n    require(slot=={\"status\":\"unresolved_existing63_acceptance_contract\",\"buildquery_root_acceptance\":None,\n                   \"runtime_root_acceptance\":None,\"metadata_acceptance\":None,\"independent_build_closure\":None,\n                   \"independent_runtime_closure\":None,\"actual_metadata_count\":None,\"actual_group_counts\":None,\n                   \"observed_phase_membership\":None},\"one explicit unresolved existing63 contract, no predicted outcome\")\n    require(False,\"UNRESOLVED existing63 acceptance contract: a separately reviewed finite terminal-outcome successor is required before any staging\")\n",
      "new": "def check_existing63_timeout_negative():\n    cohort = copy_plan[\"cohorts\"][\"existing63\"]\n    root_pin = timeout_basis[\"role_pins\"][\"root_acceptance\"]\n    require(cohort=={\"buildquery_root_negative\":root_pin},\"only the actual closed existing63 timeout authority\")\n    for required in timeout_basis[\"required_raw_files\"]:\n        require(archived_pin(required[\"path\"])==required and\n                row_by_path[required[\"path\"].casefold()][\"representation\"]==\"raw_byte_exact\",\n                \"all908 closed-timeout and source-predecessor inputs retained raw\")\n    for edge in timeout_basis[\"direct_pin_relationships\"]:\n        require(edge in copy_plan[\"direct_pin_relationships\"],\"all47 additional direct authority relationships preserved\")\n    root = document(root_pin)\n    roles = timeout_basis[\"role_pins\"]\n    peer,proof = document(roles[\"independent_peer\"]),document(roles[\"independent_proof\"])\n    require(root_pin[\"sha256\"]==\"BBE41BE72BD618F43712ECBA196E16859ED55A2782DF248FD0B54FBEB6787700\" and\n            root[\"status\"]==\"root_accepted_closed_v39_existing63_outer_timeout_negative\" and\n            root[\"reviewer\"]==\"Root\" and root[\"candidate_head\"]==HEAD and root[\"batch\"]==\"existing63\",\n            \"actual Root-accepted outer timeout, no positive outcome\")\n    require(root[\"independent_original_evidence_peer\"]==roles[\"independent_peer\"] and\n            root[\"independent_original_evidence_proof\"]==roles[\"independent_proof\"] and\n            root[\"independent_inspector\"]==roles[\"independent_inspector\"],\"exact independent original-only review\")\n    require(peer[\"status\"]==\"independent_original_evidence_peer_accepts_v39_existing63_outer_timeout_negative_only\" and\n            peer[\"reviewer\"]==\"/root/handover_review\" and peer[\"candidate_head\"]==HEAD and\n            peer[\"original_evidence_proof\"]==roles[\"independent_proof\"],\"accepted bounded peer scope\")\n    require(proof[\"status\"]==\"independently_inspected_original_v39_existing63_outer_timeout_negative\" and\n            proof[\"candidate_head\"]==HEAD and proof[\"input_count\"]==len(proof[\"all_input_pins\"])==877,\n            \"complete original-only inspection inventory\")\n    for row in proof[\"all_input_pins\"]:\n        require(row in timeout_basis[\"required_raw_files\"],\"every original inspected version retained\")\n    flags(peer[\"scope\"],false=(\"Main_access\",\"current_process_queries\",\"current_source_rehash\",\n                              \"cache_or_binary_reads\",\"native_or_candidate_or_auditor_execution\",\n                              \"original_receipts_modified\",\"configuration_or_release_issued\"))\n    flags(root,true=(\"original_closed_evidence_accepted_as_negative\",\"Root_full_peer_and_inspector_source_read\",\n                     \"Root_independent_current_before_seal_rehash\",\"Root_all50_raw_query_streams_independently_decoded\",\n                     \"Root_inspector_two_hunk_raw_inverse_replayed\",\"missing_original_closure_not_reconstructed\",\n                     \"original_partial_group_postseal_and_source_sealed_false_preserved\",\n                     \"current_against_before_rehash_equal\",\"all_observed_original_process_instances_closed\"),\n          false=(\"original_final_present\",\"original_result_present\",\"complete_buildquery_accepted\",\n                 \"positive_buildquery_accepted\",\"partial_groups_admissible\",\"metadata_audit_performed\",\n                 \"observed_helper_binding_performed\",\"runtime_configuration_issued\",\n                 \"source_inspection_negative_is_native_attempt\",\"native_execution_authorized\",\n                 \"runtime_authority\",\"source_mutation_hold_released\",\"product_qualification\",\"qualification\"))\n    require(all(root[k] is None for k in (\"actual_metadata_count\",\"accepted_metadata_count\",\n            \"original_source_postseal\",\"original_environment_restoration\",\"source_bookends_raw_equal\")),\n            \"all missing original closure fields remain unknown\")\n    require(root[\"granted_groups\"]==proof[\"granted_group_order\"]==existing63 and\n            root[\"declared_controls\"]==proof[\"declared_controls\"]==1249 and root[\"attempted_groups\"]==proof[\"attempted_groups\"]==51 and\n            root[\"unstarted_groups\"]==proof[\"unstarted_groups\"]==existing63[51:],\"exact63/51/12 source cohort\")\n    require(root[\"compile_owners\"]==proof[\"compile_owners\"]==51 and root[\"metadata_owners\"]==proof[\"metadata_owners\"]==50 and\n            root[\"runtime_owners\"]==proof[\"runtime_owners\"]==0 and root[\"observed_native_owners\"]==proof[\"native_owners\"]==101 and\n            root[\"provisional_compile_and_metadata_groups\"]==proof[\"provisional_groups\"]==50,\"all original native owners and cutpoint\")\n    require(root[\"partial_compile_only_group\"]==existing63[50]==\"native-sdk-tool-search-public\" and\n            root[\"complete_groups_accepted\"]==proof[\"complete_groups_accepted\"]==0 and\n            root[\"selected_tests_started\"]==proof[\"selected_tests_started\"]==0,\"no promoted group or runtime\")\n    counts = root[\"observed_partial_group_counts\"]\n    require(counts==proof[\"observed_partial_group_counts\"] and len(counts)==50 and\n            all(type(n) is int and n>0 for n in counts) and\n            sum(counts)==root[\"observed_partial_metadata_records\"]==proof[\"observed_partial_metadata_count\"]==985,\n            \"985 raw partial query records, never accepted metadata\")\n    require(all(proof[k] is None for k in (\"original_final\",\"original_batch_result\",\"original_source_postseal\",\n            \"original_environment_restoration\",\"accepted_total_metadata_count\")),\"independent peer preserves the same unknowns\")\n    m = membership[4];pp,pc=Path(m[\"proof\"]),Path(m[\"control\"])\n    require(m==timeout_basis[\"phase_membership\"] and m[\"proof_top_level_files\