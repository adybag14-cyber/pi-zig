      "label": "exact fifth original membership and absent final/result",
      "old": "membership = copy_plan[\"observed_phase_membership\"]\nrequire([m[\"phase\"] for m in membership]==list(PHASES),\"only four exact closed phase scopes\")\nrequire(membership==inventory[\"observed_phase_membership\"],\"complete immutable closed phase membership, no current63 additions\")\nfor index,m in enumerate(membership):\n    batch = \"new3\" if index<2 else \"new4\"\n    is_build = index<3\n    groups = NEW3[:1] if index<2 else NEW4\n    proof,control = inside(m[\"proof\"]),inside(m[\"control\"])\n    require(proof.parent==control.parent==E,\"phase roots directly under evidence\")\n    cp = \"root-native-foundation-\"+(\"fresh-\" if is_build else \"\")+\"v39-\"+batch+(\"-control-\" if is_build else \"-runtime-control-\")\n    require(control.name==cp+CLOSED_SUFFIXES[index],\"exact actual closed phase instance\")\n    require(proof.name==control.name.replace(\"-control-\",\"-buildquery-\" if is_build else \"-\",1),\"actual phase proof identity\")\n    require(m[\"proof_top_level_files\"]==[\"before.json\",\"final.json\",\"result.json\"]==names(proof),\"whole original proof membership\")\n",
      "new": "membership = copy_plan[\"observed_phase_membership\"]\nrequire([m[\"phase\"] for m in membership]==list(PHASES),\"all five exact closed phase scopes\")\nrequire(membership[:4]==inventory[\"observed_phase_membership\"] and\n        membership[4]==timeout_basis[\"phase_membership\"],\"all four prior memberships plus only the observed original timeout\")\nfor index,m in enumerate(membership):\n    batch = \"new3\" if index<2 else (\"new4\" if index<4 else \"existing63\")\n    is_build = index!=3\n    groups = NEW3[:1] if index<2 else (NEW4 if index<4 else existing63[:51])\n    proof,control = inside(m[\"proof\"]),inside(m[\"control\"])\n    require(proof.parent==control.parent==E,\"phase roots directly under evidence\")\n    cp = \"root-native-foundation-\"+(\"fresh-\" if is_build else \"\")+\"v39-\"+batch+(\"-control-\" if is_build else \"-runtime-control-\")\n    require(control.name==cp+CLOSED_SUFFIXES[index],\"exact actual closed phase instance\")\n    require(proof.name==control.name.replace(\"-control-\",\"-buildquery-\" if is_build else \"-\",1),\"actual phase proof identity\")\n    expected_proof = [\"before.json\"] if index==4 else [\"before.json\",\"final.json\",\"result.json\"]\n    require(m[\"proof_top_level_files\"]==expected_proof==names(proof),\"whole original proof membership; timeout has no final/result\")\n"
