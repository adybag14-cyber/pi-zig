      "bytes": 42,
      "sha256": "A7BFC764E39259033DDCA706B5CB6ED3AF019E9A65725C7E041B59C02B54B6E0",
      "text": "#define JS_STRING_LEN_MAX ((1 << 30) - 1)\n"
    },
    {
      "file": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\successor\\projected\\vendor\\quickjs\\quickjs.c",
        "bytes": 2403730,
        "sha256": "BC772BEE8794ADBD59385DA98F037310730704DFB9D251EA258862B1C887E454"
      },
      "start_line": 5672,
      "end_line": 5680,
      "bytes": 298,
      "sha256": "075D237EBFD710BA992B90FCE6654F398E33AE7883F024EA622481E24D74D8F2",
      "text": "JSValue JS_PiNewStringLatin1(JSContext *ctx, const uint8_t *buf, size_t len)\n{\n    if (len == 0)\n        return js_empty_string(ctx->rt);\n    if (len > JS_STRING_LEN_MAX)\n        return JS_ThrowRangeError(ctx, \"string too long\");\n    return js_new_string8_len(ctx, (const char *)buf, (int)len);\n}\n\n"
    }
