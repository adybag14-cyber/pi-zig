      "sha256": "92035334616F4900942E230308B57069E80C2BF871D955C3EDA6F470D7FD2109",
      "text": "static inline JSValue js_empty_string(JSRuntime *rt)\n{\n    JSAtomStruct *p = rt->atom_array[JS_ATOM_empty_string];\n    return js_dup(JS_MKPTR(JS_TAG_STRING, p));\n}\n"
    },
    {
      "file": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\original\\vendor\\quickjs\\quickjs.c",
        "bytes": 2403205,
        "sha256": "5C74683747165024EEEB1D54A3D34085C0ACC094B820C433B7D493613A864464"
      },
      "start_line": 5203,
      "end_line": 5216,
      "bytes": 469,
      "sha256": "0E016A9EE3822CDDF3CFAF484E69D809A9BE143D067FB0D3008913CCA73F6DA5",
      "text": "static JSValue js_new_string8_len(JSContext *ctx, const char *buf, int len)\n{\n    JSString *str;\n    str = js_alloc_string(ctx, len, 0);\n    if (!str)\n        return JS_EXCEPTION;\n    memcpy(str8(str), buf, len);\n    str8(str)[len] = '\\0';\n    return JS_MKPTR(JS_TAG_STRING, str);\n}\n\n// XXX: `buf` contains raw 8-bit data, no UTF-8 decoding is performed\n// XXX: no special case for the empty string\nstatic inline JSValue js_new_string8(JSContext *ctx, const char *str)\n"
    },
    {
      "file": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\original\\vendor\\quickjs\\quickjs.c",
        "bytes": 2403205,
        "sha256": "5C74683747165024EEEB1D54A3D34085C0ACC094B820C433B7D493613A864464"
