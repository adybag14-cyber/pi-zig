      "reason": "Native BaseObject deletion does not clear StreamReq slot.",
      "before_sha256": "C080BE992073AA08F1778F4EE670F062FD0939D74E1AE57ED229E3295293CDBE",
      "after_sha256": "133B5988B949F4DFF18CC9E87DFB4579CEFC1D35D3EA7855E507238B360545A7"
