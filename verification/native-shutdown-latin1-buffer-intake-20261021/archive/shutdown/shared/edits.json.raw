    "path": "vendor/quickjs/quickjs.c",
    "before": "/* create a string from a UTF-8 buffer */\nJSValue JS_NewStringLen(JSContext *ctx, const char *buf, size_t buf_len)\n",
    "after": "/* Raw one-byte string construction for native Node OneByteString callers.\n   Every byte denotes the same Latin-1 code unit, including embedded NUL.\n   Signed length selection and Node/V8 fatal policy belong to that caller. */\nJSValue JS_PiNewStringLatin1(JSContext *ctx, const uint8_t *buf, size_t len)\n{\n    if (len == 0)\n        return js_empty_string(ctx);\n    if (len > JS_STRING_LEN_MAX)\n        return JS_ThrowRangeError(ctx, \"string too long\");\n    return js_new_string8_len(ctx, buf, (int)len);\n}\n\n/* create a string from a UTF-8 buffer */\nJSValue JS_NewStringLen(JSContext *ctx, const char *buf, size_t buf_len)\n",
    "reason": "Raw actual VM Latin-1 allocation, no UTF-8 decoding or synthesized JS string."
  },
