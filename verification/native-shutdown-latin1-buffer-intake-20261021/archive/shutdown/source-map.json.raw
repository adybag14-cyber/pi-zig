      "excerpt_bytes": 447,
      "excerpt_sha256": "4F9F2056567D77F8BC45E31E69202633797C5AE9ADB2AF314667FDD5835848DE",
      "excerpt": "inline v8::MaybeLocal<v8::Value> AsyncWrap::MakeCallback(\n    const v8::Local<v8::Name> symbol,\n    int argc,\n    v8::Local<v8::Value>* argv) {\n  v8::Local<v8::Value> cb_v;\n  if (!object()->Get(env()->context(), symbol).ToLocal(&cb_v))\n    return v8::MaybeLocal<v8::Value>();\n  if (!cb_v->IsFunction()) {\n    v8::Isolate* isolate = env()->isolate();\n    return Undefined(isolate);\n  }\n  return MakeCallback(cb_v.As<v8::Function>(), argc, argv);\n}\n",
      "production_basenames": [
        "native_node_stream_shutdown.zig"
      ],
      "source_mapping": "Ordinary Get, then nonfunction => undefined without invocation or trace. Actual callable delegates to unchanged native_node_async_wrap_make_callback.zig 972B9D09 return-try owner."
    },
    {
      "id": "filehandle_shutdown",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\node_file.cc",
        "bytes": 139386,
        "sha256": "19C497BF90FAD9E04645FCA423BC727F18F0B4B9E3C898C35AE2678D12047C0F"
      },
      "start_line": 668,
      "end_line": 696,
      "excerpt_bytes": 959,
      "excerpt_sha256": "8235C67B43E909627D4042A8A86E149B9EC0DE4E304FBF665112E08E60BF141A",
      "excerpt": "typedef SimpleShutdownWrap<ReqWrap<uv_fs_t>> FileHandleCloseWrap;\n\nShutdownWrap* FileHandle::CreateShutdownWrap(Local<Object> object) {\n  return new FileHandleCloseWrap(this, object);\n}\n\nint FileHandle::DoShutdown(ShutdownWrap* req_wrap) {\n  if (closing_ || closed_) {\n    req_wrap->Done(0);\n    return 1;\n  }\n  FileHandleCloseWrap* wrap = static_cast<FileHandleCloseWrap*>(req_wrap);\n  closing_ = true;\n  CHECK_NE(fd_, -1);\n  FS_ASYNC_TRACE_BEGIN0(UV_FS_CLOSE, wrap)\n  wrap->Dispatch(uv_fs_close, fd_, uv_fs_callback_t{[](uv_fs_t* req) {\n    FileHandleCloseWrap* wrap = static_cast<FileHandleCloseWrap*>(\n        FileHandleCloseWrap::from_req(req));\n    FS_ASYNC_TRACE_END1(\n        req->fs_type, wrap, \"result\", static_cast<int>(req->result))\n    FileHandle* handle = static_cast<FileHandle*>(wrap->stream());\n    handle->AfterClose();\n\n    int result = static_cast<int>(req->result);\n    uv_fs_req_cleanup(req);\n    wrap->Done(result);\n  }});\n\n  return 0;\n",
      "production_basenames": [
        "native_node_file_handle_shutdown.zig",
        "native_node_file_handle_owner.zig"
      ],
      "source_mapping": "FileHandleCloseWrap is SimpleShutdownWrap<ReqWrap<uv_fs_t>>. Closed/closing: Done(0), return1. Otherwise closing=true, CHECK fd!=-1, trace begin, real Dispatch uv_fs_close; original ignores negative dispatch result and returns0. Completion trace end, actual AfterClose, fresh result read, cleanup, Done."
    },
    {
      "id": "reqwrap_constructor",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\req_wrap-inl.h",
        "bytes": 5640,
        "sha256": "27C770D8756B626C80210F96F9DB1CF31BFBF09AAB1DA53DC35B382314883E67"
      },
      "start_line": 17,
      "end_line": 39,
      "excerpt_bytes": 489,
      "excerpt_sha256": "F34A9AB2E1BDB8D795E72F98F56E348748E2A004BAD46A83AD4DE7CDADE6356C",
      "excerpt": "template <typename T>\nReqWrap<T>::ReqWrap(Environment* env,\n                    v8::Local<v8::Object> object,\n                    AsyncWrap::ProviderType provider)\n    : AsyncWrap(env, object, provider),\n      ReqWrapBase(env) {\n  MakeWeak();\n  Reset();\n}\n\ntemplate <typename T>\nReqWrap<T>::~ReqWrap() {}\n\ntemplate <typename T>\nvoid ReqWrap<T>::Dispatched() {\n  req_.data = this;\n}\n\ntemplate <typename T>\nvoid ReqWrap<T>::Reset() {\n  original_callback_ = nullptr;\n  req_.data = nullptr;\n}\n",
      "production_basenames": [
        "native_node_file_handle_shutdown.zig"
      ],
      "source_mapping": "Actual AsyncWrap then actual ReqWrapBase queue entry, MakeWeak and Reset. Original ReqWrap destructor is empty. Preallocated canonical C storage is a native layout prerequisite, not an invented async admission."
    },
    {
      "id": "reqwrap_wrapper",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\req_wrap-inl.h",
        "bytes": 5640,
        "sha256": "27C770D8756B626C80210F96F9DB1CF31BFBF09AAB1DA53DC35B382314883E67"
      },
      "start_line": 120,
      "end_line": 139,
      "excerpt_bytes": 780,
      "excerpt_sha256": "3ACC65D92E637FFF2F5EE570C1CB0A6F5BCA5569A841728574D28802AD8C79E8",
      "excerpt": "// Match the `void callback(uv_req_t*, ...);` signature that all libuv\n// callbacks use.\ntemplate <typename ReqT, typename... Args>\nstruct MakeLibuvRequestCallback<ReqT, void(*)(ReqT*, Args...)> {\n  using F = void(*)(ReqT* req, Args... args);\n\n  static void Wrapper(ReqT* req, Args... args) {\n    BaseObjectPtr<ReqWrap<ReqT>> req_wrap{ReqWrap<ReqT>::from_req(req)};\n    req_wrap->Detach();\n    req_wrap->env()->DecreaseWaitingRequestCounter();\n    F original_callback = reinterpret_cast<F>(req_wrap->original_callback_);\n    original_callback(req, args...);\n  }\n\n  static F For(ReqWrap<ReqT>* req_wrap, F v) {\n    CHECK_NULL(req_wrap->original_callback_);\n    req_wrap->original_callback_ =\n        reinterpret_cast<typename ReqWrap<ReqT>::callback_t>(v);\n    return Wrapper;\n  }\n",
      "production_basenames": [
        "native_node_file_handle_shutdown.zig"
      ],
      "source_mapping": "Existing Controller/Entry owns real Wrapper: retain, Detach, decrease waiting, invoke original callback, then release pointer. Cleanup/OnDone occur while that native pointer remains alive."
    },
    {
      "id": "reqwrap_dispatch",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\req_wrap-inl.h",
        "bytes": 5640,
        "sha256": "27C770D8756B626C80210F96F9DB1CF31BFBF09AAB1DA53DC35B382314883E67"
      },
      "start_line": 142,
      "end_line": 169,
      "excerpt_bytes": 1244,
      "excerpt_sha256": "469262A7CB4E438B8C45B165B8984E7BCFC07B0A8418951C0824ED92299AD29D",
      "excerpt": "template <typename T>\ntemplate <typename LibuvFunction, typename... Args>\nint ReqWrap<T>::Dispatch(LibuvFunction fn, Args... args) {\n  Dispatched();\n  // This expands as:\n  //\n  // int err = fn(env()->event_loop(), req(), arg1, arg2, Wrapper, arg3, ...)\n  //              ^                                       ^        ^\n  //              |                                       |        |\n  //              \\-- Omitted if `fn` has no              |        |\n  //                  first `uv_loop_t*` argument         |        |\n  //                                                      |        |\n  //        A function callback whose first argument      |        |\n  //        matches the libuv request type is replaced ---/        |\n  //        by the `Wrapper` method defined above                  |\n  //                                                               |\n  //               Other (non-function) arguments are passed  -----/\n  //               through verbatim\n  int err = CallLibuvFunction<T, LibuvFunction>::Call(\n      fn,\n      env()->event_loop(),\n      req(),\n      MakeLibuvRequestCallback<T, Args>::For(this, args)...);\n  if (err >= 0) {\n    ClearWeak();\n    env()->IncreaseWaitingRequestCounter();\n  }\n  return err;\n",
      "production_basenames": [
        "native_node_file_handle_shutdown.zig"
      ],
      "source_mapping": "Existing real Dispatch owns original callback routing, actual admission, ClearWeak and waiting increment only if admission>=0. Shutdown does not replace this with a Promise or fake queue."
    },
