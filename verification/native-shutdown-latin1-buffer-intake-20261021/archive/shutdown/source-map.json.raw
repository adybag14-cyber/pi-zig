      "excerpt_sha256": "F8B3BCCB069F64DF13B9B832F0BC3FF5C0FC26C4DBFDFAD9FDED042AFEB04774",
      "excerpt": "namespace detail {\ntemplate <typename... Ts>\nstd::string PrintToString(Ts&&... ts) {\n  CheckMessageStream oss;\n  (..., (oss << std::forward<Ts>(ts)));\n  return oss.str();\n}\n",
      "production_basenames": [
