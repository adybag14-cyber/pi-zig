      "end_line": 1001,
      "excerpt_bytes": 928,
      "excerpt_sha256": "20E56260CCB9863055E90A4857676F42B4EDD236C6332CED4D13770B1C123404",
      "excerpt": "MaybeHandle<String> FactoryBase<Impl>::NewStringFromOneByte(\n    base::Vector<const uint8_t> string, AllocationType allocation) {\n  DCHECK_NE(allocation, AllocationType::kReadOnly);\n  int length = string.length();\n  if (length == 0) return empty_string();\n  if (length == 1) return LookupSingleCharacterStringFromCode(string[0]);\n  Handle<SeqOneByteString> result;\n  ASSIGN_RETURN_ON_EXCEPTION(isolate(), result,\n                             NewRawOneByteString(string.length(), allocation));\n\n  DisallowGarbageCollection no_gc;\n  // Copy the characters into the new object.\n  // SharedStringAccessGuardIfNeeded is NotNeeded because {result} is freshly\n  // allocated and hasn't escaped the factory yet, so it can't be concurrently\n  // accessed.\n  CopyChars(Cast<SeqOneByteString>(*result)->GetChars(\n                no_gc, SharedStringAccessGuardIfNeeded::NotNeeded()),\n            string.begin(), length);\n  return result;\n}\n",
      "production_basenames": [
        "native_node_one_byte_string.zig"
      ],
      "source_mapping": "Length0 uses empty_string; length1 uses LookupSingleCharacterStringFromCode; other lengths use raw allocation/copy. Raw VM primitive does not implement V8 single-character caching/heap machinery."
    },
