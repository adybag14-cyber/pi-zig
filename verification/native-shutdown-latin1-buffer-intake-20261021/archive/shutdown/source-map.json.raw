      "excerpt_sha256": "92551513215340E8347924B4F43BAAC3D188BC6BC49F6E884818356335A995B7",
      "excerpt": "// Define PrintCheckOperand<T> for each T which defines operator<< for ostream,\n// except types explicitly specialized below.\ntemplate <typename T>\n  requires(!std::is_function_v<typename std::remove_pointer<T>::type> &&\n           !std::is_enum_v<T> && has_output_operator<T, CheckMessageStream>)\nstd::string PrintCheckOperand(T val) {\n  return detail::PrintToString(std::forward<T>(val));\n}\n",
      "production_basenames": [
        "native_node_one_byte_string_diagnostics.cpp"
      ],
      "source_mapping": "The original streamable overload applies to selected int/size_t; enum/character/unprintable overloads are outside this finite instantiation."
    },
    {
      "id": "check_message",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\v8-logging.h",
        "bytes": 21624,
        "sha256": "0FA464788992D2AB04B14F9A9B9B808E29759D111E867BABD69EAED03D931405"
      },
      "start_line": 296,
      "end_line": 314,
      "excerpt_bytes": 816,
      "excerpt_sha256": "0AE7D05F9BEA5C5AA0C1255B9F45478DADBA31467BD9D0714CA690D731ADCCE4",
      "excerpt": "// Build the error message string.  This is separate from the \"Impl\"\n// function template because it is not performance critical and so can\n// be out of line, while the \"Impl\" code should be inline. Caller\n// takes ownership of the returned string.\ntemplate <typename Lhs, typename Rhs>\nV8_NOINLINE std::string* MakeCheckOpString(Lhs lhs, Rhs rhs, char const* msg) {\n  std::string lhs_str = PrintCheckOperand<Lhs>(lhs);\n  std::string rhs_str = PrintCheckOperand<Rhs>(rhs);\n  CheckMessageStream ss;\n  ss << msg;\n  constexpr size_t kMaxInlineLength = 50;\n  if (lhs_str.size() <= kMaxInlineLength &&\n      rhs_str.size() <= kMaxInlineLength) {\n    ss << \" (\" << lhs_str << \" vs. \" << rhs_str << \")\";\n  } else {\n    ss << \"\\n   \" << lhs_str << \"\\n vs.\\n   \" << rhs_str << \"\\n\";\n  }\n  return new std::string(ss.str());\n}\n",
      "production_basenames": [
        "native_node_one_byte_string_diagnostics.cpp"
      ],
      "source_mapping": "Actual native std::string construction retains 50-character inline threshold and multiline alternative; no formatted host surrogate."
    },
    {
      "id": "check_operators",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\v8-logging.h",
