    {
      "id": "request_done",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base.cc",
        "bytes": 28310,
