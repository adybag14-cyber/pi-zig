  "excerpts": [
    {
      "id": "request_fields",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base.h",
        "bytes": 18488,
        "sha256": "E89C31A78F138DEE6FBA5EBF9795BF3A59569D041B9955AE8183B09633103334"
      },
      "start_line": 33,
      "end_line": 90,
      "excerpt_bytes": 1937,
      "excerpt_sha256": "65C52BD96A28F03F87F060178C70D11478A5CBC586DC959134C10C4EA95DD983",
      "excerpt": "class StreamReq {\n public:\n  // The kSlot internal field here mirrors BaseObject::InternalFields::kSlot\n  // here because instances derived from StreamReq will also derive from\n  // BaseObject, and the slots are used for the identical purpose.\n  enum InternalFields {\n    kSlot = BaseObject::kSlot,\n    kStreamReqField = BaseObject::kInternalFieldCount,\n    kInternalFieldCount\n  };\n\n  inline explicit StreamReq(\n      StreamBase* stream,\n      v8::Local<v8::Object> req_wrap_obj);\n\n  virtual ~StreamReq() = default;\n  virtual AsyncWrap* GetAsyncWrap() = 0;\n  inline v8::Local<v8::Object> object();\n\n  // TODO(RaisinTen): Update the return type to a Maybe, so that we can indicate\n  // if there is a pending exception/termination.\n  void Done(int status, const char* error_str = nullptr);\n  inline void Dispose();\n\n  StreamBase* stream() const { return stream_; }\n\n  static inline StreamReq* FromObject(v8::Local<v8::Object> req_wrap_obj);\n\n  // Sets all internal fields of `req_wrap_obj` to `nullptr`.\n  // This is what the `WriteWrap` and `ShutdownWrap` JS constructors do,\n  // and what we use in C++ after creating these objects from their\n  // v8::ObjectTemplates, to avoid the overhead of calling the\n  // constructor explicitly.\n  static inline void ResetObject(v8::Local<v8::Object> req_wrap_obj);\n\n protected:\n  virtual void OnDone(int status) = 0;\n\n  inline void AttachToObject(v8::Local<v8::Object> req_wrap_obj);\n\n private:\n  StreamBase* const stream_;\n};\n\nclass ShutdownWrap : public StreamReq {\n public:\n  inline ShutdownWrap(\n      StreamBase* stream,\n      v8::Local<v8::Object> req_wrap_obj);\n\n  static inline ShutdownWrap* FromObject(v8::Local<v8::Object> req_wrap_obj);\n  template <typename T, bool kIsWeak>\n  static inline ShutdownWrap* FromObject(\n      const BaseObjectPtrImpl<T, kIsWeak>& base_obj);\n\n  // Call stream()->EmitAfterShutdown() and dispose of this request wrap.\n  void OnDone(int status) override;\n};\n",
      "production_basenames": [
        "native_node_stream_request.zig",
        "native_node_async_wrap_state.zig"
      ],
      "source_mapping": "StreamReq owns a borrowed StreamBase pointer and an internal request slot independent from BaseObject; ShutdownWrap supplies OnDone."
    },
    {
      "id": "request_attach",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base-inl.h",
        "bytes": 5052,
        "sha256": "CE08E90A41BBFCA00996EB2CF14E228472246F0B8A91D91C17EC7D2F0D4BF2C6"
      },
      "start_line": 14,
      "end_line": 32,
      "excerpt_bytes": 633,
      "excerpt_sha256": "B4FCCC7556BE0006A5573A1D82A8813F273D0A40DEB3CAD00352380C36729DDB",
      "excerpt": "StreamReq::StreamReq(\n    StreamBase* stream,\n    v8::Local<v8::Object> req_wrap_obj) : stream_(stream) {\n  AttachToObject(req_wrap_obj);\n}\n\nvoid StreamReq::AttachToObject(v8::Local<v8::Object> req_wrap_obj) {\n  CHECK_EQ(req_wrap_obj->GetAlignedPointerFromInternalField(\n               StreamReq::kStreamReqField),\n           nullptr);\n  req_wrap_obj->SetAlignedPointerInInternalField(\n      StreamReq::kStreamReqField, this);\n}\n\nStreamReq* StreamReq::FromObject(v8::Local<v8::Object> req_wrap_obj) {\n  return static_cast<StreamReq*>(\n      req_wrap_obj->GetAlignedPointerFromInternalField(\n          StreamReq::kStreamReqField));\n}\n",
      "production_basenames": [
        "native_node_stream_request.zig",
        "native_node_async_wrap_state.zig"
      ],
      "source_mapping": "Attach the request slot before the OtherBase/AsyncWrap constructor. FromObject reads that slot independently. Genuine CHECK failure uses the existing Node assertion owner."
    },
    {
      "id": "request_dispose",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base-inl.h",
        "bytes": 5052,
        "sha256": "CE08E90A41BBFCA00996EB2CF14E228472246F0B8A91D91C17EC7D2F0D4BF2C6"
      },
      "start_line": 34,
      "end_line": 48,
      "excerpt_bytes": 416,
      "excerpt_sha256": "655F53430B80D4EFBD8E9D357AACF3F00649E926D7BF39C9FE23C84D210E3432",
      "excerpt": "void StreamReq::Dispose() {\n  BaseObjectPtr<AsyncWrap> destroy_me{GetAsyncWrap()};\n  object()->SetAlignedPointerInInternalField(\n      StreamReq::kStreamReqField, nullptr);\n  destroy_me->Detach();\n}\n\nv8::Local<v8::Object> StreamReq::object() {\n  return GetAsyncWrap()->object();\n}\n\nShutdownWrap::ShutdownWrap(\n    StreamBase* stream,\n    v8::Local<v8::Object> req_wrap_obj)\n    : StreamReq(stream, req_wrap_obj) { }\n",
      "production_basenames": [
        "native_node_stream_request.zig"
      ],
      "source_mapping": "Acquire a temporary actual BaseObjectPtr, clear only the StreamReq slot, Detach, then release. Last release may destroy the request; no subsequent request dereference."
    },
    {
      "id": "request_reset",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base-inl.h",
        "bytes": 5052,
        "sha256": "CE08E90A41BBFCA00996EB2CF14E228472246F0B8A91D91C17EC7D2F0D4BF2C6"
      },
      "start_line": 162,
      "end_line": 167,
      "excerpt_bytes": 274,
      "excerpt_sha256": "62BB7490B8EEB405E968A9A8DA9755FB726DD31DD1C573D3446121FD9AF83A83",
      "excerpt": "void StreamReq::ResetObject(v8::Local<v8::Object> obj) {\n  DCHECK_GT(obj->InternalFieldCount(), StreamReq::kStreamReqField);\n\n  obj->SetAlignedPointerInInternalField(StreamReq::kSlot, nullptr);\n  obj->SetAlignedPointerInInternalField(StreamReq::kStreamReqField, nullptr);\n}\n",
      "production_basenames": [
        "native_node_async_wrap_state.zig",
        "native_node_async_wrap.zig"
      ],
      "source_mapping": "Fresh template construction clears the BaseObject slot then the StreamReq slot. Real branded native fields replace V8 internal fields without adding guest roots."
    },
    {
      "id": "shutdown_template",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_wrap.cc",
        "bytes": 13099,
        "sha256": "FCA1B10EC090A78AC3CDA6496C4E6A47E340555113D9E2B5B5174E6C6D30ACB8"
      },
      "start_line": 61,
      "end_line": 92,
      "excerpt_bytes": 1271,
      "excerpt_sha256": "EDB3EE586C6883F98B4498FE98CF9BB7DFF6C5EFBD9E3310CC3402D583C29032",
      "excerpt": "void IsConstructCallCallback(const FunctionCallbackInfo<Value>& args) {\n  CHECK(args.IsConstructCall());\n  StreamReq::ResetObject(args.This());\n}\n\nvoid LibuvStreamWrap::Initialize(Local<Object> target,\n                                 Local<Value> unused,\n                                 Local<Context> context,\n                                 void* priv) {\n  Environment* env = Environment::GetCurrent(context);\n  Isolate* isolate = env->isolate();\n\n  Local<FunctionTemplate> sw =\n      NewFunctionTemplate(isolate, IsConstructCallCallback);\n  sw->InstanceTemplate()->SetInternalFieldCount(StreamReq::kInternalFieldCount);\n\n  // we need to set handle and callback to null,\n  // so that those fields are created and functions\n  // do not become megamorphic\n  // Fields:\n  // - oncomplete\n  // - callback\n  // - handle\n  sw->InstanceTemplate()->Set(env->oncomplete_string(), v8::Null(isolate));\n  sw->InstanceTemplate()->Set(FIXED_ONE_BYTE_STRING(isolate, \"callback\"),\n                              v8::Null(isolate));\n  sw->InstanceTemplate()->Set(env->handle_string(), v8::Null(isolate));\n\n  sw->Inherit(AsyncWrap::GetConstructorTemplate(env));\n\n  SetConstructorFunction(context, target, \"ShutdownWrap\", sw);\n  env->set_shutdown_wrap_template(sw->InstanceTemplate());\n",
      "production_basenames": [
        "native_node_async_wrap.zig",
        "native_node_async_wrap_state.zig"
      ],
      "source_mapping": "Actual constructor checks construct-call and resets fields; own oncomplete/callback/handle data fields are null in original order with default C/W/E attributes. Inherits the actual AsyncWrap template. This native template surface is not full FileHandle public publication."
    },
    {
      "id": "stream_shutdown",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base.cc",
        "bytes": 28310,
        "sha256": "B5420659CB816F074F9A8C3A5D96C2FE52C90253A08392E5306B657512C2A9B4"
      },
      "start_line": 44,
      "end_line": 80,
      "excerpt_bytes": 1026,
      "excerpt_sha256": "54070F3D368DA238B25AE0F26BDC64A643BAAB729B264CF75A964C38E10373A8",
      "excerpt": "int StreamBase::Shutdown(v8::Local<v8::Object> req_wrap_obj) {\n  Environment* env = stream_env();\n\n  v8::HandleScope handle_scope(env->isolate());\n\n  if (req_wrap_obj.IsEmpty()) {\n    if (!env->shutdown_wrap_template()\n             ->NewInstance(env->context())\n             .ToLocal(&req_wrap_obj)) {\n      return UV_EBUSY;\n    }\n    StreamReq::ResetObject(req_wrap_obj);\n  }\n\n  BaseObjectPtr<AsyncWrap> req_wrap_ptr;\n  AsyncHooks::DefaultTriggerAsyncIdScope trigger_scope(GetAsyncWrap());\n  ShutdownWrap* req_wrap = CreateShutdownWrap(req_wrap_obj);\n  if (req_wrap != nullptr) req_wrap_ptr.reset(req_wrap->GetAsyncWrap());\n  int err = DoShutdown(req_wrap);\n\n  if (err != 0 && req_wrap != nullptr) {\n    req_wrap->Dispose();\n  }\n\n  const char* msg = Error();\n  if (msg != nullptr) {\n    if (req_wrap_obj\n            ->Set(env->context(),\n                  env->error_string(),\n                  OneByteString(env->isolate(), msg))\n            .IsNothing()) {\n      return UV_EBUSY;\n    }\n    ClearError();\n  }\n\n  return err;\n",
      "production_basenames": [
        "native_node_stream_shutdown.zig"
      ],
      "source_mapping": "Missing input uses the stored actual InstanceTemplate. UV_EBUSY on failed ToLocal/Set; trigger scope encloses construction/DoShutdown/disposal/error handling; trigger restores before BaseObjectPtr release and local Scope disposal."
    },
    {
      "id": "trigger_scope",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\env.cc",
        "bytes": 84987,
        "sha256": "081F46DB425F5FEA9095F68E25D6C9BC89CF16BB800872A65A3D04C62FEDB4A9"
