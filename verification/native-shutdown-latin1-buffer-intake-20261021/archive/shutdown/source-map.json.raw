    {
      "id": "live_emit",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base-inl.h",
        "bytes": 5052,
        "sha256": "CE08E90A41BBFCA00996EB2CF14E228472246F0B8A91D91C17EC7D2F0D4BF2C6"
      },
      "start_line": 60,
      "end_line": 90,
      "excerpt_bytes": 918,
      "excerpt_sha256": "CDD6E123E03A2637FD47F0566D599FF9E409589A95080A81216C7D9C9E3CE4F1",
      "excerpt": "void StreamResource::PushStreamListener(StreamListener* listener) {\n  CHECK_NOT_NULL(listener);\n  CHECK_NULL(listener->stream_);\n\n  listener->previous_listener_ = listener_;\n  listener->stream_ = this;\n\n  listener_ = listener;\n}\n\nuv_buf_t StreamResource::EmitAlloc(size_t suggested_size) {\n  DebugSealHandleScope seal_handle_scope;\n  return listener_->OnStreamAlloc(suggested_size);\n}\n\nvoid StreamResource::EmitRead(ssize_t nread, const uv_buf_t& buf) {\n  DebugSealHandleScope seal_handle_scope;\n  if (nread > 0)\n    bytes_read_ += static_cast<uint64_t>(nread);\n  listener_->OnStreamRead(nread, buf);\n}\n\nvoid StreamResource::EmitAfterWrite(WriteWrap* w, int status) {\n  DebugSealHandleScope seal_handle_scope;\n  listener_->OnStreamAfterWrite(w, status);\n}\n\nvoid StreamResource::EmitAfterShutdown(ShutdownWrap* w, int status) {\n  DebugSealHandleScope seal_handle_scope;\n  listener_->OnStreamAfterShutdown(w, status);\n}\n",
      "production_basenames": [
        "native_node_stream_resource.zig"
      ],
      "source_mapping": "Emitter selects the current live listener head. Default listener forwards to its actual predecessor; no cached substitute chain."
    },
    {
      "id": "reporter_class",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base.h",
        "bytes": 18488,
        "sha256": "E89C31A78F138DEE6FBA5EBF9795BF3A59569D041B9955AE8183B09633103334"
      },
      "start_line": 184,
      "end_line": 201,
      "excerpt_bytes": 672,
      "excerpt_sha256": "1EA117E3D89E28CB19A43B067B479BC38C68F950332E90160FF7B11DC4A3B1B3",
      "excerpt": "// method of the JS objects associated with the wrap objects.\nclass ReportWritesToJSStreamListener : public StreamListener {\n public:\n  void OnStreamAfterWrite(WriteWrap* w, int status) override;\n  void OnStreamAfterShutdown(ShutdownWrap* w, int status) override;\n\n private:\n  void OnStreamAfterReqFinished(StreamReq* req_wrap, int status);\n};\n\n\n// A default emitter that just pushes data chunks as Buffer instances to\n// JS land via the handle\u2019s .ondata method.\nclass EmitToJSStreamListener : public ReportWritesToJSStreamListener {\n public:\n  uv_buf_t OnStreamAlloc(size_t suggested_size) override;\n  void OnStreamRead(ssize_t nread, const uv_buf_t& buf) override;\n};\n",
      "production_basenames": [
        "native_node_stream_shutdown.zig",
        "native_node_stream_base.zig"
      ],
      "source_mapping": "The real default EmitToJSStreamListener derives ReportWritesToJSStreamListener. Its shutdown callback therefore selects reporter semantics, not generic predecessor forwarding."
    },
    {
      "id": "reporter_body",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base.cc",
        "bytes": 28310,
        "sha256": "B5420659CB816F074F9A8C3A5D96C2FE52C90253A08392E5306B657512C2A9B4"
      },
      "start_line": 755,
      "end_line": 780,
      "excerpt_bytes": 917,
      "excerpt_sha256": "91DDBC7BEF7FDF3094B0ACD839EA00CD35E93FB0E96E2559981F82307A4CDAE6",
      "excerpt": "void ReportWritesToJSStreamListener::OnStreamAfterReqFinished(\n    StreamReq* req_wrap, int status) {\n  StreamBase* stream = static_cast<StreamBase*>(stream_);\n  Environment* env = stream->stream_env();\n  if (!env->can_call_into_js()) return;\n  AsyncWrap* async_wrap = req_wrap->GetAsyncWrap();\n  HandleScope handle_scope(env->isolate());\n  Context::Scope context_scope(env->context());\n  CHECK(!async_wrap->persistent().IsEmpty());\n  Local<Object> req_wrap_obj = async_wrap->object();\n\n  Local<Value> argv[] = {\n    Integer::New(env->isolate(), status),\n    stream->GetObject(),\n    Undefined(env->isolate())\n  };\n\n  const char* msg = stream->Error();\n  if (msg != nullptr) {\n    argv[2] = OneByteString(env->isolate(), msg);\n    stream->ClearError();\n  }\n\n  if (req_wrap_obj->Has(env->context(), env->oncomplete_string()).FromJust())\n    async_wrap->MakeCallback(env->oncomplete_string(), arraysize(argv), argv);\n}\n",
      "production_basenames": [
        "native_node_stream_shutdown.zig"
      ],
      "source_mapping": "Return immediately if JS disabled. Check persistent nonempty; arguments status, actual stream object, undefined; optional Latin-1 error then ClearError. Has.FromJust retains genuine terminal failure ownership; subsequent MakeCallback getter remains ordinary."
    },
    {
      "id": "reporter_shutdown",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\stream_base.cc",
        "bytes": 28310,
        "sha256": "B5420659CB816F074F9A8C3A5D96C2FE52C90253A08392E5306B657512C2A9B4"
      },
      "start_line": 787,
      "end_line": 795,
      "excerpt_bytes": 251,
      "excerpt_sha256": "9DEAB5E8DA8068B3124984D967FD17976AD2E2DF7B819A81EAA0CEDF2D88638B",
      "excerpt": "void ReportWritesToJSStreamListener::OnStreamAfterShutdown(\n    ShutdownWrap* req_wrap, int status) {\n  OnStreamAfterReqFinished(req_wrap, status);\n}\n\nvoid ShutdownWrap::OnDone(int status) {\n  stream()->EmitAfterShutdown(this, status);\n  Dispose();\n}\n",
      "production_basenames": [
        "native_node_stream_request.zig",
        "native_node_stream_shutdown.zig"
      ],
      "source_mapping": "OnStreamAfterShutdown delegates to shared reporter; Shutdown OnDone invokes stream listener and always follows the completed void callback with Dispose."
    },
    {
      "id": "listener_forward",
      "authority": {
