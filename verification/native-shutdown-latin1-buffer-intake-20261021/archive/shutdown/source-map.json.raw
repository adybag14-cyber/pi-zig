    {
      "id": "check_op_macro",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\v8-logging.h",
        "bytes": 21624,
        "sha256": "0FA464788992D2AB04B14F9A9B9B808E29759D111E867BABD69EAED03D931405"
      },
      "start_line": 144,
      "end_line": 180,
      "excerpt_bytes": 2203,
      "excerpt_sha256": "CAF8E86C2D8A82FA0D6147D12DDD9B3019A89D94970DC6F08A4A4980A71296CB",
      "excerpt": "// Helper macro for binary operators.\n// Don't use this macro directly in your code, use CHECK_EQ et al below.\n#define CHECK_OP(name, op, lhs, rhs)                                      \\\n  do {                                                                    \\\n    if (std::string* _msg = ::v8::base::Check##name##Impl<                \\\n            typename ::v8::base::pass_value_or_ref<decltype(lhs)>::type,  \\\n            typename ::v8::base::pass_value_or_ref<decltype(rhs)>::type>( \\\n            (lhs), (rhs), #lhs \" \" #op \" \" #rhs)) {                       \\\n      FATAL(\"Check failed: %s.\", _msg->c_str());                          \\\n      delete _msg;                                                        \\\n    }                                                                     \\\n  } while (false)\n\n#define DCHECK_OP(name, op, lhs, rhs)                                     \\\n  do {                                                                    \\\n    if (std::string* _msg = ::v8::base::Check##name##Impl<                \\\n            typename ::v8::base::pass_value_or_ref<decltype(lhs)>::type,  \\\n            typename ::v8::base::pass_value_or_ref<decltype(rhs)>::type>( \\\n            (lhs), (rhs), #lhs \" \" #op \" \" #rhs)) {                       \\\n      V8_Dcheck(__FILE__, __LINE__, _msg->c_str());                       \\\n      delete _msg;                                                        \\\n    }                                                                     \\\n  } while (false)\n\n#else\n\n// Make all CHECK functions discard their log strings to reduce code\n// bloat for official release builds.\n\n#define CHECK_OP(name, op, lhs, rhs)                                         \\\n  do {                                                                       \\\n    bool _cmp = ::v8::base::Cmp##name##Impl<                                 \\\n        typename ::v8::base::pass_value_or_ref<decltype(lhs)>::type,         \\\n        typename ::v8::base::pass_value_or_ref<decltype(rhs)>::type>((lhs),  \\\n                                                                     (rhs)); \\\n    CHECK_WITH_MSG(_cmp, #lhs \" \" #op \" \" #rhs);                             \\\n  } while (false)\n",
      "production_basenames": [
        "native_node_one_byte_string_diagnostics.cpp"
      ],
      "source_mapping": "Retain DEBUG CHECK_OP new string, Fatal and delete path; release uses comparison plus CHECK_WITH_MSG. Operands and strlen evaluate once."
    },
    {
      "id": "check_operand_stream",
      "authority": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\authority\\v8-logging.h",
