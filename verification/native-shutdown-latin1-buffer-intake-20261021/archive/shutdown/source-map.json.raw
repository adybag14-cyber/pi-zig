      "excerpt_sha256": "441E64C57F9C6825184EAC0633C40A826F72EEB13D6FA947FCCB7D3400D3DAC1",
      "excerpt": "#define NEW_STRING(v8_isolate, class_name, function_name, Char, data, type,   \\\n                   length)                                                    \\\n  MaybeLocal<String> result;                                                  \\\n  if (length == 0) {                                                          \\\n    result = String::Empty(v8_isolate);                                       \\\n  } else if (length > 0 &&                                                    \\\n             static_cast<uint32_t>(length) > i::String::kMaxLength) {         \\\n    result = MaybeLocal<String>();                                            \\\n  } else {                                                                    \\\n    i::Isolate* i_isolate = reinterpret_cast<internal::Isolate*>(v8_isolate); \\\n    ENTER_V8_NO_SCRIPT_NO_EXCEPTION(i_isolate);                               \\\n    API_RCS_SCOPE(i_isolate, class_name, function_name);                      \\\n    if (length < 0) length = StringLength(data);                              \\\n    i::DirectHandle<i::String> handle_result =                                \\\n        NewString(i_isolate->factory(), type,                                 \\\n                  base::Vector<const Char>(data, length))                     \\\n            .ToHandleChecked();                                               \\\n    result = Utils::ToLocal(handle_result);                                   \\\n  }\n",
      "production_basenames": [
