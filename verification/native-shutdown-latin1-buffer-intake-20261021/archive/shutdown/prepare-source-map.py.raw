ROWS=json.loads("[[\"request_fields\",\"stream_base.h\",33,90,[\"native_node_stream_request.zig\",\"native_node_async_wrap_state.zig\"],\"StreamReq owns a borrowed StreamBase pointer and an internal request slot independent from BaseObject; ShutdownWrap supplies OnDone.\"],[\"request_attach\",\"stream_base-inl.h\",14,32,[\"native_node_stream_request.zig\",\"native_node_async_wrap_state.zig\"],\"Attach the request slot before the OtherBase/AsyncWrap constructor. FromObject reads that slot independently. Genuine CHECK failure uses the existing Node assertion owner.\"],[\"request_dispose\",\"stream_base-inl.h\",34,48,[\"native_node_stream_request.zig\"],\"Acquire a temporary actual BaseObjectPtr, clear only the StreamReq slot, Detach, then release. Last release may destroy the request; no subsequent request dereference.\"],[\"request_reset\",\"stream_base-inl.h\",162,167,[\"native_node_async_wrap_state.zig\",\"native_node_async_wrap.zig\"],\"Fresh template construction clears the BaseObject slot then the StreamReq slot. Real branded native fields replace V8 internal fields without adding guest roots.\"],[\"shutdown_template\",\"stream_wrap.cc\",61,92,[\"native_node_async_wrap.zig\",\"native_node_async_wrap_state.zig\"],\"Actual constructor checks construct-call and resets fields; own oncomplete/callback/handle data fields are null in original order with default C/W/E attributes. Inherits the actual AsyncWrap template. This native template surface is not full FileHandle public publication.\"],[\"stream_shutdown\",\"stream_base.cc\",44,80,[\"native_node_stream_shutdown.zig\"],\"Missing input uses the stored actual InstanceTemplate. UV_EBUSY on failed ToLocal/Set; trigger scope encloses construction/DoShutdown/disposal/error handling; trigger restores before BaseObjectPtr release and local Scope disposal.\"],[\"trigger_scope\",\"env.cc\",264,285,[\"native_node_stream_shutdown.zig\"],\"Checks default trigger >= 0 when kCheck>0 (including NaN rejection), saves old trigger, installs the actual stream AsyncWrap ID, restores old trigger first on all completed paths.\"],[\"simple_constructor\",\"stream_base-inl.h\",97,109,[\"native_node_stream_shutdown.zig\",\"native_node_file_handle_shutdown.zig\",\"native_node_stream_base.zig\"],\"Base installs its real default listener. SimpleShutdown constructs StreamReq first, then actual OtherBase with PROVIDER_SHUTDOWNWRAP.\"],[\"simple_type\",\"stream_base.h\",436,455,[\"native_node_stream_shutdown.zig\",\"native_node_file_handle_shutdown.zig\"],\"Two concrete instantiations: default AsyncWrap and FileHandle ReqWrap<uv_fs_t>. No synthetic Promise/Global/Handle root is introduced.\"],[\"provider_number\",\"async_wrap.h\",34,88,[\"native_node_async_wrap_state.zig\"],\"Exact original macro order yields NONE=0 and SHUTDOWNWRAP=35; provider append does not renumber existing providers.\"],[\"default_simple\",\"stream_base.cc\",854,858,[\"native_node_stream_shutdown.zig\"],\"StreamBase default CreateShutdownWrap allocates genuine SimpleShutdownWrap<AsyncWrap> and makes it weak.\"],[\"request_done\",\"stream_base.cc\",868,883,[\"native_node_stream_request.zig\"],\"Optional error-string block owns its own HandleScope; ordinary Set IsNothing returns before OnDone. The native void OnDone continuation is preserved on completed operations.\"],[\"stream_default_get_object\",\"stream_base.cc\",492,494,[\"native_node_stream_base.zig\"],\"Default GetObject returns actual GetAsyncWrap()->object().\"],[\"stream_default_error\",\"stream_base.cc\",677,684,[\"native_node_stream_base.zig\"],\"Original default Error is null and ClearError has an empty body; these are source defaults, not placeholder host implementations.\"],[\"live_emit\",\"stream_base-inl.h\",60,90,[\"native_node_stream_resource.zig\"],\"Emitter selects the current live listener head. Default listener forwards to its actual predecessor; no cached substitute chain.\"],[\"reporter_class\",\"stream_base.h\",184,201,[\"native_node_stream_shutdown.zig\",\"native_node_stream_base.zig\"],\"The real default EmitToJSStreamListener derives ReportWritesToJSStreamListener. Its shutdown callback therefore selects reporter semantics, not generic predecessor forwarding.\"],[\"reporter_body\",\"stream_base.cc\",755,780,[\"native_node_stream_shutdown.zig\"],\"Return immediately if JS disabled. Check persistent nonempty; arguments status, actual stream object, undefined; optional Latin-1 error then ClearError. Has.FromJust retains genuine terminal failure ownership; subsequent MakeCallback getter remains ordinary.\"],[\"reporter_shutdown\",\"stream_base.cc\",787,795,[\"native_node_stream_request.zig\",\"native_node_stream_shutdown.zig\"],\"OnStreamAfterShutdown delegates to shared reporter; Shutdown OnDone invokes stream listener and always follows the completed void callback with Dispose.\"],[\"listener_forward\",\"stream_base.cc\",807,809,[\"native_node_stream_resource.zig\"],\"Base StreamListener checks non-null previous listener and forwards actual request/status. SDK's custom listener must select exported reporter callback where inherited from ReportWrites.\"],[\"callback_name_get\",\"async_wrap-inl.h\",72,84,[\"native_node_stream_shutdown.zig\"],\"Ordinary Get, then nonfunction => undefined without invocation or trace. Actual callable delegates to unchanged native_node_async_wrap_make_callback.zig 972B9D09 return-try owner.\"],[\"filehandle_shutdown\",\"node_file.cc\",668,696,[\"native_node_file_handle_shutdown.zig\",\"native_node_file_handle_owner.zig\"],\"FileHandleCloseWrap is SimpleShutdownWrap<ReqWrap<uv_fs_t>>. Closed/closing: Done(0), return1. Otherwise closing=true, CHECK fd!=-1, trace begin, real Dispatch uv_fs_close; original ignores negative dispatch result and returns0. Completion trace end, actual AfterClose, fresh result read, cleanup, Done.\"],[\"reqwrap_constructor\",\"req_wrap-inl.h\",17,39,[\"native_node_file_handle_shutdown.zig\"],\"Actual AsyncWrap then actual ReqWrapBase queue entry, MakeWeak and Reset. Original ReqWrap destructor is empty. Preallocated canonical C storage is a native layout prerequisite, not an invented async admission.\"],[\"reqwrap_wrapper\",\"req_wrap-inl.h\",120,139,[\"native_node_file_handle_shutdown.zig\"],\"Existing Controller/Entry owns real Wrapper: retain, Detach, decrease waiting, invoke original callback, then release pointer. Cleanup/OnDone occur while that native pointer remains alive.\"],[\"reqwrap_dispatch\",\"req_wrap-inl.h\",142,169,[\"native_node_file_handle_shutdown.zig\"],\"Existing real Dispatch owns original callback routing, actual admission, ClearWeak and waiting increment only if admission>=0. Shutdown does not replace this with a Promise or fake queue.\"],[\"onebyte_defaults\",\"util.h\",334,351,[\"native_node_one_byte_string.zig\"],\"Selected ordinary char/uint8 OneByteString has signed int length default -1 and NewStringType kNormal. Internalized mode is outside this selected wrapper.\"],[\"onebyte_wrapper\",\"util-inl.h\",161,184,[\"native_node_one_byte_string.zig\"],\"Ordinary OneByteString calls NewFromOneByte(...).ToLocalChecked; raw VM primitive is separate from V8 allocation and failure policy.\"],[\"empty_api_fatal\",\"v8-api.cc\",674,679,[\"native_node_one_byte_string.zig\",\"native_node_stream_shutdown.zig\"],\"ToLocalEmpty exact location v8::ToLocalChecked/message Empty MaybeLocal; Has.FromJust selects FromJustIsNothing exact Maybe value is Nothing. Existing actual Node/V8 failure owner is retained.\"],[\"cstring_length\",\"v8-api.cc\",7535,7542,[\"native_node_one_byte_string_diagnostics.cpp\",\"native_node_one_byte_string.zig\"],\"Negative signed length invokes genuine strlen once and original CHECK_GE(kMaxInt,len) before narrowing to int. Explicit nonnegative lengths do not scan for NUL.\"],[\"newstring_normal\",\"v8-api.cc\",7553,7569,[\"native_node_one_byte_string.zig\"],\"Selected kNormal forwards one-byte vector to NewStringFromOneByte; no UTF-8 interpretation and no internalized-string claim.\"],[\"newstring_api_policy\",\"v8-api.cc\",7587,7605,[\"native_node_one_byte_string.zig\"],\"Length0 returns empty. Explicit positive over max returns empty Maybe before ENTER_V8. Negative computes strlen inside scope, then internal MaybeHandle::ToHandleChecked; these are different failure paths.\"],[\"newfromonebyte\",\"v8-api.cc\",7627,7631,[\"native_node_one_byte_string.zig\"],\"The original uint8_t entry uses NEW_STRING and returns its result; selected port preserves signed length decisions and byte interpretation.\"],[\"max_length\",\"v8-v8-primitive.h\",121,130,[\"native_node_one_byte_string.zig\"],\"Pinned max-length selection is (1<<28)-16 for 32-bit pointers and (1<<29)-24 for 64-bit pointers. Network build target admission remains separate.\"],[\"raw_allocation_policy\",\"v8-factory-base.cc\",809,839,[\"native_node_one_byte_string.zig\"],\"V8 invalid length throws RangeError and returns an empty MaybeHandle before raw allocation. Actual heap retry/GC/layout is not claimed reproduced by a QuickJS raw allocator.\"],[\"normal_length_specials\",\"v8-factory-base.cc\",982,1001,[\"native_node_one_byte_string.zig\"],\"Length0 uses empty_string; length1 uses LookupSingleCharacterStringFromCode; other lengths use raw allocation/copy. Raw VM primitive does not implement V8 single-character caching/heap machinery.\"],[\"internal_maybe_check\",\"v8-maybe-handles.h\",52,57,[\"native_node_one_byte_string_diagnostics.cpp\",\"native_node_one_byte_string.zig\"],\"Internal ToHandleChecked calls MaybeHandle::Check, CHECK_NOT_NULL(location_), distinct from external ToLocalChecked fatal.\"],[\"check_stream\",\"v8-logging.h\",76,79,[\"native_node_one_byte_string_diagnostics.cpp\"],\"DEBUG formatting uses the actual std::ostringstream-derived CheckMessageStream.\"],[\"check_op_macro\",\"v8-logging.h\",144,180,[\"native_node_one_byte_string_diagnostics.cpp\"],\"Retain DEBUG CHECK_OP new string, Fatal and delete path; release uses comparison plus CHECK_WITH_MSG. Operands and strlen evaluate once.\"],[\"check_operand_stream\",\"v8-logging.h\",186,192,[\"native_node_one_byte_string_diagnostics.cpp\"],\"Selected int and size_t operands are ordinary streamable integral types; the finite helper selects the same real stream operation.\"],[\"check_operand_constraint\",\"v8-logging.h\",216,223,[\"native_node_one_byte_string_diagnostics.cpp\"],\"The original streamable overload applies to selected int/size_t; enum/character/unprintable overloads are outside this finite instantiation.\"],[\"check_message\",\"v8-logging.h\",296,314,[\"native_node_one_byte_string_diagnostics.cpp\"],\"Actual native std::string construction retains 50-character inline threshold and multiline alternative; no formatted host surrogate.\"],[\"check_operators\",\"v8-logging.h\",445,452,[\"native_node_one_byte_string_diagnostics.cpp\"],\"CHECK_GE maps to integral safe comparison, CHECK_NOT_NULL expands to (location_) != nullptr. Release expression spelling and DEBUG file/line are pinned.\"],[\"v8_set_policy\",\"v8-api.cc\",4323,4336,[\"native_node_stream_request.zig\"],\"Original Object::Set uses kDontThrow: false is not empty Maybe. Actual setter/proxy exception is preserved; nonwritable data false result continues.\"],[\"v8_has_policy\",\"v8-api.cc\",4895,4914,[\"native_node_stream_shutdown.zig\"],\"Has is an actual potentially throwing ordinary operation; the reporter's FromJust remains terminal on empty, not truthy coercion or caught false.\"]]")
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def pin(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
def write_new(p,obj):
 assert not p.exists(),str(p)
 p.write_bytes((json.dumps(obj,indent=2,ensure_ascii=True)+'\n').encode())
authorities={}
for p in sorted((P/'authority').iterdir()):
 if p.is_file() and p.suffix not in ['.json']:
  authorities[p.name]=pin(p)
sources=[]
for sub in ['production','controls','shared/projected']:
 for p in sorted((P/sub).rglob('*')):
  if p.is_file():sources.append({'relative_path':p.relative_to(P/sub).as_posix(),'snapshot':pin(p)})
excerpts=[]
for identity,name,start,end,targets,claim in ROWS:
 p=P/'authority'/name
 lines=p.read_bytes().splitlines(keepends=True)
 assert 1<=start<=end<=len(lines),(name,start,end,len(lines))
 raw=b''.join(lines[start-1:end])
 excerpts.append({'id':identity,'authority':authorities[name],'start_line':start,'end_line':end,
 'excerpt_bytes':len(raw),'excerpt_sha256':sha(raw),'excerpt':raw.decode('utf-8'),
 'production_basenames':targets,'source_mapping':claim})
m={
