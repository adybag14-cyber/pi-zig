 'authorities':list(authorities.values()),'selected_source_snapshots':sources,'excerpts':excerpts,
 'native_ownership':{
  'request':'Independent actual StreamReq pointer plus actual AsyncWrap state; no new JS-visible pointer property. Request slot attach precedes native AsyncWrap constructor and init hook.',
  'simple':'Default SimpleShutdownWrap owns only its own actual state; FileHandle variant also owns canonical uv_fs_t native storage and real Entry. Stream pointer is borrowed; it does not retain a FileHandle Global or manufacture a Promise.',
  'dispatch':'Actual Controller.dispatchRawClose + existing real Wrapper; waiting admission and retirement remain owned by existing ReqWrap machinery. No read of completion-only info before completion.',
  'callback':'Trace end sees real completed request. AfterClose may run ordinary JS read callback. An ordinary pending exception does not skip the following result read/cleanup/Done native continuation. Terminal port boundary performs only native retirement, not synthetic guest success.',
  'scope_order':'Each port Scope owns real VM values/exception occurrence. Restore default trigger, release outer native request pointer, retire locals in source destructor order. The enclosing callback Wrapper remains alive through OnDone and Dispose.',
  'field_lifetime':'RequestFields retain Registry only; they mark actual State if present and contain no JS values. Original null own properties are native template allocations. Cached error/oncomplete keys and template owner are borrowed actual Environment assembly inputs.',
  'reporter_reuse':'native_node_stream_shutdown.reportAfterRequest / reportAfterShutdown are the concrete ReportWritesToJSStreamListener operations. Generic StreamListener forwarding stays separate.'},
 'latin1_policy':{
  'raw_vm_primitive':'JS_PiNewStringLatin1 uses original QuickJS private js_new_string8_len and preserves each uint8 as a one-byte code unit. It does not call UTF-8 JS_NewStringLen. Explicit length preserves embedded NUL; strlen branch stops at first NUL.',
  'zero_length':'No data dereference; actual VM empty string.',
  'explicit_over_max':'Original API empty Maybe reaches exact ToLocalChecked fatal through existing failure owner.',
  'inferred_length':'Real native strlen followed by genuine V8 CHECK_GE(kMaxInt,len). Factory-invalid max path selects actual RangeError then internal MaybeHandle CHECK_NOT_NULL.',
  'allocation_failure':'Actual VM allocation/real native OOM occurrence is detected at the operation boundary and forwarded to existing native heap failure owner. No synthetic OOM string or exception substitution.',
  'not_implemented_by_raw_primitive':['V8 single-character string cache','V8 heap object layout','V8 GC/retry allocator machinery','internalized NewFromOneByte mode'],
  'two_abi_entries':'Both direct native wrappers declare borrowed DiagnosticContextScope first and never queue its JSContext pointer.',
  'macro_selection':'Chosen gnu++20 recipe does not define DEBUG/OFFICIAL_BUILD. DEBUG preserves file/line and original stream/new/delete diagnostic formatting; nonDEBUG expression only; official release uses genuine immediate crash. Native configuration/target qualification is separate.',
  'fatal_prerequisite':'Already reviewed immutable native_v8_base_fatal owner commit5059d6a. Default callbacks/hook installation are not claimed here.'},
 'controls':{
  'shutdown':18,'latin1':8,'future_actual_metadata':None,
  'fixture':'A stack-local Fixture has a stable address for its lifetime and owns an unchanged underlying real FileHandle fixture. Uses real VM/native queue/physical descriptors. Trace callbacks are explicitly labeled observers, not production bootstrap policies.',
  'descriptor_policy':'Physical fixture descriptors >2 avoid Windows deliberately skipping CRT close for fd<=2. The actual production descriptor policy is unchanged.',
  'fatal_controls':'No native-fatal subprocess is launched. Fatal length/OOM behavior is source-bound only; ordinary byte/NUL/control branches use real VM source controls.'},
 'limits':[
  'No compiler, preprocessor, native runtime, Node reference runtime, or generator execution.',
  'No Main edits, build authorization, default wiring or runtime/platform qualification.',
  'Complete StreamBase AddMethods/public FileHandle template and worker broker remain separately owned and unassembled.',
  'Genuine process FS trace owner, cached key/template bootstrap lifetime, and production hook policy are required inputs, never replaced by the labeled control observers.',
  'MemoryRetainer virtual assembly and full public JS entry publication remain outside this finite native shutdown slice.',
  'The complete constructor/error predecessor and historical runtime negatives remain immutable.'
 ]}
