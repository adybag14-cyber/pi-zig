 'original_source_map':pin(P/'source-map.json'),'successor':pin(P/'successor/proposal.json'),
 'selected_c':pin(selected),'unchanged_other_shared_files':6,'new_owners_controls_build_unchanged':True,
 'private_vm_authority':'Accepted constructor/Error QuickJS C5C746837, not an invented generic bridge. Private helpers are byte-identical in selected C.',
 'bindings':[
