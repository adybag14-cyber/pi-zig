P=pathlib.Path(r'C:\Users\adyba\pi-zig\worktrees\modules-io-resume-20261018\verification\native-node-shutdown-wrap-sourceonly-20261020')
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def pin(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
def excerpt(path,needle,span):
 raw=path.read_bytes();lines=raw.splitlines(keepends=True)
 indices=[i for i,l in enumerate(lines) if needle.encode() in l]
 assert len(indices)==1,(needle,indices)
 lo=indices[0];out=b''.join(lines[lo:lo+span])
 return {'file':pin(path),'start_line':lo+1,'end_line':lo+span,'bytes':len(out),'sha256':sha(out),'text':out.decode('utf-8')}
original=P/'shared/original/vendor/quickjs/quickjs.c'
