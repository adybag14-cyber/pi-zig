 {'original':'js_new_string8_len(ctx, buf, (int)len)','selected':'js_new_string8_len(ctx, (const char *)buf, (int)len)','reason':'Explicit byte-pointer interpretation required by private const char* signature. Guarded int cast unchanged; helper copies original bytes.'}],
 'qualification':False,'compiler_native_execution':False,'Main_changed':False}
p=P/'source-map-successor.json';assert not p.exists();p.write_bytes((json.dumps(m,indent=2)+'\n').encode());print(json.dumps(pin(p)))
