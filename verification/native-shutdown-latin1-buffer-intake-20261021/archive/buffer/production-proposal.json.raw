  "declared_control_names": [
    "VM view data every typed-array width and DataView expose the physical backing offset",
    "VM view data live empty views retain their exact end pointer",
    "VM view data bypasses getters and rejects forged live and revoked proxy brands",
    "VM view data detached typed and DataView addresses are null while lease acquisition still throws",
    "VM view data fixed resizable views preserve stored offsets while out of bounds and after regrowth",
    "VM view data tracking resizable views keep the address independently of rounded usable length",
    "VM view data shared aliases expose one native address across real runtime growth",
    "VM view data allocates nothing under the actual VM memory limit",
    "VM view data preserves actual ordinary uncatchable and private termination completions",
    "VM view data borrows without keeping the actual view or native backing alive",
    "VM view data observes unmanaged external storage without adding a lease or changing cleanup",
    "VM view data follows real ArrayBuffer transfer detachment and the receiving physical storage"
  ],
  "future_accepted_actual_metadata": null,
  "runtime_cohort_selected": false,
  "contract": {
    "actual_brand": "initialized native TypedArray or DataView; no Proxy or forged properties",
    "result": "current backing address plus stored byte offset; detached/invalid/incomplete views return NULL",
    "borrow": "synchronous VM owner-thread borrow; caller retains actual view/storage lifetime",
    "length": "usable length is separate; nonzero stored offset can remain when a resizable view is out of bounds",
    "no_entitlement": "no new JS root/native reference/lease, no allocation, no getter, no current completion change",
    "invalidations": "detach, transfer, collection, owner retirement or external resize/reallocation can invalidate a previous borrow; never dereference outside independently checked extent"
  },
  "remaining_original_policy_and_assembly": [
    "Node Buffer::Data performs the actual ArrayBufferView brand CHECK before the address operation; raw NULL is not that fatal policy.",
    "V8 JSTypedArray::GetBuffer can allocate, copy and attach backing storage for on-heap elements and fatal on allocation failure; this lower-level primitive does not implement that complete policy. Actual QuickJS view constructors already create or retain real backing.",
    "Actual CustomBufferJSListener ownership, ReportWrites inheritance, StreamBase/FileHandle method publication, FunctionTemplate identity/receiver signature, liveness and argument admission remain separate work.",
    "Complete FileHandle template/bootstrap, production trace/hook policy, worker assembly and native qualification remain open.",
    "Inherited standard/toolchain angle headers and shared ICU/YAML/SQLite/photon/network/package build graphs are not newly qualified by this bounded quoted-include inventory."
  ],
