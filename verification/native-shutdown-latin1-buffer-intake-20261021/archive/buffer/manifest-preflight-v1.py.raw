from pathlib import Path
import json,hashlib
P=Path(r'C:\Users\adyba\pi-zig\worktrees\sdk-owners-resume-20261018\verification\native-node-custom-buffer-sourceonly-20261020')
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def pin(p):
 p=Path(p);b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
def read(n):return json.loads((P/n).read_text(encoding='utf-8'))
def checked(x):
 p=Path(x['path']);b=p.read_bytes();assert len(b)==x['bytes'] and sha(b)==x['sha256'];return b
vm=read('vm/proposal.json');control=read('controls/binding.json');build=read('build/proposal.json');latin=read('vm/latin1-successor-composition.json');bc=read('build/shutdown-composition.json');proof=read('source-only-checks.json');closure=read('closure-and-preservation.json')
