plicit_supplemental_archive_rows\"];assert len(supp)==7\narchives=plan[\"archive_rows\"]+supp;sources=plan[\"source_rows\"]\nfor r in sources:ck(r[\"donor\"])\nfor r in archives:\n b=ck(r[\"donor\"]);assert r[\"relative_path\"].endswith(\".raw\") and r[\"preimage\"] is None\n for a in r[\"logical_donors\"]:assert ck(a[\"donor\"])==b\nassert len(plan[\"archive_rows\"])==302 and sum(len(r[\"logical_donors\"])for r in plan[\"archive_rows\"])==329\nassert len(archives)==309 and sum(len(r[\"logical_donors\"])for r in archives)==336\npaths=[r[\"relative_path\"]for r in sources+archives]+[plan[\"manifest_target\"]];assert len(paths)==331\nseen={};prefixes={}\nfor p in paths:\n assert p.isascii() and not p.startswith((\"/\",\"\\\\\")) and \"\\\\\"not in p and \":\"not in p\n parts=p.split(\"/\")\n for q in parts:assert q not in (\"\",\".\",\"..\")and not q.endswith((\".\",\" \"))and q.casefold()not in (\".git\",\".gitattributes\")and not re.fullmatch(r\"(?i)(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\..*)?\",q)\n assert p.casefold()not in seen;seen[p.casefold()]=p\n for i in range(1,len(parts)+1):\n  q=\"/\".join(parts[:i]);assert q.casefold()not in prefixes or prefixes[q.casefold()]==q;prefixes[q.casefold()]=q\nassert not any(\"/\".join(p.split(\"/\")[:i]).casefold()in seen for p in paths for i in range(1,len(p.split(\"/\"))))\ntree=subprocess.check_output([\"git\",\"--no-optional-locks\",\"ls-tree\",\"-rz\",H],cwd=W);tracked={}\nfor line in tree.split(b\"\\0\"):\n if line:\n  meta,p=line.split(b\"\\t\",1);mode,typ,oid=meta.decode().split();tracked[p.decode()]=dict(mode=mode,type=typ,oid=oid)\npreimages=[]\nfor r in sources:\n if r[\"preimage\"]:\n  b=ck(r[\"preimage\"]);g=subprocess.check_output([\"git\",\"--no-optional-locks\",\"cat-file\",\"blob\",H+\":\"+r[\"relative_path\"]],cwd=W)\n  assert b==g and tracked[r[\"relative_path\"]][\"mode\"]==\"100644\";preimages.append(r[\"relative_path\"])\n else:assert r[\"relative_path\"]not in tracked\nassert len(preimages)==9\nassert all(r[\"relative_path\"]not in tracked for r in archives)and plan[\"manifest_target\"]not in tracked\nfor packet in plan[\"coverage\"][\"new_sealed_packet_inventories\"]:\n root=Path(packet[\"directory\"]);actual=sorted(p.relative_to(root).as_posix()for p in root.rglob(\"*\")if p.is_file())\n assert actual==sorted(r[\"relative_path\"]for r in packet[\"rows\"]),str(root)\n for r in packet[\"rows\"]:ck(r)\nassert plan[\"actual_released_head\"] is None and not any(plan[\"authority\"].values())\nassert handoff[\"final_manifest_issued\"] is False and handoff[\"native_execution_authorized\"] is False\nprint(json.dumps(dict(status=\"Root independent static21plan replay passed\",finite_operations=111,full_forward_and_raw_inverse=True,core_source_rows=21,core_archive_rows=302,old223_physical_and248_logical_archives_retained=True,other19_sources_exact=True,all329_proof_input_versions_rehashed=True,all331_planned_paths_prefix_checked=True,nine_immutable_preimages=preimages,distinct_current_pins=len(pins),source_rows=[dict(target=r[\"relative_path\"],donor=r[\"donor\"],replacement=bool(r[\"preimage\"]))for r in sources],selected_control_fields={k:plan[k]for k in [\"status\",\"actual_released_head\",\"authority\",\"counts\",\"source_order_and_scope\",\"future_admission_requirements\",\"git_byte_preflight\",\"selected_adapter_contract\"]},operation_paths=[dict(op=o[\"op\"],path=o[\"path\"],index=o.get(\"index\"))for o in adapt[\"operations\"]],candidate_or_prefix_executed=False)))\n",
