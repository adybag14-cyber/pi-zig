  "original_inspector_source": "from pathlib import Path\nimport hashlib,json,copy,subprocess,re\nB=Path(r\"C:\\Users\\adyba\\pi-zig\");E=B/\"evidence\";W=B/\"worktrees/modules-io-resume-20261018\"\nD=W/\"verification/unissued-shutdown-latin1-buffer-fs-fixture21-copy-plan-sourceonly-20261022\";OLD=E/\"unissued-shutdown-latin1-buffer-union014-intake-plan-20261021\"\nH=\"014062f2d139254acab4b985b4ae343db637166f\";data={};pins={}\ndef sha(b):return hashlib.sha256(b).hexdigest().upper()\ndef read(p,n=None,h=None):\n p=Path(p);k=str(p).casefold()\n if k not in data:data[k]=p.read_bytes()\n b=data[k];assert n is None or len(b)==n,(p,len(b),n);assert h is None or sha(b)==h,(p,sha(b),h)\n pins[k]=dict(path=str(p),bytes=len(b),sha256=sha(b));return b\ndef ck(r):return read(r[\"path\"],r[\"bytes\"],r[\"sha256\"])\ndef js(p,n,h):return json.loads(read(p,n,h))\ndef wire(v):return (json.dumps(v,indent=2)+\"\\n\").encode()\nplan=js(D/\"copy-manifest-plan.json\",530121,\"B49017419D95CAF225BF4660E1341380B2A9DF8C24C568BDE82465908A1E28DC\")\nold=js(OLD/\"copy-manifest-plan.json\",378545,\"E2B029B3F00709B40FD82233194961CDEFE0E7949931EEE15C39D757EB6B4B74\")\nadapt=js(D/\"finite-plan-adaptation.json\",178617,\"F82B79EF2026464D7171FD02D4A88E313C34757AD819349653ABAC451AECDB52\")\nproof=js(D/\"source-proof.json\",170872,\"71458C161214F8C3F5F9F9A60F436EB569FB22E9B81EBD3B2488D342430FF824\")\nhandoff=js(D/\"handoff.json\",20300,\"922C5187B64C7F9B9E565B532D8879DF7155C0B686CBEBBCA36570D12545984A\")\nread(D/\"source-plan-author.py\",21918,\"24087B0D29B0636D35A19A2086977356B1676F0EF2726A816DE7EABF6EB160AF\")\nassert len(adapt[\"operations\"])==111 and ck(adapt[\"baseline\"])==read(OLD/\"copy-manifest-plan.json\") and ck(adapt[\"selected\"])==read(D/\"copy-manifest-plan.json\")\nfwd=copy.deepcopy(old)\nfor o in adapt[\"operations\"]:\n a=fwd\n if o[\"op\"]==\"append\":\n  for k in o[\"path\"]:a=a[k]\n  assert len(a)==o[\"index\"];a.append(copy.deepcopy(o[\"after\"]))\n else:\n  for k in o[\"path\"