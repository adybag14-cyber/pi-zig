explanations=[
 dict(topic="actual producer and caller lifetime",finding="The live Promise getter error is already preserved through Request.settle, AfterScope, ReqWrap retirement and UV event release. The old fixture then invokes successful outer callback cleanup after returning that typed failure; Completion treats the captured reason as diagnostic DATA and retires it.",evidence=["src/extensions/native_node_fs_request_promise.zig:184-234","src/extensions/native_node_fs_after_scope.zig:85-109","src/extensions/native_node_uv_service.zig:55-73","src/extensions/native_node_callback_scope.zig:773-790","src/extensions/native_sdk_owned_completion.zig:92-143,184-228"]),
 dict(topic="selected ownership",finding="Scope.init is inactive by value. start runs at the caller-stable address before the pump. On the explicit failure path, escaping moves captured ownership into Boundary.reason before outer cleanup. There is one outer deinit, then one finish; finish retires the scope and restores the selected reason through Engine capture. No duplicate or manual GetException/extra free is introduced.",evidence=["src/extensions/native_node_operation_scope.zig","src/extensions/native_node_commonjs_owned_boundary.zig"]),
 dict(topic="cleanup outcomes",finding="A body failure retains the first typed error. A cleanup failure is recorded if no earlier typed error exists; actual pending/fatal precedence stays with the unchanged Boundary implementation. Balanced start/finish preserves the invocation lifetime and diagnostics-suppression counter.",evidence=["selected pumpPending wrapper","Boundary.select,observe,escaping,finishRetired"]),
 dict(topic="bounded success and preservation",finding="All eight existing pump call sites are in seven controls; the one prior synchronous getter failure consumes its captured reason before calling pump. The 721-byte polling loop, deadlines, queue rejection, all25 named tests/assertions/imports and adjacent waitQueued remain byte-identical. The repair makes no general claim about unrelated incoming diagnostic history.",evidence=["all25 unchanged test section","all8 pump call sites"]),
