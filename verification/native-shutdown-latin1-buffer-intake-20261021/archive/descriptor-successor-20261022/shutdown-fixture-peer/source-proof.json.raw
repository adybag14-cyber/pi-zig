  "exact24_source_excerpts": [
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/fs.c",
      "first_line": 74,
      "last_line": 97,
      "bytes": 1705,
      "sha256": "98230F70A513B1700FA3E2927FADBB8B2F742D005CAA2AAA9A2A9A61E5F551EE",
      "text": "#define INIT(subtype)                                                         \\\n  do {                                                                        \\\n    if (req == NULL)                                                          \\\n      return UV_EINVAL;                                                       \\\n    uv__fs_req_init(loop, req, subtype, cb);                                  \\\n  }                                                                           \\\n  while (0)\n\n#define POST                                                                  \\\n  do {                                                                        \\\n    if (cb != NULL) {                                                         \\\n      uv__req_register(loop);                                                 \\\n      uv__work_submit(loop,                                                   \\\n                      &req->work_req,                                         \\\n                      UV__WORK_FAST_IO,                                       \\\n                      uv__fs_work,                                            \\\n                      uv__fs_done);                                           \\\n      return 0;                                                               \\\n    } else {                                                                  \\\n      uv__fs_work(&req->work_req);                                            \\\n      return req->result;                                                     \\\n    }                                                                         \\\n  }                                                                           \\\n  while (0)\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/fs.c",
      "first_line": 117,
      "last_line": 122,
      "bytes": 394,
      "sha256": "02F2A4176CF4D6FC04AA1FD6284975A305F89B182E0ACB68F54D27AE67A2EA8B",
      "text": "#define VERIFY_FD(fd, req)                                                  \\\n  if (fd == -1) {                                                           \\\n    req->result = UV_EBADF;                                                 \\\n    req->sys_errno_ = ERROR_INVALID_HANDLE;                                 \\\n    return;                                                                 \\\n  }\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/fs.c",
      "first_line": 397,
      "last_line": 410,
      "bytes": 360,
      "sha256": "8DCF1A52FE9D25FCD6364D601BB3C5CF0F8AE2B220B5C4EEA5C9735CE0988FA6",
      "text": "INLINE static void uv__fs_req_init(uv_loop_t* loop, uv_fs_t* req,\n    uv_fs_type fs_type, const uv_fs_cb cb) {\n  uv__once_init();\n  UV_REQ_INIT(req, UV_FS);\n  req->loop = loop;\n  req->flags = 0;\n  req->fs_type = fs_type;\n  req->sys_errno_ = 0;\n  req->result = 0;\n  req->ptr = NULL;\n  req->path = NULL;\n  req->cb = cb;\n  memset(&req->fs, 0, sizeof(req->fs));\n}\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/fs.c",
      "first_line": 668,
      "last_line": 695,
      "bytes": 590,
      "sha256": "36324C09E28C987C9414AFCE5558D245D34B607B7CD10F2F7A35541A4C358D08",
      "text": "void fs__close(uv_fs_t* req) {\n  int fd = req->file.fd;\n  int result;\n  struct uv__fd_info_s fd_info;\n\n  VERIFY_FD(fd, req);\n\n  if (uv__fd_hash_remove(fd, &fd_info)) {\n    if (fd_info.mapping != INVALID_HANDLE_VALUE) {\n      CloseHandle(fd_info.mapping);\n    }\n  }\n\n  if (fd > 2)\n    result = _close(fd);\n  else\n    result = 0;\n\n  /* _close doesn't set _doserrno on failure, but it does always set errno\n   * to EBADF on failure.\n   */\n  if (result == -1) {\n    assert(errno == EBADF);\n    SET_REQ_UV_ERROR(req, UV_EBADF, ERROR_INVALID_HANDLE);\n  } else {\n    SET_REQ_RESULT(req, 0);\n  }\n}\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/fs.c",
      "first_line": 3241,
      "last_line": 3245,
      "bytes": 126,
      "sha256": "689115A4D2A2CEF51FA528EFDBB2CC8807D6269B1907585D9242FE26B4437C67",
      "text": "int uv_fs_close(uv_loop_t* loop, uv_fs_t* req, uv_file fd, uv_fs_cb cb) {\n  INIT(UV_FS_CLOSE);\n  req->file.fd = fd;\n  POST;\n}\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/core.c",
      "first_line": 73,
      "last_line": 79,
      "bytes": 250,
      "sha256": "4A1C8585608BC880E93C9D95B873DF89717F4508583CABC52CD4BD3DC5B1F4D0",
      "text": "#if !defined(__MINGW32__) || __MSVCRT_VERSION__ >= 0x800\nstatic void uv__crt_invalid_parameter_handler(const wchar_t* expression,\n    const wchar_t* function, const wchar_t * file, unsigned int line,\n    uintptr_t reserved) {\n  /* No-op. */\n}\n#endif\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/core.c",
      "first_line": 179,
      "last_line": 198,
      "bytes": 847,
      "sha256": "4230B3E3BD2E581D7589C522862E3649EEAE0F15FE6D7ACCBC3AA42E4711FA03",
      "text": "static void uv__init(void) {\n  /* Tell Windows that we will handle critical errors. */\n  SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX |\n               SEM_NOOPENFILEERRORBOX);\n\n  /* Tell the CRT to not exit the application when an invalid parameter is\n   * passed. The main issue is that invalid FDs will trigger this behavior.\n   */\n#if !defined(__MINGW32__) || __MSVCRT_VERSION__ >= 0x800\n  _set_invalid_parameter_handler(uv__crt_invalid_parameter_handler);\n#endif\n\n  /* We also need to setup our debug report handler because some CRT\n   * functions (eg _get_osfhandle) raise an assert when called with invalid\n   * FDs even though they return the proper error code in the release build.\n   */\n#if defined(_DEBUG) && (defined(_MSC_VER) || defined(__MINGW64_VERSION_MAJOR))\n  _CrtSetReportHook(uv__crt_dbg_report_handler);\n#endif\n\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/core.c",
      "first_line": 227,
      "last_line": 238,
      "bytes": 360,
      "sha256": "7397D74DD27E0C5C4788BCCD5DAAD2D515DF602032C8F2B8C649D6FE4E3A83A2",
      "text": "int uv_loop_init(uv_loop_t* loop) {\n  uv__loop_internal_fields_t* lfields;\n  struct heap* timer_heap;\n  int err;\n\n  /* Initialize libuv itself first */\n  uv__once_init();\n\n  /* Create an I/O completion port */\n  loop->iocp = CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, 1);\n  if (loop->iocp == NULL)\n    return uv_translate_sys_error(GetLastError());\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:vendor/node-v24.13.0/uv/src/win/core.c",
      "first_line": 332,
      "last_line": 334,
      "bytes": 67,
      "sha256": "C50E47B545C4B3A230BB8A4777DC8EC375437F01E25E0020B2EA210EE1486E30",
      "text": "void uv__once_init(void) {\n  uv_once(&uv_init_guard_, uv__init);\n}\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:src/extensions/native_uv_tcp.c",
      "first_line": 676,
      "last_line": 697,
      "bytes": 1043,
      "sha256": "B13A6A5563D60059EA05999E7A399CDF110859D27AB374B7A7D79BC07072EB18",
      "text": "    int status = uv_mutex_init(&service->command_mutex);\n    if (status < 0) goto fail_service;\n    status = uv_cond_init(&service->command_condition);\n    if (status < 0) goto fail_command_mutex;\n    status = uv_mutex_init(&service->event_mutex);\n    if (status < 0) goto fail_condition;\n    status = uv_loop_init(&service->loop);\n    if (status < 0) goto fail_event_mutex;\n    status = uv_async_init(&service->loop, &service->command_async, pi_uv_command_ready);\n    if (status < 0) goto fail_loop;\n    service->command_async.data = service;\n    pi_uv_service_retain(service);\n    status = uv_thread_create(&service->thread, pi_uv_thread_main, service);\n    if (status < 0) {\n        /* No worker exists. Close only the already initialized native async. */\n        atomic_fetch_sub_explicit(&service->references, 1, memory_order_relaxed);\n        uv_close((uv_handle_t *)&service->command_async, NULL);\n        (void)uv_run(&service->loop, UV_RUN_DEFAULT);\n        goto fail_loop;\n    }\n    *result = service;\n    return pi_uv_result(0, 0);\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:tools/build_native_node_network.zig",
      "first_line": 9,
      "last_line": 29,
      "bytes": 1417,
      "sha256": "B624CF3DAB7FBCD70AFEF0FCAE3D232BBC28D22E6DAEE209617E33C4BE04D0AF",
      "text": "    const library = b.addLibrary(.{\n        .name = \"pi-node-network\",\n        .linkage = .static,\n        .root_module = b.createModule(.{ .target = target, .optimize = optimize, .link_libc = true, .link_libcpp = native_memory != null }),\n    });\n    const module = library.root_module;\n    module.addIncludePath(b.path(uv_root ++ \"/include\"));\n    module.addIncludePath(b.path(uv_root ++ \"/src\"));\n    module.addIncludePath(b.path(llhttp_root ++ \"/include\"));\n    module.addIncludePath(b.path(\"src/extensions\"));\n    module.addIncludePath(b.path(\"vendor/quickjs\"));\n    const flags: []const []const u8 = switch (target.result.os.tag) {\n        .windows => &.{ \"-std=gnu11\", \"-D_WIN32_WINNT=0x0602\", \"-D_GNU_SOURCE\", \"-fno-strict-aliasing\" },\n        .linux => &.{ \"-std=gnu11\", \"-D_GNU_SOURCE\", \"-D_LARGEFILE_SOURCE\", \"-D_FILE_OFFSET_BITS=64\", \"-fno-strict-aliasing\" },\n        else => std.debug.panic(\"The real Node TCP backend has no admitted source set for {s}\", .{@tagName(target.result.os.tag)}),\n    };\n    module.addCSourceFiles(.{ .root = b.path(uv_root), .files = &common_sources, .flags = flags });\n    switch (target.result.os.tag) {\n        .windows => {\n            module.addCSourceFiles(.{ .root = b.path(uv_root), .files = &windows_sources, .flags = flags });\n            inline for (.{ \"advapi32\", \"dbghelp\", \"ole32\", \"iphlpapi\", \"psapi\", \"shell32\", \"user32\", \"userenv\", \"uuid\", \"ws2_32\" }) |name|\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:tools/build_native_node_network.zig",
      "first_line": 83,
      "last_line": 90,
      "bytes": 575,
      "sha256": "7689005C0B811D6900C20285C6E866754CA94B41705176B4388912C739746112",
      "text": "const windows_sources = [_][]const u8{\n    \"src/win/async.c\", \"src/win/core.c\", \"src/win/detect-wakeup.c\", \"src/win/dl.c\",\n    \"src/win/error.c\", \"src/win/fs.c\", \"src/win/fs-event.c\", \"src/win/getaddrinfo.c\",\n    \"src/win/getnameinfo.c\", \"src/win/handle.c\", \"src/win/loop-watcher.c\", \"src/win/pipe.c\",\n    \"src/win/thread.c\", \"src/win/poll.c\", \"src/win/process.c\", \"src/win/process-stdio.c\",\n    \"src/win/signal.c\", \"src/win/snprintf.c\", \"src/win/stream.c\", \"src/win/tcp.c\",\n    \"src/win/tty.c\", \"src/win/udp.c\", \"src/win/util.c\", \"src/win/winapi.c\", \"src/win/winsock.c\",\n};\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v37-file-handle-runtime-fixtures-sourceonly-20261021\\authority\\windows-sdk-10.0.26100-ucrt-close.cpp",
      "first_line": 50,
      "last_line": 77,
      "bytes": 961,
      "sha256": "7035050B9FF621720805D9A2D0B9EB754BAFD8D9E61ADE88193DA5E6D38EAA65",
      "text": "// Closes the file associated with the given file handle.  On success, returns 0.\r\n// On failure, returns -1 and sets errno.\r\nextern \"C\" int __cdecl _close_internal(int const fh, __crt_cached_ptd_host& ptd)\r\n{\r\n    _UCRT_CHECK_FH_CLEAR_OSSERR_RETURN(ptd, fh, EBADF, -1);\r\n    _UCRT_VALIDATE_CLEAR_OSSERR_RETURN(ptd, (fh >= 0 && (unsigned)fh < (unsigned)_nhandle), EBADF, -1);\r\n    _UCRT_VALIDATE_CLEAR_OSSERR_RETURN(ptd, (_osfile(fh) & FOPEN), EBADF, -1);\r\n\r\n    return __acrt_lowio_lock_fh_and_call(fh, [&]()\r\n    {\r\n        if (_osfile(fh) & FOPEN)\r\n        {\r\n            return _close_nolock_internal(fh, ptd);\r\n        }\r\n        else\r\n        {\r\n            ptd.get_errno().set(EBADF);\r\n            _ASSERTE((\"Invalid file descriptor. File possibly closed by a different thread\",0));\r\n            return -1;\r\n        }\r\n    });\r\n}\r\n\r\nextern \"C\" int __cdecl _close(int const fh)\r\n{\r\n    __crt_cached_ptd_host ptd;\r\n    return _close_internal(fh, ptd);\r\n}\r\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v37-file-handle-runtime-fixtures-sourceonly-20261021\\authority\\windows-sdk-10.0.26100-corecrt-internal-lowio.h",
      "first_line": 110,
      "last_line": 129,
      "bytes": 743,
      "sha256": "99DDFEFD7ED34A1A02EC500568DCEDD63A37A4D068B5212E56516CE1D0B6CD86",
      "text": "// The log-base-2 of the number of elements in each array of lowio file objects\r\n#define IOINFO_L2E          6\r\n\r\n// The number of elements in each array of lowio file objects\r\n#define IOINFO_ARRAY_ELTS   (1 << IOINFO_L2E)\r\n\r\n// The hard maximum number of arrays of lowio file objects that may be allocated\r\n#define IOINFO_ARRAYS       128\r\n\r\n// The maximum number of lowio file objects that may be allocated at any one time\r\n#define _NHANDLE_           (IOINFO_ARRAYS * IOINFO_ARRAY_ELTS)\r\n\r\n\r\n\r\n#define STDIO_HANDLES_COUNT       3\r\n/*\r\n * Access macros for getting at an __crt_lowio_handle_data struct and its fields from a\r\n * file handle\r\n */\r\n#define _pioinfo(i)          (__pioinfo[(i) >> IOINFO_L2E] + ((i) & (IOINFO_ARRAY_ELTS - 1)))\r\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v37-file-handle-runtime-fixtures-sourceonly-20261021\\authority\\windows-sdk-10.0.26100-corecrt-internal-lowio.h",
      "first_line": 150,
      "last_line": 166,
      "bytes": 639,
      "sha256": "09F5329CA8053173D097D97C3C24B4FF8F4FA426C988379EF4BB2875479B5930",
      "text": "typedef __crt_lowio_handle_data* __crt_lowio_handle_data_array[IOINFO_ARRAYS];\r\n\r\n// Special, static lowio file object used only for more graceful handling\r\n// of a C file handle value of -1 (results from common errors at the stdio\r\n// level).\r\nextern __crt_lowio_handle_data __badioinfo;\r\n\r\n// The umask value\r\nextern int _umaskval;\r\n\r\n// Global array of pointers to the arrays of lowio file objects.\r\nextern __crt_lowio_handle_data_array __pioinfo;\r\n\r\n// The number of handles for which file objects have been allocated.  This\r\n// number is such that for any fh in [0, _nhandle), _pioinfo(fh) is well-\r\n// formed.\r\nextern int _nhandle;\r\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v37-file-handle-runtime-fixtures-sourceonly-20261021\\authority\\windows-sdk-10.0.26100-ucrt-invalid-parameter.cpp",
      "first_line": 99,
      "last_line": 114,
      "bytes": 595,
      "sha256": "628D5B5C28447B07928433A3C1B484186E0DD0052FCEBE62A0310823D7D8E137",
      "text": "    __acrt_ptd * const raw_ptd = ptd.get_raw_ptd_noexit();\r\n    if (raw_ptd && raw_ptd->_thread_local_iph)\r\n    {\r\n        raw_ptd->_thread_local_iph(expression, function_name, file_name, line_number, reserved);\r\n        return;\r\n    }\r\n\r\n    _invalid_parameter_handler const global_handler = __crt_fast_decode_pointer(__acrt_invalid_parameter_handler.value(ptd));\r\n    if (global_handler)\r\n    {\r\n        global_handler(expression, function_name, file_name, line_number, reserved);\r\n        return;\r\n    }\r\n\r\n    _invoke_watson(expression, function_name, file_name, line_number, reserved);\r\n}\r\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\toolchain\\zig-x86_64-windows-0.16.0\\lib\\libc\\include\\any-windows-any\\_mingw.h",
      "first_line": 229,
      "last_line": 247,
      "bytes": 537,
      "sha256": "A3528E66941A02FF45DADBFF1085E5A264E6E2F97E10045ABD86A48A9DCF2388",
      "text": "#ifndef __MSVCRT_VERSION__\n/*  High byte is the major version, low byte is the minor. */\n# if defined(__CRTDLL__)\n#  define __MSVCRT_VERSION__ 0x00\n# elif defined(_UCRT)\n#  define __MSVCRT_VERSION__ 0xE00\n# else\n#  define __MSVCRT_VERSION__ 0xE00\n# endif\n#endif\n\n#if !defined(__CRTDLL__) && __MSVCRT_VERSION__ == 0x00\n#define __CRTDLL__\n#endif\n\n#if !defined(_UCRT) && ((__MSVCRT_VERSION__ >= 0x1400) || (__MSVCRT_VERSION__ >= 0xE00 && __MSVCRT_VERSION__ < 0x1000))\n/* Allow both 0x1400 and 0xE00 to identify UCRT */\n#define _UCRT\n#endif\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\controls\\src\\native_node_stream_shutdown_test.zig",
      "first_line": 33,
      "last_line": 40,
      "bytes": 318,
      "sha256": "660F11FA1F26B2CB0E5CDA919BEF0657FA220A253B66A9672A085AD8F9F4112E",
      "text": "}\nfn ordinaryFile(f: *Fixture, file: *File) !*t.Handle {\n    try file.init();\n    // The selected ordinary descriptor must not be a Windows CRT std handle:\n    // libuv intentionally treats fd <= 2 differently from an ordinary file.\n    try std.testing.expect(file.descriptor > 2);\n    return f.create(file.take());\n}\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\controls\\src\\native_node_stream_shutdown_test.zig",
      "first_line": 103,
      "last_line": 114,
      "bytes": 719,
      "sha256": "6FE1621595D77A25F96822131913E60A1B5B06F27E20E93657AB7213A3460D3F",
      "text": "test \"native Stream shutdown real accepted bad descriptor still performs AfterClose and reports negative status\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    const handle = try f.create(-2);\n    const wrapper = try f.request(); defer f.base.engine.freeValue(wrapper);\n    try f.publishRequest(wrapper);\n    try std.testing.expectEqual(@as(c_int, 0), try f.run(wrapper));\n    try f.base.pumpIo();\n    try std.testing.expectEqual(@as(c_int, t.uv.UV_EBADF), f.end_result);\n    try std.testing.expect(handle.read_state.closed and handle.read_state.fd == -1);\n    try f.base.expect(\"shutdownCalls.length===1 && shutdownCalls[0][1]<0 && shutdownCalls[0][4]===1\");\n    try f.expectRetired(wrapper);\n}\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-invalid-descriptor-successor-sourceonly-20261022\\projected\\src\\native_node_stream_shutdown_test.zig",
      "first_line": 103,
      "last_line": 114,
      "bytes": 739,
      "sha256": "90DB0148632D943F0823D0DF23ACB0B481BA1D42463923BA8360AA2EB52784B8",
      "text": "test \"native Stream shutdown real accepted bad descriptor still performs AfterClose and reports negative status\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    const handle = try f.create(std.math.maxInt(c_int));\n    const wrapper = try f.request(); defer f.base.engine.freeValue(wrapper);\n    try f.publishRequest(wrapper);\n    try std.testing.expectEqual(@as(c_int, 0), try f.run(wrapper));\n    try f.base.pumpIo();\n    try std.testing.expectEqual(@as(c_int, t.uv.UV_EBADF), f.end_result);\n    try std.testing.expect(handle.read_state.closed and handle.read_state.fd == -1);\n    try f.base.expect(\"shutdownCalls.length===1 && shutdownCalls[0][1]<0 && shutdownCalls[0][4]===1\");\n    try f.expectRetired(wrapper);\n}\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\controls\\src\\native_node_stream_shutdown_test_support.zig",
      "first_line": 56,
      "last_line": 75,
      "bytes": 1088,
      "sha256": "6F46AD47DD56A18162A739F03A79E5EF8E1DCA93E6BD79BCA196A50FB172516B",
      "text": "    pub fn create(self: *Fixture, descriptor: c_int) !*Handle {\n        const handle = try self.base.create(descriptor, null, null);\n        const bindings: streams.ShutdownBindings = .{\n            .template_owner = self.base.template_owner.?,\n            .error_string = self.error_key.?, .oncomplete_string = self.oncomplete_key.?,\n        };\n        handle.stream.operations.shutdown = bindings;\n        handle.stream_operations.shutdown = bindings;\n        handle.close_trace = .{ .raw = self, .begin_sync = beginSync,\n            .end_sync = endSync, .begin_async = beginAsync, .end_async = endAsync };\n        try self.base.expose(\"shutdownHandle\", self.base.primary_wrapper.?);\n        return handle;\n    }\n    pub fn createClosed(self: *Fixture) !*Handle {\n        const handle = try self.create(-1);\n        // Use the real release/AfterClose operation to produce closed_, rather\n        // than patching constructor fields or introducing a pretend descriptor.\n        try std.testing.expectEqual(@as(c_int, -1), try self.base.releaseDescriptor());\n        return handle;\n    }\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\production\\src\\extensions\\native_node_file_handle_shutdown.zig",
      "first_line": 135,
      "last_line": 161,
      "bytes": 1280,
      "sha256": "AA3A0EF8C01C88F390E209476F806DFCA43F2FB53597B95120050A0E16FD1B2B",
      "text": "        pub fn dispatch(s: *a.Scope, handle: *Handle,\n            request: *requests.Shutdown) anyerror!c_int\n        {\n            const state = handle.getReadState();\n            if (state.closing or state.closed) {\n                request.request.done(0, null) catch |err| {\n                    requests.recordFailure(s, err);\n                    if (err != error.JavaScriptException or s.boundary.isFatal()) return err;\n                };\n                return 1;\n            }\n            const self = fromShutdown(request);\n            state.closing = true;\n            if (state.fd == -1) check.assertion(s.engine, .{\n                .file_line = \"src/node_file.cc:681\",\n                .message = \"(fd_) != (-1)\",\n                .function = \"node::fs::FileHandle::DoShutdown\",\n            });\n            self.trace.begin_async(self.trace.raw, self);\n            // Source deliberately ignores an immediate negative Dispatch. It\n            // leaves closing_ and the real request alone, then returns zero.\n            _ = try handle.getReadInputs().controller.dispatchRawClose(s,\n                &self.entry, self.actual.?, state.fd, completed);\n            return 0;\n        }\n\n        fn completed(entry: *request_state.Entry, actual_raw: *anyopaque) anyerror!void {\n"
    },
    {
      "source": "014062f2d139254acab4b985b4ae343db637166f:src/native_node_file_handle_owner_test_support.zig",
      "first_line": 435,
      "last_line": 453,
      "bytes": 742,
      "sha256": "E41EFE080C8F0A25600EE925CF0657B6B1D3FCA876C455F80E6C4C6083B7F8BE",
      "text": "    pub fn releaseDescriptor(self: *Fixture) !c_int {\n        var result: c_int = undefined;\n        const ignored = try a.expression(self.engine, struct {\n            fn body(s: *a.Scope, f: *Fixture, output: *c_int) !c.JSValue {\n                output.* = try (try f.handle()).releaseDescriptor(s);\n                return c.pi_js_undefined();\n            }\n        }.body, .{ self, &result });\n        self.engine.freeValue(ignored);\n        return result;\n    }\n    pub fn collectHandle(self: *Fixture) void {\n        self.drop(&self.primary_wrapper);\n        c.JS_RunGC(self.engine.runtime);\n    }\n    pub fn dropBindingTarget(self: *Fixture) void {\n        self.drop(&self.binding_target);\n        c.JS_RunGC(self.engine.runtime);\n    }\n"
    },
    {
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\src\\extensions\\native_node_file_handle_owner.zig",
      "first_line": 314,
      "last_line": 332,
      "bytes": 719,
      "sha256": "36CAA080F95A093B894BB5AC3FE3EB225A070E1932380B4DF047B17CA6D4C42B",
      "text": "    pub fn releaseDescriptor(self: *Handle, s: *Scope) !c_int {\n        const descriptor = self.getFD();\n        self.afterClose() catch |err| {\n            record(s, err);\n            if (!canContinue(s, err)) return err;\n        };\n        return descriptor;\n    }\n};\n\nfn int32(s: *Scope, value: c.JSValue) !i32 {\n    if (!c.JS_IsNumber(value)) invalidDescriptor(s);\n    const number = try numberValue(s, value);\n    const negative_zero = number == 0 and (@as(u64, @bitCast(number)) >> 63) != 0;\n    if (!std.math.isFinite(number) or @trunc(number) != number or\n        number < std.math.minInt(i32) or number > std.math.maxInt(i32) or negative_zero)\n        invalidDescriptor(s);\n    return @intFromFloat(number);\n}\n"
    }
  ],
