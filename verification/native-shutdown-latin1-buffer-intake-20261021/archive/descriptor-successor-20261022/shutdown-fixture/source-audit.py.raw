result={"schema":1,"status":"exact_source_only_one_descriptor_successor_passed",
 "proposal":pin(D/"proposal.json"),"original":p["original_donor"],"candidate":p["candidate"],
 "raw_forward_and_entire_inverse_exact":True,"sole_changed_expression":{"line":105,"offset":i,"old":old.decode(),"new":new.decode()},
 "unchanged_prefix":{"bytes":i,"sha256":sha(a[:i])},"unchanged_suffix":{"bytes":len(a)-i-2,"sha256":sha(a[i+2:])},
 "all18_declarations_assertions_helpers_and_imports_unchanged":True,"new3_declared_controls":38,
 "remaining20_donor_pins_unchanged":True,"predecessor_plan_unchanged":p["predecessor_copy_plan"],
 "selected_call_chain":["Shutdown fixture.create forwards c_int unchanged","actual Handle.shutdown selects real ShutdownReq.dispatch",
 "closed/closing returns done(0) before fd CHECK or uv submission","open dispatch CHECK excludes only -1 then dispatchRawClose uses state.fd",
 "Windows uv INIT initializes once; fs__close sees INT_MAX>2 and calls selected CRT _close",
