tree=subprocess.check_output(['git','--no-optional-locks','-C',str(W),'ls-tree','-rz',H])
tracked={}
for item in tree.split(b'\0'):
 if item:
  meta,name=item.split(b'\t',1);mode,typ,oid=meta.decode().split();tracked[name.decode()]={'mode':mode,'type':typ,'oid':oid}
paths=[x['relative_path']for x in p['source_rows']+allarc]+[p['manifest_target']]
assert len(paths)==331
folded={};prefixes={}
for q in tracked:
 parts=q.split('/')
 for i in range(1,len(parts)+1):
  sub='/'.join(parts[:i]);k=sub.casefold();assert k not in prefixes or prefixes[k]==sub
  prefixes[k]=sub
for q in paths:
 assert q.isascii() and not q.startswith(('/','\\')) and not any(x in q for x in '\\:\0')
 parts=q.split('/')
 for x in parts:
  assert x not in ('','.','..') and not x.endswith(('.',' ')) and x.casefold()not in ('.git','.gitattributes')
  assert not re.fullmatch(r'(?i)(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\..*)?',x)
 assert q.casefold()not in folded;folded[q.casefold()]=q
 for i in range(1,len(parts)+1):
  sub='/'.join(parts[:i]);k=sub.casefold();assert k not in prefixes or prefixes[k]==sub,('prefix alias',sub,prefixes.get(k))
  prefixes[k]=sub
for q in paths:
 for i in range(1,len(q.split('/'))):
  parentq='/'.join(q.split('/')[:i]);assert parentq.casefold()not in folded and parentq not in tracked
replace=[x for x in p['source_rows']if x['preimage']];assert len(replace)==9
requests=''.join(H+':'+x['relative_path']+'\n'for x in replace).encode()
result=subprocess.check_output(['git','--no-optional-locks','-C',str(W),'cat-file','--batch'],input=requests)
pos=0;git=[]
for row in replace:
 end=result.index(b'\n',pos);oid,typ,n=result[pos:end].decode().split();n=int(n);pos=end+1;v=result[pos:pos+n];pos+=n
 assert result[pos:pos+1]==b'\n';pos+=1;assert typ=='blob' and raw(row['preimage']['path'])==v
 meta=tracked[row['relative_path']];assert meta=={'mode':'100644','type':'blob','oid':oid}
 assert hashlib.sha1(('blob '+str(n)+'\0').encode()+v).hexdigest()==oid
 git.append({'relative_path':row['relative_path'],**meta,'bytes':n,'sha256':sha(v)})
