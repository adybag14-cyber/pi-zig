H='014062f2d139254acab4b985b4ae343db637166f'
seen={};raws={};checks=[]
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def norm(p):return str(p).replace('/','\\').casefold()
def allowed(p):
 s=norm(p)
 return s.startswith(norm(E)+'\\') or (s.startswith(norm(B/'worktrees')+'\\') and '\\verification\\' in s) or s in {norm(B/'toolchain/zig-x86_64-windows-0.16.0/lib/std/Build.zig'),norm(B/'toolchain/zig-x86_64-windows-0.16.0/lib/std/Build/Module.zig')}
def raw(p):
 p=Path(p);assert allowed(p),('forbidden read',str(p))
 k=norm(p)
 if k not in raws:
  v=p.read_bytes();raws[k]=v;seen[k]={'path':str(p),'bytes':len(v),'sha256':sha(v)}
 return raws[k]
def pin(p,n=None,h=None):
 v=raw(p);r=seen[norm(p)]
 if n is not None:assert len(v)==n,(str(p),len(v),n)
 if h is not None:assert sha(v)==h,(str(p),sha(v),h)
 return dict(r)
def verify(r):
 assert {'path','bytes','sha256'}<=set(r),r
 return pin(r['path'],r['bytes'],r['sha256'])
def obj(r):verify(r);return json.loads(raw(r['path']))
def fixed(name,n,h):return {'path':str(D/name),'bytes':n,'sha256':h}
def wire(x):return (json.dumps(x,indent=2)+'\n').encode()
def at(t,path):
 for k in path:t=t[k]
 return t
def parent(t,path):return at(t,path[:-1]),path[-1]
def put(name,data):
 p=O/name;assert p.parent==O
 with p.open('xb')as f:f.write(data)
 assert p.read_bytes()==data
 return {'path':str(p),'bytes':len(data),'sha256':sha(data)}
PLAN=fixed('copy-manifest-plan.json',530121,'B49017419D95CAF225BF4660E1341380B2A9DF8C24C568BDE82465908A1E28DC')
FINITE=fixed('finite-plan-adaptation.json',178617,'F82B79EF2026464D7171FD02D4A88E313C34757AD819349653ABAC451AECDB52')
