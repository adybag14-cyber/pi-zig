  assert alias['logical_archive_relative_path'].startswith(p['archive_prefix']+'/archive/')
  if norm(z['path'])!=norm(d['path']):dedups.append({'physical':row['relative_path'],'donor':z,'logical_target':alias['logical_archive_relative_path']})
  for a in alias['historical_reference_aliases']:
   ref=a.get('reference',a.get('historical_pin'));assert (ref['bytes'],ref['sha256'])==(d['bytes'],d['sha256'])
   if 'immutable_snapshot'in a:assert a['immutable_snapshot']==z and a['exact_original_bytes'] is True
   historical.append({'physical':row['relative_path'],'reference':ref,'snapshot':z})
