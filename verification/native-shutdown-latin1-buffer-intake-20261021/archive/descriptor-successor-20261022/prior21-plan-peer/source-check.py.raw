 ['source_rows',16,'donor'],['source_rows'],['status'],['author'],['created_utc_date'],['predecessor_plan'],['predecessor_plan_handoff'],
 ['selected_linkage_Root_acceptance'],['selected_intake_adapter_Root_acceptance'],['fixture_correction_handoff'],['fixture_independent_peer'],
 ['fixture_Root_source_acceptance'],['source_order_and_scope','selected_build_sha256'],['source_order_and_scope','selected_build_successor'],
 ['source_order_and_scope','fixture_correction'],['source_order_and_scope','explicitly_excluded'],['deduplication','canonical_archive_target'],
 ['coverage','new_sealed_packet_inventories'],['coverage','new_Root_source_acceptance_count'],['coverage','fixture_independent_review_pending'],
 ['coverage','all_new_authoring_and_checker_negatives_retained'],['coverage','new_reference_sites_already_covered'],
 ['coverage','new_toolchain_snapshot_bindings'],['coverage','external_references_addendum'],['future_admission_requirements'],
 ['git_byte_preflight','scope'],['git_byte_preflight','preconditions'],['selected_adapter_contract'],['counts'],['preserved_predecessor_accounting']]
assert [x['path']for x in f['operations']if x['path'][0]!='archive_rows']==nonarchive
assert sum(x['path'][0]=='archive_rows'for x in f['operations'])==81
state=copy.deepcopy(b);steps=[]
for i,x in enumerate(f['operations']):
 before=sha(wire(state))
 if x['op']=='append':
  a=at(state,x['path']);assert isinstance(a,list) and len(a)==x['index'];a.append(copy.deepcopy(x['after']))
 else:
  a,k=parent(state,x['path'])
  if x['op']=='replace':assert a[k]==x['before']
  else:assert x['op']=='add' and k not in a and x['before'] is None
  a[k]=copy.deepcopy(x['after'])
 steps.append({'index':i,'op':x['op'],'path':x['path'],'before_sha256':before,'after_sha256':sha(wire(state))})
assert state==p and wire(state)==raw(PLAN['path'])
for x in reversed(f['operations']):
 if x['op']=='append':
  a=at(state,x['path']);assert len(a)==x['index']+1 and a[-1]==x['after'];a.pop()
 else:
  a,k=parent(state,x['path']);assert a[k]==x['after']
  if x['op']=='replace':a[k]=copy.deepcopy(x['before'])
  else:del a[k]
assert wire(state)==raw(basepin['path'])
