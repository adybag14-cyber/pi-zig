import ast,copy,datetime,hashlib,json,re,subprocess
B=Path(r'C:\Users\adyba\pi-zig')
E=B/'evidence'
W=B/'worktrees/modules-io-resume-20261018'
S=B/'worktrees/sdk-owners-resume-20261018'
D=W/'verification/unissued-shutdown-latin1-buffer-fs-fixture21-copy-plan-sourceonly-20261022'
