 d=row['donor'];verify(d);v=raw(d['path']);key=(len(v),sha(v))
 assert key not in physical,('duplicate physical archive bytes',row['relative_path'],physical.get(key))
 physical[key]=row['relative_path']
 assert row['logical_donors']
 for alias in row['logical_donors']:
  z=alias['donor'];verify(z);assert raw(z['path'])==v
  identity=(norm(z['path']),z['bytes'],z['sha256'])
