def sha(b):return hashlib.sha256(b).hexdigest().upper()
def norm(p):return str(p).replace('/','\\').casefold()
def wire(x):return (json.dumps(x,indent=2)+'\n').encode()
def pin(p,expected=None):
 p=Path(p);n=norm(p)
 assert any(n.startswith(norm(q)+'\\') for q in (W.parent,E)),('outside assigned evidence',str(p))
 b=p.read_bytes();r={'path':str(p),'bytes':len(b),'sha256':sha(b)}
 if expected:assert (r['bytes'],r['sha256'])==expected,(r,expected)
 if n in raws:assert raws[n]==b
 inputs[n]=r;raws[n]=b;return r
def verify(r):return pin(r['path'],(r['bytes'],r['sha256']))
def read(p,expected=None):r=pin(p,expected);return json.loads(raws[norm(p)])
def put(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
 assert p.read_bytes()==b
 return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
