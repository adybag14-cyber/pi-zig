seen={};prefixes={}
for p in paths:
 assert p.isascii() and not p.startswith(('/','\\')) and '\\' not in p and ':' not in p
 parts=p.split('/')
 for x in parts:
  assert x not in ('','.','..') and not x.endswith(('.',' ')) and x.casefold() not in ('.git','.gitattributes')
  assert not re.fullmatch(r'(?i)(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\..*)?',x)
 assert p.casefold() not in seen;seen[p.casefold()]=p
 for i in range(1,len(parts)+1):
  q='/'.join(parts[:i]);key=q.casefold();assert key not in prefixes or prefixes[key]==q;prefixes[key]=q
