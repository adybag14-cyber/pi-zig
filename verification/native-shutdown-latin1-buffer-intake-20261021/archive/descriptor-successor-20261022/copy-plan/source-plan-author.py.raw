def parent(tree,path):
 for k in path[:-1]:tree=tree[k]
 return tree,path[-1]
def change(path,after):
 p,k=parent(plan,path);exists=(k<len(p) if isinstance(p,list) else k in p)
 before=copy.deepcopy(p[k]) if exists else None
 ops.append({'op':'replace' if exists else 'add','path':path,'before':before,'after':copy.deepcopy(after)})
 p[k]=copy.deepcopy(after)
def append(path,after):
 p=plan
