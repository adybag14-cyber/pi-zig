  "ordered_source_barriers": [
    {
      "source_line": 186,
      "marker": "assert re.fullmatch(r\"[0-9a-f]{40}\",BASIS)"
    },
    {
      "source_line": 187,
      "marker": "assert all(re.fullmatch(r\"[0-9A-F]{64}\",value[1]) and value[2]>0"
    },
    {
      "source_line": 197,
      "marker": "assert release[\"source_intake_authorized\"] is True"
    },
    {
      "source_line": 201,
      "marker": "for pin in release[\"required_current_pins\"]:"
    },
    {
      "source_line": 207,
      "marker": "sys.excepthook=fail_record"
    },
    {
      "source_line": 209,
      "marker": "repository=repository_identity()"
    },
    {
      "source_line": 215,
      "marker": "manifest_path=inside(ROOT/manifest_rel,ROOT/\"evidence\")"
    },
    {
      "source_line": 224,
      "marker": "allrows=[*rows,"
    },
    {
      "source_line": 229,
      "marker": "existing_spelling={}"
    },
    {
      "source_line": 236,
      "marker": "planned_spelling=dict(existing_spelling)"
    },
    {
      "source_line": 243,
      "marker": "assert key not in planned_spelling or planned_spelling[key]==value"
    },
    {
      "source_line": 244,
      "marker": "planned_spelling[key]=value"
    },
    {
      "source_line": 252,
      "marker": "rel.casefold() not in existing_spelling"
    },
    {
      "source_line": 266,
      "marker": "logical_aliases=manifest[\"logical_donor_aliases\"]"
    },
    {
      "source_line": 283,
      "marker": "alias_records.append({\"target\":target_manifest"
    },
    {
      "source_line": 286,
      "marker": "for (row,old),blob in zip(preimages,blob_many([preimage_reference"
    },
    {
      "source_line": 288,
      "marker": "for (row,old),blob in zip(preimages,blob_many([head"
    },
    {
      "source_line": 291,
      "marker": "attributes=effective_attributes(names)"
    },
    {
      "source_line": 292,
      "marker": "provenance=conversion_provenance(names)"
    },
    {
      "source_line": 297,
      "marker": "raw_git=oid_text(git(\"hash-object\",\"--no-filters\",\"--stdin\",input=b).stdout,object_format)"
    },
    {
      "source_line": 300,
      "marker": "path_git=oid_text(git(\"hash-object\",\"--path=\"+rel,\"--stdin\",input=b).stdout,object_format)"
    },
    {
      "source_line": 307,
      "marker": "before_copy_revalidation=assert_conversion_unchanged"
    },
    {
      "source_line": 320,
      "marker": "new_json(proof/(phase+\"-preflight.json\"),preflight)"
    },
    {
      "source_line": 323,
      "marker": "FAILURE_STATE.update(stage=\"copying_exact_reviewed_rows\",Main_or_index_writes_started=True)"
    },
    {
      "source_line": 335,
      "marker": "post_copy_revalidation=assert_conversion_unchanged"
    },
    {
      "source_line": 341,
      "marker": "git(\"--literal-pathspecs\",\"add\","
    },
    {
      "source_line": 346,
      "marker": "index=index_entries();staged_rows=[]"
    },
    {
      "source_line": 350,
      "marker": "assert entry[\"mode\"]==row[\"mode\"] and entry[\"oid\"]==expected_ids[rel] and entry[\"stage\"]==0"
    },
    {
      "source_line": 353,
      "marker": "pre_commit_revalidation=assert_conversion_unchanged"
    },
    {
      "source_line": 357,
      "marker": "commit=git(\"commit\",\"--file=\"+str(message))"
    },
    {
      "source_line": 360,
      "marker": "assert after!=head and parents==[head]"
    },
    {
      "source_line": 368,
      "marker": "assert entry[\"type\"]==\"blob\" and entry[\"mode\"]==row[\"mode\"] and entry[\"oid\"]==expected_ids[rel]"
    },
    {
      "source_line": 370,
      "marker": "final_revalidation=assert_conversion_unchanged"
    },
    {
      "source_line": 373,
      "marker": "new_json(receipt_path,receipt)"
    }
