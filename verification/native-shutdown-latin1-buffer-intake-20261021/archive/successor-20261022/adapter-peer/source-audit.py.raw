def references(x,loc="$"):
 if isinstance(x,dict):
  if {"path","bytes","sha256"}<=set(x) and isinstance(x["path"],str) and isinstance(x["bytes"],int):
   b=read_pin(x);reference_rows.append({"location":loc,**describe(x["path"],b)})
  for k,v in x.items(): references(v,loc+"."+k)
 elif isinstance(x,list):
  for i,v in enumerate(x):references(v,loc+"["+str(i)+"]")
