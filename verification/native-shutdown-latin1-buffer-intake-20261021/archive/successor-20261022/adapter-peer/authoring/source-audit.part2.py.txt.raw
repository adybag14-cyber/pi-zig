 assert p=="build.zig" or p.startswith(("src/","vendor/quickjs/","verification/"))
 assert not any(ord(c)<32 or ord(c)==127 or c in '<>"|?*' for c in p)
 parts=p.split("/")
 for part in parts:
  assert part not in ("",".","..") and part[-1] not in ". "
  assert part.casefold() not in (".git",".gitattributes")
  assert not re.fullmatch(r"(con|prn|aux|nul|clock\$|conin\$|conout\$|com[1-9¹²³]|lpt[1-9¹²³])",part.split(".")[0],re.I)
 assert all("/".join(parts[:i]).casefold() not in targetset for i in range(1,len(parts)))
donor_rows=[];alias_rows=[];aliaskeys=set();logical_archive_names=[];preimage_count=0
for row in rows:
 target=row["relative_path"];primary=read_pin(row["donor"])
 donor_rows.append({"target":target,"donor":row["donor"],"kind":row["kind"],"raw_bytes_verified":True})
 if row["preimage"] is not None:
  before=read_pin(row["preimage"]);preimage_count+=1
  assert row in plan["source_rows"]
  donor_rows[-1]["immutable_preimage"]=row["preimage"]
 aliases=[{"donor":row["donor"],"logical_archive_relative_path":None}] if row in plan["source_rows"] else row["logical_donors"]
 primary_key=None
 for alias in aliases:
  p=alias["donor"];actual=read_pin(p);assert actual==primary
  key=(target,str(Path(p["path"]).resolve()).casefold(),p["bytes"],p["sha256"])
  assert key not in aliaskeys,key
  aliaskeys.add(key)
  if p==row["donor"]:primary_key=key
  alias_rows.append({"target":target,"donor":p,"logical_archive_relative_path":alias["logical_archive_relative_path"],"same_physical_raw_bytes":True})
  if alias["logical_archive_relative_path"] is not None:logical_archive_names.append(alias["logical_archive_relative_path"])
 assert primary_key in aliaskeys,target
assert preimage_count==8 and len(alias_rows)==268 and len(logical_archive_names)==248
assert len(set(logical_archive_names))==248
for key in ("source_acceptance","source_peer","source_replay","paused_record"):
 value=plan[key]
 if isinstance(value,dict) and {"path","bytes","sha256"}<=set(value):read_pin(value)
