# Independent data-only prefix analysis, never executing copied candidate logic.
def prefix_conflicts(paths,remember):
 known={"verification":"verification"};issues=[]
 for path in paths:
  components=path.split("/")
  for length in range(1,len(components)+1):
   prefix="/".join(components[:length]);key=prefix.casefold()
   if key in known and known[key]!=prefix:issues.append({"previous":known[key],"next":prefix})
   if remember:known[key]=prefix
 return issues
example=["verification/Foo/a.raw","verification/foo/b.raw"]
assert prefix_conflicts(example,False)==[]
assert prefix_conflicts(example,True)==[{"previous":"verification/Foo","next":"verification/foo"}]
assert len({x.casefold() for x in example})==2
assert not any(y.casefold().startswith(x.casefold()+"/") for x in example for y in example if x!=y)
