 "status":"confirmed_source_contract_gap_corrected_only_in_selected_v2",
 "counterexample":example,"premise":"The Foo/foo parent is absent from the original committed-prefix map.",
 "old_existing_only_check_conflicts":[],"selected_combined_prefix_check_conflicts":prefix_conflicts(example,True),
 "full_name_uniqueness_and_file_ancestor_checks_alone_do_not_reject":True,
 "candidate_or_prefix_executed":False}
