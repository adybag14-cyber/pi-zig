imports=lambda b:re.findall(rb'@import\("([^"]+)"\)',b)
assert names(original)==names(candidate) and len(names(original))==25
assert imports(original)==imports(candidate)
fn=lambda b:re.findall(rb'\bfn\s+([A-Za-z_]\w*)\s*\(',b)
of=fn(original);cf=fn(candidate);cf.remove(b'pumpPendingBody');assert cf==of
assert new.count(b'outer_scope.deinit()')==1
assert new.count(b'a.Scope.init(self.engine)')==1
assert new.count(b'handles.boundary.start();')==1
assert new.count(b'handles.finish(')==1
assert new.index(b'handles.boundary.start();')<new.index(b'self.pumpPendingBody()')
assert new.index(b'handles.boundary.escaping();')<new.index(b'outer_scope.deinit()')
assert new.index(b'outer_scope.deinit()')<new.index(b'handles.finish(')
loop=old[old.index(b'        const until = physical.uv_hrtime()'):old.index(b'        try outer_scope.deinit();')]
assert new.count(loop)==1 and (len(loop),sha(loop))==(721,'CDBB385F3D419AD7154DC731F319A80B98DEA82064695B73F66FC551200762F8')
assert b'catch {}' not in new and b'JS_GetException' not in new
all_test_assertions=lambda b:[s for s in b.splitlines() if b'std.testing.' in s or b'try f.expect' in s or b'try expectOwn' in s]
assert all_test_assertions(original)==all_test_assertions(candidate)
