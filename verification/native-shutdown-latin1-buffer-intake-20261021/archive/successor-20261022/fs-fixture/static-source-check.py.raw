assert len(row['edits'])==1 and original[at:at+len(old)]==old
assert original.count(old)==candidate.count(new)==1
assert original[:at]+new+original[at+len(old):]==candidate
assert candidate.replace(new,old,1)==original
assert candidate[:at]==original[:at] and candidate[at+len(new):]==original[at+len(old):]
