 'source_inputs':list(inputs.values()),'immutable_git_inputs':list(git_inputs.values()),
 'finite_projection':{'edit_count':1,'offset':at,'before_bytes':len(old),'after_bytes':len(new),'whole_forward_inverse':True,'untouched_prefix_suffix':True,'original':op,'selected':cp},
 'preserved_authoring_negative':inputs[str(D/'source-authoring-negative.json')],
 'initial_to_selected_correction':{'restored_adjacent_method_bytes':len(wait),'whole_inverse':True,'initial_candidate':bp},
 'preservation':{'named_controls':25,'names':[x.decode() for x in names(original)],'all_test_section_bytes':len(original[first_test:]),'all_test_section_sha256':sha(original[first_test:]),'test_section_exact':True,'all_testing_assertion_lines_exact':True,'imports_exact':True,'original_function_declaration_inventory_preserved':True,'only_new_function':'pumpPendingBody','waitQueued_exact':True,'poll_loop_bytes':len(loop),'poll_loop_sha256':sha(loop),'production_edits':0},
 'ownership_order':{'stable_boundary_started_before_pump':True,'actual_failure_escaped_before_outer_teardown':True,'outer_deinit_once_after_body':True,'boundary_finished_once_after_teardown':True,'no_manual_exception_recovery':True,'reason_moved_not_duplicated':'Boundary.escaping consumes captured_exception; finish moves selected reason through JS_Throw to Engine capture; fixture takeCaught transfers it to the existing defer free.','success_path':'The exact original loop and successful callback close execute once; the added stack Scope finishes undefined and frees that sentinel. No new guest call, job checkpoint, request retirement or polling operation is added.','prior_pattern':'The accepted FileHandle finishImmediate fixture already uses Scope/escaping/markFailed/deinit/finish. This repair starts its stable Scope before the producer, so an error created by this pump cannot become Boundary.previous history.','production_cause':'The original production scopes correctly own the getter failure through request cleanup and UV event release. The fixture previously ran successful outer deinit after that error was in captured_exception; Completion treated that incoming success diagnostic as DATA and retired it.'},
 'original_reference':{'fsreqpromise_commit':ledger['node_commit'],'fsreqpromise_acquisition':inputs[str(ledgerpath)],'callback_scope_provenance':'Exact inherited Node v24.13 body is bound by the accepted 08F45 authority table and its unchanged previous-packet source; this packet does not invent a new acquisition receipt.','required_semantics':'Failed live promise Get returns from Resolve/Reject, while the native callback-scope destructor still closes/pops and the original error propagates.'},
 'original_runtime_negative':negative_files,
 'census':{'grant':inputs[str(E/'root-native-foundation-v38-existing63-runtime-control-20261022-134223/root-grant.json')],'matrix':inputs[str(E/'combined-native-batch-v38-regression63-prepared-20261021/groups.json')],'result':inputs[str(run/'result.json')],'selected_group_count':63,'attempted_prefix_count':17,'remaining_count':46,'roots':rootrows,'whole_src_pumpPending_definition':one.decode(),'whole_src_no_literal_import_of_failed_test_root':True,'test_source_search':{'pattern':pattern,'raw_bytes':len(census_raw),'sha256':sha(census_raw),'text':census_raw.decode()},'finding':'No remaining root defines pumpPending, and no src file imports the failing private test root. The other three physical fixture pump helpers have no local callback-scope teardown in their pump body. The callback-scope controls directly exercise scope closure and do not compose the failed raw-pump/deferred-outer-cleanup pattern.','limits':'This census excludes this exact fixture pattern, not every possible ownership error or any claim about unstarted tests. The same failing fixture settle helper has analogous deferred cleanup but its existing callers use normal settlement; the inline getter control consumes its reason before outer deinit. These are not additional proved repairs.'},
 'excerpts':excerpts,
 'limits':['No build, compiler, target, Node/reference, native, candidate, or runtime auditor execution.','No live Main read/write or index action; source preimages came from immutable Git objects through the owned worktree.','The native negative and all original assertions remain unchanged. Fresh independently granted validation is still required.']
