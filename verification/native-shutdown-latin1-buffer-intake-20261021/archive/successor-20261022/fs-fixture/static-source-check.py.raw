inputs={}; git_inputs={}; cache={}; excerpts=[]
def sha(b): return hashlib.sha256(b).hexdigest().upper()
def pin(p,expect=None):
    p=Path(p);b=p.read_bytes();r={'path':str(p),'bytes':len(b),'sha256':sha(b)}
    if expect: assert (len(b),sha(b))==expect,(r,expect)
    inputs[str(p)]=r
    return b,r
def js(p,expect=None):
    b,r=pin(p,expect);return json.loads(b)
def git(*args):
    return subprocess.check_output(['git','--no-optional-locks','-C',str(W),*args])
def blob(p,expect=None):
    if p not in cache:
        b=git('cat-file','blob',H+':'+p);cache[p]=b
        oid=git('rev-parse',H+':'+p).decode().strip()
        git_inputs[p]={'head':H,'relative_path':p,'git_blob':oid,'bytes':len(b),'sha256':sha(b)}
    b=cache[p]
    if expect:assert (len(b),sha(b))==expect,(p,expect,git_inputs[p])
    return b
def excerpt(label,b,a,z):
    ls=b.splitlines(keepends=True);raw=b''.join(ls[a-1:z])
    assert len(ls)>=z
    excerpts.append({'label':label,'first_line':a,'last_line':z,'bytes':len(raw),'sha256':sha(raw),'text':raw.decode()})
def put(p,b):
    p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb') as f:f.write(b)
    actual=p.read_bytes();assert actual==b
    return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
def outjson(p,j):return put(p,(json.dumps(j,indent=2)+'\n').encode())
proposal=js(V/'proposal.json',(6844,'B24664CA4DADD2B96EA581710A244050EB6F963C3AC0DD11F4BD5D04DBF83106'))
row=proposal['files'][0];assert len(proposal['files'])==1 and row['relative_path']==P
