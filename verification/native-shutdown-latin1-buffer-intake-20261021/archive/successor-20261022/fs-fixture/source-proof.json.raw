elf.outer.markFailed();\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_file_handle_read_test_support.zig:390:            const pump_native = self.engine.native_env_pump orelse return error.ActualFileHandleReadHubRequired;\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:215:            scope.markFailed();\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:222:        var outer_scope: callbacks.Scope = undefined;\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:225:            outer_scope.markFailed();\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:270:    fn pumpPending(self: *Fixture) !void {\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:271:        var outer_scope: callbacks.Scope = undefined;\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:274:            outer_scope.markFailed();\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:283:            const pump = self.engine.native_env_pump orelse return error.ActualFSReadHubRequired;\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:639:    var outer_scope: callbacks.Scope = undefined;\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:642:        outer_scope.markFailed();\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:1032:    try std.testing.expect(f.engine.native_env_context == null and f.engine.native_env_pump == null and\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_fs_request_owner_test.zig:1055:    try std.testing.expect(f.engine.native_env_context == null and f.engine.native_env_pump == null and\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_reqwrap_callback_routing_test.zig:320:            const pump_native = self.engine.native_env_pump orelse return error.ActualReqWrapHubRequired;\n014062f2d139254acab4b985b4ae343db637166f:src/native_node_stream_read_test.zig:254:                self.outer.markFailed();\n"
    },
    "finding": "No remaining root defines pumpPending, and no src file imports the failing private test root. The other three physical fixture pump helpers have no local callback-scope teardown in their pump body. The callback-scope controls directly exercise scope closure and do not compose the failed raw-pump/deferred-outer-cleanup pattern.",
    "limits": "This census excludes this exact fixture pattern, not every possible ownership error or any claim about unstarted tests. The same failing fixture settle helper has analogous deferred cleanup but its existing callers use normal settlement; the inline getter control consumes its reason before outer deinit. These are not additional proved repairs."
  },
  "excerpts": [
    {
      "label": "src/native_node_fs_request_owner_test.zig",
      "first_line": 212,
      "last_line": 236,
      "bytes": 1223,
      "sha256": "22EC69AB356A6641E95D39FA7306E48298B4456D7EE8D006E46FB2238C9F3D2E",
      "text": "    fn outer(self: *Fixture, scope: *callbacks.Scope, resource: c.JSValue) !void {\n        scope.initialized = false;\n        errdefer if (scope.initialized and !scope.deinitialized) {\n            scope.markFailed();\n            scope.deinit() catch {};\n        };\n        try scope.init(self.env(), resource, .{ .async_id = 0, .trigger_async_id = 0 },\n            .{ .skip_async_hooks = true, .skip_task_queues = true }, c.pi_js_undefined());\n    }\n    fn settle(self: *Fixture, request_value: *requests.Request, settled_value: c.JSValue, rejecting: bool) !void {\n        var outer_scope: callbacks.Scope = undefined;\n        try self.outer(&outer_scope, try request_value.object());\n        defer if (!outer_scope.deinitialized) {\n            outer_scope.markFailed();\n            outer_scope.deinit() catch {};\n        };\n        if (rejecting) try request_value.reject(settled_value) else try request_value.resolve(settled_value);\n        try outer_scope.deinit();\n    }\n    fn takeCaught(self: *Fixture) !c.JSValue {\n        const reason = self.engine.captured_exception orelse\n            return error.ExpectedActualFSRequestCapturedReason;\n        self.engine.captured_exception = null;\n        return reason;\n    }\n"
    },
    {
      "label": "src/native_node_fs_request_owner_test.zig",
      "first_line": 270,
      "last_line": 298,
      "bytes": 1441,
      "sha256": "9B5B2AD82DBC42FA4A78D24877E4B9D71104A5E0392996116FB4B9778A6EB207",
      "text": "    fn pumpPending(self: *Fixture) !void {\n        var outer_scope: callbacks.Scope = undefined;\n        try self.outer(&outer_scope, self.target);\n        defer if (!outer_scope.deinitialized) {\n            outer_scope.markFailed();\n            outer_scope.deinit() catch {};\n        };\n        const until = physical.uv_hrtime() + 10 * std.time.ns_per_s;\n        while (self.env().requests.waiting != 0) {\n            // This control explicitly selects nested callback settlement, not\n            // the separately unfinished production microtask checkpoint.\n            if (c.JS_IsJobPending(self.engine.runtime))\n                return error.UnselectedFSReadControlTaskQueue;\n            const pump = self.engine.native_env_pump orelse return error.ActualFSReadHubRequired;\n            _ = try pump(self.engine);\n            if (self.env().requests.waiting == 0) break;\n            if (physical.uv_hrtime() >= until) return error.ActualFSReadCompletionTimeout;\n            physical.uv_sleep(1);\n        }\n        try outer_scope.deinit();\n    }\n    fn waitQueued(self: *Fixture, count: usize) !void {\n        const service = self.controller.?.service;\n        const until = physical.uv_hrtime() + 10 * std.time.ns_per_s;\n        while (uv.pi_uv_service_snapshot(service).queued_events < count) {\n            if (physical.uv_hrtime() >= until) return error.ActualFSReadCompletionTimeout;\n            physical.uv_sleep(1);\n        }\n    }\n"
    },
    {
      "label": "src/native_node_fs_request_owner_test.zig",
      "first_line": 625,
      "last_line": 657,
      "bytes": 1691,
      "sha256": "93B200EAFC3A957CC5876F6DEFC3FE0C1D3CA66DD774F99CA1860DCA24B5FCBD",
      "text": "test \"native FS request owner completes its callback destructor after an ordinary live Promise Get throw\" {\n    var f: Fixture = undefined; try f.init(.{}); defer f.deinit();\n    const req = try f.request(false);\n    try f.expose(\"requestOwner\", try req.object());\n    const original = f.keep(try req.returnPromise());\n    const reason = f.keep(try f.value(\"({ordinaryPromiseGetter:true})\"));\n    try f.expose(\"ownerGetterReason\", reason);\n    f.env().field(.before).* = 1;\n    f.env().field(.after).* = 1;\n    try f.evaluate(\n        \\\\Object.defineProperty(requestOwner, \"promise\", { configurable:true,\n        \\\\  get() { ownerTrace.push([\"get-throw\"]); throw ownerGetterReason; }\n        \\\\});\n    );\n    var outer_scope: callbacks.Scope = undefined;\n    try f.outer(&outer_scope, try req.object());\n    defer if (!outer_scope.deinitialized) {\n        outer_scope.markFailed();\n        outer_scope.deinit() catch {};\n    };\n    try std.testing.expectError(error.JavaScriptException, req.resolve(c.JS_NewInt32(f.engine.context, 99)));\n    const actual = try f.takeCaught();\n    defer f.engine.freeValue(actual);\n    try std.testing.expect(c.JS_IsStrictEqual(f.engine.context, reason, actual));\n    try std.testing.expect(req.finished);\n    try std.testing.expectEqual(@as(usize, 1), f.env().callback_depth);\n    try std.testing.expectEqual(@as(u32, 1), f.env().field(.stack_length).*);\n    try std.testing.expectEqual(c.JS_PROMISE_PENDING, c.JS_PromiseState(f.engine.context, original));\n    try outer_scope.deinit();\n    try f.expect(\n        \\\\ownerTrace.length === 3 && ownerTrace[0][0] === \"before\" &&\n        \\\\ownerTrace[1][0] === \"get-throw\" && ownerTrace[2][0] === \"after\"\n    );\n"
    },
    {
      "label": "src/native_node_fs_request_owner_test.zig",
      "first_line": 947,
      "last_line": 990,
      "bytes": 2484,
      "sha256": "431A8E7BB240AAA671F95AC01D1784C2105ACC9E39B70402DC47553F9B0C7EC7",
      "text": "test \"native FS request owner physical completion preserves live Promise getter failure and still retires the request\" {\n    var f: Fixture = undefined; try f.init(.{ .physical_read = true }); defer f.deinit();\n    var file: PhysicalFile = undefined; try file.init(&f, \"CALL\"); defer file.deinit();\n    f.env().field(.init).* = 1;\n    f.env().field(.before).* = 1;\n    f.env().field(.after).* = 1;\n    try f.evaluate(\n        \\\\globalThis.actualReadView = new Uint8Array(4);\n        \\\\globalThis.readCompletionReason = { originalCompletionGet: true };\n        \\\\globalThis.readCompletionProgress = { gets: 0 };\n        \\\\globalThis.ownerInitAction = resource => {\n        \\\\  globalThis.readCompletionPromise = resource.promise;\n        \\\\  Object.defineProperty(resource, \"promise\", { configurable: true, get() {\n        \\\\    if (++readCompletionProgress.gets === 2) {\n        \\\\      ownerTrace.push([\"completion-get\"]);\n        \\\\      throw readCompletionReason;\n        \\\\    }\n        \\\\    return readCompletionPromise;\n        \\\\  }});\n        \\\\  delete globalThis.ownerInitAction;\n        \\\\};\n    );\n    const reason = f.keep(try f.value(\"readCompletionReason\"));\n    const promise = f.keep(try f.value(\n        \"actualNativeRead(actualReadFd, actualReadView, 0, 4, 0, actualUsePromises)\"));\n    const wrapper = f.keep(a.duplicate(f.engine, try (try f.firstRequest()).object()));\n    const native_request = try f.retainNativeRequest();\n    defer uv.pi_uv_fs_request_release(native_request);\n    try std.testing.expectError(error.JavaScriptException, f.pumpPending());\n    const caught = try f.takeCaught();\n    defer f.engine.freeValue(caught);\n    try std.testing.expect(c.JS_IsStrictEqual(f.engine.context, reason, caught));\n    try std.testing.expectEqual(c.JS_PROMISE_PENDING, c.JS_PromiseState(f.engine.context, promise));\n    try std.testing.expectEqual(@as(usize, 0), f.env().callback_depth);\n    try std.testing.expectEqual(@as(u32, 0), f.env().field(.stack_length).*);\n    try std.testing.expect(f.env().requests.head == null and f.env().requests.waiting == 0);\n    try std.testing.expect((try f.registry()).unwrap(wrapper) == null);\n    try std.testing.expectEqual(@as(c_int, 1), uv.pi_uv_fs_request_info(native_request).cleaned);\n    try f.expect(\n        \\\\readCompletionProgress.gets === 2 &&\n        \\\\ownerTrace.map(row => row[0]).join(\",\") === \"init,before,completion-get,after\" &&\n        \\\\Array.from(actualReadView).join(\",\") === \"67,65,76,76\"\n    );\n}\n"
    },
    {
      "label": "src/extensions/native_node_fs_request_promise.zig",
      "first_line": 184,
      "last_line": 234,
      "bytes": 2640,
      "sha256": "7C681690FD363B49D7140BBD126201995EA625E171883F6EC67758BCCD81C296",
      "text": "    fn settle(self: *Request, value: c.JSValue, is_reject: bool) !void {\n        // This assignment precedes both native scope constructors in Source.\n        self.finished = true;\n        const engine = try self.environment().requireEngine();\n        var handles = Scope.init(engine);\n        var callback_scope: callbacks.Scope = undefined;\n        callback_scope.initialized = false;\n        var failure: ?anyerror = null;\n        self.settleBody(&handles, &callback_scope, value, is_reject) catch |err| {\n            handles.boundary.escaping();\n            failure = err;\n        };\n        // The InternalCallbackScope destructor runs even after a failed Get,\n        // before any of the enclosing HandleScope's local roots are released.\n        if (callback_scope.initialized) {\n            callback_scope.deinit() catch |err| {\n                handles.boundary.escaping();\n                if (failure == null) failure = err;\n            };\n        }\n        const ignored = try handles.finish(if (failure) |err|\n            @as(anyerror!c.JSValue, err) else c.pi_js_undefined());\n        engine.freeValue(ignored);\n    }\n    fn settleBody(self: *Request, s: *Scope, callback_scope: *callbacks.Scope,\n        value: c.JSValue, is_reject: bool) !void\n    {\n        const environment_value = self.environment();\n        const data = self.binding_data orelse return self.wrap.registry.check(.invalid_wrap_brand);\n        const wrapper = try self.object();\n        callback_scope.init(environment_value, wrapper, self.wrap.context(), .{},\n            self.wrap.context_frame) catch |err|\n        {\n            s.boundary.escaping();\n            // The completed void InternalCallbackScope constructor does not\n            // skip the original live promise-property Get after an ordinary\n            // before-hook rethrow. Keep that real completion in this existing\n            // HandleScope while executing Get and the unchanged FromJust path.\n            if (!callback_scope.initialized or !callback_scope.pushed_ids or\n                err != error.JavaScriptException or s.boundary.isFatal()) return err;\n        };\n        const resolver = try s.getKey(wrapper, data.promise_string);\n        try s.pending();\n        var result = c.JS_PiSettlePromise(s.engine.context, resolver, value, is_reject);\n        // Resolver::{Resolve,Reject}.FromJust is a genuine native CHECK on an\n        // empty Maybe. It is not an ordinary Promise rejection/guest catch.\n        if (c.JS_IsException(result))\n            return self.wrap.registry.check(.promise_property_settle);\n        s.boundary.release(&result);\n        try s.pending();\n    }\n"
    },
    {
      "label": "src/extensions/native_node_fs_request_io.zig",
      "first_line": 159,
      "last_line": 189,
      "bytes": 1464,
      "sha256": "C726B36D4962D7971DAC7BE1FFCB207056680F09E611ADAEA5C60BD6F2E22E75",
      "text": "    fn deliver(raw: *anyopaque, event: *uv.PiUvEvent) !void {\n        const self: *Controller = @ptrCast(@alignCast(raw));\n        try self.hub.assertOwner();\n        const actual = uv.pi_uv_event_fs_request(event) orelse\n            return error.ActualFSCompletionEventRequired;\n        const entry = try self.find(actual);\n        if (!entry.dispatched or !entry.counted)\n            return error.ActualFSAcceptedCompletionRequired;\n        self.busy += 1;\n        defer self.leave();\n        // MakeLibuvRequestCallback::Wrapper: native strong pointer, Detach,\n        // decrement, then select/call the original callback. Its pointer dies\n        // last, even if that callback resets and redispatches this same Entry.\n        try entry.beginCallback();\n        const engine = self.hub.engine;\n        var handles = Scope.init(engine);\n        var failure: ?anyerror = null;\n        const outcome: anyerror!void = if (entry.original_callback) |callback|\n            callback.call(entry, callback.request) else error.ActualFSOriginalCallbackRequired;\n        outcome catch |err| {\n            record(&handles, err);\n            failure = err;\n        };\n        entry.endCallback() catch |err| {\n            record(&handles, err);\n            if (failure == null) failure = err;\n        };\n        const ignored = try handles.finish(if (failure) |err|\n            @as(anyerror!c.JSValue, err) else c.pi_js_undefined());\n        engine.freeValue(ignored);\n    }\n"
    },
    {
      "label": "src/extensions/native_node_fs_request_io.zig",
      "first_line": 248,
      "last_line": 265,
      "bytes": 990,
      "sha256": "8C19711BD8FE8EF4EEBE48D1E4E8B9C6C0858B003BE7257014E9ADCE222E7B63",
      "text": "fn afterInteger(request: *requests.Request, actual: *uv.PiUvFsRequest) !void {\n    const info = uv.pi_uv_fs_request_info(actual);\n    if (info.kind != uv.PI_UV_FS_READ) return error.ActualFSReadCompletionRequired;\n    var after: after_scope.AfterScope = undefined;\n    try after.init(request, .{ .raw = actual, .run = cleanupRequest });\n    return after.finish(afterIntegerBody(&after, request, info));\n}\nfn afterIntegerBody(after: *after_scope.AfterScope, request: *requests.Request,\n    info: uv.PiUvFsInfo) !void\n{\n    // Read's validated Int32 length bounds every successful uv result.\n    const result = std.math.cast(c_int, info.result) orelse\n        return error.ActualFSReadResultRequired;\n    const path: ?[]const u8 = if (info.path == null) null else\n        std.mem.span(@as([*:0]const u8, @ptrCast(info.path)));\n    if (try after.proceed(.{ .code = result, .syscall = \"read\", .path = path }))\n        try request.resolve(c.JS_NewInt32(after.handles.engine.context, result));\n}\n"
    },
    {
      "label": "src/extensions/native_node_fs_after_scope.zig",
      "first_line": 27,
      "last_line": 47,
      "bytes": 1066,
      "sha256": "E49B5F708514394E71E8C08F62FA1704BC9CBE6B489489AE68A8795B5EE5C7B9",
      "text": "    /// pointer is initialized before HandleScope/Context::Scope construction.\n    pub fn init(self: *AfterScope, request: *requests.Request, cleanup: Cleanup) !void {\n        const engine = try request.environment().requireEngine();\n        try request.wrap.retainNative();\n        self.* = .{\n            .handles = Scope.init(engine), .request = request,\n            .cleanup = cleanup, .initialized = true,\n        };\n    }\n\n    /// Destructor-body ordering: cleanup the real physical request, detach the\n    /// native BaseObject, then reset this scope's native pointer. The original\n    /// enclosing HandleScope still owns its Local values throughout this call.\n    pub fn clear(self: *AfterScope) !void {\n        const request = self.request orelse return;\n        self.cleanup.run(self.cleanup.raw);\n        try request.wrap.detach();\n        self.request = null;\n        // This may delete the native request when Dispatch failed and no\n        // MakeLibuvRequestCallback pointer surrounds the original callback.\n        try request.wrap.releaseNative();\n"
    },
    {
      "label": "src/extensions/native_node_fs_after_scope.zig",
      "first_line": 85,
      "last_line": 109,
      "bytes": 1111,
      "sha256": "B70C9DF5D59054EFDABD74D093B3EF1AD0F1A27AFDD55087730D37F6472F16CF",
      "text": "\n    /// A caller invokes finish on every initialized path, including ordinary\n    /// callback failure and stopped-runtime completion. Preserve that failure\n    /// before native pointer destruction can produce another pending reason.\n    pub fn finish(self: *AfterScope, incoming: anyerror!void) !void {\n        if (!self.initialized or self.finished) return incoming;\n        self.finished = true;\n        var failure: ?anyerror = null;\n        if (incoming) |_| {} else |err| {\n            self.handles.boundary.escaping();\n            if (err == error.OutOfMemory and !self.handles.boundary.isFatal()) {\n                _ = self.handles.engine.throwNativeOutOfMemoryFatal();\n                self.handles.boundary.escaping();\n            }\n            failure = err;\n        }\n        self.clear() catch |err| {\n            self.handles.boundary.escaping();\n            if (failure == null) failure = err;\n        };\n        const result = try self.handles.finish(if (failure) |err|\n            @as(anyerror!c.JSValue, err) else c.pi_js_undefined());\n        self.handles.engine.freeValue(result);\n    }\n};\n"
    },
    {
      "label": "src/extensions/native_node_uv_service.zig",
      "first_line": 55,
      "last_line": 73,
      "bytes": 1116,
      "sha256": "DE82210896860A36AFFFBE2CC8CC055989E528F0A0EF4E6F15C3B236972E7E57",
      "text": "        const self: *Owner = @ptrCast(@alignCast(raw));\n        try self.hub.assertOwner();\n        try self.hub.engine.checkNativeEntry();\n        if (self.stopping or self.hub.stopping) return error.NativeEnvClosed;\n        if (self.busy or c.JS_IsJobPending(self.hub.engine.runtime)) return false;\n        // Preserve the actual TCP construction/callback reentry gate before\n        // consuming any shared FIFO entry. FS uses its own same-owner gate.\n        for (self.clients) |optional| if (optional) |selected|\n            if (!selected.ready(selected.raw)) return false;\n        const event = uv.pi_uv_service_next(self.service) orelse return false;\n        self.busy = true;\n        defer self.busy = false;\n        const engine = self.hub.engine;\n        engine.native_exception_diagnostics_suppressed += 1;\n        defer engine.native_exception_diagnostics_suppressed -= 1;\n        var completion = Completion.initVoid(engine, self.deliver(event, false));\n        uv.pi_uv_event_release(event);\n        try completion.finishVoid();\n        return true; // The existing Hub owns the subsequent checkpoint.\n"
    },
    {
      "label": "src/extensions/native_env_io.zig",
      "first_line": 103,
      "last_line": 119,
      "bytes": 848,
      "sha256": "5AB7065CFA1A2EDA4545B008829C482D04C084F73225FDAE27327AA490D3714C",
      "text": "                _ = @import(\"native_durable.zig\").reject(engine, err);\n                const reason = c.JS_GetException(engine.context);\n                defer engine.freeValue(reason);\n                try task.settled(true, reason);\n            };\n            worked = true;\n            if (c.JS_IsJobPending(engine.runtime)) return worked;\n        }\n        var resource_index: usize = 0;\n        while (resource_index < self.resources.items.len) {\n            const resource = self.resources.items[resource_index];\n            if (resource.poll) |poll| {\n                worked = (try poll(resource.raw)) or worked;\n                if (c.JS_IsJobPending(engine.runtime)) return worked;\n            }\n            // Other native resources may retire during a callback. A scheduler\n            // controller itself stays registered until teardown.\n"
    },
    {
      "label": "src/extensions/engine.zig",
      "first_line": 729,
      "last_line": 738,
      "bytes": 540,
      "sha256": "44659903E25FEA204C4FDB8086B62275F8D6246E18A1A382CAB9029F857F0332",
      "text": "    pub fn checked(self: *Engine, value: c.JSValue) !c.JSValue {\n        const result = self.nativeCallbackResult(value);\n        if (c.JS_IsException(result)) {\n            if (!c.JS_HasException(self.context)) {\n                if (c.JS_PiIsExecutionTermination(result)) _ = c.JS_Throw(self.context, result)\n                else _ = c.JS_ThrowInternalError(self.context, \"Native callback returned exception without a pending reason\");\n            }\n            return self.captureException(self.context);\n        }\n        return result;\n"
    },
    {
      "label": "src/extensions/engine.zig",
      "first_line": 1198,
      "last_line": 1258,
      "bytes": 3435,
      "sha256": "467CE0C2560C82E058B78A525E6D281BACEFDD1D0AE51CFB69DF064EB4969269",
      "text": "    fn captureException(self: *Engine, context: *c.JSContext) anyerror {\n        const exception = c.JS_GetException(context);\n        return self.captureValue(context, exception, true);\n    }\n\n    /// Consumes exception. actual_event is supplied only by JS_GetException;\n    /// settled Promise rejection DATA never gains fatal authority from its bit.\n    fn captureValue(self: *Engine, context: *c.JSContext, exception: c.JSValue, actual_event: bool) anyerror {\n        var owned: NativePending = .{\n            .reason = exception,\n            .fatal = actual_event and c.JS_PiNativePendingPriority(self.runtime, exception) > 0,\n            .actual_event = actual_event,\n        };\n        if (owned.isFatal(self.runtime)) self.recordNativeFatal(exception);\n        if (self.currentNativeFatal()) |first| {\n            if (actual_event) _ = c.JS_PiNativePendingReplaceClassified(self.runtime,\n                first, true, exception, owned.fatal);\n            owned = .{ .reason = c.JS_DupValue(context, first), .fatal = true };\n            self.releaseNativeOwned(exception, &owned);\n        }\n        self.takeNativePending(&owned);\n        // A native implementation may call guest functions whose exceptions\n        // are still inside a guest try/catch. Capturing their identity must\n        // not invoke user ToString code before that catch gets the exception.\n        var diagnostic_message: ?[]u8 = null;\n        if (self.native_exception_diagnostics_suppressed == 0 and\n            !owned.isFatal(self.runtime) and !c.JS_PiIsExecutionTermination(owned.reason.?)) {\n            const text = c.JS_ToCString(context, owned.reason.?);\n            self.takeNativePending(&owned);\n            if (text != null) {\n                if (!owned.isFatal(self.runtime) and !c.JS_PiIsExecutionTermination(owned.reason.?)) diagnostic_message = self.gpa.dupe(u8, std.mem.span(text)) catch null;\n                c.JS_FreeCString(context, text);\n                self.takeNativePending(&owned);\n            }\n        }\n        // String conversion can invoke user code and another native callback.\n        // Commit ownership only afterward, retaining the original thrown value.\n        while (c.JS_HasException(self.context) or self.captured_exception != null or self.last_error != null) {\n            self.takeNativePending(&owned);\n            if (self.captured_exception) |previous| {\n                self.captured_exception = null;\n                self.releaseNativeOwned(previous, &owned);\n            } else if (self.last_error) |message| {\n                // A released diagnostic may reenter checked()/captureValue\n                // and publish another owned message. Detach before freeing;\n                // drain all channels before committing this invocation's text.\n                self.last_error = null;\n                self.gpa.free(message);\n            }\n        }\n        if (c.JS_PiIsExecutionTermination(owned.reason.?)) {\n            if (diagnostic_message) |message| self.gpa.free(message);\n            _ = self.throwNativePending(&owned);\n            return error.ExecutionTerminated;\n        }\n        if (owned.isFatal(self.runtime)) {\n            if (diagnostic_message) |message| self.gpa.free(message);\n            c.JS_SetUncatchableError(context, owned.reason.?);\n        } else self.last_error = diagnostic_message;\n        self.captured_exception = owned.reason.?;\n        return error.JavaScriptException;\n"
    },
    {
      "label": "src/extensions/native_node_callback_scope.zig",
      "first_line": 671,
      "last_line": 690,
      "bytes": 1064,
      "sha256": "1C4BAF744D1DC15B58F1AA4956363C0D6166207EAB1D7BD35208D97DA70C25B6",
      "text": "    pub fn init(self: *Scope, environment: *Environment, resource: c.JSValue, id: AsyncContext, flags: Flags, frame: c.JSValue) !void {\n        const engine = try environment.requireEngine();\n        self.* = .{\n            .environment = environment.retain(),\n            .resource = a.duplicate(engine, resource),\n            .prior_frame = c.pi_js_undefined(),\n            .async_context = id,\n            .flags = flags,\n            .previous_scope = environment.callback_scope,\n            .initialized = true,\n        };\n        // PushAsyncCallbackScope precedes can_call_into_js and frame exchange.\n        environment.callback_depth += 1;\n        environment.callback_scope = self;\n        if (!environment.canCallIntoJs()) { self.failed = true; return; }\n        environment.idle = false;\n        self.prior_frame = try environment.exchangeContextFrame(frame);\n        try environment.pushAsyncContext(id, &self.resource);\n        self.pushed_ids = true;\n        if (id.async_id != 0 and !flags.skip_async_hooks) try environment.emitBefore(id.async_id);\n"
    },
    {
      "label": "src/extensions/native_node_callback_scope.zig",
      "first_line": 699,
      "last_line": 732,
      "bytes": 1614,
      "sha256": "1DFE7B6A0E2B3ABE202686621375BB590E2F8275146335F5D2C91061BA92EF67",
      "text": "    pub fn close(self: *Scope) !void {\n        std.debug.assert(self.initialized and !self.deinitialized);\n        if (self.closed) return;\n        self.closed = true;\n        const env = self.environment;\n        const engine = try env.requireEngine();\n        var s = LocalScope.init(engine);\n        const ignored = try s.finish(self.closeBody(&s));\n        engine.freeValue(ignored);\n    }\n    fn closeBody(self: *Scope, s: *LocalScope) !c.JSValue {\n        const env = self.environment;\n        // Stopping clears IDs and returns before frame restoration or idle reset.\n        if (try self.stoppingCheck()) return c.pi_js_undefined();\n        defer env.idle = true;\n        var error_from_hook: ?anyerror = null;\n        if (!self.failed and self.async_context.async_id != 0 and !self.flags.skip_async_hooks)\n            env.emitAfter(self.async_context.async_id) catch |err| {\n                s.boundary.escaping();\n                error_from_hook = err;\n            };\n        if (self.pushed_ids) {\n            _ = env.popAsyncContext(self.async_context.async_id) catch |err| failed_pop: {\n                s.boundary.escaping();\n                if (error_from_hook == null) error_from_hook = err;\n                break :failed_pop false;\n            };\n            const displaced = try env.exchangeContextFrame(self.prior_frame);\n            var old = displaced;\n            s.boundary.release(&old);\n        }\n        if (error_from_hook) |err| return err;\n        if (self.failed or env.callback_depth > 1 or self.flags.skip_task_queues or !env.canCallIntoJs())\n            return c.pi_js_undefined();\n"
    },
    {
      "label": "src/extensions/native_node_callback_scope.zig",
      "first_line": 773,
      "last_line": 790,
      "bytes": 923,
      "sha256": "F5EEB06F55DF310271F980B0C84E51DF8B76400B4DE2B26F6C23132D2358C085",
      "text": "    /// Close before PopAsyncCallbackScope, then retire owned local handles.\n    /// Returns actual completion; callers must not silently swallow it.\n    pub fn deinit(self: *Scope) !void {\n        std.debug.assert(self.initialized and !self.deinitialized);\n        const env = self.environment;\n        const engine = try env.requireEngine();\n        if (env.callback_scope != self or env.callback_depth == 0)\n            return env.operations.native_check_failure(env, .callback_scope_order);\n        var completion = Completion.initVoid(engine, self.close());\n        env.callback_scope = self.previous_scope;\n        env.callback_depth -= 1;\n        self.deinitialized = true;\n        completion.release(self.prior_frame);\n        completion.release(self.resource);\n        self.prior_frame = c.pi_js_undefined();\n        self.resource = c.pi_js_undefined();\n        env.release();\n        try completion.finishVoid();\n"
    },
    {
      "label": "src/extensions/native_sdk_owned_completion.zig",
      "first_line": 92,
      "last_line": 143,
      "bytes": 2987,
      "sha256": "F6B77D9BC7C5BA140DD50AD6DF80AC1C29D308EE8F13385722B99A093EBCFF5A",
      "text": "    // A cancelled native call can still return this explicit abrupt error\n    // after its private pending slot has been cleared by the actual cancel.\n    native_aborted: bool = false,\n    finished: bool = false,\n\n    pub fn initAction(engine: *em.Engine, result: anyerror!p.af.Action) Completion {\n        var selected: ?p.af.Action = null;\n        var native_aborted = false;\n        if (result) |action| {\n            selected = action;\n        } else |err| {\n            // Surface actual pending/current invocation events independently\n            // BEFORE inspecting a failed-operation diagnostic ownership slot.\n            _ = engine.nativeCallbackResult(c.pi_js_undefined());\n            if (err == error.ExecutionTerminated) {\n                native_aborted = true;\n            } else if (err == error.JavaScriptException and !c.JS_HasException(engine.context) and engine.captured_exception != null) {\n                const reason = engine.captured_exception.?;\n                engine.captured_exception = null;\n                selected = .{ .thrown = reason }; // Owned DATA; never flag/tag infer.\n            } else {\n                // Direct trusted GPA and non-JS host failures become actual\n                // producer exits before any owned temporary is released.\n                _ = @import(\"native_sdk.zig\").fail(engine, err);\n            }\n        }\n        var self: Completion = .{ .owner = .{ .engine = engine }, .action = selected, .native_aborted = native_aborted };\n        if (self.action) |action| switch (action) {\n            // Even flagged/private Error payloads are DATA, not pending events.\n            .thrown => |reason| { self.owner.chosen = reason; self.action = null; },\n            else => {},\n        };\n        // Detach historical diagnostic DATA before any free. Its own flag has\n        // no authority; newly captured cleanup events then have an empty slot.\n        self.diagnostic = engine.captured_exception;\n        engine.captured_exception = null;\n        // Own entry pending without releasing another value in this inactive\n        // init record; the first release starts the caller-stable boundary.\n        if (c.JS_HasException(engine.context)) self.pending = c.JS_GetException(engine.context);\n        return self;\n    }\n    pub fn initValue(engine: *em.Engine, result: anyerror!c.JSValue) Completion {\n        const outcome: anyerror!p.af.Action = if (result) |value| .{ .returned = value } else |err| err;\n        return initAction(engine, outcome);\n    }\n    pub fn initVoid(engine: *em.Engine, result: anyerror!void) Completion {\n        const outcome: anyerror!p.af.Action = if (result) |_| .{ .returned = c.pi_js_undefined() } else |err| err;\n        return initAction(engine, outcome);\n    }\n    pub fn initRecorded(s: anytype, result: anyerror!void, state: c.JSValue) Completion {\n        result catch |err| return initVoid(s.engine, err);\n        s.engine.checkNativeEntry() catch |err| return initVoid(s.engine, err);\n"
    },
    {
      "label": "src/extensions/native_sdk_owned_completion.zig",
      "first_line": 184,
      "last_line": 228,
      "bytes": 2332,
      "sha256": "89E680A5644A587549C63D49402948B87787C011952FA96FB2495F4DA33E0A97",
      "text": "    pub fn finishAction(self: *Completion) anyerror!p.af.Action {\n        std.debug.assert(!self.finished);\n        self.enter();\n        if (self.diagnostic) |value| { self.diagnostic = null; self.release(value); }\n        if (self.owner.chosen != null) if (self.action) |action| {\n            self.action = null;\n            switch (action) { .returned, .awaited, .thrown => |value| self.release(value) }\n        };\n        // Pop before the selected completion or Await can escape. Keep our\n        // chosen first reason owned while the invocation holder retires.\n        _ = self.owner.engine.leaveNativeInvocation(&self.invocation, c.pi_js_undefined());\n        self.owner.events(null);\n        self.finished = true;\n        if (self.owner.chosen) |reason| {\n            const actual_pending = self.owner.chosen_pending;\n            self.owner.chosen = null;\n            self.owner.chosen_pending = false;\n            if (self.owner.fatal or (actual_pending and c.JS_PiIsExecutionTermination(reason))) {\n                // A private completion, including cancelled native unwind,\n                // reaches Engine's ExecutionTerminated path, never Action DATA.\n                if (self.owner.fatal) c.JS_SetUncatchableError(self.owner.engine.context, reason);\n                _ = try self.owner.engine.checked(c.JS_Throw(self.owner.engine.context, reason));\n                unreachable;\n            }\n            return .{ .thrown = reason };\n        }\n        if (self.native_aborted) return error.ExecutionTerminated;\n        const action = self.action orelse return error.MissingSdkScopeCompletion;\n        self.action = null;\n        return action;\n    }\n    pub fn finishValue(self: *Completion) anyerror!c.JSValue {\n        return switch (try self.finishAction()) {\n            .returned => |value| value,\n            .thrown => |reason| self.owner.engine.checked(c.JS_Throw(self.owner.engine.context, reason)),\n            .awaited => unreachable,\n        };\n    }\n    pub fn finishVoid(self: *Completion) anyerror!void {\n        switch (try self.finishAction()) {\n            .returned => |value| self.owner.engine.freeValue(value),\n            .thrown => |reason| { _ = try self.owner.engine.checked(c.JS_Throw(self.owner.engine.context, reason)); unreachable; },\n            .awaited => unreachable,\n        }\n    }\n"
    },
    {
      "label": "src/extensions/native_node_commonjs_owned_boundary.zig",
      "first_line": 12,
      "last_line": 20,
      "bytes": 501,
      "sha256": "CF82581236BE6939D7557C7F86A92DB7BFD94D724C99E94D2C5978AE1E27DBA6",
      "text": "    finished: bool = false,\n    pub fn begin(engine: *v.em.Engine) Boundary {\n        const previous=engine.captured_exception;engine.captured_exception=null;\n        engine.native_exception_diagnostics_suppressed+=1;\n        // Returned INACTIVE by value. No pointer into this temporary escapes.\n        return .{.engine=engine,.previous=previous};\n    }\n    pub fn start(self:*Boundary)void{\n        if(!self.finished and !self.invocation.active)self.engine.enterNativeInvocation(&self.invocation);\n"
    },
    {
      "label": "src/extensions/native_node_commonjs_owned_boundary.zig",
      "first_line": 78,
      "last_line": 85,
      "bytes": 421,
      "sha256": "6FEA096EF0584028D7BB8F4C6C505565385A12BCB18DDA5163C4FE9079AA8640",
      "text": "    /// supply an ordinary thrown value, but its flag/tag is never fatal proof.\n    pub fn escaping(self:*Boundary)void{\n        self.observe(null);\n        if(self.reason==null)if(self.engine.captured_exception)|value|{\n            self.engine.captured_exception=null;self.reason=value;self.reason_pending=false;self.fatal=false;\n        };\n    }\n    pub fn own(self:*Boundary,scope:*v.Scope,value:c.JSValue)!c.JSValue{\n"
    },
    {
      "label": "src/extensions/native_node_commonjs_owned_boundary.zig",
      "first_line": 115,
      "last_line": 164,
      "bytes": 3559,
      "sha256": "C3A78345DE6BF35BEB74F3C60EA5535824BDC69F74B455D8BB9A644A474F4F10",
      "text": "    fn failureRoots(self:*Boundary,values:[]c.JSValue)void{\n        for(values)|*value|self.release(value);\n        while(self.engine.captured_exception)|value|{self.engine.captured_exception=null;var old=value;self.release(&old);}\n        if(self.previous)|value|{self.previous=null;var old=value;self.release(&old);}\n    }\n    /// Retire native ownership without popping/materializing the completion.\n    /// Args owner rollback uses this SAME stable frame before finishRetired.\n    pub fn retire(self:*Boundary,host_error:?anyerror,scope:*v.Scope,values:[]c.JSValue)void{\n        self.start();self.observe(null);\n        if(host_error) |err| { if(err==error.JavaScriptException and self.reason==null)self.escaping(); }\n        // A trusted direct host allocation failure precedes root retirement.\n        if(host_error) |err| { if(err==error.OutOfMemory and !self.isFatal()){_=self.engine.throwNativeOutOfMemoryFatal();self.observe(null);} }\n        const count=scope.inline_count;scope.inline_count=0;for(scope.inline_values[0..count])|*value|self.release(value);\n        const dynamic=scope.values.items;scope.values.items=dynamic[0..0];for(dynamic)|*value|self.release(value);\n        const generation=self.engine.native_allocation_generation;scope.values.deinit(self.engine.gpa);self.observe(generation);\n        if(host_error!=null or self.reason!=null)self.failureRoots(values)\n        else if(self.engine.captured_exception==null){self.engine.captured_exception=self.previous;self.previous=null;}\n        else if(self.previous)|value|{self.previous=null;var old=value;self.release(&old);}\n        if(host_error!=null or self.reason!=null)self.failureRoots(values);\n    }\n    pub fn failed(self:*Boundary,host_error:?anyerror)bool{self.observe(null);return host_error!=null or self.reason!=null;}\n    pub fn finishRetired(self:*Boundary,host_error:?anyerror,values:[]c.JSValue)!void{\n        defer self.engine.native_exception_diagnostics_suppressed-=1;\n        self.observe(null);\n        if(host_error!=null or self.reason!=null)self.failureRoots(values);\n        // Pop at the caller-stable address before returning any completion.\n        self.finished=true;\n        const result=self.engine.leaveNativeInvocation(&self.invocation,c.pi_js_undefined());\n        self.engine.freeValue(result); // Undefined/exception sentinel only.\n        self.observe(null); // finished prevents relinking the dead frame.\n        if(host_error!=null or self.reason!=null)self.failureRoots(values);\n        if(self.reason)|value|{\n            const termination=self.isTermination();\n            self.reason=null;self.reason_pending=false;\n            if(!termination){\n                if(self.fatal)c.JS_SetUncatchableError(self.engine.context,value)\n                else c.JS_ClearUncatchableError(self.engine.context,value);\n            }\n            _=self.engine.checked(c.JS_Throw(self.engine.context,value)) catch |err|return err;\n            return error.ActualCommonJSBoundaryThrowDidNotFail;\n        }\n        if(host_error)|err|return err;\n    }\n    pub fn finishMany(self:*Boundary,host_error:?anyerror,scope:*v.Scope,values:[]c.JSValue)!void{self.retire(host_error,scope,values);return self.finishRetired(host_error,values);}\n    pub fn finish(self:*Boundary,completion:anyerror!c.JSValue,scope:*v.Scope)!c.JSValue{\n        var values=[_]c.JSValue{c.pi_js_undefined()};var host_error:?anyerror=null;\n        if(completion)|value|values[0]=value else |err|host_error=err;\n        try self.finishMany(host_error,scope,&values);return values[0];\n    }\n};\n"
    },
    {
      "label": "src/extensions/native_node_operation_scope.zig",
      "first_line": 7,
      "last_line": 14,
      "bytes": 523,
      "sha256": "331B5EB56D355B1C3596785BBFCF3AA891C6699433BC5CF8AF6B7537005B73F2",
      "text": "pub const Scope = struct {\n    engine: *v.em.Engine,\n    values: v.Scope,\n    boundary: Boundary,\n    pub fn init(engine: *v.em.Engine) Scope { return .{ .engine = engine, .values = .{ .engine = engine }, .boundary = Boundary.begin(engine) }; }\n    pub fn pending(self: *Scope) !void { try self.boundary.checkCurrent(); }\n    pub fn beforeAllocation(self: *Scope) !u64 { return self.boundary.beforeAllocation(); }\n    pub fn own(self: *Scope, value: c.JSValue) !c.JSValue { return self.boundary.own(&self.values, value); }\n"
    },
    {
      "label": "src/extensions/native_node_operation_scope.zig",
      "first_line": 89,
      "last_line": 92,
      "bytes": 377,
      "sha256": "47DFE47B4DCDBBA73AAB7F71465DC25227DC16AD2A7474698968494D67A9745D",
      "text": "    pub fn truthy(self: *Scope, value: c.JSValue) bool { return c.JS_ToBool(self.engine.context, value) == 1; }\n    pub fn equal(self: *Scope, left: c.JSValue, right: c.JSValue) bool { return c.JS_IsStrictEqual(self.engine.context, left, right); }\n    pub fn finish(self: *Scope, result: anyerror!c.JSValue) !c.JSValue { return self.boundary.finish(result, &self.values); }\n};\n"
    },
    {
      "label": "src/native_node_file_handle_owner_test_support.zig",
      "first_line": 117,
      "last_line": 138,
      "bytes": 897,
      "sha256": "DC0185B04639065C6A675E3DAF34533045BE6F66144BC5CCC7CA0284BE19EA37",
      "text": "fn finishImmediate(engine: *em.Engine, raw: ?*anyopaque, outcome: anyerror!bool) !bool {\n    const frame: *NativeCallback = @ptrCast(@alignCast(raw.?));\n    const f = frame.fixture;\n    var handles = a.Scope.init(engine);\n    var worked = false;\n    var failure: ?anyerror = null;\n    if (outcome) |value| worked = value else |err| {\n        handles.boundary.escaping();\n        failure = err;\n        frame.scope.markFailed();\n    }\n    frame.scope.deinit() catch |err| {\n        handles.boundary.escaping();\n        if (failure == null) failure = err;\n    };\n    if (frame.prior_javascript) |previous|\n        _ = c.JS_PiExchangeJavascriptExecutionAllowed(engine.runtime, previous);\n    f.env().allocator().destroy(frame);\n    const ignored = try handles.finish(if (failure) |err|\n        @as(anyerror!c.JSValue, err) else c.pi_js_undefined());\n    engine.freeValue(ignored);\n    return worked;\n"
    },
    {
      "label": "src/native_node_file_handle_owner_test_support.zig",
      "first_line": 484,
      "last_line": 494,
      "bytes": 616,
      "sha256": "8594F738D5AE74CD497CFF4A85F16D9808F4E6ED5DAD9D12F1C9855E83C4DE4C",
      "text": "    pub fn pumpIo(self: *Fixture) !void {\n        const limit = physical.uv_hrtime() + 10 * std.time.ns_per_s;\n        while (self.env().requests.waiting != 0) {\n            if (c.JS_IsJobPending(self.engine.runtime)) return error.UnselectedConcreteFileHandleJobQueue;\n            const pump = self.engine.native_env_pump orelse return error.ConcreteFileHandleHubRequired;\n            _ = try pump(self.engine);\n            if (self.env().requests.waiting == 0) break;\n            if (physical.uv_hrtime() >= limit) return error.ConcreteFileHandleCompletionTimeout;\n            physical.uv_sleep(1);\n        }\n    }\n"
    },
    {
      "label": "src/native_node_file_handle_read_test_support.zig",
      "first_line": 386,
      "last_line": 400,
      "bytes": 860,
      "sha256": "B2D9337F84A86025C2A9CC44F2054AA06B53CD064BFF6A22C31F60B09EF6ACE4",
      "text": "    pub fn pump(self: *Fixture) !void {\n        const until = physical.uv_hrtime() + 10 * std.time.ns_per_s;\n        while (self.env().requests.waiting != 0) {\n            if (c.JS_IsJobPending(self.engine.runtime)) return error.UnselectedFileHandleReadTaskQueue;\n            const pump_native = self.engine.native_env_pump orelse return error.ActualFileHandleReadHubRequired;\n            _ = try pump_native(self.engine);\n            if (self.env().requests.waiting == 0) break;\n            if (physical.uv_hrtime() >= until) return error.ActualFileHandleReadCompletionTimeout;\n            physical.uv_sleep(1);\n        }\n    }\n    pub fn takeCaught(self: *Fixture) !c.JSValue {\n        const reason = self.engine.captured_exception orelse return error.ActualFileHandleReadReasonRequired;\n        self.engine.captured_exception = null;\n        return reason;\n"
    },
    {
      "label": "src/native_node_reqwrap_callback_routing_test.zig",
      "first_line": 316,
      "last_line": 330,
      "bytes": 824,
      "sha256": "56EF912A5651FA4D2CAB92F7061938DD05E15150BAF06CB6FBC9EB605D1D73C4",
      "text": "    fn pump(self: *Fixture) !void {\n        const until = physical.uv_hrtime() + 10 * std.time.ns_per_s;\n        while (self.env().requests.waiting != 0) {\n            if (c.JS_IsJobPending(self.engine.runtime)) return error.UnselectedReqWrapTaskQueue;\n            const pump_native = self.engine.native_env_pump orelse return error.ActualReqWrapHubRequired;\n            _ = try pump_native(self.engine);\n            if (self.env().requests.waiting == 0) break;\n            if (physical.uv_hrtime() >= until) return error.ActualReqWrapCompletionTimeout;\n            physical.uv_sleep(1);\n        }\n    }\n    fn takeCaught(self: *Fixture) !c.JSValue {\n        const actual = self.engine.captured_exception orelse return error.ActualReqWrapReasonRequired;\n        self.engine.captured_exception = null;\n        return actual;\n"
    },
    {
      "label": "src/native_node_callback_scope_test.zig",
      "first_line": 127,
      "last_line": 137,
      "bytes": 579,
      "sha256": "47EAE73937D7E731A2D806176B69BE4610167A71D7A2EBA38E040B715C61C449",
      "text": "    fn initScope(self: *Fixture, scope: *callbacks.Scope, resource: c.JSValue,\n        id: callbacks.AsyncContext, flags: callbacks.Flags, frame: c.JSValue) !void {\n        // init acquires native/JS owners before its fallible hook and stack work.\n        // Retire a partially initialized scope before the fixture can disarm.\n        scope.initialized = false;\n        errdefer if (scope.initialized and !scope.deinitialized) {\n            scope.markFailed();\n            scope.deinit() catch {};\n        };\n        try scope.init(self.env(), resource, id, flags, frame);\n    }\n"
    },
    {
      "label": "src/native_node_callback_scope_test.zig",
      "first_line": 258,
      "last_line": 299,
      "bytes": 2620,
      "sha256": "0078C5004998DF83B36CC6538A2C477E883753C8A0C09D25601B4B2D60949436",
      "text": "test \"native Node callback scope closes once before releasing the callback-depth owner\" {\n    var f: Fixture = undefined; try f.init(true, false); defer f.deinit();\n    f.env().field(.after).* = 1;\n    const resource = try f.value(\"({})\"); defer f.engine.freeValue(resource);\n    var scope: callbacks.Scope = undefined;\n    try f.initScope(&scope, resource, .{ .async_id = 2, .trigger_async_id = 0 }, .{ .skip_task_queues = true }, c.pi_js_undefined());\n    defer if (!scope.deinitialized) scope.deinit() catch {};\n    try scope.close(); try scope.close();\n    try std.testing.expectEqual(@as(usize, 1), f.env().callback_depth);\n    try std.testing.expectEqual(@as(u32, 0), f.env().field(.stack_length).*);\n    try f.expect(\"trace.length === 1 && trace[0][0] === 'after'\");\n    try scope.deinit();\n    try std.testing.expectEqual(@as(usize, 0), f.env().callback_depth);\n    try std.testing.expect(f.env().callback_scope == null);\n}\n\ntest \"native Node callback scope marked failure restores context while suppressing after and queues\" {\n    var f: Fixture = undefined; try f.init(true, false); defer f.deinit();\n    f.env().field(.before).* = 1; f.env().field(.after).* = 1;\n    const resource = try f.value(\"({})\"); defer f.engine.freeValue(resource);\n    const initial = try f.value(\"'before-failure'\"); defer f.engine.freeValue(initial);\n    const current = try f.value(\"'inside-failure'\"); defer f.engine.freeValue(current);\n    try f.env().setContextFrame(initial);\n    var scope: callbacks.Scope = undefined;\n    try f.initScope(&scope, resource, .{ .async_id = 6, .trigger_async_id = 0 }, .{}, current);\n    defer if (!scope.deinitialized) scope.deinit() catch {};\n    scope.markFailed();\n    try scope.deinit();\n    try f.expect(\"trace.length === 1 && trace[0][0] === 'before' && uid[0] === 0 && actualNodeFrame() === 'before-failure'\");\n}\n\ntest \"native Node callback scope skip hooks and task queues preserves actual push and pop\" {\n    var f: Fixture = undefined; try f.init(true, false); defer f.deinit();\n    f.env().field(.before).* = 1; f.env().field(.after).* = 1;\n    const resource = try f.value(\"({})\"); defer f.engine.freeValue(resource);\n    var scope: callbacks.Scope = undefined;\n    try f.initScope(&scope, resource, .{ .async_id = 8, .trigger_async_id = 4 },\n        .{ .skip_async_hooks = true, .skip_task_queues = true }, c.pi_js_undefined());\n    defer if (!scope.deinitialized) scope.deinit() catch {};\n    try f.expect(\"uid[0] === 8 && uid[1] === 4 && fields[7] === 1 && trace.length === 0\");\n    try scope.deinit();\n    try f.expect(\"uid[0] === 0 && fields[7] === 0 && trace.length === 0\");\n"
    },
    {
      "label": "Node FSReqPromise Resolve/Reject",
      "first_line": 219,
      "last_line": 251,
      "bytes": 1387,
      "sha256": "7219BF7029E73A413405C293F4351A8A55314F2F7B4A9140536E6952FC3C5C45",
      "text": "template <typename AliasedBufferT>\nvoid FSReqPromise<AliasedBufferT>::Reject(v8::Local<v8::Value> reject) {\n  finished_ = true;\n  v8::HandleScope scope(env()->isolate());\n  InternalCallbackScope callback_scope(this);\n  v8::Local<v8::Value> value;\n  if (!object()\n           ->Get(env()->context(), env()->promise_string())\n           .ToLocal(&value)) {\n    // If we hit this, getting the value from the object failed and\n    // an error was likely scheduled. We could try to reject the promise\n    // but let's just allow the error to propagate.\n    return;\n  }\n  v8::Local<v8::Promise::Resolver> resolver = value.As<v8::Promise::Resolver>();\n  USE(resolver->Reject(env()->context(), reject).FromJust());\n}\n\ntemplate <typename AliasedBufferT>\nvoid FSReqPromise<AliasedBufferT>::Resolve(v8::Local<v8::Value> value) {\n  finished_ = true;\n  v8::HandleScope scope(env()->isolate());\n  InternalCallbackScope callback_scope(this);\n  v8::Local<v8::Value> val;\n  if (!object()->Get(env()->context(), env()->promise_string()).ToLocal(&val)) {\n    // If we hit this, getting the value from the object failed and\n    // an error was likely scheduled. We could try to reject the promise\n    // but let's just allow the error to propagate.\n    return;\n  }\n  v8::Local<v8::Promise::Resolver> resolver = val.As<v8::Promise::Resolver>();\n  USE(resolver->Resolve(env()->context(), value).FromJust());\n}\n"
    },
    {
      "label": "Node InternalCallbackScope destructor and Close",
      "first_line": 107,
      "last_line": 148,
      "bytes": 1021,
      "sha256": "77335B3DC0C19F680F4A2E4D0DAD7EF401BE7714E04FBE9DFC22D6AD4B2F8B8D",
      "text": "\nInternalCallbackScope::~InternalCallbackScope() {\n  Close();\n  env_->PopAsyncCallbackScope();\n}\n\nvoid InternalCallbackScope::Close() {\n  if (closed_) return;\n  closed_ = true;\n\n  // This function must ends up with either cleanup the\n  // async id stack or pop the topmost one from it\n\n  auto perform_stopping_check = [&]() {\n    if (env_->is_stopping()) {\n      MarkAsFailed();\n      env_->async_hooks()->clear_async_id_stack();\n    }\n  };\n  perform_stopping_check();\n\n  if (env_->is_stopping()) return;\n\n  Isolate* isolate = env_->isolate();\n  auto idle = OnScopeLeave([&]() { isolate->SetIdle(true); });\n\n  if (!failed_ && async_context_.async_id != 0 && !skip_hooks_) {\n    AsyncWrap::EmitAfter(env_, async_context_.async_id);\n  }\n\n  if (pushed_ids_) {\n    env_->async_hooks()->pop_async_context(async_context_.async_id);\n\n    async_context_frame::exchange(isolate, prior_context_frame_.Get(isolate));\n  }\n\n  if (failed_) return;\n\n  if (env_->async_callback_scope_depth() > 1 || skip_task_queues_) {\n    return;\n  }\n\n"
    }
  ],
