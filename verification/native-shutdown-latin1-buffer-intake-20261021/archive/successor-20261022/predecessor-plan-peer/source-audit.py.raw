assert handoff["complete_current_plan_replacements"]==8 and handoff["complete_current_plan_new_paths_including_manifest"]==239
assert handoff["manifest_issued"] is False and handoff["source_release"] is False

# Every selected immutable input remains byte-identical at the end of this read-only observation.
for key,row in list(pins.items()):assert pin(Path(row["path"]),Path(row["path"]).read_bytes())==row
result={"schema":1,"status":"passed_independent_inert_pending20_copy_plan_checks","recorded_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"plan":plan_pin,"source_acceptance":plan["source_acceptance"],"paused_record":plan["paused_record"],"accepted_source_peer":plan["source_peer"],"accepted_source_replay":plan["source_replay"],"source_rows":source_checks,"all20_paused_selections_equal":True,"immutable_git_preimages":git_reads,"all12_additions_absent_in_immutable014":True,"physical_archive_paths":223,"logical_immutable_donors":248,"logical_donor_raw_rehashes_passed":248,"full_byte_deduplicated_alias_count":25,"archive_bytes_before_dedup":before_bytes,"archive_bytes_to_copy":after_bytes,"archive_bytes_saved":before_bytes-after_bytes,"dedup_groups":dedup_groups,"historical_snapshot_aliases":historical_aliases,"historical_alias_locations_not_read":True,"all_90_and_72_frozen_packet_members":coverage,"all202_accepted_source_replay_inputs_preserved":True,"six_root_authorities":root_authorities,"retained12_negative_predecessor_versions":plan["retained_negative_and_rejected_versions"],"explicit_json_reference_sites_verified":json_sites,"special_reference_site_counts":dict(special_counts),"all244_core_plus_manifest_paths_canonical_unique_and_no_ancestor_collision":True,"plan_handoff":handoff_pin,"supplemental_plan_rows":supplemental,"current_planned_paths_including_three_supplements_and_manifest":247,"all247_paths_canonical_unique_and_no_ancestor_collision":True,"future_final_path_count":None,"future_review_receipts_excluded_from_core_count":True,"external_historical_references":external,"closure_boundary":plan["coverage"]["graph_boundary"],"fully_self_contained_archive_claim":False,"source_order_and_scope":scope,"future_full_git_byte_preflight_contract":pre,"current_git_conversion_preflight_performed":False,"future_requirements":req,"exact_inputs_rehashed":sorted(pins.values(),key=lambda x:norm(x["path"])),"input_versions":len(pins),"Main_accessed":False,"existing_artifacts_changed":False,"candidate_or_prefix_executed":False,"intake_or_archive_executed":False,"manifest_issued":False,"configuration_issued":False,"source_release":False,"native_executed":False,"application_qualified":False}
raw=encode(result);target=OUT/"source-proof.json";assert not target.exists()
with target.open("xb") as f:f.write(raw)
assert target.read_bytes()==raw
print(json.dumps(pin(target,raw)))
print(json.dumps({"inputs":len(pins),"source_paths":20,"archives":223,"logical_donors":248,"historical_aliases":9,"deduplicated_copies":25,"json_sites":140,"immutable_git_reads":8,"future_manifest_included":True,"Main_accessed":False,"target_execution":False}))
