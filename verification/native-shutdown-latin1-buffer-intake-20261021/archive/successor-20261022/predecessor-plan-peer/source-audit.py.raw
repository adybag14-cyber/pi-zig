    readp(row["donor"]);supp_ids.append(ident(row["donor"]))
assert supp_ids==[ident(handoff[k]) for k in ("plan","static_checker","static_proof")]
all_final_keys=keys+[target_ok(r["relative_path"]) for r in supplemental]
assert len(all_final_keys)==len(set(all_final_keys))==247
