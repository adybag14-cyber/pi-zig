  "future_full_git_byte_preflight_contract": {
    "status": "required_future_Root_action_not_run",
    "scope": "Every future copied path: all twenty source/build rows, every physical archive row, any explicitly added final review/plan rows, and the eventual manifest itself. No extension or small-file exception.",
    "preconditions": [
      "The exact Root source release and reviewed adapter/manifest pins exist; all V38 required validation phases and original process intervals have independently closed.",
      "Reverify final head, clean index/worktree, canonical repository root and object format. Enumerate the exact finite path list, including manifest, with no directory glob staging.",
      "Rehash every donor and any content-dedup alias. Check all eight raw checkout and raw committed-Git preimages and all new target absences before any source/index write.",
      "Canonicalize Windows targets: relative forward-slash paths only, no parent traversal, absolute/drive/UNC/ADS/device names, .git components, trailing-dot/space aliases, case-fold duplicates or file/directory ancestor collisions. Existing parents may not redirect outside the repository."
    ],
    "attributes_argv": [
      "git",
      "-C",
      "<actual-root-released-repository>",
      "check-attr",
      "-z",
      "--stdin",
      "text",
      "eol",
      "filter",
      "working-tree-encoding",
      "ident"
    ],
    "attributes_stdin": "Exact NUL-delimited list of every final relative target, including manifest. Capture the complete effective per-path attribute map and relevant configuration/attribute provenance before mutation.",
    "disallowed_attributes": "For every target, filter, working-tree-encoding and ident must be unset or unspecified. Do not invoke a configured content filter. Do not modify attributes or normalize donors to make a failed byte gate pass.",
    "raw_blob_argv": [
      "git",
      "-C",
      "<actual-root-released-repository>",
      "hash-object",
      "--no-filters",
      "--stdin"
    ],
    "path_aware_blob_argv": [
      "git",
      "-C",
      "<actual-root-released-repository>",
      "hash-object",
      "--path=<one-exact-relative-target>",
      "--stdin"
    ],
    "hash_stdin": "Pass the exact donor bytes through a binary stdin API, never a text shell pipeline. Run both read-only hash-object forms without -w only after the disallowed-attribute gate.",
    "required_equality": "For every final target, raw Git object ID must equal the path-aware clean-conversion object ID. Recompute the raw blob header/content digest for the repository object format and compare it with the raw Git result. Record raw size/SHA-256, both Git IDs, effective attributes, donor pin and exact target.",
    "raw_archive_suffix_limit": "A .raw suffix is a preservation measure, not evidence that conversion is disabled. Every archive still requires the actual path-aware check under the final repository attributes.",
    "before_writes": "Complete all donor, preimage, path, attribute and raw/path-aware blob checks for the entire final manifest before the first Main or index mutation. Store the exact preflight as a new immutable receipt.",
    "after_copy_before_staging": "Read back every copied target and require byte-for-byte equality, exact length and SHA-256 with its donor. Revalidate unchanged target attributes/configuration; keep all original donor and preimage files.",
    "staging": "Stage only the exact reviewed NUL-delimited path list, including manifest. Require the complete staged path set to match exactly, with no unexpected path or mode. For each stage-zero blob, read raw bytes with cat-file and require exact equality with the donor, plus the preflight raw Git ID. Never apply text decoding to blobs.",
    "after_commit": "Root must verify the exact commit parent and changed-path set, then read every committed raw blob and compare it byte-for-byte with the pinned donor and staged/preflight identity. Record actual commit, receipt and source hold state; no native or application qualification is conferred.",
    "failure_rule": "Preserve any mismatch as a new immutable negative and stop before the prohibited next write. Do not relax filters, normalization, source counts or expected preimages. Any fix requires a distinct finite reviewed successor and a separate applicable Root release."
  },
  "current_git_conversion_preflight_performed": false,
  "future_requirements": {
    "required_actual_original63_buildquery_closure": null,
    "required_actual_original63_strict_runtime_closure": null,
    "required_current_V38_all_original_process_closure": null,
    "required_Root_source_intake_release": null,
    "required_finite_intake_adapter": null,
    "required_independent_adapter_manifest_peer": null,
    "required_exact_final_manifest": null,
    "required_current_head_and_clean_index_observation": null,
    "required_complete_current_byte_conversion_preflight": null,
    "all_requirements_unissued": true,
    "source_head_policy": "Use the exact Root-released head after original63 validation and all current validation processes close. This plan proves only the immutable014 source basis. Any change in one of the eight preimages, any collision with a new source or archive target, or any source/build rebase requires a distinct finite reviewed successor; never treat this plan as authority to overwrite.",
    "receipt_policy": "Later adapter, review, release, preflight, staged/path-list, commit and receipt records must be separately retained with exact observed pins. Their future identities, timestamps and outcomes are not fabricated here.",
    "plan_record_policy": "After the inert plan and its own static checker/proof are sealed, their exact pins may be added as three separately enumerated archive rows in the small handoff. The explanatory handoff is retained outside Main and need not be recursively copied. Any additional later intake records require an explicit manifest successor and externally pinned release."
  },
