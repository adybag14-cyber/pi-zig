def reach(root,target=None):
 todo=[root];parent={root:None}
 for p in todo:
  if p==target:
   out=[]
   while p is not None:out.append(p);p=parent[p]
   return out[::-1]
  for e in aug.get(p,[]):
   q=e["target"]
   if q not in parent:parent[q]=p;todo.append(q)
 return None if target else sorted(parent)
s=original.decode();ts=lex(s);fields=[]
for i,t in enumerate(ts):
 if t[0]=="."and i+2<len(ts)and ts[i+1][0]=="root_source_file"and ts[i+2][0]=="=":
  j=i+3;k=j;depth=0
  while k<len(ts):
   x=ts[k][0]
   if x==","and depth==0:break
   if x in ("(","[","{"):depth+=1
   if x in (")","]","}"):depth-=1
   k+=1
  expr=s[ts[j][1]:ts[k-1][2]]
  fields.append({"line":s.count("\n",0,t[1])+1,"expression":expr})
