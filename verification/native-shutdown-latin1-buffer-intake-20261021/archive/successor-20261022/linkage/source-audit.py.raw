rx=re.compile(r'(?P<comment>//[^\n]*)|(?P<multiline>\\\\[^\n]*)|(?P<string>"(?:\\.|[^"\\])*")|(?P<char>\'(?:\\.|[^\'\\])*\')|(?P<word>@?[A-Za-z_][A-Za-z_0-9]*)|(?P<punct>\S)')
def lex(s):return [(m.group(),m.start(),m.end(),m.lastgroup)for m in rx.finditer(s)if m.lastgroup not in ("comment","multiline")]
