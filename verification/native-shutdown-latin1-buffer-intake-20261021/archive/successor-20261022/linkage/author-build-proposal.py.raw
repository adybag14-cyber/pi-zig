assert sha(plan_raw)=="E2B029B3F00709B40FD82233194961CDEFE0E7949931EEE15C39D757EB6B4B74"
plan=json.loads(plan_raw)
rows=plan["source_rows"];assert len(rows)==20
selected={r["relative_path"]:r for r in rows};assert len(selected)==20
for r in rows:
 p=r["donor"];raw=Path(p["path"]).read_bytes()
