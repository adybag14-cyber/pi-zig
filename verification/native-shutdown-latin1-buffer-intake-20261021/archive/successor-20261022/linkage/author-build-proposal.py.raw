from pathlib import Path
import hashlib,json,re
W=Path(r"C:\Users\adyba\pi-zig\worktrees\modules-io-resume-20261018")
B=W.parents[1]
D=W/"verification/native-node-shutdown-linkage-build-successor-sourceonly-20261022"
sha=lambda b:hashlib.sha256(b).hexdigest().upper()
def pin(p):
 r=p.read_bytes();return {"path":str(p),"bytes":len(r),"sha256":sha(r)}
plan_p=B/"evidence/unissued-shutdown-latin1-buffer-union014-intake-plan-20261021/copy-manifest-plan.json"
