{
  "schema": "finite_intake_adapter_reuse_plan_v1",
  "status": "inert_source_only_reuse_inventory",
  "conclusion": "Reuse the accepted V37 progress adapter for a future V38 progress/archive intake. The accepted V37 fixture adapter is an equally capable mixed source/addition base for the pending twenty-source union; their eleven helpers and entire rows-to-end tail are identical. The union's accepted stronger byte-conversion contract needs a separately reviewed bounded successor, not only identity literal changes.",
  "recommendations": [
    {
      "purpose": "V38 archive/progress",
      "baseline": "Apply-ExactV37ProgressNegativeIntake-20261021.py",
      "minimal_future_changes": [
        "Docstring/version description",
        "BASIS to actual Root-released head",
        "The single MANIFESTS tuple: actual manifest path/hash/count/subject"
      ],
      "unchanged_phase": "progress",
      "note": "No actual V38 output manifest, release, future count, or actual original63 outcome is asserted here. Preserve accepted history/gzip/source proofs in the final manifest and required_current_pins."
    },
    {
      "purpose": "Pending twenty-source Shutdown/Latin1/Buffer union",
      "baseline": "Apply-ExactV37FixtureSourceIntake-20261021.py",
      "minimal_future_changes": [
        "Docstring/phase description",
        "BASIS to actual Root-released head",
        "MANIFESTS tuple with actual final manifest/hash/count/subject",
        "If phase changes from fixture, update both dictionary key and explicit predecessor phase assertion"
      ],
      "additional_contract_work": "Implement or explicitly bind an independently reviewed complete preflight/stage/commit successor meeting the accepted E2B copy-plan contract listed below. Do not represent the existing adapter as already recording every promised field."
    }
  ],
  "consumed_release_schema": {
    "cli": "python <exact-adapter> <phase> <absolute-release-path> <exact-release-sha256>",
    "release_must_be_within": "C:\\Users\\adyba\\pi-zig\\evidence",
    "fields": {
      "executor_sha256": "exact hash of __file__",
      "basis_main_head": "exact hard-coded BASIS",
      "branch": "work/pi-zig-consolidated-20261016",
      "source_intake_authorized": true,
      "native_execution_authorized": false,
      "application_qualified": false,
      "authorized_phases": "Object keyed by phase; selected record binds manifest_sha256 and total_commit_paths",
      "required_current_pins": "Array of {path,bytes,sha256}; every path inside project ROOT and each exact byte version rehashed",
      "receipt_directory": "New receipt namespace inside ROOT/evidence; selected phase-receipt.json must not exist"
    },
    "distinction": "These are the fields consumed by the existing source, not an exact-key JSON schema. Historical Root releases also carry reviewer/time/scope/executor and qualification metadata. This plan is not a release."
  },
  "consumed_manifest_schema": {
    "root_fields": [
      "rows",
      "target_manifest OR manifest_target"
    ],
    "row_fields": {
      "target": "relative forward-slash path",
      "source": "absolute pinned donor inside project ROOT",
      "bytes": "raw donor length",
      "sha256": "uppercase raw SHA-256",
      "before": "null for addition; otherwise {bytes,sha256}",
      "role": "preserved in preflight"
    },
    "manifest_self_row": "The adapter appends the manifest as one synthetic row using the externally pinned raw manifest hash. The manifest does not self-hash.",
    "total_count": "MANIFESTS count and release total_commit_paths include that synthetic manifest row.",
    "allowed_target_prefixes": [
      "build.zig",
      "src/",
      "vendor/quickjs/",
      "verification/"
    ],
    "additional_metadata": "Comparison bases, archive maps, history inverses, qualification fields and other semantic proof remain in the exact reviewed manifest or separately pinned evidence; the generic adapter does not rederive those semantics."
  },
  "existing_gates": [
    {
      "stage": "Release and repository admission",
      "checks": [
        "Exact release bytes, adapter self hash, BASIS, branch, source-only authority and selected manifest/count",
        "Rehash every required_current_pin before Main/index mutation",
        "Exact branch; empty status including untracked files; receipt absent",
        "No core.hooksPath override or non-sample hook files; core.autocrlf must be literal false",
        "Current HEAD equals hard-coded BASIS"
      ]
    },
    {
      "stage": "Finite donor and preimage admission",
      "checks": [
        "All paths including synthetic manifest are checked; case-fold duplicate targets rejected",
        "Target resolves inside Main; donor resolves inside project ROOT; accepted target prefixes only",
        "Every donor exact length/SHA-256",
        "Addition absent on disk and basis/head trees",
        "Replacement exact raw live bytes and exact committed basis/head cat-file bytes",
        "Existing parent symlink check; HEAD and complete clean status rechecked before writes"
      ]
    },
    {
      "stage": "Existing byte-conversion gate",
      "checks": [
        "Exact NUL-delimited all-target list passed to check-attr for filter, working-tree-encoding and ident",
        "Those three attributes must be unset or unspecified before path-aware hashing",
        "Per donor: compute SHA-1 Git blob header+bytes digest in Python; compare with git hash-object --path=<relative-target> --stdin over exact binary input, without -w",
        "Manifest, archives and source/build paths all participate; .raw is not exempt"
      ],
      "limits": [
        "Hard-coded SHA-1; no object-format query",
        "No explicit --no-filters Git hash result or recorded per-path pair",
        "text/eol and attribute/config provenance are not captured in the existing preflight"
      ]
    },
    {
      "stage": "Copy and stage",
      "checks": [
        "All listed preflight checks complete before first Main or index write",
        "Create-only preflight/pathspec/commit-message evidence",
        "Additions use xb; replacements use newly created temporary donor bytes plus os.replace",
        "Read back every target exactly",
        "git add only the exact NUL pathspec; exact staged changed-name set/count; no unstaged diff or untracked files",
        "Every raw stage-zero blob equals donor bytes; HEAD still unchanged"
      ],
      "limits": [
        "No explicit stage mode inventory",
        "No attribute/config revalidation after copy in existing source"
      ]
    },
    {
      "stage": "Commit and final receipt",
      "checks": [
        "Ordinary git commit with pinned subject/message and hooks admission",
        "Commit differs; its first parent equals the prior HEAD",
        "Exact changed-name set/count",
        "Every committed raw blob and checkout file equals donor bytes",
        "Final clean status and create-only receipt recording actual head, manifest, adapter and release hashes plus raw commit output"
      ],
      "limits": [
        "The source checks after^, not an explicit complete parent list",
        "No explicit committed mode inventory",
        "No push or native execution"
      ]
    }
  ],
  "pending_union_contract_differences": [
    {
      "requirement": "Canonical final repository and paths",
      "existing": "Checks configured branch/head, inside resolution, relative path basics, casefold uniqueness and parent symlinks.",
      "needed": "Record canonical repository root and object format; enforce the accepted Windows canonical-path/device/.git/trailing-dot-space/ancestor-collision contract for the complete final target list."
    },
    {
      "requirement": "All logical aliases",
      "existing": "Physical row donors and release required_current_pins are rehashed.",
      "needed": "Put every exact logical donor/dedup alias into required_current_pins or an equally strict pinned complete alias preflight. Deduplication does not drop an authority."
    },
    {
      "requirement": "Full effective attributes and provenance",
      "existing": "Checks filter, working-tree-encoding and ident only.",
      "needed": "Capture text/eol as well as the three disallowed attributes, plus relevant configuration/attribute provenance. Keep disallowed attributes rejected before any filter-capable hash call."
    },
    {
      "requirement": "Two Git IDs and raw algorithm",
      "existing": "Python SHA-1 raw blob compared to path-aware Git ID.",
      "needed": "Query repository object format; independently compute that raw digest and compare both read-only git hash-object --no-filters --stdin and --path=<target> --stdin IDs. Record sizes/SHA-256/IDs/attributes/donor/target for every path including manifest."
    },
    {
      "requirement": "After-copy invariance",
      "existing": "Reads back exact target bytes.",
      "needed": "Revalidate effective target attributes/configuration before staging and preserve the original preflight values."
    },
    {
      "requirement": "Index and commit identity",
      "existing": "Exact name sets and raw blob equality.",
      "needed": "Record stage-zero modes and IDs, reject unexpected modes; compare index and committed IDs with the preflight raw IDs and assert the complete one-parent relation."
    },
    {
      "requirement": "Mismatch preservation",
      "existing": "Assertions stop the adapter; Root may preserve the failed job externally.",
      "needed": "Retain every mismatch as a distinct immutable negative through the reviewed failure-observation mechanism; never normalize bytes or relax attributes/preimages to continue."
    }
  ],
  "future_manifest_translation": {
    "pending20": "Translate source_rows and physical archive_rows into target/source/bytes/sha256/before/role rows without touching donor bytes. Keep logical donor identities, historical aliases, preserved negatives and external-reference limits in the exact manifest/archive map. Add the manifest itself through the common synthetic-row logic.",
