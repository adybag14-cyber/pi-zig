def sha(b):return hashlib.sha256(b).hexdigest().upper()
def pin(x):
 b=Path(x["path"]).read_bytes();assert len(b)==x["bytes"] and sha(b)==x["sha256"],x
 return b
def new(name,v):
 p=D/name;assert not p.exists(),str(p);b=(json.dumps(v,indent=2)+"\n").encode()
 with p.open("xb")as f:f.write(b)
 assert p.read_bytes()==b
 return {"path":str(p),"bytes":len(b),"sha256":sha(b)}
