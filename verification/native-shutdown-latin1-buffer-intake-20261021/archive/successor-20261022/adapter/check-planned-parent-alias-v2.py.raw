assert cur==base
def helpers(raw):
 tree=ast.parse(raw.decode());lines=raw.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno])for n in tree.body if isinstance(n,ast.FunctionDef)}
h0=helpers(old);h1=helpers(selected);assert h0==h1 and len(h1)==22
hb=helpers(base);assert len(hb)==11 and all(h1[k]==v for k,v in hb.items())
