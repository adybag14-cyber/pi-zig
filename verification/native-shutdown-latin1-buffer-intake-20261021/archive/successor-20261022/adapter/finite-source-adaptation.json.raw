      "before_utf8": "names=[]; contents=[]; preimages=[]; basis_paths=tree_paths(BASIS); head_paths=tree_paths(head)\nfor row in allrows:\n rel=row[\"target\"]; pp=PurePosixPath(rel)\n assert not pp.is_absolute() and \"\\\\\" not in rel and \":\" not in rel and all(x not in (\"..\",\".\") for x in pp.parts),rel\n assert rel==\"build.zig\" or rel.startswith((\"src/\",\"vendor/quickjs/\",\"verification/\")),rel\n target=inside(MAIN/rel,MAIN); donor=inside(row[\"source\"],ROOT)\n b=pinned(donor,row[\"sha256\"]); assert len(b)==row[\"bytes\"]\n names.append(rel); contents.append(b)\n before=row[\"before\"]\n if before is None:\n  assert not target.exists() and rel not in basis_paths and rel not in head_paths,rel\n else:\n  old=pinned(target,before[\"sha256\"]); assert len(old)==before[\"bytes\"]\n  assert rel in basis_paths and rel in head_paths,rel\n  preimages.append((row,old))\nassert len(set(x.casefold() for x in names))==count\n",
      "after_utf8": "FAILURE_STATE.update(stage=\"complete_donor_path_and_preimage_admission\",before_head=head)\nnames=[]; contents=[]; preimages=[]; basis_paths=tree_paths(BASIS); head_paths=tree_paths(head)\nprior_entries=tree_entries(head);assert set(prior_entries)==head_paths==basis_paths\nexisting_spelling={}\nfor rel in head_paths:\n parts=rel.split(\"/\")\n for depth in range(1,len(parts)+1):\n  value=\"/\".join(parts[:depth]);key=value.casefold()\n  assert key not in existing_spelling or existing_spelling[key]==value,(\"existing_case_alias\",value)\n  existing_spelling[key]=value\nfor row in allrows:\n rel=target_name(row[\"target\"]);no_reparse_target(rel)\n assert row[\"mode\"] in (\"100644\",\"100755\"),(rel,row[\"mode\"])\n parts=rel.split(\"/\")\n for depth in range(1,len(parts)+1):\n  value=\"/\".join(parts[:depth]);key=value.casefold()\n  assert key not in existing_spelling or existing_spelling[key]==value,(\"target_existing_case_alias\",value)\n target=inside(MAIN/rel,MAIN); donor=inside(row[\"source\"],ROOT)\n assert MAIN.resolve() not in donor.parents and donor!=MAIN.resolve(),(\"donor_must_be_outside_Main\",str(donor))\n b=pinned(donor,row[\"sha256\"]); assert len(b)==row[\"bytes\"]\n names.append(rel); contents.append(b)\n before=row[\"before\"]\n if before is None:\n  assert row[\"mode\"]==\"100644\",(\"new_regular_source_or_archive_mode\",rel)\n  assert not os.path.lexists(target) and rel.casefold() not in existing_spelling,rel\n  assert rel not in basis_paths and rel not in head_paths,rel\n else:\n  assert before[\"mode\"]==row[\"mode\"],(\"source_intake_does_not_change_existing_mode\",rel)\n  assert prior_entries[rel][\"type\"]==\"blob\" and prior_entries[rel][\"mode\"]==before[\"mode\"],rel\n  old=pinned(target,before[\"sha256\"]); assert len(old)==before[\"bytes\"]\n  assert rel in basis_paths and rel in head_paths,rel\n  assert prior_entries[rel][\"oid\"]==raw_oid(old,object_format),(\"preimage_object_id\",rel)\n  preimages.append((row,old))\nassert len(set(x.casefold() for x in names))==count\nfolded_names={x.casefold() for x in names}\nfor rel in names:\n parts=rel.split(\"/\")\n assert not any(\"/\".join(parts[:depth]).casefold() in folded_names for depth in range(1,len(parts))),(\"file_directory_target_collision\",rel)\nlogical_aliases=manifest[\"logical_donor_aliases\"]\nassert len(logical_aliases)==release[\"authorized_phases\"][phase][\"logical_donor_alias_count\"]\nphysical={row[\"target\"]:(row,b) for row,b in zip(allrows,contents)}\nalias_records=[];alias_keys=set()\nfor alias in logical_aliases:\n rel=alias[\"target\"];assert rel in physical and rel!=target_manifest,rel\n row,b=physical[rel];donor=inside(alias[\"source\"],ROOT)\n assert MAIN.resolve() not in donor.parents and donor!=MAIN.resolve(),str(donor)\n alias_bytes=pinned(donor,alias[\"sha256\"])\n assert len(alias_bytes)==alias[\"bytes\"] and alias_bytes==b,(\"logical_donor_alias_bytes\",rel,str(donor))\n key=(rel,str(donor).casefold(),alias[\"bytes\"],alias[\"sha256\"])\n assert key not in alias_keys,(\"duplicate_logical_donor_identity\",key)\n alias_keys.add(key)\n alias_records.append({**alias,\"canonical_donor\":str(donor),\"same_physical_bytes\":True})\nfor row in rows:\n key=(row[\"target\"],str(inside(row[\"source\"],ROOT)).casefold(),row[\"bytes\"],row[\"sha256\"])\n assert key in alias_keys,(\"physical_donor_missing_from_logical_inventory\",row[\"target\"])\nalias_records.append({\"target\":target_manifest,\"source\":str(manifest_path),\"bytes\":len(manifest_raw),\n \"sha256\":manifest_sha,\"canonical_donor\":str(manifest_path),\"same_physical_bytes\":True,\"synthetic_manifest\":True})\n",
