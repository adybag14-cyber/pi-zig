def sha(b):return hashlib.sha256(b).hexdigest().upper()
def checked(pin):
 b=Path(pin["path"]).read_bytes()
 assert len(b)==pin["bytes"] and sha(b)==pin["sha256"],pin
 return b
def describe(path,b):return {"path":str(path),"bytes":len(b),"sha256":sha(b)}
def write_new(path,value):
 b=(json.dumps(value,indent=2,ensure_ascii=False)+"\n").encode("utf-8")
 assert not path.exists(),str(path)
 with path.open("xb") as f:f.write(b)
 assert path.read_bytes()==b
 return describe(path,b)
def functions(raw):
 lines=raw.splitlines(keepends=True);tree=ast.parse(raw.decode("utf-8"))
 return {node.name:(b"".join(lines[node.lineno-1:node.end_lineno]),node.lineno,node.end_lineno)
  for node in tree.body if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef))}
outputs=[D/"finite-source-adaptation.json",D/"static-source-proof.json"]
assert all(not path.exists() for path in outputs)
loaded=[checked(pin) for pin in PINS]
base,gap_raw,plan_raw,accept_raw,cap_raw,selected,declared_raw=loaded
gap=json.loads(gap_raw);plan=json.loads(plan_raw);accept=json.loads(accept_raw);cap=json.loads(cap_raw)
declared=json.loads(declared_raw);steps=declared["edits"]
assert len(steps)==20
assert declared["baseline"]==PINS[0]
assert declared["candidate"]["path"]==PINS[5]["path"]
assert declared["candidate"]["sha256"]==PINS[5]["sha256"]
assert declared["candidate"]["bytes"]==PINS[5]["bytes"]
assert declared["candidate_or_prefix_executed"] is False
current=base;origins=list(range(len(base)));finite=[];labels=set()
for number,edit in enumerate(steps,1):
 assert edit["label"] not in labels
 labels.add(edit["label"])
 text=current.decode("utf-8");char_offset=edit["offset"]
 before=edit["before"].encode("utf-8");after=edit["after"].encode("utf-8")
 assert text[char_offset:char_offset+len(edit["before"])]==edit["before"],number
 offset=len(text[:char_offset].encode("utf-8"));assert current[offset:offset+len(before)]==before
 prefix=current[:offset];suffix=current[offset+len(before):]
 next_raw=prefix+after+suffix
 assert next_raw[:offset]==prefix and next_raw[offset+len(after):]==suffix
 finite.append({"step":number,"label":edit["label"],"current_offset_bytes":offset,
  "before_utf8":edit["before"],"after_utf8":edit["after"],
  "before_bytes":len(before),"after_bytes":len(after),"before_sha256":sha(before),"after_sha256":sha(after),
  "intermediate_before_bytes":len(current),"intermediate_before_sha256":sha(current),
  "intermediate_after_bytes":len(next_raw),"intermediate_after_sha256":sha(next_raw),
  "untouched_prefix":{"bytes":len(prefix),"sha256":sha(prefix)},
  "untouched_suffix":{"bytes":len(suffix),"sha256":sha(suffix)}})
 origins=origins[:offset]+[-1]*len(after)+origins[offset+len(before):]
 current=next_raw
assert current==selected
back=selected
for edit in reversed(finite):
 offset=edit["current_offset_bytes"];before=edit["before_utf8"].encode("utf-8");after=edit["after_utf8"].encode("utf-8")
 assert sha(back)==edit["intermediate_after_sha256"]
 assert back[offset:offset+len(after)]==after
 back=back[:offset]+before+back[offset+len(after):]
 assert sha(back)==edit["intermediate_before_sha256"]
assert back==base
# The full-line function bytes are parsed, never evaluated.
bf=functions(base);sf=functions(selected)
expected=["sha","raw","pinned","git","gout","inside","new_file","new_json","blob_many","tree_paths","no_hooks"]
assert list(bf)==expected and len(sf)==22
helpers=[]
for name in expected:
 old,old_start,old_end=bf[name];new,new_start,new_end=sf[name]
 assert old==new,name
 helpers.append({"name":name,"bytes":len(old),"sha256":sha(old),
  "baseline_lines":[old_start,old_end],"candidate_lines":[new_start,new_end],"complete_full_line_bytes_equal":True})
gap_helpers=gap["independently_recomputed_source_comparison"][0]["helpers"]
assert [(x["name"],x["bytes"],x["sha256"]) for x in helpers]==[(x["name"],x["bytes"],x["sha256"]) for x in gap_helpers]
new_helpers=[{"name":name,"bytes":len(value[0]),"sha256":sha(value[0]),"lines":[value[1],value[2]]}
 for name,value in sf.items() if name not in bf]
tail_start=base.index(b'rows=manifest["rows"]\n');tail=base[tail_start:]
assert len(tail)==5897 and sha(tail)=="E8CAF87944A614D7BAC12EF745B79D83314DD7CFAF94F06B99231E4D008A2F8E"
# Track every raw baseline byte that survives outside an explicitly replaced span.
fragments=[];i=0
while i<len(origins):
 if origins[i]<0:i+=1;continue
 start=i;original=origins[i];i+=1
 while i<len(origins) and origins[i]==original+(i-start):i+=1
 block=selected[start:i];assert block==base[original:original+len(block)]
 fragments.append({"baseline_start":original,"candidate_start":start,"bytes":len(block),"sha256":sha(block)})
covered={x for x in origins if x>=0};assert len(covered)==sum(x["bytes"] for x in fragments)
replaced=[];i=0
while i<len(base):
 if i in covered:i+=1;continue
 start=i;i+=1
 while i<len(base) and i not in covered:i+=1
 replaced.append({"baseline_start":start,"bytes":i-start,"sha256":sha(base[start:i])})
assert sum(x["bytes"] for x in replaced)+len(covered)==len(base)
tail_retained=sum(x>=tail_start for x in covered)
tail_accounting={"baseline_start":tail_start,"bytes":len(tail),"sha256":sha(tail),
 "retained_outside_declared_replacements_bytes":tail_retained,
 "inside_declared_replaced_spans_bytes":len(tail)-tail_retained,
 "all_5897_bytes_accounted":True,"entire_tail_unchanged":False}
# Fixed unresolved literals, no invented future intake identity.
tree=ast.parse(selected.decode("utf-8"));assignments={}
for node in tree.body:
 if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
  if node.targets[0].id in ("BASIS","MANIFESTS","BYTE_CONTRACT","ATTR_NAMES"):
   assignments[node.targets[0].id]=ast.literal_eval(node.value)
assert assignments["BASIS"]=="UNRESOLVED_PENDING20_RELEASED_HEAD______"
assert len(assignments["BASIS"])==40
manifest=assignments["MANIFESTS"];assert set(manifest)=={"fixture"}
