 'final_revalidation=assert_conversion_unchanged(',
 'new_json(receipt_path,receipt)']
positions=[main.index(marker) for marker in markers];assert positions==sorted(positions) and len(set(positions))==len(positions)
barriers=[{"marker":marker,"main_character_offset":pos} for marker,pos in zip(markers,positions)]
for required in [
 'assert raw_git==expected_blob','assert path_git==raw_git',
 'alias_bytes==b','assert key in alias_keys','assert before["mode"]==row["mode"]',
 'for rel in names: no_reparse_target(rel)',
 'assert blob==old,("basis_preimage",row["target"])',
 'assert blob==old,("head_preimage",row["target"])',
 'no_hooks()','"rollback_or_cleanup_performed":False',
 'assert actual_attributes==attributes','assert actual_provenance==provenance',
 'present=sorted(k for k in os.environ if k in unsafe or k.startswith("GIT_CONFIG_"))']:
 assert required in text,required
# The sole child invocation remains the original Git helper; no candidate import/evaluation exists.
run_calls=[node for node in ast.walk(tree) if isinstance(node,ast.Call) and isinstance(node.func,ast.Attribute)
 and isinstance(node.func.value,ast.Name) and node.func.value.id=="subprocess" and node.func.attr=="run"]
assert len(run_calls)==1
for node in ast.walk(tree):
 if isinstance(node,ast.Call) and isinstance(node.func,ast.Name):
  assert node.func.id not in {"eval","exec","compile","__import__"},node.func.id
