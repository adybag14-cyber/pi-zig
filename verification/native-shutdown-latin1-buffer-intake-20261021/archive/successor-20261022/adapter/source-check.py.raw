assert len(manifest["fixture"][1])==64
assert assignments["BYTE_CONTRACT"]=="pending20_exact_git_bytes_attributes_aliases_modes_v1"
assert assignments["ATTR_NAMES"]==("text","eol","filter","working-tree-encoding","ident")
text=selected.decode("utf-8")
assert 'if not __debug__: raise RuntimeError' in text
assert 'Future released source head is unresolved' in text and 'Future manifest bindings are unresolved' in text
assert text.index('Future manifest bindings are unresolved')<text.index('assert len(sys.argv)==4')
# Complete ordered main-body barriers. Helper definitions are outside this ordering.
main=text[text.index('assert len(sys.argv)==4'):]
markers=[
 'assert release["source_intake_authorized"] is True',
 'for pin in release["required_current_pins"]:',
 'repository=repository_identity()',
 'FAILURE_STATE.update(stage="complete_donor_path_and_preimage_admission"',
 'logical_aliases=manifest["logical_donor_aliases"]',
 'FAILURE_STATE["stage"]="complete_attribute_and_git_object_preflight"',
 'attributes=effective_attributes(names)',
 'raw_git=oid_text(git("hash-object","--no-filters","--stdin",input=b).stdout,object_format)',
 'path_git=oid_text(git("hash-object","--path="+rel,"--stdin",input=b).stdout,object_format)',
 'before_copy_revalidation=assert_conversion_unchanged(',
 'new_json(proof/(phase+"-preflight.json"),preflight)',
 'FAILURE_STATE.update(stage="copying_exact_reviewed_rows",Main_or_index_writes_started=True)',
 'post_copy_revalidation=assert_conversion_unchanged(',
