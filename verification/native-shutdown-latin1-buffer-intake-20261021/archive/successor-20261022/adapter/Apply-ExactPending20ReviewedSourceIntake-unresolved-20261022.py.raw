MANIFESTS={
 "fixture":("evidence/UNRESOLVED-PENDING20-FINAL-MANIFEST/manifest.json","UNRESOLVED_PENDING20_FINAL_MANIFEST_SHA256______________________",0,"Integrate independently reviewed Shutdown Latin1 and Buffer source"),
}
def sha(b): return hashlib.sha256(b).hexdigest().upper()
def raw(p): return Path(p).read_bytes()
def pinned(p,h):
 b=raw(p); assert sha(b)==h,(str(p),sha(b),h); return b
def git(*args,input=None,check=True):
 q=subprocess.run(["git",*args],cwd=MAIN,input=input,capture_output=True)
 if check: assert q.returncode==0,(args,q.returncode,q.stdout.decode("utf-8",errors="replace"),q.stderr.decode("utf-8",errors="replace"))
 return q
def gout(*args): return git(*args).stdout.decode("utf-8").strip()
def inside(p,base):
 p=Path(p).resolve(); base=Path(base).resolve()
 assert p==base or base in p.parents,(str(p),str(base))
 return p
def new_file(p,b):
 p=Path(p); assert not p.exists(),str(p)
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open("xb") as f: f.write(b)
def new_json(p,v): new_file(p,(json.dumps(v,indent=2,ensure_ascii=False)+"\n").encode("utf-8"))
def blob_many(specs):
 if not specs: return []
 response=git("cat-file","--batch",input=("\n".join(specs)+"\n").encode("utf-8")).stdout
 offset=0; result=[]
 for spec in specs:
  end=response.index(b"\n",offset); header=response[offset:end].split()
  assert len(header)==3 and header[1]==b"blob",(spec,header)
  size=int(header[2]); start=end+1; body=response[start:start+size]
  assert len(body)==size and response[start+size:start+size+1]==b"\n",spec
  result.append(body); offset=start+size+1
 assert offset==len(response)
 return result
def tree_paths(revision):
 return set(x.decode("utf-8") for x in git("ls-tree","-r","--name-only","-z",revision).stdout.split(b"\0") if x)
def no_hooks():
 q=git("config","--get","core.hooksPath",check=False); assert q.returncode==1
 hooks=Path(gout("rev-parse","--git-path","hooks"))
 if not hooks.is_absolute(): hooks=MAIN/hooks
 assert not [p for p in hooks.iterdir() if p.is_file() and not p.name.endswith(".sample")]
 assert gout("config","--get","core.autocrlf")=="false"

# These guards strengthen byte preservation without changing the11 inherited helpers.
BYTE_CONTRACT="pending20_exact_git_bytes_attributes_aliases_modes_v1"
ATTR_NAMES=("text","eol","filter","working-tree-encoding","ident")
FAILURE_STATE={"stage":"release_admission","Main_or_index_writes_started":False}
def fail_record(exc_type,exc,tb):
 try:
  stamp=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
  name=phase+"-negative-"+stamp+"-"+os.urandom(6).hex()+".json"
  value={"status":"preserved_exact_intake_failure","utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),
   "phase":phase,"release_path":str(release_path),"release_sha256":release_sha,
   "executor_sha256":self_sha,"state":dict(FAILURE_STATE),
   "exception_type":exc_type.__name__,"exception":str(exc),
   "traceback":"".join(traceback.format_exception(exc_type,exc,tb)),
   "native_execution_authorized":False,"application_qualified":False,"rollback_or_cleanup_performed":False}
  new_json(proof/name,value)
 except BaseException as capture_error:
  print("Immutable failure receipt could not be saved: "+repr(capture_error),file=sys.stderr)
 sys.__excepthook__(exc_type,exc,tb)
def target_name(rel):
 assert isinstance(rel,str) and rel and str(PurePosixPath(rel))==rel,rel
 assert not PurePosixPath(rel).is_absolute() and "\\" not in rel and ":" not in rel,rel
 assert not any(ord(c)<32 or ord(c)==127 or c in '<>"|?*' for c in rel),rel
 for part in rel.split("/"):
  assert part not in ("",".","..") and part[-1] not in ". ",rel
  lower=part.casefold()
  assert lower not in (".git",".gitattributes"),rel
  stem=lower.split(".",1)[0]
  assert not re.fullmatch(r"(con|prn|aux|nul|clock\$|conin\$|conout\$|com[1-9¹²³]|lpt[1-9¹²³])",stem),rel
 assert rel=="build.zig" or rel.startswith(("src/","vendor/quickjs/","verification/")),rel
 return rel
def no_reparse_target(rel):
 current=MAIN
 assert current.is_dir() and not current.is_symlink(),str(current)
 for part in [None,*PurePosixPath(rel).parts]:
  if part is not None: current=current/part
  if os.path.lexists(current):
   info=current.lstat()
   assert not current.is_symlink() and not (getattr(info,"st_file_attributes",0)&0x400),str(current)
   assert stat.S_ISDIR(info.st_mode) if current!=MAIN/rel else stat.S_ISREG(info.st_mode),str(current)
 inside(MAIN/rel,MAIN)
def oid_text(output,object_format):
 value=output.decode("ascii").strip()
 length={"sha1":40,"sha256":64}[object_format]
 assert re.fullmatch("[0-9a-f]{"+str(length)+"}",value),value
 return value
def raw_oid(b,object_format):
 return hashlib.new(object_format,b"blob "+str(len(b)).encode("ascii")+b"\0"+b).hexdigest()
def repository_identity():
 unsafe={"GIT_DIR","GIT_WORK_TREE","GIT_COMMON_DIR","GIT_INDEX_FILE","GIT_OBJECT_DIRECTORY",
  "GIT_ALTERNATE_OBJECT_DIRECTORIES","GIT_NAMESPACE","GIT_ATTR_NOSYSTEM","GIT_ATTR_SOURCE","GIT_CONFIG",
  "GIT_LITERAL_PATHSPECS","GIT_GLOB_PATHSPECS","GIT_NOGLOB_PATHSPECS","GIT_ICASE_PATHSPECS"}
 present=sorted(k for k in os.environ if k in unsafe or k.startswith("GIT_CONFIG_"))
 assert not present,("unreviewed_git_environment_override_names",present)
 top=Path(gout("rev-parse","--show-toplevel")).resolve()
 assert top==MAIN.resolve() and top==MAIN.absolute(),("canonical_repository_root",str(top))
 assert gout("rev-parse","--is-bare-repository")=="false"
 assert gout("rev-parse","--is-inside-work-tree")=="true"
 object_format=gout("rev-parse","--show-object-format")
 assert object_format in ("sha1","sha256") and object_format==release["expected_git_object_format"]
 assert re.fullmatch("[0-9a-f]{"+str({"sha1":40,"sha256":64}[object_format])+"}",BASIS)
 return {"canonical_root":str(top),"git_dir":gout("rev-parse","--absolute-git-dir"),
  "common_dir":gout("rev-parse","--path-format=absolute","--git-common-dir"),
  "object_format":object_format,"git_version":gout("--version"),"rejected_override_names_present":present}
def conversion_provenance(names):
 # Only conversion/attribute configuration and origins are captured.
 pattern=r"^(core\.(autocrlf|eol|safecrlf|attributesfile|checkroundtripencoding|filemode|ignorecase|symlinks|protectntfs|protecthfs)|extensions\.objectformat)$"
 args=("config","--includes","--show-origin","--show-scope","--null","--get-regexp",pattern)
 config=git(*args,check=False);assert config.returncode in (0,1)
 sources={}
 def add(path,role):
  p=Path(path)
  if not p.is_absolute(): p=MAIN/p
  k=str(p.absolute()).casefold()
  if k not in sources: sources[k]={"path":str(p.absolute()),"roles":[]}
  if role not in sources[k]["roles"]: sources[k]["roles"].append(role)
 for variable in ("GIT_ATTR_SYSTEM","GIT_ATTR_GLOBAL"):
  value=gout("var",variable);assert value and "\n" not in value and "\r" not in value,variable
  add(value,variable)
 add(gout("rev-parse","--path-format=absolute","--git-path","info/attributes"),"repository_info_attributes")
 add(MAIN/".gitattributes","root_attributes")
 for rel in names:
  parts=PurePosixPath(rel).parts
  for depth in range(1,len(parts)):
   add(MAIN.joinpath(*parts[:depth])/".gitattributes","target_ancestor_attributes")
 files=[]
 for source in sorted(sources.values(),key=lambda x:x["path"].casefold()):
  path=Path(source["path"]);present=os.path.lexists(path)
  record={**source,"exists":present,"resolved_path":str(path.resolve())}
  if present:
   assert path.is_file(),str(path)
   b=raw(path);record.update(bytes=len(b),sha256=sha(b),raw_base64=base64.b64encode(b).decode("ascii"),
    is_symlink=path.is_symlink())
  files.append(record)
 return {"repository":repository_identity(),"configuration":{"argv":list(args),"exit_code":config.returncode,
  "stdout_base64":base64.b64encode(config.stdout).decode("ascii"),"stdout_sha256":sha(config.stdout),
  "stderr_base64":base64.b64encode(config.stderr).decode("ascii")},"attribute_sources":files}
def effective_attributes(names):
 request=b"\0".join(rel.encode("utf-8") for rel in names)+b"\0"
 output=git("check-attr","-z","--stdin",*ATTR_NAMES,input=request).stdout
 assert output.endswith(b"\0")
 fields=output.split(b"\0")[:-1];assert len(fields)==len(names)*len(ATTR_NAMES)*3
 result={rel:{} for rel in names}
 for i in range(0,len(fields),3):
  rel,key,value=(v.decode("utf-8") for v in fields[i:i+3])
  assert rel in result and key in ATTR_NAMES and key not in result[rel],(rel,key)
  result[rel][key]=value
 for rel,values in result.items():
  assert set(values)==set(ATTR_NAMES),rel
  for key in ("filter","working-tree-encoding","ident"):
   assert values[key] in ("unset","unspecified"),("disallowed_conversion_attribute",rel,key,values[key])
 return result
def tree_entries(revision):
 result={}
 for line in git("ls-tree","-r","--full-tree","-z",revision).stdout.split(b"\0"):
  if not line: continue
  header,path=line.split(b"\t",1);mode,kind,oid=header.decode("ascii").split()
  rel=path.decode("utf-8");assert rel not in result,rel
  result[rel]={"mode":mode,"type":kind,"oid":oid}
 return result
def index_entries():
 result={}
 for line in git("ls-files","--stage","-z").stdout.split(b"\0"):
  if not line: continue
  header,path=line.split(b"\t",1);mode,oid,stage=header.decode("ascii").split()
  rel=path.decode("utf-8");assert stage=="0" and rel not in result,("nonzero_or_duplicate_index_stage",rel,stage)
  result[rel]={"mode":mode,"oid":oid,"stage":0}
 return result
def assert_conversion_unchanged(names,attributes,provenance,label):
 actual_attributes=effective_attributes(names)
 actual_provenance=conversion_provenance(names)
 assert actual_attributes==attributes,(label,"effective_attributes_changed")
 assert actual_provenance==provenance,(label,"configuration_or_attribute_sources_changed")
 return {"stage":label,"effective_attributes_unchanged":True,"conversion_provenance_unchanged":True,
  "provenance_sha256":sha((json.dumps(provenance,sort_keys=True,separators=(",",":"))).encode("utf-8"))}

