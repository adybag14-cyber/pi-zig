from pathlib import Path, PurePosixPath
import base64, datetime, hashlib, json, os, re, stat, subprocess, sys, traceback
if not __debug__: raise RuntimeError("This reviewed intake requires Python assertions enabled")
ROOT=Path(r"C:\Users\adyba\pi-zig")
MAIN=ROOT/"main"
BASIS="UNRESOLVED_PENDING20_RELEASED_HEAD______"
