      "label": "new_strict_byte_contract_helpers",
      "offset": 2575,
      "before": "assert len(sys.argv)==4,\"phase release-path release-sha256\"\n",
      "after": "\n# These guards strengthen byte preservation without changing the11 inherited helpers.\nBYTE_CONTRACT=\"pending20_exact_git_bytes_attributes_aliases_modes_v1\"\nATTR_NAMES=(\"text\",\"eol\",\"filter\",\"working-tree-encoding\",\"ident\")\nFAILURE_STATE={\"stage\":\"release_admission\",\"Main_or_index_writes_started\":False}\ndef fail_record(exc_type,exc,tb):\n try:\n  stamp=datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y%m%dT%H%M%S%fZ\")\n  name=phase+\"-negative-\"+stamp+\"-\"+os.urandom(6).hex()+\".json\"\n  value={\"status\":\"preserved_exact_intake_failure\",\"utc\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\n   \"phase\":phase,\"release_path\":str(release_path),\"release_sha256\":release_sha,\n   \"executor_sha256\":self_sha,\"state\":dict(FAILURE_STATE),\n   \"exception_type\":exc_type.__name__,\"exception\":str(exc),\n   \"traceback\":\"\".join(traceback.format_exception(exc_type,exc,tb)),\n   \"native_execution_authorized\":False,\"application_qualified\":False,\"rollback_or_cleanup_performed\":False}\n  new_json(proof/name,value)\n except BaseException as capture_error:\n  print(\"Immutable failure receipt could not be saved: \"+repr(capture_error),file=sys.stderr)\n sys.__excepthook__(exc_type,exc,tb)\ndef target_name(rel):\n assert isinstance(rel,str) and rel and str(PurePosixPath(rel))==rel,rel\n assert not PurePosixPath(rel).is_absolute() and \"\\\\\" not in rel and \":\" not in rel,rel\n assert not any(ord(c)<32 or ord(c)==127 or c in '<>\"|?*' for c in rel),rel\n for part in rel.split(\"/\"):\n  assert part not in (\"\",\".\",\"..\") and part[-1] not in \". \",rel\n  lower=part.casefold()\n  assert lower not in (\".git\",\".gitattributes\"),rel\n  stem=lower.split(\".\",1)[0]\n  assert not re.fullmatch(r\"(con|prn|aux|nul|clock\\$|conin\\$|conout\\$|com[1-9¹²³]|lpt[1-9¹²³])\",stem),rel\n assert rel==\"build.zig\" or rel.startswith((\"src/\",\"vendor/quickjs/\",\"verification/\")),rel\n return rel\ndef no_reparse_target(rel):\n current=MAIN\n assert current.is_dir() and not current.is_symlink(),str(current)\n for part in [None,*PurePosixPath(rel).parts]:\n  if part is not None: current=current/part\n  if os.path.lexists(current):\n   info=current.lstat()\n   assert not current.is_symlink() and not (getattr(info,\"st_file_attributes\",0)&0x400),str(current)\n   assert stat.S_ISDIR(info.st_mode) if current!=MAIN/rel else stat.S_ISREG(info.st_mode),str(current)\n inside(MAIN/rel,MAIN)\ndef oid_text(output,object_format):\n value=output.decode(\"ascii\").strip()\n length={\"sha1\":40,\"sha256\":64}[object_format]\n assert re.fullmatch(\"[0-9a-f]{\"+str(length)+\"}\",value),value\n return value\ndef raw_oid(b,object_format):\n return hashlib.new(object_format,b\"blob \"+str(len(b)).encode(\"ascii\")+b\"\\0\"+b).hexdigest()\ndef repository_identity():\n unsafe={\"GIT_DIR\",\"GIT_WORK_TREE\",\"GIT_COMMON_DIR\",\"GIT_INDEX_FILE\",\"GIT_OBJECT_DIRECTORY\",\n  \"GIT_ALTERNATE_OBJECT_DIRECTORIES\",\"GIT_NAMESPACE\",\"GIT_ATTR_NOSYSTEM\",\"GIT_ATTR_SOURCE\",\"GIT_CONFIG\",\n  \"GIT_LITERAL_PATHSPECS\",\"GIT_GLOB_PATHSPECS\",\"GIT_NOGLOB_PATHSPECS\",\"GIT_ICASE_PATHSPECS\"}\n present=sorted(k for k in os.environ if k in unsafe or k.startswith(\"GIT_CONFIG_\"))\n assert not present,(\"unreviewed_git_environment_override_names\",present)\n top=Path(gout(\"rev-parse\",\"--show-toplevel\")).resolve()\n assert top==MAIN.resolve() and top==MAIN.absolute(),(\"canonical_repository_root\",str(top))\n assert gout(\"rev-parse\",\"--is-bare-repository\")==\"false\"\n assert gout(\"rev-parse\",\"--is-inside-work-tree\")==\"true\"\n object_format=gout(\"rev-parse\",\"--show-object-format\")\n assert object_format in (\"sha1\",\"sha256\") and object_format==release[\"expected_git_object_format\"]\n assert re.fullmatch(\"[0-9a-f]{\"+str({\"sha1\":40,\"sha256\":64}[object_format])+\"}\",BASIS)\n return {\"canonical_root\":str(top),\"git_dir\":gout(\"rev-parse\",\"--absolute-git-dir\"),\n  \"common_dir\":gout(\"rev-parse\",\"--path-format=absolute\",\"--git-common-dir\"),\n  \"object_format\":object_format,\"git_version\":gout(\"--version\"),\"rejected_override_names_present\":present}\ndef conversion_provenance(names):\n # Only conversion/attribute configuration and origins are captured.\n pattern=r\"^(core\\.(autocrlf|eol|safecrlf|attributesfile|checkroundtripencoding|filemode|ignorecase|symlinks|protectntfs|protecthfs)|extensions\\.objectformat)$\"\n args=(\"config\",\"--includes\",\"--show-origin\",\"--show-scope\",\"--null\",\"--get-regexp\",pattern)\n config=git(*args,check=False);assert config.returncode in (0,1)\n sources={}\n def add(path,role):\n  p=Path(path)\n  if not p.is_absolute(): p=MAIN/p\n  k=str(p.absolute()).casefold()\n  if k not in sources: sources[k]={\"path\":str(p.absolute()),\"roles\":[]}\n  if role not in sources[k][\"roles\"]: sources[k][\"roles\"].append(role)\n for variable in (\"GIT_ATTR_SYSTEM\",\"GIT_ATTR_GLOBAL\"):\n  value=gout(\"var\",variable);assert value and \"\\n\" not in value and \"\\r\" not in value,variable\n  add(value,variable)\n add(gout(\"rev-parse\",\"--path-format=absolute\",\"--git-path\",\"info/attributes\"),\"repository_info_attributes\")\n add(MAIN/\".gitattributes\",\"root_attributes\")\n for rel in names:\n  parts=PurePosixPath(rel).parts\n  for depth in range(1,len(parts)):\n   add(MAIN.joinpath(*parts[:depth])/\".gitattributes\",\"target_ancestor_attributes\")\n files=[]\n for source in sorted(sources.values(),key=lambda x:x[\"path\"].casefold()):\n  path=Path(source[\"path\"]);present=os.path.lexists(path)\n  record={**source,\"exists\":present,\"resolved_path\":str(path.resolve())}\n  if present:\n   assert path.is_file(),str(path)\n   b=raw(path);record.update(bytes=len(b),sha256=sha(b),raw_base64=base64.b64encode(b).decode(\"ascii\"),\n    is_symlink=path.is_symlink())\n  files.append(record)\n return {\"repository\":repository_identity(),\"configuration\":{\"argv\":list(args),\"exit_code\":config.returncode,\n  \"stdout_base64\":base64.b64encode(config.stdout).decode(\"ascii\"),\"stdout_sha256\":sha(config.stdout),\n  \"stderr_base64\":base64.b64encode(config.stderr).decode(\"ascii\")},\"attribute_sources\":files}\ndef effective_attributes(names):\n request=b\"\\0\".join(rel.encode(\"utf-8\") for rel in names)+b\"\\0\"\n output=git(\"check-attr\",\"-z\",\"--stdin\",*ATTR_NAMES,input=request).stdout\n assert output.endswith(b\"\\0\")\n fields=output.split(b\"\\0\")[:-1];assert len(fields)==len(names)*len(ATTR_NAMES)*3\n result={rel:{} for rel in names}\n for i in range(0,len(fields),3):\n  rel,key,value=(v.decode(\"utf-8\") for v in fields[i:i+3])\n  assert rel in result and key in ATTR_NAMES and key not in result[rel],(rel,key)\n  result[rel][key]=value\n for rel,values in result.items():\n  assert set(values)==set(ATTR_NAMES),rel\n  for key in (\"filter\",\"working-tree-encoding\",\"ident\"):\n   assert values[key] in (\"unset\",\"unspecified\"),(\"disallowed_conversion_attribute\",rel,key,values[key])\n return result\ndef tree_entries(revision):\n result={}\n for line in git(\"ls-tree\",\"-r\",\"--full-tree\",\"-z\",revision).stdout.split(b\"\\0\"):\n  if not line: continue\n  header,path=line.split(b\"\\t\",1);mode,kind,oid=header.decode(\"ascii\").split()\n  rel=path.decode(\"utf-8\");assert rel not in result,rel\n  result[rel]={\"mode\":mode,\"type\":kind,\"oid\":oid}\n return result\ndef index_entries():\n result={}\n for line in git(\"ls-files\",\"--stage\",\"-z\").stdout.split(b\"\\0\"):\n  if not line: continue\n  header,path=line.split(b\"\\t\",1);mode,oid,stage=header.decode(\"ascii\").split()\n  rel=path.decode(\"utf-8\");assert stage==\"0\" and rel not in result,(\"nonzero_or_duplicate_index_stage\",rel,stage)\n  result[rel]={\"mode\":mode,\"oid\":oid,\"stage\":0}\n return result\ndef assert_conversion_unchanged(names,attributes,provenance,label):\n actual_attributes=effective_attributes(names)\n actual_provenance=conversion_provenance(names)\n assert actual_attributes==attributes,(label,\"effective_attributes_changed\")\n assert actual_provenance==provenance,(label,\"configuration_or_attribute_sources_changed\")\n return {\"stage\":label,\"effective_attributes_unchanged\":True,\"conversion_provenance_unchanged\":True,\n  \"provenance_sha256\":sha((json.dumps(provenance,sort_keys=True,separators=(\",\",\":\"))).encode(\"utf-8\"))}\n\nassert re.fullmatch(r\"[0-9a-f]{40}\",BASIS),\"Future released source head is unresolved\"\nassert all(re.fullmatch(r\"[0-9A-F]{64}\",value[1]) and value[2]>0 for value in MANIFESTS.values()),\"Future manifest bindings are unresolved\"\nassert len(sys.argv)==4,\"phase release-path release-sha256\"\n"
    },
