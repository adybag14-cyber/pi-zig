inputs={};raws={};ops=[]
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def norm(p):return str(p).replace('/','\\').casefold()
def pin(p,expected=None):
 p=Path(p);b=p.read_bytes();r={'path':str(p),'bytes':len(b),'sha256':sha(b)}
 if expected:assert (len(b),sha(b))==expected,(r,expected)
 k=norm(p)
 if k in inputs:assert (inputs[k]['bytes'],inputs[k]['sha256'])==(len(b),sha(b)) and raws[k]==b
 else:inputs[k]=r
 raws[k]=b;return r
def verify(r):
 q=pin(r['path'],(r['bytes'],r['sha256']))
 return q
def read(p,expected=None):r=pin(p,expected);return json.loads(raws[norm(p)])
def wire(x):return (json.dumps(x,indent=2)+'\n').encode()
def put(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
 assert p.read_bytes()==b
 return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
