 alias={'donor':donor,'logical_archive_relative_path':logical_target,'reference_sites':[site],'historical_reference_aliases':[]}
 if 'historical_original' in site:alias['historical_reference_aliases']=[{'historical_pin':site['historical_original'],'immutable_snapshot':donor,'exact_original_bytes':True}]
 equal=[]
