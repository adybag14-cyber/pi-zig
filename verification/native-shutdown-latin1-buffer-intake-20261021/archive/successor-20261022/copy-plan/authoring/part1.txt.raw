assert sum(len(x['logical_donors']) for x in baseline['archive_rows'])==248
plan=copy.deepcopy(baseline)
def parent(tree,path):
 for k in path[:-1]:tree=tree[k]
 return tree,path[-1]
def setv(path,value):
 p,k=parent(plan,path);exists=(k<len(p) if isinstance(p,list) else k in p)
 before=copy.deepcopy(p[k]) if exists else None
 ops.append({'op':'replace' if exists else 'add','path':path,'before':before,'after':copy.deepcopy(value)})
 p[k]=copy.deepcopy(value)
def append(path,value):
 p=plan
 for k in path:p=p[k]
 ops.append({'op':'append','path':path,'index':len(p),'after':copy.deepcopy(value)})
 p.append(copy.deepcopy(value))
