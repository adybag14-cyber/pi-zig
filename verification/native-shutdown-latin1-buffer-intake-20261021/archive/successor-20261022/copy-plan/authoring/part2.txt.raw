setv(['coverage','new_toolchain_snapshot_bindings'],[{'snapshot':a[2],'historical_pin':a[3],'exact_original_bytes':True} for a in compiler_snapshots])
setv(['coverage','external_references_addendum'],[
 {'scope':'Source dependency and immutable Git censuses in the new linkage and FS fixture proofs','policy':'The complete JSON proofs are archived. The entire historical source tree is not recopied; exact immutable Git bases remain external authority.'},
 {'scope':'Original V38 native phase artifacts, full compiler/source seals and actual process intervals referenced by Root receipts','policy':'The separate V38 validation archive and its future Root acceptance/commit are not authored or predicted by this source-copy plan. Original paths and raw reference pins remain unchanged.'},
 {'scope':'Selected fixture source references','policy':'The source proof preserves exact authority/source pins. Existing immutable Node authority files remain referenced externally unless already included by the old bounded union; this plan does not claim a self-contained original-source tree.'}
])
future=copy.deepcopy(plan['future_admission_requirements'])
future.update({
 'required_actual_original63_buildquery_closure':verify(linkroot['compiler_authority']),
 'required_actual_original63_strict_runtime_closure':None,
 'required_current_V38_all_original_process_closure':None,
 'required_actual_V38_archive_commit':None,
 'required_actual_V38_archive_Root_acceptance':None,
 'required_fixture_independent_peer':None,
