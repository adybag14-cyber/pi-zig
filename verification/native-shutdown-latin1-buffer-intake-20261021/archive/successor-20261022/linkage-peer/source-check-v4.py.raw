# Check concrete artifact recipes, unchanged root/filter/install/target identities and scope.
def artifact_block(raw,var):
    needle=("        const "+var+" = b.addTest(.{\n").encode()
    need(raw.count(needle)==1,("unique artifact",var))
    a=raw.index(needle);z=raw.find(b"\n        const ",a+1)
    need(z>a,("artifact extent",var))
    return a,z,raw[a:z]
