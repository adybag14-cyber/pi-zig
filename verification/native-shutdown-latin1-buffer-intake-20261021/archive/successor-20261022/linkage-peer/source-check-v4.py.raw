identity=sources["tools/build_native_vm_identity.zig"]
need(identity.count(b"options.addOption(")==2 and b'options.addOption([64]u8, "sha256"'in identity and b'options.addOption([]const u8, "schema"'in identity and b"return options.createModule();"in identity,"constant VM identity options")
need(b'sdk_public_options.addOption(?u8, "range", sdk_public_allocation_range);'in old and b'sdk_ui_options.addOption(?u8, "range", sdk_ui_allocation_range);'in old,"two constant allocation modules")
def reach(root,target=None):
    queue=[root];parent={root:None}
    for p in queue:
        if p==target:
            result=[]
            while p is not None:result.append(p);p=parent[p]
            return result[::-1]
        for q in edges_aug.get(p,[]):
            if q not in parent:parent[q]=p;queue.append(q)
    return sorted(parent) if target is None else None
# Derive all root fields and their enclosing literal loops; no trusted line-range census.
def root_fields(raw):
    s,ts=tokens(raw);pairs={};stack=[]
    for i,t in enumerate(ts):
        v=t[0]
        if v in ("(","[","{"):stack.append((v,i))
        elif v in (")","]","}"):
            need(stack and {"(":")","[":"]","{":"}"}[stack[-1][0]]==v,("balanced build syntax",i))
            _,j=stack.pop();pairs[j]=i
    need(not stack,"balanced complete build")
    loops=[]
    for i,t in enumerate(ts):
        if t[0]!="for" or i+1 not in pairs or ts[i+1][0]!="(":continue
        e=pairs[i+1];j=e+1
        if j>=len(ts)or ts[j][0]!="|":continue
        k=j+1
        while k<len(ts)and ts[k][0]!="|":k+=1
        if k+1>=len(ts)or ts[k+1][0]!="{":continue
        if not any(ts[q][0]=="root_source_file" for q in range(k+2,pairs[k+1])):continue
        capture=[x[0]for x in ts[j+1:k]if x[3]=="word"]
        iterable=ts[i+2:e]
        vals=[json.loads(x[0])for x in iterable if x[3]=="string"]
        binding=None
        if not vals and len(iterable)==1 and iterable[0][3]=="word":
            name=iterable[0][0]
            declarations=[n for n in range(i-2)if [x[0]for x in ts[n:n+3]]==["const",name,"="]]
            need(len(declarations)==1,("unique preceding constant loop table",name))
            n=declarations[0];a=n+3;z=a
            while z<i and ts[z][0]!=";":
                z=pairs[z]+1 if z in pairs else z+1
            need(z<i and ts[z][0]==";",("complete constant loop table",name))
            vals=[json.loads(x[0])for x in ts[a:z]if x[3]=="string"]
            table=s[ts[n][1]:ts[z][2]].encode()
            binding=dict(name=name,bytes=len(table),sha256=sha(table),utf8=table.decode())
        loops.append(dict(start=i,body=k+1,end=pairs[k+1],capture=capture,values=vals,table_binding=binding,header_start=ts[i][1],header_end=ts[k+1][2]))
    fields=[];dynamic=[]
    nl=[m.start()for m in re.finditer("\n",s)]
    for i in range(len(ts)-3):
        if [x[0]for x in ts[i:i+3]]!=[".","root_source_file","="]:continue
        j=i+3;k=j
        while k<len(ts) and ts[k][0]!=",":
            if k in pairs:k=pairs[k]+1
            else:k+=1
        need(k<len(ts),"root field delimiter")
        expr=s[ts[j][1]:ts[k-1][2]]
        row=dict(line=bisect.bisect_right(nl,ts[i][1])+1,expression=expr)
        m=re.fullmatch(r'b\.path\("([^"]+)"\)',expr)
        if m:row["roots"]=[m.group(1)]
        else:
            enclosing=[x for x in loops if x["body"]<i<x["end"]]
            need(enclosing,("dynamic root outside loop",row))
            loop=max(enclosing,key=lambda x:x["body"])
            need(any(re.search(r"\b"+re.escape(v)+r"\b",expr)for v in loop["capture"]),("dynamic root capture",row))
            roots=sorted({v for v in loop["values"]if v.endswith(".zig")and v.startswith(("src/","tools/"))})
            need(roots,("finite loop literals",row))
            row["roots"]=roots
            hdr=s[loop["header_start"]:loop["header_end"]].encode()
            dynamic.append(dict(**row,loop_capture=loop["capture"],constant_table_binding=loop["table_binding"],header_bytes=len(hdr),header_sha256=sha(hdr),header_utf8=hdr.decode()))
        fields.append(row)
    return fields,dynamic
fields,loops=root_fields(old)
