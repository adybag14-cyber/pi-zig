need(cur==old,"whole inverse")
# All raw Zig inputs are derived independently from the immutable Git tree.
tree={}
for entry in git("ls-tree","-r","-z",HEAD).split(b"\0"):
    if entry:
        meta,path=entry.split(b"\t",1);mode,kind,oid=meta.split()
        if kind==b"blob":tree[path.decode()]=(mode.decode(),oid.decode())
zig_paths=sorted(p for p in tree if p.endswith(".zig") and p.startswith(("src/","tools/")))
need(len(zig_paths)==2841,"complete raw source census")
def batch(paths):
    data=git("cat-file","--batch",input=("\n".join(tree[p][1] for p in paths)+"\n").encode())
    result={};at=0
    for path in paths:
        end=data.index(b"\n",at);oid,kind,n=data[at:end].split();n=int(n);start=end+1
        raw=data[start:start+n]
        need(kind==b"blob" and oid.decode()==tree[path][1] and data[start+n:start+n+1]==b"\n",("raw blob",path))
        need(hashlib.sha1(b"blob "+str(n).encode()+b"\0"+raw).hexdigest()==oid.decode(),("raw object id",path))
        result[path]=raw;at=start+n+1
    need(at==len(data),"complete cat-file output")
    return result
