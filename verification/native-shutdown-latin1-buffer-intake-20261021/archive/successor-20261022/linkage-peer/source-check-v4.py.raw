# Tokenize comments, quoted literals and Zig multiline strings before identifying imports.
# This scanner never evaluates Zig and uses independently derived token/brace positions.
token_re=re.compile(r'(?P<comment>//[^\n]*)|(?P<multi>\\\\[^\n]*)|(?P<string>"(?:\\.|[^"\\])*")|(?P<char>\'(?:\\.|[^\'\\])*\')|(?P<word>@?[A-Za-z_][A-Za-z_0-9]*)|(?P<punct>\S)')
def tokens(raw):
    s=raw.decode("utf-8")
    return s,[(m.group(),m.start(),m.end(),m.lastgroup)for m in token_re.finditer(s)if m.lastgroup not in ("comment","multi")]
def line_at(s,offset): return bisect.bisect_right([i for i,c in enumerate(s)if c=="\n"],offset)+1
literal_named={"catalog_tool":"tools/catalog.zig","native_icu_api":"src/extensions/icu/native_icu_api.zig","native_photon_link":"src/ai/photon_session.zig","pi_zig":"src/root.zig"}
edges={};named=collections.defaultdict(list);missing=[];nonliteral=[]
for path,raw in sources.items():
    if not path.endswith(".zig"):continue
    s,ts=tokens(raw);nl=[m.start()for m in re.finditer("\n",s)];out=[]
    for i,t in enumerate(ts):
        if t[0]!="@import":continue
        line=bisect.bisect_right(nl,t[1])+1
        if not(i+3<len(ts) and ts[i+1][0]=="(" and ts[i+2][3]=="string" and ts[i+3][0]==")"):
            nonliteral.append(dict(source=path,line=line));continue
        value=json.loads(ts[i+2][0])
        dest=posixpath.normpath(posixpath.join(posixpath.dirname(path),value)) if value.endswith(".zig") else literal_named.get(value)
        if dest is None:named[value].append(dict(source=path,line=line))
        elif dest in sources:out.append(dict(target=dest,literal=value,line=line))
        else:missing.append(dict(source=path,import_=value,destination=dest,line=line))
    edges[path]=out
missing=[dict(source=x["source"],**{"import":x["import_"]},destination=x["destination"],line=x["line"])for x in missing]
need(not nonliteral and nonliteral==inventory["nonliteral_import_sites"],"literal import grammar complete")
need(edges==inventory["literal_import_edges"],"complete edges reconstructed from raw source bytes")
need(missing==inventory["unresolved_relative_imports"] and len(missing)==2,"two retained missing imports")
bindings={"pi_features":["src/features_no_sqlite.zig","src/features_sqlite.zig"],"sqlite_persistence":["src/sqlite_server_persistence.zig"],"release_config":["src/config.zig"]}
options={"native_vm_identity","sdk_public_allocation_options","sdk_ui_allocation_options"}
need(set(named)-{"std","builtin","root"}==set(bindings)|options,"complete named imports")
need(b"pub const sqlite_enabled = false;"in sources["src/features_no_sqlite.zig"] and b"pub const sqlite_enabled = true;"in sources["src/features_sqlite.zig"],"both feature branches")
for name,targets in bindings.items():
