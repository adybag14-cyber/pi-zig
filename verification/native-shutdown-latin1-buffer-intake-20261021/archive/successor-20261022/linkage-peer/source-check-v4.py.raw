def need(ok,what):
    if not ok: raise AssertionError(what)
def sha(raw): return hashlib.sha256(raw).hexdigest().upper()
inputs={}
def readpin(row):
    path=Path(row["path"])
    need(not str(path).lower().startswith(str(B/"main").lower()+"\\"),"Main read forbidden")
    raw=path.read_bytes()
    need(len(raw)==row["bytes"] and sha(raw)==row["sha256"],("pin",row))
    inputs[(str(path),sha(raw))]=dict(path=str(path),bytes=len(raw),sha256=sha(raw))
    return raw
def fixed(path,n,h): return readpin(dict(path=str(path),bytes=n,sha256=h))
def git(*args,input=None):
    q=subprocess.run(["git","--no-optional-locks","-C",str(W),*args],input=input,capture_output=True,timeout=40,
                     env={**os.environ,"GIT_OPTIONAL_LOCKS":"0"})
    need(q.returncode==0,("git read",args,q.stderr.decode(errors="replace")))
    return q.stdout
