    need(len(a)==s["before_bytes"] and len(b)==s["after_bytes"] and cur[o:o+len(a)]==a,("step preimage",i))
    nxt=cur[:o]+b+cur[o+len(a):]
    need(len(nxt)==s["output_bytes"] and sha(nxt)==s["output_sha256"],("step output",i))
    need(nxt[:o]+a+nxt[o+len(b):]==cur,("step inverse",i))
    edit_rows.append(dict(index=i,label=s["label"],offset=o,input_sha256=sha(cur),output_sha256=sha(nxt),prefix_sha256=sha(cur[:o]),suffix_sha256=sha(cur[o+len(a):])))
    cur=nxt
