seen={}
cache={}
def need(c,m):
 if not c:raise AssertionError(m)
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def encode(x):return (json.dumps(x,indent=2,ensure_ascii=False)+"\n").encode()
def pin(p,b):return {"path":str(p),"bytes":len(b),"sha256":sha(b)}
def allowed(value):
 p=Path(value);rel=p.relative_to(B).parts
 need(p.is_absolute() and ".." not in p.parts and not p.is_symlink(),"canonical original/output file")
 need(rel and (rel[0].casefold()=="evidence" or len(rel)>=4 and rel[0].casefold()=="worktrees" and rel[2].casefold()=="verification"),"no Main access")
 need(not any(x.casefold() in {"cache","global-cache",".zig-cache","zig-out","installed"} for x in rel),"no cache input")
 need(p.suffix.casefold() not in (".exe",".dll",".pdb"),"no native executable input")
 return p
def raw(p):
 p=allowed(p);k=str(p).casefold()
 if k not in cache:
  b=p.read_bytes();cache[k]=b;seen[k]=pin(p,b)
 return cache[k]
def exact(p):
 need(set(p)=={"path","bytes","sha256"},"exact pin keys")
 b=raw(p["path"]);need(seen[p["path"].casefold()]==p,"actual pinned bytes "+p["path"]);return b
def pp(key):
 p,n,h=PINS[key];return {"path":str(p),"bytes":n,"sha256":h}
def load(key):return json.loads(exact(pp(key)))
def document(p):return json.loads(exact(p))
def get(x,path):
 for k in path:x=x[k]
 return x
def lists(x,path=()):
 if isinstance(x,list):
  yield path,x
  for i,v in enumerate(x):yield from lists(v,path+(i,))
 elif isinstance(x,dict):
  for k,v in x.items():yield from lists(v,path+(k,))
def names(p,dirs=False):return sorted(x.name for x in p.iterdir() if x.is_dir()==dirs)
def pinfields(x):return isinstance(x,dict) and {"path","bytes","sha256"}<=set(x)
def record_refs(x):
 if pinfields(x):yield {k:x[k] for k in ("path","bytes","sha256")}
 elif isinstance(x,dict):
  for v in x.values():yield from record_refs(v)
 elif isinstance(x,list):
  for v in x:yield from record_refs(v)

