for row in list(seen.values()):need(pin(Path(row["path"]),Path(row["path"]).read_bytes())==row,"current versions unchanged")
proof={"schema":1,"status":"independently_verified_exact_v38_archive_normalization_and_five_literal_adapter_binding",
 "reviewer":"/root/handover_review","candidate_head":H,"emitted_output_proof":pp("emitted_proof"),
 "original_manifest":pp("old_manifest"),"normalized_manifest":pp("manifest"),"template":pp("template"),"bound_adapter":pp("adapter"),
 "root_binding_proof":pp("root_proof"),"preparation_job":pp("preparation_job"),"binding_plan":pp("plan"),
 "checker":pin(Path(__file__),read(__file__)),"source_build_paths":0,"original_rows":1929,"normalized_rows":1930,"logical_aliases":1930,
 "total_commit_paths":1931,"sole_replacement":P,"sole_extra_row":extra,"all_original_manifest_bytes_inverse_exact":True,
 "whole_manifest_inverse_bytes":1226916,"current_physical_donor_count":len(donors),
 "complete_donor_pin_map_sha256":sha(encode(donors)),"complete_planned_prefix_count":len(prefixes),
 "five_independently_derived_literal_steps":edits,"untouched_fragments":fragments,"full_adapter_byte_inverse":True,
 "unchanged_nonconstant_tokens":True,"unchanged_function_bodies":functions,"phase":"fixture",
 "future_exact_release_required":True,"actual_Git_byte_preflight_remains_future":True,
 "retained_future_gates":["canonical repository and object format","all physical donors plus synthetic manifest and all aliases",
 "all existing and planned parent spellings","five attributes and relevant config plus origin files",
 "independent raw OID and both Git raw/path OIDs before Main writes","pre-copy and post-copy attributes/provenance",
 "exact staging and committed blob bytes/OIDs/modes","complete single-parent list","final clean index and worktree"],
 "scope":{"source_only":True,"adapter_or_prefix_executed":False,"Main_or_index_accessed":False,"native_execution_authorized":False,
 "application_qualified":False,"source_mutation_hold_released":False},
 "small_control_inputs":[pp(k) for k in PINS],"current_input_versions":len(seen)}
