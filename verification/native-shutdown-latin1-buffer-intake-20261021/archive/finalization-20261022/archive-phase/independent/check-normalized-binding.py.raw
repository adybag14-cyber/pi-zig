need(logs["id"]==j["id"] and logs["status"]=="succeeded" and logs["stderr"]=="" and logs["logs"]["truncated"] is False,"actual terminal stdout envelope")
event=json.loads(logs["stdout"]);need(event["manifest"]==pp("old_manifest") and event["commit_paths"]==1930 and event["Main_access"] is False and event["native_execution"] is False and event["configuration_issued"] is False,"original preparer output identity")
need(job["native_execution_authorized"] is False and job["Main_changed"] is False,"separate historical prep authority")
