seen={};cache={}
def need(x,m):
 if not x:raise AssertionError(m)
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def norm(p):return str(p).replace("/","\\").casefold()
def wire(x):return (json.dumps(x,indent=2)+"\n").encode()
def pin(p,b):return {"path":str(p),"bytes":len(b),"sha256":sha(b)}
def allowed(p):
 p=Path(p);parts=p.relative_to(B).parts
 need(p.is_absolute() and ".." not in p.parts and not p.is_symlink(),"canonical evidence path")
 need(parts[0].casefold()=="evidence" or len(parts)>=4 and parts[0].casefold()=="worktrees" and parts[2].casefold()=="verification","no Main or live source read")
 return p
def raw(p):
 p=allowed(p);k=norm(p)
 if k not in cache:cache[k]=p.read_bytes();seen[k]=pin(p,cache[k])
 return cache[k]
def exact(r):
 b=raw(r["path"]);need(len(b)==r["bytes"] and sha(b)==r["sha256"],"actual pinned bytes "+r["path"]);return b
def document(r):return json.loads(exact(r))
def pp(k):
 p,n,h=PINS[k];return {"path":str(p),"bytes":n,"sha256":h}
def doc(k):return document(pp(k))
def at(x,path):
 for p in path:x=x[p]
 return x
def parent(x,path):return at(x,path[:-1]),path[-1]
def identity(r):return norm(r["path"]),r["bytes"],r["sha256"]
def allpins(x):
 if isinstance(x,dict) and {"path","bytes","sha256"}<=set(x):yield {k:x[k] for k in ("path","bytes","sha256")}
 elif isinstance(x,dict):
  for v in x.values():yield from allpins(v)
 elif isinstance(x,list):
  for v in x:yield from allpins(v)
