def normalize(e):
 before=e.get("before",e.get("old_text"));after=e.get("after",e.get("new_text"))
 need(isinstance(before,str)and isinstance(after,str),"exact finite replacement strings")
 pos=e.get("byte_offset",e.get("offset",e.get("offset_in_predecessor")))
 ih=e.get("before_sha256",e.get("input_sha256"));oh=e.get("after_sha256",e.get("output_sha256"))
 return before.encode(),after.encode(),pos,ih,oh
def replay(label,original,edits,expected=None,declared_hashes=True):
 work=original;steps=[]
 for i,e in enumerate(edits,1):
  before,after,pos,ih,oh=normalize(e)
  need(before and work.count(before)==1,"unique finite preimage: "+label)
  at=work.index(before);need(pos is None or not declared_hashes or pos==at,"exact declared current offset: "+label)
  pre=sha(work)
  if declared_hashes and ih is not None:need(pre==ih,"declared intermediate input: "+label)
  work=work[:at]+after+work[at+len(before):]
  if declared_hashes and oh is not None:need(sha(work)==oh,"declared intermediate output: "+label)
  steps.append(dict(index=i,offset=at,before_bytes=len(before),after_bytes=len(after),before_sha256=sha(before),after_sha256=sha(after),input_sha256=pre,output_sha256=sha(work),before=before.decode(),after=after.decode()))
 if expected is not None:need(work==expected,"entire saved projection: "+label)
 inverse=work
 for e in reversed(steps):
  at=e["offset"];before=e["before"].encode();after=e["after"].encode()
  need(sha(inverse)==e["output_sha256"]and inverse[at:at+len(after)]==after,"exact reverse postimage: "+label)
  inverse=inverse[:at]+before+inverse[at+len(after):]
  need(sha(inverse)==e["input_sha256"],"every reverse intermediate: "+label)
 need(inverse==original,"whole byte inverse: "+label)
 replays.append(dict(label=label,original_bytes=len(original),original_sha256=sha(original),projected_bytes=len(work),projected_sha256=sha(work),declared_intermediate_hashes_checked=declared_hashes,steps=steps,complete_forward_and_inverse_exact=True))
 return work
