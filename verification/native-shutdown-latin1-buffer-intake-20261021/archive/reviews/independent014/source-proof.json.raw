  "new_control_roots": [
    {
      "root_source": "src/native_node_stream_shutdown_test.zig",
      "target": "build-native-node-stream-shutdown",
      "declared_controls": 18,
      "names": [
        "native Stream shutdown actual constructor owns original null fields and independent empty slots",
        "native Stream shutdown genuine Simple wrapper clears request slot before last native pointer retirement",
        "native Stream shutdown physical close reports after trace end cleanup and AfterClose with borrowed handle",
        "native Stream shutdown real accepted bad descriptor still performs AfterClose and reports negative status",
        "native Stream shutdown closed fast path completes synchronously and restores the prior trigger",
        "native Stream shutdown closing fast path retires its own request while real first close stays queued",
        "native Stream shutdown nonfunction oncomplete yields undefined without invoking trace or callback",
        "native Stream shutdown absent oncomplete skips the ordinary Get and native callback",
        "native Stream shutdown throwing oncomplete getter preserves actual reason and still disposes native request",
        "native Stream shutdown real close callback exception survives actual Wrapper and event destruction",
        "native Stream shutdown disabled JavaScript returns before oncomplete getter while native close retires",
        "native Stream shutdown live listener head uses original predecessor forwarding into real reporter",
        "native StreamReq Done stores actual Latin1 error bytes then reports and clears request field",
        "native StreamReq Done failing ordinary error setter returns before OnDone and preserves both native slots",
        "native StreamReq Done false nonwritable Set still continues to OnDone",
        "native Stream shutdown reporter converts Latin1 error then clears original stream error",
        "native Stream shutdown missing caller object uses actual stored InstanceTemplate then real native close",
        "native Stream shutdown request init inherits actual handle async ID and restores prior trigger"
      ],
      "actual_metadata_count": null
    },
    {
      "root_source": "src/native_node_one_byte_string_test.zig",
      "target": "build-native-node-one-byte-string",
      "declared_controls": 8,
      "names": [
        "native OneByteString explicit full byte range preserves all Latin1 code units including high bytes",
        "native OneByteString UTF8-looking bytes remain two original Latin1 code units",
        "native OneByteString explicit length preserves embedded NUL before nonASCII bytes",
        "native OneByteString negative length follows original strlen termination",
        "native OneByteString zero length accepts null data without reading a byte",
        "native OneByteString all negative signed lengths select the CString branch",
        "native OneByteString explicit prefix does not consume trailing buffer bytes",
        "native OneByteString returned caller ownership survives source scope and real VM collection"
      ],
      "actual_metadata_count": null
    },
    {
      "root_source": "src/native_vm_array_buffer_view_data_test.zig",
      "target": "build-native-vm-array-buffer-view-data",
      "declared_controls": 12,
      "names": [
        "VM view data every typed-array width and DataView expose the physical backing offset",
        "VM view data live empty views retain their exact end pointer",
        "VM view data bypasses getters and rejects forged live and revoked proxy brands",
        "VM view data detached typed and DataView addresses are null while lease acquisition still throws",
        "VM view data fixed resizable views preserve stored offsets while out of bounds and after regrowth",
        "VM view data tracking resizable views keep the address independently of rounded usable length",
        "VM view data shared aliases expose one native address across real runtime growth",
        "VM view data allocates nothing under the actual VM memory limit",
        "VM view data preserves actual ordinary uncatchable and private termination completions",
        "VM view data borrows without keeping the actual view or native backing alive",
        "VM view data observes unmanaged external storage without adding a lease or changing cleanup",
        "VM view data follows real ArrayBuffer transfer detachment and the receiving physical storage"
      ],
      "actual_metadata_count": null
    }
  ],
