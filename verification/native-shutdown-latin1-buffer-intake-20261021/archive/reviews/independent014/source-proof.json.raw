      "steps": [
        {
          "index": 1,
          "offset": 2283975,
          "before_bytes": 55,
          "after_bytes": 1203,
          "before_sha256": "9197AC312C91EF9090807106B391E6AEA30CE513D4B52F37D050A840876FCAA1",
          "after_sha256": "1D8550C344CBBF2FB5E34FD94379810762DD6C82B889A1E28FA174BB02E460AF",
          "input_sha256": "5C74683747165024EEEB1D54A3D34085C0ACC094B820C433B7D493613A864464",
          "output_sha256": "3B4474CFE4BE5A4AFC850220012AD31F288B6ADFD46C4A0AA61BB216E6D50003",
          "before": "/* Intrinsic V8 ArrayBufferView::ByteLength projection.",
          "after": "/* Intrinsic Buffer::Data projection: borrow the actual ArrayBufferView's\n   native address without consulting guest properties or acquiring storage.\n   V8 ByteOffset is zero only for detached views. A live out-of-bounds RAB\n   view retains its stored offset even though ByteLength is zero. Do address\n   arithmetic as uintptr_t so that merely observing such an address does not\n   form an out-of-allocation C pointer by pointer arithmetic. The result must\n   not be dereferenced beyond the separately observed usable byte length.\n   No context, allocation, ownership, or pending-completion operation occurs. */\nuint8_t *JS_PiArrayBufferViewData(JSValueConst view)\n{\n    JSObject *p;\n    JSTypedArray *ta;\n    JSArrayBuffer *abuf;\n\n    if (JS_VALUE_GET_TAG(view) != JS_TAG_OBJECT)\n        return NULL;\n    p = JS_VALUE_GET_OBJ(view);\n    if (!is_typed_array(p->class_id) && p->class_id != JS_CLASS_DATAVIEW)\n        return NULL;\n    ta = p->u.typed_array;\n    if (!ta)\n        return NULL;\n    abuf = ta->buffer->u.array_buffer;\n    if (abuf->detached)\n        return NULL;\n    return (uint8_t *)((uintptr_t)abuf->data + (uintptr_t)ta->offset);\n}\n\n/* Intrinsic V8 ArrayBufferView::ByteLength projection."
        }
      ],
      "complete_forward_and_inverse_exact": true
    },
    {
      "label": "Buffer VM vendor/quickjs/quickjs.h",
