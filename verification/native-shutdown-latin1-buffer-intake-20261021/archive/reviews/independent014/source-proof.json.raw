          "before_sha256": "0EC8641D70B8796D9174AC541824258DBE7F3861069BEEFE3733ABC08C977D33",
          "after_sha256": "4C2DD92A899FDC9B40CA94A8C3C7DAB964820E381AE103788D3BFE43A22A9549",
          "input_sha256": "7FBD8411454695434D67C7F09E5C7BE3C1F19837730ED889F392E04CC48D5952",
          "output_sha256": "9F63BF26C91440A8C9B3D5F1FF06AB387D6E76630ADEC6D4CAA745179DB46978",
          "before": "JS_EXTERN size_t JS_PiArrayBufferViewByteLength(JSValueConst view);\n",
          "after": "JS_EXTERN size_t JS_PiArrayBufferViewByteLength(JSValueConst view);\n/* Borrow an actual TypedArray/DataView's backing address plus stored byte\n   offset. Detached views and invalid brands return NULL. Live RAB OOB views\n   retain their offset; consult ByteLength before any dereference. No JS root,\n   native backing entitlement, allocation, guest operation, or pending-state\n   change occurs. The caller supplies the actual view/storage lifetime; this\n   VM-owner-thread borrow is not an asynchronous or cross-thread lease. */\nJS_EXTERN uint8_t *JS_PiArrayBufferViewData(JSValueConst view);\n"
        }
      ],
      "complete_forward_and_inverse_exact": true
    },
