  "production_findings": [
    {
      "topic": "Native brand and valid representation",
      "finding": "The complete new C body first checks the actual JSValue tag, then the actual TypedArray class range or DataView class, then the initialized typed_array pointer. It performs no guest lookup or Proxy unwrapping. The read constructors initialize ta->buffer/offset before publishing ta; the actual view retains and marks its real buffer. This relies on the explicit live view/owner-thread precondition and does not admit use during or after collection."
    },
    {
      "topic": "Original Node/V8 mapping",
      "finding": "Pinned Node Buffer::Data uses Buffer()->Data() plus ByteOffset. Pinned V8 ArrayBuffer::Data reads backing_store, and ByteOffset returns the stored offset unless detached. The selected already-backed QuickJS fields express that lower-level address operation. Node's caller brand CHECK and V8 TypedArray::GetBuffer's on-heap allocation/copy/fatal policy remain separate; raw invalid-brand NULL is not substituted for those owners."
    },
    {
      "topic": "Detached and out-of-bounds views",
      "finding": "The detached branch returns NULL before any address formation. Live RAB out-of-bounds views retain the original stored offset even when the separate usable ByteLength is zero. Integer uintptr_t addition avoids forming an out-of-allocation pointer by C pointer arithmetic solely to observe such an address. It is not permission to dereference the result. All selected control dereferences occur within retained and currently usable extents."
    },
    {
      "topic": "Backing and lifetime",
      "finding": "The helper reads abuf->data on every call. Native Pi storage preserves that address while actual commit/usable length changes, whereas the existing unmanaged resize path may move data. Detach, transfer, collection and owner retirement can invalidate an earlier borrow. The new helper adds no root, native reference or lease and calls no release. The fixture uses actual retaining views or explicit independent leases when observing ownership counters and never uses a borrowed address after final retirement."
    },
    {
      "topic": "Shared buffers",
      "finding": "The provider publishes actual shared length atomically and retains real shared storage through serializer hooks. The primitive only reads stable data and offset; usable length remains the existing independent ByteLength operation. The two-runtime control observes real growth and common physical storage without fabricating a cross-thread JS lease. No concurrency or target qualification is inferred."
    },
    {
      "topic": "No allocation, guest work or pending-state change",
      "finding": "The full body and actual macro/class helper definitions contain only value/tag/class/field reads and local pointer arithmetic. No JSContext, allocator, guest call, root/lease operation or current-exception access occurs. The controls use real malloc_state limit guards, JS_Throw/JS_GetException, uncatchable Error flags and private termination request/generation/cancel owners. The source read supports noninterference without relying solely on the lexical helper inventory."
    },
    {
      "topic": "Fixture teardown",
      "finding": "Fixture initialization/deinitialization retains the actual memory domain through runtime teardown. Deferred JS values are freed before their contexts; clone bytes and explicit shared backing references are retired in their actual ownership order. External stack storage and callback state outlive the runtime/cleanup that borrows them. Explicit early releases reset variables or leases, avoiding repeated ownership drops in deferred cleanup."
    },
    {
      "topic": "Bounded ABI",
      "finding": "The exact uint8_t *(JSValueConst) declaration is visible through unchanged engine_abi.h -> quickjs.h and the common VM library. No new translation unit, include, compiler option, generic host bridge, replacement callback policy, listener or public FileHandle method is introduced."
    }
  ],
  "control_source_review": [
    {
      "index": 0,
      "name": "VM view data every typed-array width and DataView expose the physical backing offset",
      "observation": "Reads every supported TypedArray width and DataView at nonzero aligned or byte offsets, then performs in-extent physical writes in both directions.",
      "executed": false
    },
    {
      "index": 1,
      "name": "VM view data live empty views retain their exact end pointer",
      "observation": "Observes one-past-end addresses of zero-length views over a retained nonempty backing without dereferencing them.",
      "executed": false
    },
    {
      "index": 2,
      "name": "VM view data bypasses getters and rejects forged live and revoked proxy brands",
      "observation": "Uses throwing own getters, a live Proxy and a revoked Proxy plus forged prototypes; native branding remains independent of all guest properties.",
      "executed": false
    },
    {
      "index": 3,
      "name": "VM view data detached typed and DataView addresses are null while lease acquisition still throws",
      "observation": "Actually detaches the backing and checks raw NULL/zero length, while the independent retaining lease API still raises its real catchable error.",
      "executed": false
    },
    {
      "index": 4,
      "name": "VM view data fixed resizable views preserve stored offsets while out of bounds and after regrowth",
      "observation": "Shrinks a real fixed RAB below each stored offset, observes addresses without dereference, then regrows before the physical write.",
      "executed": false
    },
    {
      "index": 5,
      "name": "VM view data tracking resizable views keep the address independently of rounded usable length",
      "observation": "Separately observes stored address and rounded usable length for tracking typed/DataView views through shrink-to-zero and regrowth.",
      "executed": false
    },
    {
      "index": 6,
      "name": "VM view data shared aliases expose one native address across real runtime growth",
      "observation": "Uses actual same-process SAB serialization, retained backing and two real VM runtimes; growth occurs before an in-range write through the receiver alias. This is not a concurrent-thread qualification.",
      "executed": false
    },
    {
      "index": 7,
      "name": "VM view data allocates nothing under the actual VM memory limit",
      "observation": "Sets the actual QuickJS malloc limit to 1 and checks native memory accounting and backing references remain unchanged during repeated valid/invalid raw reads.",
      "executed": false
    },
    {
      "index": 8,
      "name": "VM view data preserves actual ordinary uncatchable and private termination completions",
      "observation": "Establishes real ordinary, flagged uncatchable and private execution-termination pending events. Reads under the actual memory limit retain the current reason or private event generation, then dispose through the existing real completion APIs.",
      "executed": false
    },
    {
      "index": 9,
      "name": "VM view data borrows without keeping the actual view or native backing alive",
      "observation": "Drops actual view/buffer references, runs GC, observes the only remaining native lease reference and releases it; no raw address is used after final retirement.",
      "executed": false
    },
    {
      "index": 10,
      "name": "VM view data observes unmanaged external storage without adding a lease or changing cleanup",
      "observation": "Uses caller-owned external stack storage and its actual cleanup callback; no native lease is acquired, the raw in-range write changes the real bytes, and detach triggers exactly the existing single cleanup.",
      "executed": false
    },
    {
      "index": 11,
      "name": "VM view data follows real ArrayBuffer transfer detachment and the receiving physical storage",
      "observation": "Performs actual ArrayBuffer transfer, observes NULL on the detached old view and checks the receiving physical bytes through a new view.",
      "executed": false
    }
  ],
