  "excerpts": [
    {
      "id": "actual_empty_helper",
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\vendor\\quickjs\\quickjs.c",
      "source_sha256": "2AEE7EA130CCF08282928A9FDA056B444CF0905E8C53F1EFD520E8243F9C37B4",
      "start_line": 5195,
      "end_line": 5199,
      "bytes": 164,
      "sha256": "92035334616F4900942E230308B57069E80C2BF871D955C3EDA6F470D7FD2109",
      "text": "static inline JSValue js_empty_string(JSRuntime *rt)\n{\n    JSAtomStruct *p = rt->atom_array[JS_ATOM_empty_string];\n    return js_dup(JS_MKPTR(JS_TAG_STRING, p));\n}\n"
    },
    {
      "id": "actual_byte_helper",
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\vendor\\quickjs\\quickjs.c",
      "source_sha256": "2AEE7EA130CCF08282928A9FDA056B444CF0905E8C53F1EFD520E8243F9C37B4",
      "start_line": 5201,
      "end_line": 5211,
      "bytes": 388,
      "sha256": "6768656DA97B3FE06BD7E4EC2617DF26F3B0D38CCBA188B335B74B41CE6C592C",
      "text": "// XXX: `buf` contains raw 8-bit data, no UTF-8 decoding is performed\n// XXX: no special case for len == 0\nstatic JSValue js_new_string8_len(JSContext *ctx, const char *buf, int len)\n{\n    JSString *str;\n    str = js_alloc_string(ctx, len, 0);\n    if (!str)\n        return JS_EXCEPTION;\n    memcpy(str8(str), buf, len);\n    str8(str)[len] = '\\0';\n    return JS_MKPTR(JS_TAG_STRING, str);\n"
    },
    {
      "id": "new_latin1_body",
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\vendor\\quickjs\\quickjs.c",
      "source_sha256": "2AEE7EA130CCF08282928A9FDA056B444CF0905E8C53F1EFD520E8243F9C37B4",
      "start_line": 5669,
      "end_line": 5679,
      "bytes": 506,
      "sha256": "9DAB510A6A34C7AD38AA0FD7F45D81369C0ED1A712183F9C0DDCA03A3658860B",
      "text": "/* Raw one-byte string construction for native Node OneByteString callers.\n   Every byte denotes the same Latin-1 code unit, including embedded NUL.\n   Signed length selection and Node/V8 fatal policy belong to that caller. */\nJSValue JS_PiNewStringLatin1(JSContext *ctx, const uint8_t *buf, size_t len)\n{\n    if (len == 0)\n        return js_empty_string(ctx);\n    if (len > JS_STRING_LEN_MAX)\n        return JS_ThrowRangeError(ctx, \"string too long\");\n    return js_new_string8_len(ctx, buf, (int)len);\n}\n"
    },
    {
      "id": "existing_empty_caller",
      "source": "C:\\Users\\adyba\\pi-zig\\worktrees\\modules-io-resume-20261018\\verification\\native-node-shutdown-wrap-sourceonly-20261020\\shared\\projected\\vendor\\quickjs\\quickjs.c",
      "source_sha256": "2AEE7EA130CCF08282928A9FDA056B444CF0905E8C53F1EFD520E8243F9C37B4",
      "start_line": 5681,
      "end_line": 5689,
      "bytes": 240,
      "sha256": "DAD49BDBAA06A1FC8B571D947575F21AA2E56895EBAF6249B82BA55A33C4D9B1",
      "text": "/* create a string from a UTF-8 buffer */\nJSValue JS_NewStringLen(JSContext *ctx, const char *buf, size_t buf_len)\n{\n    JSString *str;\n    size_t len;\n    int kind;\n\n    if (unlikely(buf_len <= 0))\n        return js_empty_string(ctx->rt);\n"
    }
