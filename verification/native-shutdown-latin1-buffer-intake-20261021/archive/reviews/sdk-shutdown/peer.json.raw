  "lifetime_and_behavior": [
    {
      "component": "Independent native request slot",
      "assessment": "RequestFields keeps an independent StreamReq pointer and Registry retention; attaches before AsyncWrap init and contains no hidden guest handle root. Reset clears BaseObject then request slot. FromObject reads request slot directly. Mark/finalizer use actual State and retire it before destroying fields.",
