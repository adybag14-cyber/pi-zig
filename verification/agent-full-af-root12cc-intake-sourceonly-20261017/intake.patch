diff --git a/src/extensions/native_agent_config_async.zig b/src/extensions/native_agent_config_async.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5f83c34f76cf13ac0654338f7548299fc20282eb
--- /dev/null
+++ b/src/extensions/native_agent_config_async.zig
@@ -0,0 +1,41 @@
+//! Actual createLoopConfig lexical async arrows: return vs return-Await.
+const p = @import("native_agent_af_values.zig");
+const em = @import("engine.zig");
+const c = p.c;
+const af = p.af;
+pub const Kind = enum(i32) { prepare, steering, follow_up };
+pub fn create(engine: *em.Engine, agent: c.JSValue, cell: c.JSValue, kind: Kind, name: [*:0]const u8, length: c_int) !c.JSValue {
+    return af.createResumableArrow(engine, name, length, invoke, &.{ agent, cell, c.JS_NewInt32(engine.context, @intFromEnum(kind)) }, agent);
+}
+fn invoke(engine: *em.Engine, _: c.JSValue, args: []const c.JSValue, roots: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) anyerror!af.Action {
+    return run(engine, args, roots, state, completion, input) catch |err| p.failure(engine, err);
+}
+fn run(engine: *em.Engine, args: []const c.JSValue, roots: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action {
+    var s: p.Scope = .{ .engine = engine }; defer s.deinit();
+    if (completion == .fulfilled) return .{ .returned = c.JS_DupValue(engine.context, input) };
+    if (completion == .rejected) { try p.rejected(&s, state.*, input); return .{ .thrown = c.JS_DupValue(engine.context, input) }; }
+    var raw: i32 = 0;
+    if (c.JS_ToInt32(engine.context, &raw, roots[2]) < 0) return @import("native_js_values.zig").capture(engine);
+    const kind: Kind = @enumFromInt(raw);
+    if (kind == .steering and s.truthy(try s.get(roots[1], "skip"))) {
+        try s.put(roots[1], "skip", c.pi_js_bool(engine.context, 0));
+        return .{ .returned = c.JS_DupValue(engine.context, try s.array()) };
+    }
+    if (kind != .prepare) {
+        const queue = try p.get(&s, roots[0], if (kind == .steering) "steeringQueue" else "followUpQueue");
+        return .{ .returned = c.JS_DupValue(engine.context, try p.invoke(&s, queue, "drain", &.{})) };
+    }
+    const owner = try p.init(&s, state);
+    if (s.truthy(try p.get(&s, roots[0], "prepareNextTurnWithContext"))) {
+        const handler = try p.get(&s, roots[0], "prepareNextTurnWithContext");
+        const signal = try p.get(&s, roots[0], "signal");
+        return p.wait(&s, owner, handler, roots[0], &.{ if (args.len > 0) args[0] else c.pi_js_undefined(), signal }, 0);
+    }
+    const handler = try p.get(&s, roots[0], "prepareNextTurn");
+    if (c.JS_IsNull(handler) or c.JS_IsUndefined(handler)) {
+        // Optional call skips signal lookup, but Source still says return await.
+        try s.put(owner, "awaitGeneration", try s.own(try engine.checked(c.JS_NewBigUint64(engine.context, engine.native_allocation_generation))));
+        return .{ .awaited = c.pi_js_undefined() };
+    }
+    return p.wait(&s, owner, handler, roots[0], &.{try p.get(&s, roots[0], "signal")}, 0);
+}
diff --git a/src/extensions/native_agent_events_async.zig b/src/extensions/native_agent_events_async.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c1091924c56f1b06da0921ac00d448a450af52e5
--- /dev/null
+++ b/src/extensions/native_agent_events_async.zig
@@ -0,0 +1,98 @@
+//! Actual processEvents reducer and synchronous for-of with awaited listeners.
+const p = @import("native_agent_af_values.zig");
+const em = @import("engine.zig");
+const c = p.c;
+const af = p.af;
+const js = @import("native_js_values.zig");
+pub fn create(engine: *em.Engine) !c.JSValue { return af.createResumable(engine, "processEvents", 1, invoke, &.{}); }
+fn invoke(engine: *em.Engine, agent: c.JSValue, args: []const c.JSValue, _: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) anyerror!af.Action {
+    return run(engine, agent, args, state, completion, input) catch |err| p.failure(engine, err);
+}
+fn run(engine: *em.Engine, agent: c.JSValue, args: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action {
+    var s: p.Scope = .{ .engine = engine }; defer s.deinit();
+    if (completion == .rejected) { try p.rejected(&s, state.*, input); return closeThrow(&s, state.*, input); }
+    if (completion == .fulfilled) return next(&s, state.*);
+    const owner = try p.init(&s, state);
+    const event = if (args.len > 0) args[0] else c.pi_js_undefined();
+    try s.put(owner, "event", event);
+    try reduce(&s, agent, event);
+    const active = try p.get(&s, agent, "activeRun");
+    const signal = if (c.JS_IsNull(active) or c.JS_IsUndefined(active)) c.pi_js_undefined() else try p.get(&s, try p.get(&s, active, "abortController"), "signal");
+    if (!s.truthy(signal)) _ = try p.raise(&s, "Agent listener invoked outside active run");
+    try s.put(owner, "signal", signal);
+    const listeners = try p.get(&s, agent, "listeners");
+    const symbol = try s.own(try engine.checked(c.JS_GetIteratorSymbol(engine.context)));
+    const generation = engine.native_allocation_generation;
+    const method = try s.own(try p.guard(engine, generation, js.getKey(engine, listeners, symbol)));
+    const iterator = try p.call(&s, method, listeners, &.{});
+    if (!c.JS_IsObject(iterator)) return js.typeError(engine, "Iterator is not an object");
+    try s.put(owner, "iterator", iterator);
+    try s.put(owner, "next", try p.get(&s, iterator, "next"));
+    try s.put(owner, "steps", try s.own(try engine.checked(c.JS_NewBigUint64(engine.context, 0))));
+    return next(&s, owner);
+}
+fn next(s: *p.Scope, owner: c.JSValue) !af.Action {
+    var steps: u64 = 0;
+    if (c.JS_ToBigUint64(s.engine.context, &steps, try s.get(owner, "steps")) < 0) return js.capture(s.engine);
+    steps +|= 1;
+    if (s.engine.cancelled.load(.acquire) or (steps % 256 == 0 and blk: {
+        s.engine.interrupts +|= 1;
+        break :blk s.engine.interrupts > s.engine.options.interrupt_budget;
+    })) {
+        _ = c.JS_ThrowInternalError(s.engine.context, "interrupted");
+        const reason = c.JS_GetException(s.engine.context);
+        c.JS_SetUncatchableError(s.engine.context, reason);
+        _ = try s.engine.checked(c.JS_Throw(s.engine.context, reason));
+        unreachable;
+    }
+    try s.put(owner, "steps", try s.own(try s.engine.checked(c.JS_NewBigUint64(s.engine.context, steps))));
+    // Iterator step/result/done/value failures precede the Source loop body and
+    // must not invoke return. The captured next method is never reread.
+    const iterator = try s.get(owner, "iterator");
+    const result = try p.call(s, try s.get(owner, "next"), iterator, &.{});
+    if (!c.JS_IsObject(result)) return js.typeError(s.engine, "Iterator result is not an object");
+    if (s.truthy(try p.get(s, result, "done"))) return .{ .returned = c.pi_js_undefined() };
+    const listener = try p.get(s, result, "value");
+    try s.put(owner, "listener", listener);
+    return listen(s, owner, listener) catch |err| {
+        const reason = try s.own(try p.caught(s.engine, err));
+        return closeThrow(s, owner, reason);
+    };
+}
+fn listen(s: *p.Scope, owner: c.JSValue, listener: c.JSValue) !af.Action { return p.wait(s, owner, listener, c.pi_js_undefined(), &.{ try s.get(owner, "event"), try s.get(owner, "signal") }, 0); }
+fn closeThrow(s: *p.Scope, owner: c.JSValue, reason: c.JSValue) !af.Action {
+    close(s, owner) catch |err| {
+        // Sync IteratorClose preserves an ordinary original body throw over
+        // ordinary return getter/call/type errors. Fresh trusted fatal escapes.
+        const discarded = try p.caught(s.engine, err);
+        s.engine.freeValue(discarded);
+    };
+    return .{ .thrown = c.JS_DupValue(s.engine.context, reason) };
+}
+fn close(s: *p.Scope, owner: c.JSValue) !void {
+    const iterator = try s.get(owner, "iterator");
+    const method = try p.get(s, iterator, "return");
+    if (c.JS_IsNull(method) or c.JS_IsUndefined(method)) return;
+    // This is synchronous for-of. Never Await a Promise returned by return().
+    _ = try p.call(s, method, iterator, &.{});
+}
+fn reduce(s: *p.Scope, agent: c.JSValue, event: c.JSValue) !void {
+    const kind = try p.get(s, event, "type");
+    if (s.equal(kind, try s.text("message_start")) or s.equal(kind, try s.text("message_update"))) {
+        try p.set(s, try p.get(s, agent, "_state"), "streamingMessage", try p.get(s, event, "message"));
+    } else if (s.equal(kind, try s.text("message_end"))) {
+        try p.set(s, try p.get(s, agent, "_state"), "streamingMessage", c.pi_js_undefined());
+        const messages = try p.get(s, try p.get(s, agent, "_state"), "messages");
+        const push = try p.get(s, messages, "push");
+        _ = try p.call(s, push, messages, &.{try p.get(s, event, "message")});
+    } else if (s.equal(kind, try s.text("tool_execution_start")) or s.equal(kind, try s.text("tool_execution_end"))) {
+        const constructor = try p.global(s, "Set");
+        const prior = try p.get(s, try p.get(s, agent, "_state"), "pendingToolCalls");
+        const pending = try p.construct(s, constructor, &.{prior});
+        const callback = try p.get(s, pending, if (s.equal(kind, try s.text("tool_execution_start"))) "add" else "delete");
+        _ = try p.call(s, callback, pending, &.{try p.get(s, event, "toolCallId")});
+        try p.set(s, try p.get(s, agent, "_state"), "pendingToolCalls", pending);
+    } else if (s.equal(kind, try s.text("turn_end"))) {
+        if (s.equal(try p.get(s, try p.get(s, event, "message"), "role"), try s.text("assistant")) and s.truthy(try p.get(s, try p.get(s, event, "message"), "errorMessage"))) try p.set(s, try p.get(s, agent, "_state"), "errorMessage", try p.get(s, try p.get(s, event, "message"), "errorMessage"));
+    } else if (s.equal(kind, try s.text("agent_end"))) try p.set(s, try p.get(s, agent, "_state"), "streamingMessage", c.pi_js_undefined());
+}
diff --git a/src/extensions/native_agent_execution_async.zig b/src/extensions/native_agent_execution_async.zig
new file mode 100644
index 0000000000000000000000000000000000000000..74f3dbee261872b407dcc7d8b738c522c8d42d1d
--- /dev/null
+++ b/src/extensions/native_agent_execution_async.zig
@@ -0,0 +1,51 @@
+//! Actual runPromptMessages/runContinuation and their lexical AF executors.
+const p = @import("native_agent_af_values.zig");
+const em = @import("engine.zig");
+const c = p.c;
+const af = p.af;
+const functions = @import("native_node_function.zig");
+pub fn create(engine: *em.Engine, comptime continuing: bool, actual_loop: c.JSValue) !c.JSValue {
+    const Adapter = struct {
+        fn run(host: *em.Engine, agent: c.JSValue, args: []const c.JSValue, roots: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) anyerror!af.Action {
+            return outer(host, continuing, agent, args, roots[0], state, completion, input) catch |err| p.failure(host, err);
+        }
+    };
+    return af.createResumable(engine, if (continuing) "runContinuation" else "runPromptMessages", if (continuing) 0 else 1, Adapter.run, &.{actual_loop});
+}
+fn outer(engine: *em.Engine, comptime continuing: bool, agent: c.JSValue, args: []const c.JSValue, loop: c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action {
+    if (completion == .fulfilled) return .{ .returned = c.pi_js_undefined() };
+    var s: p.Scope = .{ .engine = engine }; defer s.deinit();
+    if (completion == .rejected) { try p.rejected(&s, state.*, input); return .{ .thrown = c.JS_DupValue(engine.context, input) }; }
+    const owner = try p.init(&s, state);
+    const messages = if (args.len > 0) args[0] else c.pi_js_undefined();
+    const options = if (!continuing and (args.len < 2 or c.JS_IsUndefined(args[1]))) try s.object() else if (args.len > 1) args[1] else c.pi_js_undefined();
+    try s.put(owner, "options", options);
+    const lifecycle = try p.get(&s, agent, "runWithLifecycle");
+    const executor = try s.own(try createExecutor(engine, continuing, agent, messages, options, loop));
+    return p.wait(&s, owner, lifecycle, agent, &.{executor}, 0);
+}
+fn createExecutor(engine: *em.Engine, comptime continuing: bool, agent: c.JSValue, messages: c.JSValue, options: c.JSValue, loop: c.JSValue) !c.JSValue {
+    const Adapter = struct {
+        fn run(host: *em.Engine, _: c.JSValue, args: []const c.JSValue, roots: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) anyerror!af.Action {
+            return executor(host, continuing, args, roots, state, completion, input) catch |err| p.failure(host, err);
+        }
+    };
+    return af.createResumableArrow(engine, "", 1, Adapter.run, &.{ agent, messages, options, loop }, agent);
+}
+fn executor(engine: *em.Engine, comptime continuing: bool, args: []const c.JSValue, roots: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action {
+    if (completion == .fulfilled) return .{ .returned = c.pi_js_undefined() };
+    var s: p.Scope = .{ .engine = engine }; defer s.deinit();
+    if (completion == .rejected) { try p.rejected(&s, state.*, input); return .{ .thrown = c.JS_DupValue(engine.context, input) }; }
+    const owner = try p.init(&s, state);
+    const snapshot = try p.invoke(&s, roots[0], "createContextSnapshot", &.{});
+    const config = try p.invoke(&s, roots[0], "createLoopConfig", if (continuing) &.{} else &.{roots[2]});
+    const emitter = try s.own(try functions.createArrow(engine, "", 1, emit, &.{roots[0]}));
+    const signal = if (args.len > 0) args[0] else c.pi_js_undefined();
+    const stream = try p.get(&s, roots[0], "streamFunction");
+    return p.wait(&s, owner, roots[3], c.pi_js_undefined(), if (continuing) &.{ snapshot, config, emitter, signal, stream } else &.{ roots[1], snapshot, config, emitter, signal, stream }, 0);
+}
+fn emit(engine: *em.Engine, _: c.JSValue, args: []const c.JSValue, roots: []const c.JSValue) !c.JSValue {
+    var s: p.Scope = .{ .engine = engine }; defer s.deinit();
+    const result = p.invoke(&s, roots[0], "processEvents", &.{if (args.len > 0) args[0] else c.pi_js_undefined()}) catch |err| return p.callbackFailure(engine, err);
+    return c.JS_DupValue(engine.context, result);
+}
diff --git a/src/extensions/native_agent_executor_fatal.zig b/src/extensions/native_agent_executor_fatal.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0b3757b334dc4e13056826e650503dc11e392fd5
--- /dev/null
+++ b/src/extensions/native_agent_executor_fatal.zig
@@ -0,0 +1,86 @@
+//! Private per-construction retention for the actual idle-Promise executor.
+//! The global Promise constructor may consume an executor exception, then run
+//! more user code. Engine's mutable diagnostic slot cannot retain that event.
+const em = @import("engine.zig");
+const p = @import("native_agent_af_values.zig");
+const c = em.c;
+const Holder = struct { engine: *em.Engine, first: ?c.JSValue = null };
+fn data(owner: c.JSValue) *Holder { return @ptrCast(@alignCast(c.JS_GetOpaque(owner, c.JS_GetClassID(owner)).?)); }
+fn finalizer(runtime: ?*c.JSRuntime, owner: c.JSValue) callconv(.c) void {
+    const holder: *Holder = @ptrCast(@alignCast(c.JS_GetOpaque(owner, c.JS_GetClassID(owner)) orelse return));
+    if (holder.first) |reason| c.JS_FreeValueRT(runtime, reason);
+    holder.engine.gpa.destroy(holder);
+}
+fn mark(runtime: ?*c.JSRuntime, owner: c.JSValue, visit: ?*const c.JS_MarkFunc) callconv(.c) void {
+    const holder: *Holder = @ptrCast(@alignCast(c.JS_GetOpaque(owner, c.JS_GetClassID(owner)) orelse return));
+    if (holder.first) |reason| c.JS_MarkValue(runtime, reason, visit);
+}
+/// Owned private object; callback roots retain it even if a custom constructor
+/// retains the executor. Nothing is exposed in a Source-visible object graph.
+pub fn create(engine: *em.Engine) !c.JSValue {
+    var class: c.JSClassID = 0;
+    _ = c.JS_NewClassID(engine.runtime, &class);
+    const definition: c.JSClassDef = .{ .class_name = "Private Agent executor fatal", .finalizer = finalizer, .gc_mark = mark };
+    if (c.JS_NewClass(engine.runtime, class, &definition) < 0) return error.OutOfMemory;
+    const owner = try engine.checked(c.JS_NewObjectClass(engine.context, class));
+    errdefer engine.freeValue(owner);
+    const holder = try engine.gpa.create(Holder);
+    holder.* = .{ .engine = engine };
+    _ = c.JS_SetOpaque(owner, holder);
+    return owner;
+}
+/// Only called on this executor's actual failed operation. No value supplied
+/// as DATA is classified, and historical private tags remain ordinary.
+pub fn callbackFailure(engine: *em.Engine, owner: c.JSValue, err: anyerror, generation: u64) anyerror {
+    var failure_error = err;
+    if (err == error.OutOfMemory) {
+        failure_error = p.callbackFailure(engine, err);
+    } else if (err == error.JavaScriptException) {
+        if (engine.captured_exception) |reason| p.body.rethrowRecognizedAllocation(engine, reason, generation) catch |fatal| { failure_error = fatal; };
+    }
+    if (failure_error == error.JavaScriptException) if (engine.captured_exception) |reason| {
+        const tagged = c.pi_js_native_allocation_error_generation(reason);
+        const distance = tagged -% generation;
+        const fresh = tagged != 0 and distance != 0 and distance <= engine.native_allocation_generation -% generation;
+        if (c.JS_IsUncatchableError(reason) and (err == error.OutOfMemory or fresh)) {
+            const holder = data(owner);
+            if (holder.first == null) holder.first = c.JS_DupValue(engine.context, reason);
+        }
+    };
+    return failure_error;
+}
+fn drain(engine: *em.Engine) void {
+    while (c.JS_HasException(engine.context)) {
+        const displaced = c.JS_GetException(engine.context);
+        engine.freeValue(displaced);
+    }
+}
+/// Check the retained callback event BEFORE checking the constructor result.
+/// This includes a custom constructor throwing after super(executor). Keep the
+/// selected reason owned outside pending/captured slots while freeing results
+/// and displaced reasons; cleanup cannot replace the first executor fatal.
+pub fn construct(s: *p.Scope, constructor: c.JSValue, args: []const c.JSValue, owner: c.JSValue) !c.JSValue {
+    const engine = s.engine;
+    const generation = engine.native_allocation_generation;
+    const result = c.JS_CallConstructor(engine.context, constructor, @intCast(args.len), @constCast(args.ptr));
+    if (data(owner).first) |first| {
+        const reason = c.JS_DupValue(engine.context, first);
+        const pending: ?c.JSValue = if (c.JS_HasException(engine.context)) c.JS_GetException(engine.context) else null;
+        const captured = engine.captured_exception;
+        engine.captured_exception = null;
+        engine.freeValue(result);
+        drain(engine);
+        if (pending) |old| { engine.freeValue(old); drain(engine); }
+        if (captured) |old| { engine.freeValue(old); drain(engine); }
+        c.JS_SetUncatchableError(engine.context, reason);
+        return engine.checked(c.JS_Throw(engine.context, reason));
+    }
+    const checked = try p.guard(engine, generation, engine.checked(result));
+    var owned = true;
+    errdefer if (owned) engine.freeValue(checked);
+    // Retain the ordinary constructor's existing pending/fresh-exit policy.
+    if (c.JS_HasException(engine.context)) return p.guard(engine, generation, engine.checked(c.JS_Throw(engine.context, c.JS_GetException(engine.context))));
+    if (engine.captured_exception) |reason| if (c.JS_IsUncatchableError(reason)) try p.body.rethrowRecognizedAllocation(engine, reason, generation);
+    owned = false;
+    return s.own(checked);
+}
diff --git a/src/extensions/native_agent_failure_async.zig b/src/extensions/native_agent_failure_async.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ea9b2e2c71e27b2685f995f7988207f922a09e3c
--- /dev/null
+++ b/src/extensions/native_agent_failure_async.zig
@@ -0,0 +1,47 @@
+//! Actual handleRunFailure message and four direct Source Awaits.
+const p = @import("native_agent_af_values.zig");
+const em = @import("engine.zig");
+const c = p.c;
+const af = p.af;
+pub fn create(engine: *em.Engine, actual_empty_usage: c.JSValue) !c.JSValue { return af.createResumable(engine, "handleRunFailure", 2, invoke, &.{actual_empty_usage}); }
+fn invoke(engine: *em.Engine, agent: c.JSValue, args: []const c.JSValue, roots: []const c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) anyerror!af.Action {
+    return run(engine, agent, args, roots[0], state, completion, input) catch |err| p.failure(engine, err);
+}
+fn run(engine: *em.Engine, agent: c.JSValue, args: []const c.JSValue, usage: c.JSValue, state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action {
+    var s: p.Scope = .{ .engine = engine }; defer s.deinit();
+    if (completion == .rejected) { try p.rejected(&s, state.*, input); return .{ .thrown = c.JS_DupValue(engine.context, input) }; }
+    if (completion == .fulfilled) {
+        const stage = try p.stage(&s, state.*);
+        if (stage < 3) return advance(&s, agent, state.*, stage + 1);
+        return .{ .returned = c.pi_js_undefined() };
+    }
+    const owner = try p.init(&s, state);
+    const error_value = if (args.len > 0) args[0] else c.pi_js_undefined();
+    const aborted = if (args.len > 1) args[1] else c.pi_js_undefined();
+    const message = try s.object();
+    try s.put(message, "role", try s.text("assistant"));
+    const content = try s.array(); const text = try s.object();
+    try s.put(text, "type", try s.text("text")); try s.put(text, "text", try s.text(""));
+    try s.index(content, 0, text); try s.put(message, "content", content);
+    inline for (.{ "api", "provider", "id" }, .{ "api", "provider", "model" }) |source, target| try s.put(message, target, try p.get(&s, try p.get(&s, try p.get(&s, agent, "_state"), "model"), source));
+    try s.put(message, "usage", usage);
+    try s.put(message, "stopReason", try s.text(if (s.truthy(aborted)) "aborted" else "error"));
+    const error_constructor = try p.global(&s, "Error");
+    const generation = engine.native_allocation_generation;
+    const instance = c.JS_IsInstanceOf(engine.context, error_value, error_constructor);
+    if (instance < 0) { _ = try p.guard(engine, generation, @import("native_js_values.zig").capture(engine)); unreachable; }
+    const error_message = if (instance != 0) try p.get(&s, error_value, "message") else try p.call(&s, try p.global(&s, "String"), c.pi_js_undefined(), &.{error_value});
+    try s.put(message, "errorMessage", error_message);
+    try s.put(message, "timestamp", try p.invoke(&s, try p.global(&s, "Date"), "now", &.{}));
+    try s.put(owner, "failureMessage", message);
+    return advance(&s, agent, owner, 0);
+}
+fn advance(s: *p.Scope, agent: c.JSValue, owner: c.JSValue, stage: i32) !af.Action {
+    const handler = try p.get(s, agent, "processEvents");
+    const event = try s.object();
+    try s.put(event, "type", try s.text(switch (stage) { 0 => "message_start", 1 => "message_end", 2 => "turn_end", else => "agent_end" }));
+    const message = try s.get(owner, "failureMessage");
+    if (stage == 3) { const messages = try s.array(); try s.index(messages, 0, message); try s.put(event, "messages", messages); }
+    else { try s.put(event, "message", message); if (stage == 2) try s.put(event, "toolResults", try s.array()); }
+    return p.wait(s, owner, handler, agent, &.{event}, stage);
+}
