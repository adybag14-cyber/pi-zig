             if (c.JS_DefinePropertyValueStr(engine.context, prototype, entry.name, c.JS_DupValue(engine.context, callback), c.JS_PROP_WRITABLE | c.JS_PROP_CONFIGURABLE) < 0) return js.capture(engine);
