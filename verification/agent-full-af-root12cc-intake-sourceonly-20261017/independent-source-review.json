  "scope": [
    "Five remaining actual Agent class AF bodies plus two lexical AF executors and three config AF arrows; prior prompt/continue closure remains separate.",
    "Live callee/getter/receiver and argument evaluation order, state/reason ownership and GC roots, synchronous for-of with awaited listeners and ordinary IteratorClose precedence.",
    "Operation-local fresh allocation qualification, exact interrupt reason handling, actual global Promise construction and retained first executor fatal priority.",
    "Prepared original Source32 observer and four native test definitions; no generated expected or observed output."
  ],
  "findings": [
    {
      "id": "F1",
      "issue": "Native iterator cancellation/budget reason could become an ordinary rejection.",
      "original": "1ec",
      "resolution": "802 preserves the exact actual interruption reason and marks it uncatchable before AF failure, matching pinned VM interruption policy."
    },
    {
      "id": "F2",
      "issue": "Actual Promise construction consumes the executor exception into a rejected idle Promise.",
      "original": "1ec",
      "resolution": "802 added success-path actual pending/fresh-private marked checks; fc2 independently retains the first trusted callback event before constructor result handling."
    },
    {
      "id": "F3",
      "issue": "Plain-object lookalike control did not actually acquire the Error-only uncatchable flag.",
      "original": "802",
      "resolution": "1138 uses actual JS_NewError and asserts real flag true and private tag zero before the ordinary-data success case."
    },
    {
      "id": "F4",
      "issue": "A real Promise subclass could overwrite mutable captured diagnostics or throw after super(executor), replacing the selected trusted callback failure.",
      "original": "1138",
      "resolution": "fc2 preallocates a private GC-marked first-reason holder rooted beside resolveCell. Callback retains only this actual operation failure, construct checks the retained reason before either constructor success/error, disarms displaced pending/captured slots and restores the exact owned reason."
    }
  ],
  "causal_controls": [
    "Real global Promise executor failure and generation wrap; catchable fresh, historical marked and actually marked untagged Error data.",
    "Actual processEvents captured next getter triggers native cancellation before next invocation.",
    "Real Promise subclass bodies: ordinary throw after super, successful native diagnostic overwrite, overwrite then throw, second executor OOM; assert first exact identity/private+uncatchable flags/count/pending empty."
  ],
