    "declarations": [
      {
        "index": 1,
        "name": "native environment map starts empty without exposing a detached key snapshot"
      },
      {
        "index": 2,
        "name": "native environment map copies caller key and value storage before publication"
      },
      {
        "index": 3,
        "name": "native environment map replacement constructs the original long temporary key"
      },
      {
        "index": 4,
        "name": "native environment map Get constructs and retires a long C string lookup key"
      },
      {
        "index": 5,
        "name": "native environment map Query constructs the same real temporary even for an absent key"
      },
      {
        "index": 6,
        "name": "native environment map Get unlocks before its owned value survives a real replacement"
      },
      {
        "index": 7,
        "name": "native environment map JS Get retains both original native string copies"
      },
      {
        "index": 8,
        "name": "native environment map missing Get still allocates and retires its long temporary key"
      },
      {
        "index": 9,
        "name": "native environment map Get and Query use C prefixes while Set retains full spans"
      },
      {
        "index": 10,
        "name": "native environment map Delete selects the full span independently of C prefix lookups"
      },
      {
        "index": 11,
        "name": "native environment map uses the original case sensitive map on admitted platforms"
      },
      {
        "index": 12,
        "name": "native environment map enumeration follows the actual original standard container after growth and erase"
      },
      {
        "index": 13,
        "name": "native environment map Clone copies actual entries before independent mutation"
      },
      {
        "index": 14,
        "name": "native environment map enumeration retains its native owner after caller release"
      },
      {
        "index": 15,
        "name": "native environment map mutation guard independently retains the live native table"
      },
      {
        "index": 16,
        "name": "native environment map retained store survives full runtime and caller domain retirement"
      },
      {
        "index": 17,
        "name": "native environment map actual workers share a mutex and domain after runtime retirement"
      },
      {
        "index": 18,
        "name": "native environment map Clone allocations belong to the actual destination domain"
      },
      {
        "index": 19,
        "name": "native environment map empty keys are ignored but empty values remain real entries"
      },
      {
        "index": 20,
        "name": "native environment map native retry leaves actual pending and VM OOM occurrence untouched"
      },
      {
        "index": 21,
        "name": "native environment map actual short string lookup needs no artificial heap allocation"
      },
      {
        "index": 22,
        "name": "native environment map Delete constructs its real long span temporary before erase"
      }
    ]
