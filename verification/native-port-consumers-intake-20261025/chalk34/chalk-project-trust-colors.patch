+    var fixture: Fixture = undefined;
+    try fixture.init();
+    defer fixture.deinit();
+    var s: v.Scope = .{ .engine = fixture.engine };
+    defer s.deinit();
+    const first = try v.own(&s, try chalk.createDefault(fixture.engine));
+    try expose(&s, "__ccFirst", first);
