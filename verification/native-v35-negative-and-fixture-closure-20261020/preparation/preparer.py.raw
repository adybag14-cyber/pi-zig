require({k:len(seal[k]) for k in COUNTS}==COUNTS,"all five historical seal inventories")
def gzip_bytes(raw):
    out = io.BytesIO()
    with gzip.GzipFile(filename="",mode="wb",fileobj=out,mtime=0,compresslevel=9) as gz:
        gz.write(raw)
    return out.getvalue()
compressed = gzip_bytes(before_raw)
require(compressed[:10]==bytes.fromhex("1f8b08000000000002ff"),"deterministic gzip header")
require(gzip.decompress(compressed)==before_raw==final_raw,"two-source complete raw gzip roundtrip")
require(gzip_bytes(before_raw)==compressed,"deterministic gzip second encoding")
