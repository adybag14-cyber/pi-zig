 "production_bridge_removed":False,"published_release":False,
 "scope":"One exact progress replacement and new immutable raw/gzip negative and fixture execution archives only. Separate Root review/release/intake is required. No source, build, index, cache, compiler, test, bridge or publication action is authorized."
}
manifest_raw = encode(manifest)
all_targets = [(r["target"],payloads[r["target"]]) for r in rows]+[(MANIFEST_TARGET,manifest_raw)]
require(len({n.casefold() for n,_ in all_targets})==len(all_targets),"complete proposed Windows path aliases")
for target,raw in all_targets:
    relative(target)
    path = inside(M/target,M)
    if target==PROGRESS:
        require(path.read_bytes()==old_progress_raw,"unchanged live progress preimage")
        committed(current_tree,target,old_progress_raw)
    else:
        require(not path.exists() and target not in current_tree,"new archive target collision: "+target)
    prefix = target.casefold()
    require(not any(p.casefold()==prefix for p in current_tree if p!=target),"tracked Windows alias: "+target)
# Path-filtered hash-object has no -w: reject conversion before writing any proposal.
attribute_names = ("filter","working-tree-encoding","ident")
attrs = git("check-attr","-z","--stdin",*attribute_names,input=b"\0".join(n.encode("utf-8") for n,_ in all_targets)+b"\0").split(b"\0")
require(attrs[-1]==b"" and len(attrs)-1==9*len(all_targets),"complete Git attribute output")
for index,(target,raw) in enumerate(all_targets):
    triples = [attrs[9*index+3*j:9*index+3*j+3] for j in range(3)]
    require({tuple(t[:2]) for t in triples}=={(target.encode("utf-8"),a.encode()) for a in attribute_names},"exact target attributes")
    require(all(t[2] in (b"unspecified",b"unset") for t in triples),"unsupported Git transformation")
    filtered = git("hash-object","--path="+target,"--stdin",input=raw).decode().strip()
    require(filtered==blob_id(raw),"Git would normalize exact archive bytes: "+target)
state(HEAD)
original_inventory()
for path,raw in originals.items():
    require(Path(path).read_bytes()==raw,"original input changed before proposal output: "+path)
require(not OUT.exists() and not (M/ARCHIVE).exists(),"final create-only gate")

# The only writes begin here, exclusively under the one new evidence directory.
OUT.mkdir()
for row in rows:
    target = Path(row["source"])
    require(target.is_relative_to(OUT),"proposal output containment")
    target.parent.mkdir(parents=True,exist_ok=True)
    with target.open("xb") as f:
        f.write(payloads[row["target"]])
    require(target.read_bytes()==payloads[row["target"]],"projected output exact")
with (OUT/"manifest.json").open("xb") as f:
    f.write(manifest_raw)
require((OUT/"manifest.json").read_bytes()==manifest_raw,"exact output manifest")
