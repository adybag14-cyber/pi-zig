 ("authority/buildquery-launch.json",E/"combined-native-batch-v35-new4-prepared-20261020/buildquery-launch.json",2090,"EC776BC8437221D235A2820BC1EC0B002458A1F960D6BE33EC700ED7C76F4FF2"),
 ("fixture/root-source-acceptance.json",E/"root-v35-filehandle-fixture-corrections-source-acceptance-20261020.json",3873,"083D5CBD75E1A23F555F556BE1136CA6F0977F9DCBB9BDC073BA2AF8C99FAAB3"),
 ("fixture/manifest.json",FIXTURE_MANIFEST,20327,FIXTURE_MANIFEST_SHA),
