 ("fixture/independent-source-audit.py",B/"worktrees/modules-io-resume-20261018/verification/v35-fixture-intake-independent-peer-20261020/source-audit.py",12665,"B82904B005ADFCC778F9D9B854614959E9C4B63E181FF20562875625BA70D95B"),
 ("fixture/independent-source-audit.json",B/"worktrees/modules-io-resume-20261018/verification/v35-fixture-intake-independent-peer-20261020/source-audit.json",27142,"107CF22AF9861B6ABCD8E19CD336F9C4A627FF279DCA6416562718970CEDA57F"),
]
EXECUTION_NAMES = {
 "source_release":"source-release.json",
 "executor_peer":"independent-executor-peer.json",
 "receipt":"receipt.json",
 "preflight":"preflight.json",
 "staged":"staged.json",
 "pathspec":"paths.nul",
 "commit_message":"commit-message.txt",
}
def require(ok, label):
    if not ok:
        raise AssertionError(label)
def sha(raw):
    return hashlib.sha256(raw).hexdigest().upper()
def encode(value):
    return (json.dumps(value,indent=2)+"\n").encode("utf-8")
def read_json(raw):
    return json.loads(raw.decode("utf-8-sig"))
def raw_pin(path, raw):
    return {"path":str(path),"bytes":len(raw),"sha256":sha(raw)}
def inside(path, base=B):
    path = Path(path)
    require(path.is_absolute(),"absolute input path")
    resolved = path.resolve()
    require(resolved.is_relative_to(base.resolve()),"path outside allowed root: "+str(path))
    current = path
    while current != base and current != current.parent:
        require(not current.is_symlink(),"symlink input: "+str(current))
        if hasattr(current,"is_junction"):
            require(not current.is_junction(),"junction input: "+str(current))
        current = current.parent
    return path
def relative(name):
    require(isinstance(name,str) and re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*",name),"unsafe target")
    require(not PurePosixPath(name).is_absolute(),"absolute target")
    reserved = {"CON","PRN","AUX","NUL",*[f"COM{i}" for i in range(1,10)],*[f"LPT{i}" for i in range(1,10)]}
    for part in name.split("/"):
        require(part not in (".","..") and not part.endswith(("."," ")),"target dot alias")
        require(part.split(".")[0].upper() not in reserved,"target device alias")
    return name
originals = {}
def exact(path, digest, size):
    path = inside(path)
    require(re.fullmatch(r"[0-9A-F]{64}",digest) is not None,"SHA256 format")
    require(type(size) is int and size >= 0,"input length")
    raw = path.read_bytes()
    require(len(raw)==size and sha(raw)==digest,"input bytes: "+str(path))
    old = originals.get(str(path))
    require(old is None or old==raw,"input changed between reads: "+str(path))
    originals[str(path)] = raw
    return raw
def configured(row):
    require(set(row)=={"path","bytes","sha256"},"configured pin keys")
    return exact(Path(row["path"]),row["sha256"],row["bytes"])
def git(*args, input=None):
    q = subprocess.run(["git","--no-optional-locks","-c","core.fsmonitor=false",*args],cwd=M,input=input,capture_output=True)
    require(q.returncode==0,("read-only Git failed",args,q.returncode,q.stderr.decode("utf-8",errors="replace")))
    return q.stdout
def state(head):
    require(git("rev-parse","HEAD").decode().strip()==head,"Main head")
    require(git("branch","--show-current").decode().strip()==BRANCH,"Main branch")
    require(git("status","--porcelain=v1","--untracked-files=all")==b"","Main must be clean")
def blob_id(raw):
    return hashlib.sha1(b"blob "+str(len(raw)).encode()+b"\0"+raw).hexdigest()
def tree(commit):
    result = {}
    aliases = {}
    for item in git("ls-tree","-r","-z",commit).split(b"\0"):
        if not item:
            continue
        meta,name = item.split(b"\t",1)
        mode,kind,oid = meta.decode().split()
        name = name.decode("utf-8")
        require(name.casefold() not in aliases,"Git case alias")
        aliases[name.casefold()] = name
        result[name] = (mode,kind,oid)
    return result
def committed(entries, target, raw):
    require(entries.get(target) in [("100644","blob",blob_id(raw)),("100755","blob",blob_id(raw))],"committed bytes: "+target)
def filenames(directory):
    return {p.name for p in directory.iterdir() if p.is_file()}
def original_inventory():
    require(filenames(P)=={"before.json","final.json","result.json"},"complete proof top-level inventory")
    require(filenames(C)=={r[0] for r in CONTROL_FILES},"complete control top-level inventory")
    require(filenames(G)=={r[0] for r in GROUP_FILES},"complete attempted group inventory")
    require({p.name for p in (P/"groups").iterdir()}=={"native-node-file-handle-owner"},"one attempted group")
    require(not any(p.is_dir() for p in G.iterdir()),"no hidden attempted-group subdirectory")
def json_pin(path):
    raw = Path(path).read_bytes()
    return raw_pin(path,raw)

require(len(sys.argv)==3,"exact Root configuration path and SHA256 required")
config_path = inside(Path(sys.argv[1]),E)
config_raw = config_path.read_bytes()
require(sha(config_raw)==sys.argv[2],"Root configuration SHA256")
cfg = read_json(config_raw)
require(cfg["status"]=="root_reviewed_specific_v35_progress_negative_archive_preparation","Root-specific status")
require(cfg["evidence_preparation_authorized"] is True,"Root evidence preparation grant")
for name in ("main_intake_authorized","native_execution_authorized","runtime_authority","qualification"):
    require(cfg[name] is False,"no authority: "+name)
self_path = inside(Path(__file__),E)
self_raw = self_path.read_bytes()
require(sha(self_raw)==cfg["preparer_sha256"],"exact preparer bytes")
require(cfg["basis_head"]==BASIS,"historical Main basis")
HEAD = cfg["fixture_commit"]
require(isinstance(HEAD,str) and re.fullmatch(r"[0-9a-f]{40}",HEAD) and HEAD!=BASIS,"actual fixture commit required")
require(cfg["output_directory"]==str(OUT) and cfg["archive_target_prefix"]==ARCHIVE,"fixed output roots")
require(set(cfg["fixture_execution"])==set(EXECUTION_NAMES),"complete fixture execution input set")
require(not OUT.exists() and not (M/ARCHIVE).exists(),"create-only output/archive")
state(HEAD)
require(git("rev-parse",HEAD+"^").decode().strip()==BASIS,"single exact fixture commit parent")
require(git("rev-parse","--show-object-format").decode().strip()=="sha1","known Git blob format")
old_progress_raw = exact(M/PROGRESS,OLD_PROGRESS,294251)
require(git("show",BASIS+":"+PROGRESS)==old_progress_raw,"original progress committed bytes")
require(git("show",HEAD+":"+PROGRESS)==old_progress_raw,"fixture intake preserves progress")
old = read_json(old_progress_raw)
require(encode(old)==old_progress_raw,"exact historical JSON byte roundtrip")
require(old["status"]=="active_incomplete" and old["schema"]==1,"historical progress schema")
for key in ("application_qualification","production_bridge_removed","published_release"):
    require(old[key] is False,"historical qualification remains false")
old_lengths = {"integrated_source_units":62,"preserved_attempts":32,"retained_recent_native_negatives":10,"execution_checkpoint_history":11}
require({k:len(old[k]) for k in old_lengths}==old_lengths,"exact historical list lengths")
require(old["current_execution_checkpoint"]["schema"]==5,"historical checkpoint schema")
require(old["current_execution_checkpoint"]["status"]=="v34_build_and_runtime_negatives_closed_five_source_intakes_committed_v35_pending","historical current checkpoint")
original_inventory()

# Stage all proposal bytes in memory first. Every archived original gets .raw.
payloads, roles, preimages, archived, archive_rows = {}, {}, {}, {}, []
def add(target, raw, role, before=None):
    target = relative(target)
    require(target==PROGRESS or target.startswith(ARCHIVE+"/"),"proposal scope")
    require(target not in payloads and target.casefold() not in {p.casefold() for p in payloads},"duplicate proposal target")
    require(target!=MANIFEST_TARGET,"manifest is included separately")
    payloads[target],roles[target],preimages[target] = raw,role,before
    return raw_pin(OUT/"projected"/target,raw)
def archive(name, path, size, digest):
    raw = exact(path,digest,size)
    target = ARCHIVE+"/"+relative(name)+".raw"
    result = add(target,raw,"immutable_original_bytes")
    archived[name] = {"original":raw_pin(path,raw),"target":target,"projected":result}
    archive_rows.append(archived[name])
    return raw
for name,size,digest in PROOF_FILES:
    archive("proof/"+name,P/name,size,digest)
for name,size,digest in CONTROL_FILES:
    archive("control/"+name,C/name,size,digest)
for name,size,digest in GROUP_FILES:
    archive("group/"+name,G/name,size,digest)
for name,path,size,digest in EXTRA_FILES:
    archive(name,path,size,digest)
archive("prior-progress.json",M/PROGRESS,294251,OLD_PROGRESS)
execution = {}
for key,name in EXECUTION_NAMES.items():
    row = cfg["fixture_execution"][key]
    raw = configured(row)
    archive("fixture/"+name,Path(row["path"]),row["bytes"],row["sha256"])
    execution[key] = raw if key in ("pathspec","commit_message") else read_json(raw)
archive("preparation/preparer.py",self_path,len(self_raw),sha(self_raw))
archive("preparation/root-issued-config.json",config_path,len(config_raw),sha(config_raw))
now = cfg["recorded_utc"]
require(isinstance(now,str),"exact Root recording timestamp")
moment = datetime.datetime.fromisoformat(now.replace("Z","+00:00"))
require(moment.utcoffset()==datetime.timedelta(0),"UTC recording timestamp")

# Admit only the actual committed fixture phase, with complete raw Git identity.
manifest_raw = originals[str(FIXTURE_MANIFEST)]
fixture_manifest = read_json(manifest_raw)
require(fixture_manifest["comparison_head"]==BASIS and fixture_manifest["path_count_including_manifest"]==42,"fixture manifest basis/count")
target_manifest = relative(fixture_manifest["manifest_target"])
fixture_rows = copy.deepcopy(fixture_manifest["rows"])
fixture_rows.append({"target":target_manifest,"source":str(FIXTURE_MANIFEST),"bytes":len(manifest_raw),"sha256":FIXTURE_MANIFEST_SHA,"before":None,"role":"exact_intake_manifest"})
require(len(fixture_rows)==42,"exact fixture commit path count")
names = [relative(r["target"]) for r in fixture_rows]
require(len(set(n.casefold() for n in names))==42,"fixture target aliases")
require([r["target"] for r in fixture_rows if r["before"] is not None]==[FIXTURE],"one fixture replacement")
require(all(n==FIXTURE or n.startswith("verification/native-v35-fixture-corrections-20261020/") for n in names),"fixture intake scope")
previous_tree,current_tree = tree(BASIS),tree(HEAD)
changed = {v.decode("utf-8") for v in git("diff","--name-only","-z",BASIS,HEAD).split(b"\0") if v}
require(changed==set(names),"complete fixture commit delta")
fixture_current = {}
for row in fixture_rows:
    target = row["target"]
    donor = exact(Path(row["source"]),row["sha256"],row["bytes"])
    current = exact(M/target,row["sha256"],row["bytes"])
    require(current==donor,"fixture current/donor bytes")
    committed(current_tree,target,donor)
    fixture_current[target] = donor
    if row["before"] is None:
        require(target not in previous_tree,"new fixture archive target absent at basis")
    else:
        require(row["before"]["bytes"]==32558 and row["before"]["sha256"]==OLD_FIXTURE,"fixture predecessor pin")
        before = git("show",BASIS+":"+target)
        require(len(before)==32558 and sha(before)==OLD_FIXTURE,"fixture original committed preimage")
        require(len(current)==33137 and sha(current)==NEW_FIXTURE,"selected fixture bytes")
receipt = execution["receipt"]
release = execution["source_release"]
peer = execution["executor_peer"]
preflight = execution["preflight"]
staged = execution["staged"]
require(receipt["status"]=="exact_source_intake_committed" and receipt["phase"]=="fixture","actual fixture receipt")
require(receipt["before_head"]==receipt["basis_main_head"]==BASIS and receipt["after_head"]==HEAD,"fixture receipt commit chain")
require(receipt["branch"]==BRANCH and receipt["path_count"]==42,"fixture receipt branch/count")
require(receipt["manifest"]==str(FIXTURE_MANIFEST) and receipt["manifest_sha256"]==FIXTURE_MANIFEST_SHA,"fixture receipt manifest")
require(receipt["executor_sha256"]==FIXTURE_EXECUTOR_SHA,"fixture receipt executor")
require(receipt["release_sha256"]==cfg["fixture_execution"]["source_release"]["sha256"],"fixture receipt exact release")
require(receipt["staged_and_committed_bytes_match"] is True and receipt["clean_worktree"] is True,"fixture committed byte acceptance")
for key in ("native_execution_authorized","application_qualified","production_bridge_removed"):
    require(receipt[key] is False,"fixture receipt remains source-only")
require(release["status"]=="root_reviewed_exact_v35_fixture_source_intake_release","Root fixture release")
require(release["basis_main_head"]==BASIS and release["branch"]==BRANCH,"release basis")
require(release["executor_sha256"]==FIXTURE_EXECUTOR_SHA and release["source_intake_authorized"] is True,"historical exact fixture authorization")
require(release["authorized_phases"]=={"fixture":{"manifest_sha256":FIXTURE_MANIFEST_SHA,"total_commit_paths":42}},"release phase scope")
for key in ("native_execution_authorized","application_qualified","production_bridge_removed","push_authorized_by_this_release"):
    require(release[key] is False,"release excludes native/publication")
require(release["retained_authoring_preflight"]==archived["fixture/root-release-authoring-preflight.json"]["original"],"retained release authoring rejection")
required_release_pins = {r["sha256"] for r in release["required_current_pins"]}
require({FIXTURE_MANIFEST_SHA,FIXTURE_EXECUTOR_SHA,FIXTURE_ADAPTATION_SHA,cfg["fixture_execution"]["executor_peer"]["sha256"],"07883502323A898D097E467FB9E2CE5ED1A52A8A83A0A6B1EA7F877A35657129"}<=required_release_pins,"release binds exact reviewed phase and negative")
require(peer["status"]=="accepted_bounded_source_only_fixture_intake_adapter_and_manifest" and peer["source_only"] is True,"independent fixture intake peer")
require(peer["candidate_manifest"]==raw_pin(FIXTURE_MANIFEST,manifest_raw),"peer manifest pin")
require(peer["candidate_executor"]==archived["fixture/executor.py"]["original"],"peer executor pin")
require(peer["finite_adaptation"]==archived["fixture/finite-executor-adaptation.json"]["original"],"peer finite adaptation pin")
require(peer["source_audit"]==archived["fixture/independent-source-audit.py"]["original"] and peer["decisive_proof"]==archived["fixture/independent-source-audit.json"]["original"],"peer complete retained proof")
require(peer["adapter_executed"] is False and peer["main_applied"] is False and peer["native_execution_authorized"] is False and peer["application_qualified"] is False,"peer authority remains historical source-only")
receipt_directory = inside(Path(release["receipt_directory"]),E)
for key,filename in (("receipt","fixture-receipt.json"),("preflight","fixture-preflight.json"),("staged","fixture-staged.json"),("pathspec","fixture-paths.nul"),("commit_message","fixture-commit-message.txt")):
    require(Path(cfg["fixture_execution"][key]["path"]).resolve()==(receipt_directory/filename).resolve(),"actual fixture evidence location")
for record in (preflight,staged):
    require(record["before_head"]==BASIS and record["path_count"]==42,"fixture preflight/staged basis")
    require(record["manifest_sha256"]==FIXTURE_MANIFEST_SHA and record["executor_sha256"]==FIXTURE_EXECUTOR_SHA,"fixture preflight/staged pins")
    require(record["release_sha256"]==cfg["fixture_execution"]["source_release"]["sha256"],"fixture preflight/staged release")
require(preflight["phase"]=="fixture" and preflight["basis_head"]==BASIS,"fixture preflight phase")
require(preflight["all_donors_live_preimages_and_committed_basis_verified"] is True,"fixture preflight raw preimages")
