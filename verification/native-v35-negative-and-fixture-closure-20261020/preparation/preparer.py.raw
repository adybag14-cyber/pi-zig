require(acceptance["original"]["sha256"]==OLD_FIXTURE and acceptance["selected_fixture"]["sha256"]==NEW_FIXTURE,"accepted fixture composition")
require(acceptance["source_accepted"] is True and acceptance["source_corrections_accepted"] is True,"both source corrections accepted")
require([acceptance[k] for k in ("identifier_token_edits","local_bindings","original_compiler_diagnostics","additional_adjacent_source_binding","phase_hunks")]==[25,11,10,1,1],"bounded correction counts")
require(acceptance["both_composition_orders_and_complete_inverses_verified"] is True,"both correction orders")
require(acceptance["all58_declared_controls_and4_root_import_topologies_unchanged"] is True and acceptance["production_source_unchanged"] is True,"unchanged controls and production")
require(acceptance["unchanged_completion_observer"]=={"bytes":593,"sha256":"9FF6EFA60530AAC84182CC7A254B709009605E3471FE420C677590DCF859F07F"},"completion observer retained")
correction_locations = {}
for key in ("identifier_proposal","phase_proposal","independent_identifier_peer","independent_phase_peer"):
    pin = acceptance[key]
    raw = configured(pin)
    matching = [r for r in fixture_rows if Path(r["source"]).resolve()==Path(pin["path"]).resolve() and r["sha256"]==pin["sha256"] and r["bytes"]==pin["bytes"]]
    require(len(matching)==1,"accepted correction proof already committed: "+key)
    correction_locations[key] = {"original":pin,"archived_path":matching[0]["target"]}
for key in ("native_execution_authorized","runtime_qualification","application_qualified"):
    require(acceptance[key] is False,"source acceptance excludes qualification")

# Read the accepted historical negative; this preparation does not rerun its audit.
