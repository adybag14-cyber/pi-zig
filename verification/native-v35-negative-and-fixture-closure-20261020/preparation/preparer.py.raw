        require(updated[key]==old[key],"unrelated historical record changed: "+key)
require(updated["execution_checkpoint_history"][-1]==old["current_execution_checkpoint"],"complete prior checkpoint appended")
for key,length in old_lengths.items():
    require(len(updated[key])==length+1 and updated[key][:length]==old[key],"exact historical list prefix: "+key)
for key in ("application_qualification","production_bridge_removed","published_release"):
    require(updated[key] is False,"current false status: "+key)
def list_paths(value, path=()):
    if isinstance(value,list):
        yield path,value
        for index,item in enumerate(value):
            yield from list_paths(item,path+(index,))
    elif isinstance(value,dict):
        for key,item in value.items():
            yield from list_paths(item,path+(key,))
def get_path(value, path):
    for item in path:
        value = value[item]
    return value
list_checks = []
for path,items in list_paths(old):
    current = get_path(updated,path)
    require(isinstance(current,list) and current[:len(items)]==items,"historical nested list prefix: "+repr(path))
    list_checks.append({"path":list(path),"old_length":len(items),"new_length":len(current),"unchanged_prefix_sha256":sha(encode(items))})
inverse = copy.deepcopy(updated)
for key in added_keys:
    del inverse[key]
for key in replaced_keys:
    inverse[key] = copy.deepcopy(old[key])
require(inverse==old and encode(inverse)==old_progress_raw,"complete progress structural and raw-byte inverse")
progress_raw = encode(updated)
progress_pin = add(PROGRESS,progress_raw,"only_existing_progress_replacement",{"bytes":294251,"sha256":OLD_PROGRESS})
