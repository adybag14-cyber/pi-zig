require(negative["status"]=="independently_closed_first_compile_negative" and negative["candidate_head"]==BASIS,"exact V35 negative")
require(negative["distinct_current_files_rehashed"]==34068 and negative["seal_counts"]==COUNTS,"accepted complete inventory counts")
require([negative[k] for k in ("granted_groups","attempted_groups","unstarted_groups","actual_partial_metadata_count","actual_tests_started","native_owner_count")]==[4,1,3,0,0,1],"actual negative counts")
for key in ("whole_bookends_unchanged","current_all_sealed_inputs_rehashed","current_complete_directory_inventories_verified","current_actual_process_instances_absent","original_negative_rejections_preserved","controller_environment_restored"):
    require(negative[key] is True,"accepted negative gate: "+key)
for key in ("runtime_started","metadata_acceptance","qualification","source_mutation_hold_released"):
    require(negative[key] is False,"original negative false flag: "+key)
require(len(negative["groups"])==1 and len(negative["actual_process_intervals"])==4,"one native owner and three outer instances")
require(all(negative["current_absence"][k]==[] for k in ("owners","direct_children","native")),"closed original current owner inventories")
result = read_json(originals[str(P/"result.json")])
require(result["candidate_head"]==BASIS and result["status"]=="failed","retained original result")
require(result["runtime_requested"] is False and result["product_qualified"] is False,"original result remains negative")
require(originals[str(P/"result.json")]==originals[str(C/"outer.stdout.bin")],"exact original outer result")
before_raw = exact(P/"before.json",SEAL,SEAL_BYTES)
final_raw = exact(P/"final.json",SEAL,SEAL_BYTES)
require(before_raw==final_raw,"whole original before/final bytes identical")
seal = read_json(before_raw)
