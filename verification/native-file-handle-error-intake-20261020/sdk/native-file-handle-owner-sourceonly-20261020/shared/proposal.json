      "edits": [
        {
          "index": 0,
          "offset_in_sequential_input": 0,
          "before": "/* Typed real asynchronous filesystem requests on the one native UV service.\n * uv_loop and uv_fs_t remain private to their actual native thread/owner.\n * No JS value, Engine pointer or guest callback is accepted by this API. */\n",
          "after": "/* Typed real filesystem operations on the one native UV service.\n * Asynchronous uv_fs_t and the loop remain private to their actual owner.\n * The selected synchronous close borrows its caller's native stack uv_fs_t.\n * No JS value, Engine pointer or guest callback is accepted by this API. */\n",
          "input_sha256": "E4DC253302062445270904800B2816374DBF840C2BEF4C66C57D6C42D039A8CE",
          "output_sha256": "55149B084DBFC348B68E92AE7D9A3FA52589A65D08DA0159F1AF6623924E12CE"
        },
        {
          "index": 1,
          "offset_in_sequential_input": 3738,
          "before": "int pi_uv_fs_close(PiUvFsRequest *request, int descriptor);\n",
          "after": "int pi_uv_fs_close(PiUvFsRequest *request, int descriptor);\n/* Original FileHandle GC close: synchronous calling-thread uv_fs_close with\n * cb == NULL and the retained service's actual loop. The caller owns a full\n * canonical uv_fs_t on its stack and performs uv_fs_req_cleanup after its\n * trace-end operation. This call queues no command/event and allocates no\n * PiUvFsRequest. Pinned libuv's synchronous path does not dereference the loop;\n * retaining the service keeps its address/storage valid even after stop/join.\n */\nstruct uv_fs_s;\nint pi_uv_fs_close_sync(PiUvService *service, struct uv_fs_s *request,\n    int descriptor);\n",
          "input_sha256": "55149B084DBFC348B68E92AE7D9A3FA52589A65D08DA0159F1AF6623924E12CE",
          "output_sha256": "D5BB021DFECD726A7FBB6860616753957C1B25B11C4776BAFD24F2C935589D34"
        }
      ],
      "forward_exact": true,
      "whole_inverse_exact": true
    },
