        {
          "index": 0,
          "offset_in_sequential_input": 40521,
          "before": "int pi_uv_fs_cancel(PiUvFsRequest *request) {\n",
          "after": "int pi_uv_fs_close_sync(PiUvService *service, struct uv_fs_s *request,\n                        int descriptor) {\n    assert(service != NULL && request != NULL);\n    /* cb == NULL follows the actual synchronous libuv FS implementation.\n     * No service command, queued completion, callback, or waiting count is\n     * involved. The original caller traces and cleans its own stack request. */\n    return uv_fs_close(&service->loop, request, descriptor, NULL);\n}\nint pi_uv_fs_cancel(PiUvFsRequest *request) {\n",
          "input_sha256": "5A8DA6FA8AD86DCB44FD5E0B20A139FEF1B1A7D9A7E0CCBD24545702DC00AE71",
          "output_sha256": "85E49522C7C05764957ADACF6B80F2745D5C06E0A361D33531A8BAF9FEA49F87"
        }
      ],
