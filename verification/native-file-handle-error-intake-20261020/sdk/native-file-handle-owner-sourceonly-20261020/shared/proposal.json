          "before": "/// remains traced until the wrapper itself is collected, even after detach.\n",
          "after": "/// remains traced until the wrapper itself is collected, even after detach.\n/// FileHandle's closing Promise is another actual internal wrapper edge; it\n/// remains owned by that same wrapper after its native State is deleted.\n",
          "input_sha256": "16C3B02F8DC9398131A2E691986B82A792DAF29A5132B50E66FE7738744D5994",
          "output_sha256": "EAA7CB8CAEB761F778D84FE0B1C8B848B9A9E22958069CDEB17B1BE2CA4E9308"
        },
        {
          "index": 1,
          "offset_in_sequential_input": 2581,
          "before": "    onread: c.JSValue,\n",
          "after": "    onread: c.JSValue,\n    closing_promise: c.JSValue,\n",
          "input_sha256": "EAA7CB8CAEB761F778D84FE0B1C8B848B9A9E22958069CDEB17B1BE2CA4E9308",
          "output_sha256": "08BA83513999F3BCF3DE2A5B5664B4E546BDB38E3E2905706720CF14284FA375"
        },
        {
          "index": 2,
          "offset_in_sequential_input": 11161,
          "before": "            created.* = .{ .registry = self.retain(), .onread = c.pi_js_undefined() };\n",
          "after": "            created.* = .{\n                .registry = self.retain(), .onread = c.pi_js_undefined(),\n                .closing_promise = c.pi_js_undefined(),\n            };\n",
          "input_sha256": "08BA83513999F3BCF3DE2A5B5664B4E546BDB38E3E2905706720CF14284FA375",
          "output_sha256": "BBA13146BC123CC596684A714D2014757F6FDCF81AD741293F101BE39E56C026"
        },
        {
          "index": 3,
          "offset_in_sequential_input": 10415,
          "before": "    /// Caller has already selected the genuine template's instance prototype.\n",
          "after": "    /// FileHandle::kClosingPromiseSlot is an internal wrapper edge, not a\n    /// guest property, a native Global, or a slot in the derived native object.\n    pub fn fileHandleClosingPromise(self: *Registry, s: *LocalScope,\n        wrapper: c.JSValue) !c.JSValue\n    {\n        const fields = self.streamFields(wrapper) orelse return self.check(.invalid_wrap_brand);\n        return s.own(a.duplicate(s.engine, fields.closing_promise));\n    }\n    pub fn setFileHandleClosingPromise(self: *Registry, s: *LocalScope,\n        wrapper: c.JSValue, value: c.JSValue) !void\n    {\n        const fields = self.streamFields(wrapper) orelse return self.check(.invalid_wrap_brand);\n        var previous = fields.closing_promise;\n        fields.closing_promise = a.duplicate(s.engine, value);\n        s.boundary.release(&previous);\n    }\n    /// Caller has already selected the genuine template's instance prototype.\n",
          "input_sha256": "BBA13146BC123CC596684A714D2014757F6FDCF81AD741293F101BE39E56C026",
          "output_sha256": "6CA28E011B306531ACDE22C42F1881211ACE9F75D084AA68179201519E2FADFF"
        },
        {
          "index": 4,
          "offset_in_sequential_input": 25302,
          "before": "        scope.boundary.release(&fields.onread);\n",
          "after": "        scope.boundary.release(&fields.onread);\n        scope.boundary.release(&fields.closing_promise);\n",
          "input_sha256": "6CA28E011B306531ACDE22C42F1881211ACE9F75D084AA68179201519E2FADFF",
          "output_sha256": "8D901ABF8818676ACD3A787E4DA152E488A69AA0E08A1D633732F6BE079D137A"
        },
        {
          "index": 5,
          "offset_in_sequential_input": 25998,
          "before": "        const onread = fields.onread;\n        fields.onread = c.pi_js_undefined();\n        c.JS_FreeValueRT(runtime, onread);\n",
          "after": "        const onread = fields.onread;\n        const closing_promise = fields.closing_promise;\n        fields.onread = c.pi_js_undefined();\n        fields.closing_promise = c.pi_js_undefined();\n        c.JS_FreeValueRT(runtime, onread);\n        c.JS_FreeValueRT(runtime, closing_promise);\n",
          "input_sha256": "8D901ABF8818676ACD3A787E4DA152E488A69AA0E08A1D633732F6BE079D137A",
          "output_sha256": "427788B1A220837ED978744183BF36DEAA2A40562028E0895ED31C24C1225E0D"
        },
        {
          "index": 6,
