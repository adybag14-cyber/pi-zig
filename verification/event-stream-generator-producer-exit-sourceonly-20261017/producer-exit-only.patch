+   release capabilities without ordinary resolver calls, and return the first
+   actual fatal to the entry/job boundary. Already-published JS Promises are not
+   given ordinary settlements during an uncatchable host abort. */
+static void js_pi_ag_abort(JSContext *caller, JSContext *owned_realm,
+                           JSAsyncGeneratorData *s, JSValue first_fatal)
+{
+    bool have = true, fatal = true;
+    JSAsyncGeneratorRequest *request;
+    js_async_generator_complete(owned_realm, s);
+    js_pi_ag_take_pending(owned_realm, &first_fatal, &have, &fatal);
+    while (!list_empty(&s->queue)) {
+        request = list_entry(s->queue.next, JSAsyncGeneratorRequest, link);
+        list_del(&request->link);
+        JS_FreeValue(owned_realm, request->result);
+        js_pi_ag_take_pending(owned_realm, &first_fatal, &have, &fatal);
+        JS_FreeValue(owned_realm, request->promise);
+        js_pi_ag_take_pending(owned_realm, &first_fatal, &have, &fatal);
+        JS_FreeValue(owned_realm, request->resolving_funcs[0]);
+        js_pi_ag_take_pending(owned_realm, &first_fatal, &have, &fatal);
+        JS_FreeValue(owned_realm, request->resolving_funcs[1]);
+        js_pi_ag_take_pending(owned_realm, &first_fatal, &have, &fatal);
+        js_free(owned_realm, request);
+    }
+    /* caller is an active same-runtime entry/callback context. It remains
+       valid if retiring the last native-owner reference frees the body realm. */
+    JS_FreeContext(owned_realm);
+    js_pi_ag_take_pending(caller, &first_fatal, &have, &fatal);
+    JS_Throw(caller, first_fatal);
+}
