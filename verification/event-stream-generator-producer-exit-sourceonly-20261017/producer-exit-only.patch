+/* Only CURRENT pending events are examined here. Flagged action/input/rejected
+   DATA is never promoted. Selected reasons remain owned outside pending slots. */
+static void js_pi_ag_take_pending(JSContext *ctx, JSValue *selected,
+                                  bool *have, bool *fatal)
+{
+    JSValue cleanup, displaced;
+    while (JS_HasException(ctx)) {
+        cleanup = JS_GetException(ctx);
+        if (!*have) {
+            *selected = cleanup;
+            *have = true;
+            *fatal = JS_IsUncatchableError(cleanup);
+            continue;
+        }
+        if (!*fatal && JS_IsUncatchableError(cleanup)) {
+            displaced = *selected;
+            *selected = cleanup;
+            *fatal = true;
+        } else {
+            displaced = cleanup;
+        }
+        JS_FreeValue(ctx, displaced);
+    }
+}
+
+static void js_pi_ag_free_value(JSContext *ctx, JSValue owned)
+{
+    JSValue selected = JS_UNDEFINED;
+    bool have = false, fatal = false;
+    js_pi_ag_take_pending(ctx, &selected, &have, &fatal);
+    JS_FreeValue(ctx, owned);
+    js_pi_ag_take_pending(ctx, &selected, &have, &fatal);
+    if (have)
+        JS_Throw(ctx, selected);
+}
+
+static void js_pi_ag_free_context(JSContext *caller, JSContext *owned)
+{
