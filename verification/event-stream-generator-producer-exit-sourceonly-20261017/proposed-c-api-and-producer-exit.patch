+/* Native factory errors obey the C API exception-return convention. Keep the
+   selected reason outside pending while releasing displaced owned state. */
+static JSValue js_pi_generator_discard_pending(JSContext *ctx, JSValue value)
+{
+    JSValue reason = JS_GetException(ctx), cleanup, displaced;
+    bool fatal = JS_IsUncatchableError(reason);
+    JS_FreeValue(ctx, value);
+    while (JS_HasException(ctx)) {
+        cleanup = JS_GetException(ctx);
+        if (!fatal && JS_IsUncatchableError(cleanup)) {
+            displaced = reason;
+            reason = cleanup;
+            fatal = true;
+        } else {
+            displaced = cleanup;
+        }
+        JS_FreeValue(ctx, displaced);
+    }
+    return JS_Throw(ctx, reason);
+}
