+/* Checked native opt-in closure path. js_closure2 is the actual VM closure/GC
+   initializer; closure_var_count is zero, so it performs no fallible work.
+   Ordinary js_closure and js_function_set_properties remain unchanged. */
+static JSValue js_pi_checked_generator_closure(JSContext *ctx,
+                                               JSFunctionBytecode *b)
+{
+    JSValue function, name, prototype;
+    function = JS_NewObjectClass(ctx, func_kind_to_class_id[b->func_kind]);
+    if (JS_IsException(function))
+        return js_pi_generator_discard_pending(ctx,
+                    JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b));
+    function = js_closure2(ctx, function, b, NULL, NULL);
+    if (JS_DefinePropertyValue(ctx, function, JS_ATOM_length,
+                               js_int32(b->defined_arg_count),
+                               JS_PROP_CONFIGURABLE) < 0)
+        return js_pi_generator_discard_pending(ctx, function);
+    name = JS_AtomToString(ctx, b->func_name);
+    if (JS_IsException(name))
+        return js_pi_generator_discard_pending(ctx, function);
+    if (JS_DefinePropertyValue(ctx, function, JS_ATOM_name, name,
+                               JS_PROP_CONFIGURABLE) < 0)
+        return js_pi_generator_discard_pending(ctx, function);
+    prototype = JS_NewObjectProto(ctx, ctx->class_proto[JS_CLASS_ASYNC_GENERATOR]);
+    if (JS_IsException(prototype))
+        return js_pi_generator_discard_pending(ctx, function);
+    if (JS_DefinePropertyValue(ctx, function, JS_ATOM_prototype, prototype,
+                               JS_PROP_WRITABLE) < 0)
+        return js_pi_generator_discard_pending(ctx, function);
+    return function;
+}
