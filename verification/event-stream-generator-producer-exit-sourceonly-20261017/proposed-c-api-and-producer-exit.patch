+static JSValue js_pi_native_generator_function_call(JSContext *caller,
+    JSValueConst function, JSValueConst receiver, int argc, JSValueConst *argv)
+{
+    JSFunctionBytecode *b = JS_VALUE_GET_OBJ(function)->u.func.function_bytecode;
+    JSContext *ctx = b->realm;
+    JSAsyncGeneratorData *s;
+    JSValue owner, object;
+    (void)caller;
+    if (JS_HasException(ctx))
+        return JS_EXCEPTION;
+    if (argc < 0 || (size_t)argc > SIZE_MAX / sizeof(JSValue))
+        return JS_ThrowInternalError(ctx, "Invalid native generator argument count");
+    s = js_mallocz(ctx, sizeof(*s));
+    if (!s)
+        return JS_EXCEPTION;
+    init_list_head(&s->queue);
+    s->state = JS_ASYNC_GENERATOR_STATE_SUSPENDED_START;
+    owner = b->native_async_generator_factory(ctx, b->cpool[0], receiver, argc, argv);
+    if (JS_IsException(owner) || JS_HasException(ctx)) {
+        js_free(ctx, s);
+        if (JS_HasException(ctx))
+            return js_pi_generator_discard_pending(ctx, owner);
+        return owner; /* JS_EXCEPTION without pending is a callback violation. */
+    }
+    /* Use the same live prototype lookup / creation-realm fallback as the
+       ordinary VM generator-function call, after parameter/state capture. */
+    object = js_create_from_ctor(ctx, function, JS_CLASS_ASYNC_GENERATOR);
+    if (JS_IsException(object)) {
+        js_free(ctx, s);
+        return js_pi_generator_discard_pending(ctx, owner);
+    }
+    s->native_resume = b->native_async_generator_resume;
+    s->native_ctx = JS_DupContext(ctx);
+    s->native_owner = owner;
+    s->generator = JS_VALUE_GET_OBJ(object);
+    JS_SetOpaqueInternal(object, s);
+    return object;
+}
