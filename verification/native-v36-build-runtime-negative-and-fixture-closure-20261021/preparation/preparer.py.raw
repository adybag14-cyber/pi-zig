BASIS = "a6b6c37680d4b66f8cb90b9eb03a6efff6d0bef8"
BRANCH = "work/pi-zig-consolidated-20261016"
OLD_PROGRESS = "23A951AAEB578839CC84AD9548C755F63BD034E966549F5C73B93E2833073DD8"
OLD_PROGRESS_BYTES = 354535
OLD_FIXTURE = "0D09BBA76254B22996F4D6B8EB7C43B8487FE4F9C22A02709B4839580AD29127"
OLD_FIXTURE_BYTES = 33137
P = E / "root-native-foundation-v36-new4-runtime-20261021-082608"
C = E / "root-native-foundation-v36-new4-runtime-control-20261021-082608"
G = P / "groups/native-node-file-handle-owner"
BP = E / "root-native-foundation-fresh-v36-new4-buildquery-20261021-080944"
