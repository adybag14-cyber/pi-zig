def gzip_bytes(raw):
    out = io.BytesIO()
    with gzip.GzipFile(filename="",mode="wb",fileobj=out,mtime=0,compresslevel=9) as gz:
        gz.write(raw)
    return out.getvalue()
seal_mappings = []
gzip_pins = []
compressed_sizes = []
for label,proof,size,digest,counts in BOOKENDS:
    before_raw = exact(proof/"before.json",digest,size)
    final_raw = exact(proof/"final.json",digest,size)
    require(before_raw==final_raw,"whole original before/final bytes identical: "+label)
    seal = read_json(before_raw)
    require(seal["candidate_head"]==BASIS and seal["clean"] is True and seal["errors"]==[],"historical clean seal: "+label)
    require({k:len(seal[k]) for k in counts}==counts,"all five historical seal inventories: "+label)
    compressed = gzip_bytes(before_raw)
    require(compressed[:10]==bytes.fromhex("1f8b08000000000002ff"),"deterministic gzip header")
    require(gzip.decompress(compressed)==before_raw==final_raw,"two-source complete raw gzip roundtrip")
    require(gzip_bytes(before_raw)==compressed,"deterministic gzip second encoding")
    gzip_target = ARCHIVE+"/"+label+"/proof/before-and-final.json.gz"
    gzip_pin = add(gzip_target,compressed,"one_lossless_copy_of_each_identical_original_bookend_pair")
    gzip_pins.append(gzip_pin)
    compressed_sizes.append(len(compressed))
    seal_mappings.append({
      "schema":1,"status":"exact_original_bookends_represented_losslessly","phase":label,
      "raw_bytes":size,"raw_sha256":digest,"original_before_and_final_byte_identical":True,
      "originals":[raw_pin(proof/"before.json",before_raw),raw_pin(proof/"final.json",final_raw)],
      "archive_target":gzip_target,"archive_pin":gzip_pin,
      "gzip":{"filename":"","mtime":0,"compression_level":9,"header_hex":compressed[:10].hex()},
      "complete_decompression_roundtrip":True,"deterministic_second_encoding_equal":True,
      "historical_seal_counts":counts,"original_files_modified":False,"new_native_execution":False,
      "qualification":False
    })
require(len(seal_mappings)==2 and seal_mappings[0]["raw_sha256"]!=seal_mappings[1]["raw_sha256"],"two distinct original phase seals retained")
add(ARCHIVE+"/seal-archive-map.json",encode(seal_mappings),"lossless_original_buildquery_and_runtime_seal_mapping")

