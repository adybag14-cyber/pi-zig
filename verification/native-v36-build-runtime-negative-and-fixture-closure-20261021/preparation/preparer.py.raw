"""Prepare exact V36 BuildQuery, strict runtime negative and fixture/progress archives outside Main.
Root must issue the exact configuration after the fixture intake commits.
This script only reads Main/Git and creates a new evidence proposal.
It never stages, commits, builds, runs a test, issues a grant, or releases a hold.
"""
from pathlib import Path, PurePosixPath
import copy, datetime, gzip, hashlib, io, json, re, subprocess, sys

