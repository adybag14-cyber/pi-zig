progress_pin = add(PROGRESS,progress_raw,"only_existing_progress_replacement",{"bytes":OLD_PROGRESS_BYTES,"sha256":OLD_PROGRESS})
history_report = {
 "schema":1,"status":"complete_historical_prefixes_and_progress_inverse_verified",
 "basis_progress":raw_pin(M/PROGRESS,old_progress_raw),
 "prior_progress_archive":archived["prior-progress.json"]["target"],
 "projected_progress":progress_pin,"replaced_top_level_keys":sorted(replaced_keys),
 "added_top_level_keys":sorted(added_keys),
 "old_top_level_history_lengths":old_lengths,
 "new_top_level_history_lengths":{k:len(updated[k]) for k in old_lengths},
 "nested_historical_lists_checked":len(list_checks),
 "nested_list_check_inventory_sha256":sha(encode(list_checks)),
 "complete_old_checkpoint_appended":True,
 "old_checkpoint_canonical_sha256":sha(encode(old["current_execution_checkpoint"])),
 "unrelated_historical_records_exact":True,
 "complete_structural_inverse":True,"complete_raw_byte_inverse":True,
 "inverse_method":"Remove exactly added_top_level_keys and restore exactly replaced_top_level_keys from the archived byte-identical prior progress; indent-2 UTF-8 plus LF reproduces the complete 354535-byte original.",
 "qualification":False,"native_execution":False,"source_mutation_hold_released":False
}
add(ARCHIVE+"/history-preservation.json",encode(history_report),"finite_progress_inverse_and_history_proof")
chain_report = {
 "schema":1,"status":"actual_fixture_commit_and_all_raw_bytes_verified",
 "basis_head":BASIS,"fixture_commit":HEAD,"parent_exact":True,
 "manifest":archived["fixture/manifest.json"]["original"],
 "receipt":cfg["fixture_execution"]["receipt"],"execution_inputs":cfg["fixture_execution"],
 "path_count":FIXTURE_PATH_COUNT,"existing_source_replacements":1,"new_archive_paths_including_manifest":FIXTURE_PATH_COUNT-1,
 "complete_changed_path_set_exact":True,"all_donor_current_and_committed_bytes_exact":True,
 "original_raw_fixture_preimage_exact":True,"all_current_fixture_evidence_pins_rehashed":True,
 "production_and_build_sources_unchanged":True,"old_progress_unchanged_by_fixture_intake":True,
 "source_corrections":corrections,"historical_release_consumed_for_this_completed_phase_only":True,
 "new_source_release":False,"native_execution":False,"qualification":False
}
add(ARCHIVE+"/fixture-intake-chain.json",encode(chain_report),"actual_fixture_phase_provenance")
archive_index = {
 "schema":1,"status":"exact_original_buildquery_and_strict_runtime_negative_and_fixture_execution_archive",
 "candidate_head":HEAD,"original_observed_head":BASIS,"archive_prefix":ARCHIVE,
 "raw_archived_files":archive_rows,"compressed_original_bookends":seal_mappings,
 "original_evidence_inventory":archived["preparation/original-evidence-inventory.json"]["original"],
 "original_phase_inventories":{
  key:{"proof_top_level_files":len(row["proof_files"]),"control_top_level_files":len(row["control_files"]),
       "attempted_group_count":len(row["group_files"]),"group_files":{g:len(files) for g,files in row["group_files"].items()}}
  for key,row in inventory["runs"].items()
 },
 "large_original_seal_copies":2,"represented_original_seal_files":4,"cache_files_archived":0,
 "installed_native_binary_files_archived":0,
 "excluded_artifact_subtrees":["buildquery/cache","buildquery/global-cache","buildquery/groups/*/installed"],
 "artifact_journals_and_accepted_raw_metadata_fully_archived":True,
 "all_raw_archive_suffixes_preserve_original_bytes":True,
 "original_evidence_modified":False,"qualification":False,"native_execution":False,
 "source_mutation_hold_released":False
}
add(ARCHIVE+"/archive-index.json",encode(archive_index),"complete_bounded_archive_mapping")

# Reviewable exact manifest:
# Reviewable exact manifest: one old progress replacement, every archive target new.
rows = []
for target in sorted(payloads):
    raw = payloads[target]
    rows.append({
      "target":target,"source":str(OUT/"projected"/target),
      "bytes":len(raw),"sha256":sha(raw),"before":preimages[target],"role":roles[target]
    })
require([r["target"] for r in rows if r["before"] is not None]==[PROGRESS],"only existing progress replacement")
require(all(r["target"]==PROGRESS or r["target"].startswith(ARCHIVE+"/") for r in rows),"archive manifest scope")
manifest = {
 "schema":1,"status":"exact_v36_build_runtime_negative_progress_archive_intake_unissued",
 "comparison_head":HEAD,"basis_head":BASIS,
 "path_count_including_manifest":len(rows)+1,"rows":rows,"manifest_target":MANIFEST_TARGET,
 "source_build_paths":0,"existing_progress_replacements":1,
 "historical_prefixes_and_full_progress_inverse_verified":True,
 "actual_fixture_commit":HEAD,"original_v36_negative_closure_sha256":negative_record["closure"]["sha256"],
 "original_v36_buildquery_closure_sha256":build_record["closure"]["sha256"],
 "original_v36_metadata_acceptance_sha256":build_record["metadata_acceptance"]["sha256"],
 "source_mutation_hold_released":False,"main_applied":False,
 "native_execution_authorized":False,"application_qualified":False,
 "production_bridge_removed":False,"published_release":False,
 "scope":"One exact progress replacement and new immutable raw/gzip original BuildQuery, strict runtime negative and fixture execution archives only. Complete original metadata/flags/stderr remain historical and are never transferred to the corrected source. Separate Root review/release/intake is required. No source, build, index, cache, compiler, test, bridge or publication action is authorized."
}
manifest_raw = encode(manifest)
all_targets = [(r["target"],payloads[r["target"]]) for r in rows]+[(MANIFEST_TARGET,manifest_raw)]
require(len({n.casefold() for n,_ in all_targets})==len(all_targets),"complete proposed Windows path aliases")
for target,raw in all_targets:
    relative(target)
    path = inside(M/target,M)
    if target==PROGRESS:
        require(path.read_bytes()==old_progress_raw,"unchanged live progress preimage")
        committed(current_tree,target,old_progress_raw)
    else:
        require(not path.exists() and target not in current_tree,"new archive target collision: "+target)
    prefix = target.casefold()
    require(not any(p.casefold()==prefix for p in current_tree if p!=target),"tracked Windows alias: "+target)
# Path-filtered hash-object has no -w: reject conversion before writing any proposal.
attribute_names = ("filter","working-tree-encoding","ident")
attrs = git("check-attr","-z","--stdin",*attribute_names,input=b"\0".join(n.encode("utf-8") for n,_ in all_targets)+b"\0").split(b"\0")
require(attrs[-1]==b"" and len(attrs)-1==9*len(all_targets),"complete Git attribute output")
for index,(target,raw) in enumerate(all_targets):
    triples = [attrs[9*index+3*j:9*index+3*j+3] for j in range(3)]
    require({tuple(t[:2]) for t in triples}=={(target.encode("utf-8"),a.encode()) for a in attribute_names},"exact target attributes")
    require(all(t[2] in (b"unspecified",b"unset") for t in triples),"unsupported Git transformation")
    filtered = git("hash-object","--path="+target,"--stdin",input=raw).decode().strip()
    require(filtered==blob_id(raw),"Git would normalize exact archive bytes: "+target)
state(HEAD)
original_inventory()
for path,raw in originals.items():
    require(Path(path).read_bytes()==raw,"original input changed before proposal output: "+path)
require(not OUT.exists() and not (M/ARCHIVE).exists(),"final create-only gate")

# The only writes begin here, exclusively under the one new evidence directory.
OUT.mkdir()
for row in rows:
    target = Path(row["source"])
    require(target.is_relative_to(OUT),"proposal output containment")
    target.parent.mkdir(parents=True,exist_ok=True)
    with target.open("xb") as f:
        f.write(payloads[row["target"]])
    require(target.read_bytes()==payloads[row["target"]],"projected output exact")
with (OUT/"manifest.json").open("xb") as f:
    f.write(manifest_raw)
require((OUT/"manifest.json").read_bytes()==manifest_raw,"exact output manifest")
state(HEAD)
original_inventory()
for path,raw in originals.items():
    require(Path(path).read_bytes()==raw,"original input changed after proposal output: "+path)
require(not (M/ARCHIVE).exists(),"no Main archive write")
for target,raw in fixture_current.items():
    require((M/target).read_bytes()==raw,"fixture checkout unchanged")
require((M/PROGRESS).read_bytes()==old_progress_raw,"Main progress unchanged")
review = {
 "schema":1,"status":"source_only_exact_v36_build_runtime_negative_progress_archive_prepared",
 "prepared_utc":now,"candidate_head":HEAD,"preparer":raw_pin(self_path,self_raw),
 "root_configuration":raw_pin(config_path,config_raw),
 "manifest":raw_pin(OUT/"manifest.json",manifest_raw),"commit_paths":len(rows)+1,
 "projected_progress":progress_pin,"archived_raw_file_count":len(archive_rows),
 "compressed_seals":gzip_pins,"original_seal_bytes":[r[2] for r in BOOKENDS],"original_seal_sha256":[r[3] for r in BOOKENDS],
 "historical_buildquery_metadata":61,"historical_runtime_completed":19,"historical_runtime_failed":18,"historical_runtime_passed":1,"historical_runtime_unstarted":42,
 "complete_raw_seal_roundtrip":True,"all_historical_list_prefixes_preserved":True,
 "complete_old_checkpoint_appended":True,"progress_full_raw_byte_inverse":True,
 "existing_replacements":1,"source_build_paths":0,"cache_files":0,
 "all_target_git_blob_bytes_exact":True,"Main_and_index_not_written":True,
 "original_evidence_unchanged":True,"source_mutation_hold_released":False,
 "main_intake_authorized":False,"native_execution_authorized":False,
 "qualification":False,"runtime_authority":False,"production_bridge_removed":False
}
with (OUT/"preparation-review.json").open("xb") as f:
    f.write(encode(review))
print(json.dumps({
 "candidate_head":HEAD,"manifest":review["manifest"],
 "review":json_pin(OUT/"preparation-review.json"),"commit_paths":len(rows)+1,
 "raw_archive_files":len(archive_rows),"gzip_bytes":compressed_sizes,
 "progress":progress_pin,"historical_list_counts":history_report["new_top_level_history_lengths"],
 "native_execution":False,"Main_mutated":False,"qualification":False
}))
