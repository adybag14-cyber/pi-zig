+  ]), event, {});
+  trustAssert(output.result === winner && output.errors.length === 1, "no added yes/no validation");
+  trustAssert(typeof output.errors[0].error === "string" && Object.hasOwn(output.errors[0], "stack"), "null result caught");
+}
