 "commit_message":"commit-message.txt",
}
def require(ok, label):
    if not ok:
        raise AssertionError(label)
def sha(raw):
    return hashlib.sha256(raw).hexdigest().upper()
def encode(value):
    return (json.dumps(value,indent=2)+"\n").encode("utf-8")
def read_json(raw):
    return json.loads(raw.decode("utf-8-sig"))
def raw_pin(path, raw):
    return {"path":str(path),"bytes":len(raw),"sha256":sha(raw)}
def inside(path, base=B):
    path = Path(path)
    require(path.is_absolute(),"absolute input path")
    resolved = path.resolve()
    require(resolved.is_relative_to(base.resolve()),"path outside allowed root: "+str(path))
    current = path
    while current != base and current != current.parent:
        require(not current.is_symlink(),"symlink input: "+str(current))
        if hasattr(current,"is_junction"):
            require(not current.is_junction(),"junction input: "+str(current))
        current = current.parent
    return path
def relative(name):
    require(isinstance(name,str) and re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*",name),"unsafe target")
    require(not PurePosixPath(name).is_absolute(),"absolute target")
    reserved = {"CON","PRN","AUX","NUL",*[f"COM{i}" for i in range(1,10)],*[f"LPT{i}" for i in range(1,10)]}
    for part in name.split("/"):
        require(part not in (".","..") and not part.endswith(("."," ")),"target dot alias")
        require(part.split(".")[0].upper() not in reserved,"target device alias")
    return name
originals = {}
def exact(path, digest, size):
    path = inside(path)
    require(re.fullmatch(r"[0-9A-F]{64}",digest) is not None,"SHA256 format")
    require(type(size) is int and size >= 0,"input length")
    raw = path.read_bytes()
    require(len(raw)==size and sha(raw)==digest,"input bytes: "+str(path))
    old = originals.get(str(path))
    require(old is None or old==raw,"input changed between reads: "+str(path))
    originals[str(path)] = raw
    return raw
def configured(row):
    require(set(row)=={"path","bytes","sha256"},"configured pin keys")
    return exact(Path(row["path"]),row["sha256"],row["bytes"])
def git(*args, input=None):
    q = subprocess.run(["git","--no-optional-locks","-c","core.fsmonitor=false",*args],cwd=M,input=input,capture_output=True)
    require(q.returncode==0,("read-only Git failed",args,q.returncode,q.stderr.decode("utf-8",errors="replace")))
    return q.stdout
def state(head):
    require(git("rev-parse","HEAD").decode().strip()==head,"Main head")
    require(git("branch","--show-current").decode().strip()==BRANCH,"Main branch")
    require(git("status","--porcelain=v1","--untracked-files=all")==b"","Main must be clean")
def blob_id(raw):
    return hashlib.sha1(b"blob "+str(len(raw)).encode()+b"\0"+raw).hexdigest()
def tree(commit):
    result = {}
    aliases = {}
    for item in git("ls-tree","-r","-z",commit).split(b"\0"):
        if not item:
            continue
        meta,name = item.split(b"\t",1)
        mode,kind,oid = meta.decode().split()
        name = name.decode("utf-8")
        require(name.casefold() not in aliases,"Git case alias")
        aliases[name.casefold()] = name
        result[name] = (mode,kind,oid)
    return result
def committed(entries, target, raw):
    require(entries.get(target) in [("100644","blob",blob_id(raw)),("100755","blob",blob_id(raw))],"committed bytes: "+target)
def filenames(directory):
    return {p.name for p in directory.iterdir() if p.is_file()}
def original_inventory():
    initial = inventory["initial_admission"]
    require(initial["proof"]==str(IP) and initial["control"]==str(IC) and initial["job_id"]==INITIAL_JOB,"initial admission original roots and job")
    require(not IP.exists() and initial["proof_absent"] is True,"initial admission created no proof directory")
    required_names = {"grant-launch-adaptation.json","launch.ps1","outer-absence.json","outer.json","outer.stderr.log","outer.stdout.bin","root-grant.json"}
    require(filenames(IC)=={r[0] for r in initial["control_files"]}==required_names,"all seven original initial-admission control files")
    require(not any(p.is_dir() for p in IC.iterdir()),"no initial-admission control subdirectory")
    for key,proof,control,groups,expected_dirs in (
        ("buildquery",BP,BC,GROUPS,{"cache","global-cache","groups"}),
        ("strict_runtime",P,C,GROUPS[:1],{"groups"}),
    ):
        observed = inventory["runs"][key]
        require(observed["proof"]==str(proof) and observed["control"]==str(control),"fixed original evidence roots")
        require(filenames(proof)=={r[0] for r in observed["proof_files"]}=={"before.json","final.json","result.json"},"complete original proof files")
        require({p.name for p in proof.iterdir() if p.is_dir()}==set(observed["proof_directories"])==expected_dirs,"complete original proof directories")
        require(filenames(control)=={r[0] for r in observed["control_files"]},"complete original control files")
        require(not any(p.is_dir() for p in control.iterdir()),"no original control subdirectory")
        require(set(observed["group_files"])==set(groups),"exact original observed group set")
        require({p.name for p in (proof/"groups").iterdir()}==set(groups),"complete original group directories")
        for group in groups:
            directory = proof/"groups"/group
            require(filenames(directory)=={r[0] for r in observed["group_files"][group]},"complete original group files")
            expected_group_dirs = {"installed"} if key=="buildquery" else set()
            require({p.name for p in directory.iterdir() if p.is_dir()}==expected_group_dirs,"only original installed artifacts excluded from raw evidence archive")
def json_pin(path):
    raw = Path(path).read_bytes()
    return raw_pin(path,raw)

require(len(sys.argv)==3,"exact Root configuration path and SHA256 required")
config_path = inside(Path(sys.argv[1]),E)
config_raw = config_path.read_bytes()
require(sha(config_raw)==sys.argv[2],"Root configuration SHA256")
cfg = read_json(config_raw)
require(cfg["status"]=="root_reviewed_specific_v37_progress_negative_archive_preparation","Root-specific status")
require(cfg["evidence_preparation_authorized"] is True,"Root evidence preparation grant")
for name in ("main_intake_authorized","native_execution_authorized","runtime_authority","qualification"):
    require(cfg[name] is False,"no authority: "+name)
self_path = inside(Path(__file__),E)
self_raw = self_path.read_bytes()
require(sha(self_raw)==cfg["preparer_sha256"],"exact preparer bytes")
require(cfg["basis_head"]==BASIS,"historical Main basis")
HEAD = cfg["fixture_commit"]
require(isinstance(HEAD,str) and re.fullmatch(r"[0-9a-f]{40}",HEAD) and HEAD!=BASIS,"actual fixture commit required")
require(cfg["output_directory"]==str(OUT) and cfg["archive_target_prefix"]==ARCHIVE,"fixed output roots")
require(set(cfg["fixture_execution"])==set(EXECUTION_NAMES),"complete fixture execution input set")
require(set(cfg["fixture_source"])==set(FIXTURE_SOURCE_NAMES),"complete fixture source input set")
FIXTURE_MANIFEST = E / "pending-v37-filehandle-runtime-fixtures-main-intake-20261021/manifest.json"
FIXTURE_ARCHIVE = "verification/native-v37-build-runtime-negative-and-fixture-closure-20261021"
require(cfg["fixture_source"]["manifest"]["path"]==str(FIXTURE_MANIFEST) and cfg["fixture_archive_target_prefix"]==FIXTURE_ARCHIVE,"fixed exact future fixture manifest and separate archive")
require(cfg["original_evidence_inventory"]["path"]==str(INVENTORY_PATH),"fixed observed evidence inventory path")
INVENTORY_SHA = cfg["original_evidence_inventory"]["sha256"]
INVENTORY_BYTES = cfg["original_evidence_inventory"]["bytes"]
require(cfg["runtime_negative_closure"]["path"]==str(C/"independent-negative-runtime-closure.json"),"original exact runtime closure path")
runtime_closure_raw = configured(cfg["runtime_negative_closure"])
runtime_root_raw = configured(cfg["runtime_negative_root_acceptance"])
RUNTIME_CURRENT_FILES = cfg["runtime_current_files_rehashed"]
require(type(RUNTIME_CURRENT_FILES) is int and RUNTIME_CURRENT_FILES==34365,"actual accepted runtime inventory cardinality")
require(cfg["runtime_negative_closure"]=={"path":str(C/"independent-negative-runtime-closure.json"),"bytes":22838,"sha256":"321ABB743297FC9720D36E78F17B38441F8FAE3A60BEA32DE488FC248342F517"},"observed exact accepted original runtime closure")
require(cfg["runtime_negative_root_acceptance"]=={"path":str(E/"root-v37-new4-retry1-original-negative-runtime-acceptance-20261021.json"),"bytes":3131,"sha256":"D305B2B2E462CA38BCC4D0E8B44F51E8F997DA902ABBD323E1F9283B51BC6557"},"observed exact Root original runtime acceptance")
FIXTURE_MANIFEST_SHA = cfg["fixture_source"]["manifest"]["sha256"]
FIXTURE_EXECUTOR = inside(Path(cfg["fixture_source"]["executor"]["path"]),E)
FIXTURE_EXECUTOR_SHA = cfg["fixture_source"]["executor"]["sha256"]
FIXTURE_ADAPTATION_SHA = cfg["fixture_source"]["executor_adaptation"]["sha256"]
FIXTURE_PATH_COUNT = cfg["fixture_path_count"]
require(type(FIXTURE_PATH_COUNT) is int and FIXTURE_PATH_COUNT>1,"actual fixture manifest count required")
NEW_FIXTURES = cfg["fixtures_after"]
require(set(NEW_FIXTURES)==set(FIXTURES),"both exact selected fixture postimages required")
for target,row in NEW_FIXTURES.items():
    require(set(row)=={"bytes","sha256"} and type(row["bytes"]) is int and row["bytes"]>0 and re.fullmatch(r"[0-9A-F]{64}",row["sha256"]) and row["sha256"]!=OLD_FIXTURES[target]["sha256"],"exact changed fixture bytes required: "+target)
require(isinstance(cfg["fixture_extra_files"],list),"explicit complete retained fixture extras")
require(isinstance(cfg["fixture_commit_message"],str) and cfg["fixture_commit_message"].endswith("\n"),"exact future fixture commit message")
require(isinstance(cfg["fixture_correction_name"],str) and cfg["fixture_correction_name"],"reviewed bounded fixture correction name")
require(type(cfg["fixture_finite_hunks"]) is int and cfg["fixture_finite_hunks"]>0,"actual reviewed correction hunk count")
require(not OUT.exists() and not (M/ARCHIVE).exists(),"create-only output/archive")
state(HEAD)
require(git("rev-parse",HEAD+"^").decode().strip()==BASIS,"single exact fixture commit parent")
require(git("rev-parse","--show-object-format").decode().strip()=="sha1","known Git blob format")
old_progress_raw = exact(M/PROGRESS,OLD_PROGRESS,OLD_PROGRESS_BYTES)
require(git("show",BASIS+":"+PROGRESS)==old_progress_raw,"original progress committed bytes")
require(git("show",HEAD+":"+PROGRESS)==old_progress_raw,"fixture intake preserves progress")
old = read_json(old_progress_raw)
require(encode(old)==old_progress_raw,"exact historical JSON byte roundtrip")
require(old["status"]=="active_incomplete" and old["schema"]==1,"historical progress schema")
for key in ("application_qualification","production_bridge_removed","published_release"):
    require(old[key] is False,"historical qualification remains false")
old_lengths = {"integrated_source_units":64,"preserved_attempts":35,"retained_recent_native_negatives":12,"execution_checkpoint_history":13}
require({k:len(old[k]) for k in old_lengths}==old_lengths,"exact historical list lengths")
require(old["current_execution_checkpoint"]["schema"]==7,"historical checkpoint schema")
require(old["current_execution_checkpoint"]["status"]=="v36_buildquery_accepted_strict_runtime_negative_closed_fixture_committed_v37_pending","historical current checkpoint")
inventory_raw = exact(INVENTORY_PATH,INVENTORY_SHA,INVENTORY_BYTES)
inventory = read_json(inventory_raw)
require(inventory["status"]=="source_only_unissued_exact_observed_v37_archive_inputs" and inventory["basis_head"]==BASIS,"exact observed evidence inventory")
require(inventory["groups"]==GROUPS and inventory["declared_counts"]==[18,3,24,13] and inventory["accepted_metadata_counts"]==ACTUAL_COUNTS,"actual complete historical groups/counts")
require(set(inventory["runs"])=={"buildquery","strict_runtime"},"both historical phases required")
require(inventory["runs"]["buildquery"]["seal_counts"]==BUILD_COUNTS and inventory["runs"]["strict_runtime"]["seal_counts"]==COUNTS,"both complete historical seal counts")
require(inventory["initial_admission"]["actual_metadata_count"] is None and inventory["initial_admission"]["attempted_groups"]==0,"initial admission metadata remains unknown with no attempted group")
require(inventory["original63"]["issued"] is False and inventory["original63"]["attempted"] is False,"original63 remains explicitly unissued and unattempted")
require(inventory["runtime_negative_closure"]==cfg["runtime_negative_closure"] and inventory["runtime_negative_root_acceptance"]==cfg["runtime_negative_root_acceptance"],"observed inventory binds exact separately accepted runtime closure")
original_inventory()

# Stage all proposal bytes in memory first. Every archived original gets .raw.
payloads, roles, preimages, archived, archive_rows = {}, {}, {}, {}, []
def add(target, raw, role, before=None):
    target = relative(target)
    require(target==PROGRESS or target.startswith(ARCHIVE+"/"),"proposal scope")
    require(target not in payloads and target.casefold() not in {p.casefold() for p in payloads},"duplicate proposal target")
    require(target!=MANIFEST_TARGET,"manifest is included separately")
    payloads[target],roles[target],preimages[target] = raw,role,before
    return raw_pin(OUT/"projected"/target,raw)
def archive(name, path, size, digest):
    raw = exact(path,digest,size)
    target = ARCHIVE+"/"+relative(name)+".raw"
    result = add(target,raw,"immutable_original_bytes")
    archived[name] = {"original":raw_pin(path,raw),"target":target,"projected":result}
    archive_rows.append(archived[name])
    return raw
for key,proof,control,prefix in (("buildquery",BP,BC,"buildquery"),("strict_runtime",P,C,"strict-runtime")):
    observed = inventory["runs"][key]
    for name,size,digest in observed["proof_files"]:
        if name not in ("before.json","final.json"):
            archive(prefix+"/proof/"+name,proof/name,size,digest)
    for name,size,digest in observed["control_files"]:
        archive(prefix+"/control/"+name,control/name,size,digest)
    for group,files in observed["group_files"].items():
        for name,size,digest in files:
            archive(prefix+"/groups/"+group+"/"+name,proof/"groups"/group/name,size,digest)
for name,size,digest in inventory["initial_admission"]["control_files"]:
    archive("initial-admission/control/"+name,IC/name,size,digest)
for row in inventory["extra_files"]:
    archive(row["archive_name"],Path(row["path"]),row["bytes"],row["sha256"])
archive("prior-progress.json",M/PROGRESS,OLD_PROGRESS_BYTES,OLD_PROGRESS)
archive("preparation/original-evidence-inventory.json",INVENTORY_PATH,INVENTORY_BYTES,INVENTORY_SHA)
for key,name in FIXTURE_SOURCE_NAMES.items():
    row = cfg["fixture_source"][key]
    archive("fixture/"+name,Path(row["path"]),row["bytes"],row["sha256"])
execution = {}
for key,name in EXECUTION_NAMES.items():
    row = cfg["fixture_execution"][key]
    raw = configured(row)
    archive("fixture/"+name,Path(row["path"]),row["bytes"],row["sha256"])
    execution[key] = raw if key in ("pathspec","commit_message") else read_json(raw)
archive("preparation/preparer.py",self_path,len(self_raw),sha(self_raw))
archive("preparation/root-issued-config.json",config_path,len(config_raw),sha(config_raw))
for key,name in (("preparer_finite_adaptation","finite-source-adaptation.json"),("preparer_source_review","root-source-review.json"),("preparer_handoff","source-handoff.json")):
    row = cfg[key]
    archive("preparation/"+name,Path(row["path"]),row["bytes"],row["sha256"])
extra_fixture_pins = []
for row in cfg["fixture_extra_files"]:
    require(set(row)=={"name","pin"},"explicit retained fixture extra keys")
    pin = row["pin"]
    archive("fixture/extra/"+relative(row["name"]),Path(pin["path"]),pin["bytes"],pin["sha256"])
    extra_fixture_pins.append(pin)
now = cfg["recorded_utc"]
require(isinstance(now,str),"exact Root recording timestamp")
moment = datetime.datetime.fromisoformat(now.replace("Z","+00:00"))
require(moment.utcoffset()==datetime.timedelta(0),"UTC recording timestamp")

# Admit only the actual committed fixture phase, with complete raw Git identity.
manifest_raw = originals[str(FIXTURE_MANIFEST)]
fixture_manifest = read_json(manifest_raw)
require(fixture_manifest["comparison_head"]==BASIS and fixture_manifest["path_count_including_manifest"]==FIXTURE_PATH_COUNT,"fixture manifest basis/count")
target_manifest = relative(fixture_manifest["manifest_target"])
require(target_manifest==FIXTURE_ARCHIVE+"/manifest.json","fixed fixture archive manifest target")
fixture_rows = copy.deepcopy(fixture_manifest["rows"])
fixture_rows.append({"target":target_manifest,"source":str(FIXTURE_MANIFEST),"bytes":len(manifest_raw),"sha256":FIXTURE_MANIFEST_SHA,"before":None,"role":"exact_intake_manifest"})
require(len(fixture_rows)==FIXTURE_PATH_COUNT,"exact fixture commit path count")
names = [relative(r["target"]) for r in fixture_rows]
require(len(set(n.casefold() for n in names))==FIXTURE_PATH_COUNT,"fixture target aliases")
require(sorted(r["target"] for r in fixture_rows if r["before"] is not None)==sorted(FIXTURES),"exactly two reviewed test/support replacements")
require(all(n in FIXTURES or n.startswith(FIXTURE_ARCHIVE+"/") for n in names),"fixture intake scope")
previous_tree,current_tree = tree(BASIS),tree(HEAD)
changed = {v.decode("utf-8") for v in git("diff","--name-only","-z",BASIS,HEAD).split(b"\0") if v}
require(changed==set(names),"complete fixture commit delta")
fixture_current = {}
fixture_before = {}
for row in fixture_rows:
    target = row["target"]
    donor = exact(Path(row["source"]),row["sha256"],row["bytes"])
    current = exact(M/target,row["sha256"],row["bytes"])
    require(current==donor,"fixture current/donor bytes")
    committed(current_tree,target,donor)
    fixture_current[target] = donor
    if row["before"] is None:
        require(target not in previous_tree,"new fixture archive target absent at basis")
    else:
        require(row["before"]==OLD_FIXTURES[target],"exact fixture predecessor pin")
        before = git("show",BASIS+":"+target)
        require({"bytes":len(before),"sha256":sha(before)}==OLD_FIXTURES[target],"fixture original committed preimage")
        require({"bytes":len(current),"sha256":sha(current)}==NEW_FIXTURES[target],"selected fixture bytes")
        fixture_before[target] = before
require(set(fixture_before)==set(FIXTURES),"both actual fixture preimages admitted")
for target,before in fixture_before.items():
    current = fixture_current[target]
    for token in (b"import",b"embedFile",b"cInclude",b"cDefine",b"cUndef"):
        pattern = rb"@"+token+rb"\s*\(([^)]*)\)"
        require(re.findall(pattern,before)==re.findall(pattern,current),"fixture literal dependency invocations unchanged: "+target)
        require(before.count(b"@"+token)==current.count(b"@"+token),"fixture dependency invocation count unchanged: "+target)
    require(re.findall(rb'\btest\s+"([^"]*)"\s*\{',before)==re.findall(rb'\btest\s+"([^"]*)"\s*\{',current),"all exact named test declarations unchanged: "+target)
receipt = execution["receipt"]
release = execution["source_release"]
peer = execution["executor_peer"]
preflight = execution["preflight"]
staged = execution["staged"]
require(receipt["status"]=="exact_source_intake_committed" and receipt["phase"]=="fixture","actual fixture receipt")
require(receipt["before_head"]==receipt["basis_main_head"]==BASIS and receipt["after_head"]==HEAD,"fixture receipt commit chain")
require(receipt["branch"]==BRANCH and receipt["path_count"]==FIXTURE_PATH_COUNT,"fixture receipt branch/count")
require(receipt["manifest"]==str(FIXTURE_MANIFEST) and receipt["manifest_sha256"]==FIXTURE_MANIFEST_SHA,"fixture receipt manifest")
require(receipt["executor_sha256"]==FIXTURE_EXECUTOR_SHA,"fixture receipt executor")
require(receipt["release_sha256"]==cfg["fixture_execution"]["source_release"]["sha256"],"fixture receipt exact release")
require(receipt["staged_and_committed_bytes_match"] is True and receipt["clean_worktree"] is True,"fixture committed byte acceptance")
for key in ("native_execution_authorized","application_qualified","production_bridge_removed"):
    require(receipt[key] is False,"fixture receipt remains source-only")
require(release["status"]=="root_reviewed_exact_v37_fixture_source_intake_release","Root fixture release")
require(release["basis_main_head"]==BASIS and release["branch"]==BRANCH,"release basis")
require(release["executor_sha256"]==FIXTURE_EXECUTOR_SHA and release["source_intake_authorized"] is True,"historical exact fixture authorization")
require(release["authorized_phases"]=={"fixture":{"manifest_sha256":FIXTURE_MANIFEST_SHA,"total_commit_paths":FIXTURE_PATH_COUNT}},"release phase scope")
for key in ("native_execution_authorized","application_qualified","production_bridge_removed","push_authorized_by_this_release"):
    require(release[key] is False,"release excludes native/publication")
if "retained_authoring_preflight" in release:
    require(release["retained_authoring_preflight"] in extra_fixture_pins,"retain any actual release authoring rejection")
required_release_pins = {r["sha256"] for r in release["required_current_pins"]}
require({FIXTURE_MANIFEST_SHA,FIXTURE_EXECUTOR_SHA,FIXTURE_ADAPTATION_SHA,cfg["fixture_execution"]["executor_peer"]["sha256"],cfg["runtime_negative_closure"]["sha256"]}<=required_release_pins,"release binds exact reviewed phase and original runtime negative")
require(peer["status"]=="accepted_bounded_source_only_fixture_intake_adapter_and_manifest" and peer["source_only"] is True,"independent fixture intake peer")
require(peer["candidate_manifest"]==raw_pin(FIXTURE_MANIFEST,manifest_raw),"peer manifest pin")
require(peer["candidate_executor"]==archived["fixture/executor.py"]["original"],"peer executor pin")
require(peer["finite_adaptation"]==archived["fixture/finite-executor-adaptation.json"]["original"],"peer finite adaptation pin")
require(peer["source_audit"]==archived["fixture/independent-source-audit.py"]["original"] and peer["decisive_proof"]==archived["fixture/independent-source-audit.json"]["original"],"peer complete retained proof")
require(peer["adapter_executed"] is False and peer["main_applied"] is False and peer["native_execution_authorized"] is False and peer["application_qualified"] is False,"peer authority remains historical source-only")
receipt_directory = inside(Path(release["receipt_directory"]),E)
for key,filename in (("receipt","fixture-receipt.json"),("preflight","fixture-preflight.json"),("staged","fixture-staged.json"),("pathspec","fixture-paths.nul"),("commit_message","fixture-commit-message.txt")):
    require(Path(cfg["fixture_execution"][key]["path"]).resolve()==(receipt_directory/filename).resolve(),"actual fixture evidence location")
for record in (preflight,staged):
    require(record["before_head"]==BASIS and record["path_count"]==FIXTURE_PATH_COUNT,"fixture preflight/staged basis")
    require(record["manifest_sha256"]==FIXTURE_MANIFEST_SHA and record["executor_sha256"]==FIXTURE_EXECUTOR_SHA,"fixture preflight/staged pins")
    require(record["release_sha256"]==cfg["fixture_execution"]["source_release"]["sha256"],"fixture preflight/staged release")
require(preflight["phase"]=="fixture" and preflight["basis_head"]==BASIS,"fixture preflight phase")
require(preflight["all_donors_live_preimages_and_committed_basis_verified"] is True,"fixture preflight raw preimages")
require(preflight["rows"]==[{k:r[k] for k in ("target","role","bytes","sha256","before")} for r in fixture_rows],"complete fixture preflight rows")
require(preflight["native_execution_authorized"] is False and preflight["qualification"] is False,"preflight authority")
require(staged["exact_index_blob_bytes_verified"] is True,"actual staged raw bytes")
require(execution["pathspec"]==b"\0".join(n.encode("utf-8") for n in names)+b"\0","actual exact staging path list")
require(execution["commit_message"]==cfg["fixture_commit_message"].encode("utf-8"),"actual fixture commit message")
actual_commit = git("cat-file","commit",HEAD).split(b"\n\n",1)[1]
require(actual_commit==execution["commit_message"],"raw committed fixture message exact")

# Root and peer source acceptance binds the finite correction; no source generator runs here.
acceptance = read_json(originals[str(Path(cfg["fixture_source"]["root_source_acceptance"]["path"]))])
require(acceptance["status"]=="root_and_independent_peer_accepted_bounded_filehandle_runtime_fixture_corrections","fixture source acceptance")
require(acceptance["candidate_head"]==BASIS,"accepted two-file fixture basis")
require(acceptance["source_accepted"] is True and acceptance["source_corrections_accepted"] is True,"reviewed source correction accepted")
require(acceptance["finite_hunks"]==cfg["fixture_finite_hunks"],"bounded accepted correction count")
require(acceptance["all58_declared_controls_and4_root_import_topologies_unchanged"] is True and acceptance["production_source_unchanged"] is True,"unchanged controls and production")
correction_locations = {}
for role,key in (("source_proposal","correction_proposal"),("independent_source_peer","independent_correction_peer")):
    pin = cfg["fixture_source"][key]
    require(acceptance[role]==pin,"Root binds exact source proposal and source peer")
    raw = configured(pin)
    matching = [r for r in fixture_rows if Path(r["source"]).resolve()==Path(pin["path"]).resolve() and r["sha256"]==pin["sha256"] and r["bytes"]==pin["bytes"]]
    require(len(matching)==1,"accepted correction proof already committed: "+key)
    correction_locations[key] = {"original":pin,"archived_path":matching[0]["target"]}
proposal = read_json(configured(acceptance["source_proposal"]))
require(proposal["main_basis"]==BASIS and proposal["finite_edits"]==cfg["fixture_finite_hunks"],"accepted proposal basis and finite edit total")
require([r["relative_path"] for r in proposal["files"]]==list(FIXTURES),"accepted proposal exact two-file order")
proposal_edits = 0
for row in proposal["files"]:
    target = row["relative_path"]
    before = configured(row["original"])
    after = configured(row["candidate"])
    require(before==fixture_before[target] and after==fixture_current[target],"Root accepted original/projected donors equal actual committed bytes: "+target)
    replay = before
    for edit in row["edits"]:
        old_bytes,new_bytes = edit["old"].encode(),edit["new"].encode()
        offset = edit["offset"]
        require(sha(replay)==edit["before_sha256"] and replay[offset:offset+len(old_bytes)]==old_bytes,"proposal exact finite source preimage")
        replay = replay[:offset]+new_bytes+replay[offset+len(old_bytes):]
        require(sha(replay)==edit["after_sha256"],"proposal finite source intermediate hash")
    require(replay==after,"proposal complete source forward")
    for edit in reversed(row["edits"]):
        old_bytes,new_bytes = edit["old"].encode(),edit["new"].encode()
        offset = edit["offset"]
        require(replay[offset:offset+len(new_bytes)]==new_bytes,"proposal exact inverse span")
        replay = replay[:offset]+old_bytes+replay[offset+len(new_bytes):]
    require(replay==before and row["full_inverse_exact"] is True,"proposal complete raw source inverse")
    proposal_edits += len(row["edits"])
require(proposal_edits==cfg["fixture_finite_hunks"],"every accepted finite correction edit retained")
for key in ("native_execution_authorized","runtime_qualification","application_qualified"):
    require(acceptance[key] is False,"source acceptance excludes qualification")


# Retain the independently closed initial admission rejection as its own attempt.
initial_root = read_json(exact(INITIAL_ROOT,INITIAL_ROOT_SHA,INITIAL_ROOT_BYTES))
initial_peer = read_json(exact(INITIAL_PEER,INITIAL_PEER_SHA,INITIAL_PEER_BYTES))
require(archived["initial-admission/root-acceptance.json"]["original"]==raw_pin(INITIAL_ROOT,originals[str(INITIAL_ROOT)]),"initial Root receipt archived exactly")
require(archived["initial-admission/independent-peer.json"]["original"]==raw_pin(INITIAL_PEER,originals[str(INITIAL_PEER)]),"initial independent closure archived exactly")
require(initial_root["status"]=="root_accepted_original_v37_new4_initial_admission_negative" and initial_peer["status"]=="independently_closed_initial_admission_negative_before_proof_creation","two exact initial-admission closure authorities")
for record in (initial_root,initial_peer):
    require(record["candidate_head"]==BASIS and record["original_job_id"]==INITIAL_JOB,"initial closure original identity")
    require(record["original_control"]==str(IC) and record["original_proof"]==str(IP),"initial closure original directories")
    require(record["failure"]["reason"]=="Initial grant must be within300seconds before first child launch","original unchanged freshness rejection")
    require(record["failure"]["source_line"]==44 and record["failure"]["first_call_line"]==45 and record["failure"]["maximum_seconds"]==300,"unchanged initial freshness guard")
    require(record["failure"]["driver_sha256"]=="1DD3A9D27FA7B54F9383F325792A9E5259C66C32FA6C601F21216B4DBB483601","unchanged strict driver")
    require(record["failure"]["terminal_job_status"]==record["failure"]["terminal_outer_status"]=="failed" and record["failure"]["terminal_job_exit_code"]==record["failure"]["terminal_outer_exit_code"]==1,"initial failed terminal observations retained")
    for key in ("full_source_vendor_compiler_seal_claim","build_acceptance","runtime_authority","native_execution_authorized","application_qualified"):
        require(record[key] is False,"initial admission negative cannot imply build/runtime qualification")
require(initial_root["negative_accepted"] is True and initial_root["proof_absent"] is True and initial_root["all_groups_unattempted"] is True,"Root accepted only pre-proof negative")
require(initial_root["declared_groups"]==4 and initial_root["declared_controls"]==58 and initial_root["actual_metadata_count"] is None,"initial count separation")
require(initial_root["source_mutation_hold_released"] is False and initial_peer["retry_authorized"] is False,"historical initial closure has no successor authority")
require(initial_root["independent_peer"]==raw_pin(INITIAL_PEER,originals[str(INITIAL_PEER)]),"Root exact initial independent peer")
for root_role,peer_role,archive_name in (
 ("independent_proof","decisive_proof","source-audit.json"),
 ("independent_checker","source_audit","source-audit.py"),
 ("full_job_tool_observation","full_job_tool_observation","job-tool-observation.json"),
 ("process_observation","fresh_process_observation","process-observation.json"),
):
    require(initial_root[root_role]==initial_peer[peer_role]==archived["initial-admission/"+archive_name]["original"],"complete initial original closure proof archived: "+root_role)
for role,name in (("fresh_process_query","process-query.ps1"),("process_query_tool_metadata","process-query-tool-metadata.json")):
    require(initial_peer[role]==archived["initial-admission/"+name]["original"],"initial exact independent process-query evidence retained")
require(initial_root["failure"]==initial_peer["failure"],"initial exact failure authority agreement")
require(initial_root["original_control_exact_names"]==initial_peer["original_control_members"]==sorted(r[0] for r in inventory["initial_admission"]["control_files"]),"initial exact original control names")
require(initial_peer["process_observation"]["original_pids_present"]==initial_peer["process_observation"]["original_direct_children_present"]==initial_peer["process_observation"]["native_candidates"]==[],"historically closed initial original instances")
require(initial_peer["process_observation"]["all_five_classifier_conditions_and_pattern_equal"] is True and initial_peer["process_observation"]["runner_instance_preserved_as_string"] is True,"initial process evidence retains original identity and classifier")
require([g["group"] for g in initial_peer["groups"]]==GROUPS and [g["declared_controls"] for g in initial_peer["groups"]]==[18,3,24,13],"all four initial unattempted groups")
for group in initial_peer["groups"]:
    require(group["actual_metadata_count"] is None and all(group[k] is False for k in ("compile_attempted","metadata_attempted","runtime_attempted")),"initial metadata remains unobserved and no native phase attempted")
initial_outer = read_json(originals[str(IC/"outer.json")])
require(initial_outer["status"]=="failed" and initial_outer["exit_code"]==1 and initial_outer["error"]=="Owned terminal failed: "+initial_outer["executable"] and initial_outer["timeout_seconds"]==1800,"initial retained outer failed under the original bounded owner")
require(originals[str(IC/"outer.stdout.bin")]==b"","initial driver emitted no build result")
require(b"Initial grant must be within300seconds before first child launch" in originals[str(IC/"outer.stderr.log")],"actual original stderr freshness rejection retained")
require(initial_root["original_prepared_launch"]==initial_peer["original_prepared_launch"]==archived["initial-admission/buildquery-launch.json"]["original"],"old prepared launch remains separate from Retry1")

# Read both accepted Retry1 phases. This preparation never reruns any audit.
build = read_json(originals[str(BC/"independent-current-seals-and-owners.json")])
metadata = read_json(originals[str(BC/"independent-metadata-acceptance.json")])
build_result = read_json(originals[str(BP/"result.json")])
build_root = read_json(originals[str(E/"root-v37-new4-retry1-complete-buildquery-acceptance-20261021.json")])
require(build["status"]=="independently_closed_complete_fresh_build_query" and build["candidate_head"]==BASIS,"accepted original V37 Retry1 BuildQuery")
require(build["distinct_current_files_rehashed"]==34354 and build["seal_counts"]==BUILD_COUNTS,"accepted complete BuildQuery inventories")
require([build[k] for k in ("granted_groups","attempted_groups","unstarted_groups","actual_metadata_count","actual_tests_started","native_owner_count")]==[4,4,0,61,0,8],"actual BuildQuery counts")
for key in ("whole_bookends_unchanged","current_all_sealed_inputs_rehashed","current_complete_directory_inventories_verified","current_actual_process_instances_absent","all_original_terminal0_owner_gates_passed","controller_environment_restored"):
    require(build[key] is True,"accepted original BuildQuery gate: "+key)
for key in ("runtime_started","qualification","cache_seeded","source_mutation_hold_released"):
    require(build[key] is False,"BuildQuery does not qualify runtime: "+key)
require(len(build["actual_process_intervals"])==11,"eight native owners and three outer original instances")
require(build["current_absence"]["native"]==[] and build["current_absence"]["direct_children"]==[],"accepted BuildQuery native and child absence")
# Preserve the accepted later Chrome reuse; raw owners need not be an empty list.
require(isinstance(build["current_process_instance_reconciliations"],list),"exact accepted original-instance reconciliation retained")
require(metadata["status"]=="independently_accepted_combined_native_batch_metadata" and metadata["accepted"] is True and metadata["candidate_head"]==BASIS,"actual independent metadata acceptance")
require([g["group"] for g in metadata["groups"]]==GROUPS and [g["actual_count"] for g in metadata["groups"]]==ACTUAL_COUNTS,"actual ordered19/4/24/14 metadata")
require(metadata["runtime_started"] is False and metadata["runtime_qualification"] is False,"metadata acceptance remains distinct from runtime")
require(build["metadata_acceptance"]==archived["buildquery/control/independent-metadata-acceptance.json"]["original"],"BuildQuery closure metadata binding")
require(build_result["status"]=="passed_build_query_batch" and build_result["mode"]=="BuildQuery" and build_result["candidate_head"]==BASIS,"original positive build/query result")
require([g["group"] for g in build_result["groups"]]==GROUPS and all(g["status"]=="passed_build_query" for g in build_result["groups"]),"every original complete BuildQuery group")
require(build_result["runtime_requested"] is False and build_result["product_qualified"] is False,"BuildQuery is not runtime/product qualification")
require(metadata["build_result_sha256"]==archived["buildquery/proof/result.json"]["original"]["sha256"] and metadata["build_source_seal_sha256"]==BOOKENDS[0][3],"metadata binds exact result and original full seal")
require(build_root["status"]=="root_accepted_complete_v37_new4_retry1_buildquery" and build_root["candidate_head"]==BASIS and build_root["batch"]=="new4","Root accepted actual complete BuildQuery")
require(build_root["complete_buildquery_accepted"] is True and build_root["actual_metadata_count"]==61 and build_root["groups"]==GROUPS,"Root BuildQuery scope")
for role,name in (("build_result","buildquery/proof/result.json"),("metadata_acceptance","buildquery/control/independent-metadata-acceptance.json"),("independent_closure","buildquery/control/independent-current-seals-and-owners.json")):
    require(build_root[role]==archived[name]["original"],"Root BuildQuery exact pin: "+role)
require(build_root["build_final"]=={"path":str(BP/"final.json"),"bytes":BOOKENDS[0][2],"sha256":BOOKENDS[0][3]},"Root original BuildQuery final seal")
for key in ("runtime_execution_authorized","qualification","source_mutation_hold_released"):
    require(build_root[key] is False,"Root BuildQuery acceptance has no successor authority")

negative = read_json(originals[str(C/"independent-negative-runtime-closure.json")])
negative_root = read_json(runtime_root_raw)
require(originals[str(C/"independent-negative-runtime-closure.json")]==runtime_closure_raw,"exact configured accepted runtime closure archived")
require(archived["authority/root-runtime-negative-acceptance.json"]["original"]==cfg["runtime_negative_root_acceptance"],"exact configured Root runtime acceptance archived")
require(negative["status"]=="independently_closed_negative_strict_runtime" and negative["candidate_head"]==BASIS and negative["batch"]=="new4","exact V37 Retry1 original runtime negative")
require(negative["distinct_current_files_rehashed"]==RUNTIME_CURRENT_FILES and negative["seal_counts"]==COUNTS,"accepted complete runtime inventory counts")
require([negative[k] for k in ("granted_groups","attempted_groups","unstarted_groups","accepted_cohort","runtime_owner_count","observed_started","observed_completed","observed_failed","observed_passed","not_started")]==[4,1,3,61,1,19,19,5,14,42],"actual original runtime negative counts")
require(negative["metadata_acceptance"]==build["metadata_acceptance"] and negative["independent_build_closure"]==archived["buildquery/control/independent-current-seals-and-owners.json"]["original"],"negative uses exact accepted parent cohort")
for key in ("whole_bookends_unchanged","current_all_sealed_inputs_rehashed","current_complete_directory_inventories_verified","current_actual_process_instances_absent","original_strict_failures_preserved","controller_environment_restored"):
    require(negative[key] is True,"accepted runtime negative gate: "+key)
for key in ("all_original_strict_empty_stderr_and_all_tests_passing_gates_passed","runtime_qualification","product_qualification","source_mutation_hold_released"):
    require(negative[key] is False,"original runtime negative remains failed: "+key)
require(len(negative["observed_groups"])==1 and len(negative["actual_process_intervals"])==4,"one runtime owner and three outer instances")
require(all(negative["current_absence"][k]==[] for k in ("owners","direct_children","native")),"closed original runtime owner inventories")
result = read_json(originals[str(P/"result.json")])
require(result["candidate_head"]==BASIS and result["status"]=="failed" and result["mode"]=="RuntimeOnly","retained original runtime result")
require(result["runtime_requested"] is True and result["product_qualified"] is False and result["all_groups_closed"] is False,"original runtime failure remains a failure")
require(originals[str(P/"result.json")]==originals[str(C/"outer.stdout.bin")],"exact original failed outer result")
require([g["group"] for g in result["groups"]]==GROUPS[:1],"only one original runtime group attempted")
canonical = read_json(originals[str(G/"runtime.results.json")])
require(canonical["expected"]==canonical["started"]==canonical["completed"]==19 and canonical["failed_or_skipped_or_logged_or_leaked"]==5 and canonical["status"]=="failed","original complete19 results retain five failures")
require(canonical["results"]==[{"index":i,"flags":1 if i in (5,10,11,12,16) else 0,"passed":i not in (5,10,11,12,16)} for i in range(19)],"original five failure flags and fourteen passes exactly retained")
phase = result["groups"][0]["phases"]["runtime"]
require(phase["failure"]==phase["original_execution_failure"]=="Native test protocol did not report every selected test passing without logs/leaks","original strict runtime protocol failure")
require(phase["owner_binding"]["status"]=="invalid" and phase["owner_binding"]["errors"]==["Actual metadata/new API or ordinary retained runtime stderr must be empty"],"original strict nonempty stderr rejection")
require(phase["postchecks"]["owner_bound"] is False and all(phase["postchecks"][k] is True for k in ("evidence_valid","source_sealed","artifacts_bound","absence_closed")),"original owner negative and other gates retained")
require(len(originals[str(G/"runtime.stderr.log")])==68389 and sha(originals[str(G/"runtime.stderr.log")])=="1BB42117F374DECBF5C91100686DF7DA7D686A285ECF9F874423D5799AF945ED","exact original nonempty stderr")
require(negative_root["status"]=="root_accepted_original_v37_retry1_new4_strict_runtime_negative_closure" and negative_root["candidate_head"]==BASIS,"Root original runtime negative acceptance")
require(negative_root["negative_closure_accepted"] is True and negative_root["original_nonempty_stderr_and_failure_flags_preserved"] is True,"Root retains strict failures")
for role,name in (("independent_negative_closure","strict-runtime/control/independent-negative-runtime-closure.json"),("independent_negative_auditor","strict-runtime/control/Audit-NegativeV37Retry1New4StrictRuntime.py"),("audit_configuration","strict-runtime/control/independent-negative-runtime-audit-inputs.json"),("root_audit_release","strict-runtime/control/root-negative-runtime-audit-release.json"),("audit_job_observation","strict-runtime/control/independent-negative-audit-job-observation.json")):
    require(negative_root[role]==archived[name]["original"],"Root negative exact pin: "+role)
for key in ("native_execution_authorized","source_mutation_hold_released","runtime_qualification","product_qualification"):
    require(negative_root[key] is False,"Root negative acceptance excludes new authority")
def gzip_bytes(raw):
    out = io.BytesIO()
    with gzip.GzipFile(filename="",mode="wb",fileobj=out,mtime=0,compresslevel=9) as gz:
        gz.write(raw)
    return out.getvalue()
seal_mappings = []
gzip_pins = []
compressed_sizes = []
for label,proof,size,digest,counts in BOOKENDS:
    before_raw = exact(proof/"before.json",digest,size)
    final_raw = exact(proof/"final.json",digest,size)
    require(before_raw==final_raw,"whole original before/final bytes identical: "+label)
    seal = read_json(before_raw)
    require(seal["candidate_head"]==BASIS and seal["clean"] is True and seal["errors"]==[],"historical clean seal: "+label)
    require({k:len(seal[k]) for k in counts}==counts,"all five historical seal inventories: "+label)
    compressed = gzip_bytes(before_raw)
    require(compressed[:10]==bytes.fromhex("1f8b08000000000002ff"),"deterministic gzip header")
    require(gzip.decompress(compressed)==before_raw==final_raw,"two-source complete raw gzip roundtrip")
    require(gzip_bytes(before_raw)==compressed,"deterministic gzip second encoding")
    gzip_target = ARCHIVE+"/"+label+"/proof/before-and-final.json.gz"
    gzip_pin = add(gzip_target,compressed,"one_lossless_copy_of_each_identical_original_bookend_pair")
    gzip_pins.append(gzip_pin)
    compressed_sizes.append(len(compressed))
    seal_mappings.append({
      "schema":1,"status":"exact_original_bookends_represented_losslessly","phase":label,
      "raw_bytes":size,"raw_sha256":digest,"original_before_and_final_byte_identical":True,
      "originals":[raw_pin(proof/"before.json",before_raw),raw_pin(proof/"final.json",final_raw)],
      "archive_target":gzip_target,"archive_pin":gzip_pin,
      "gzip":{"filename":"","mtime":0,"compression_level":9,"header_hex":compressed[:10].hex()},
      "complete_decompression_roundtrip":True,"deterministic_second_encoding_equal":True,
      "historical_seal_counts":counts,"original_files_modified":False,"new_native_execution":False,
      "qualification":False
    })
require(len(seal_mappings)==2 and seal_mappings[0]["raw_sha256"]!=seal_mappings[1]["raw_sha256"],"two distinct original phase seals retained")
add(ARCHIVE+"/seal-archive-map.json",encode(seal_mappings),"lossless_original_buildquery_and_runtime_seal_mapping")

# Update only current state and append records; historical records are immutable.
initial_record = {
 "name":"V37 new4 initial expired-grant admission rejection",
 "status":"independently_closed_initial_admission_negative_before_proof_creation","candidate_head":BASIS,
 "job_id":INITIAL_JOB,"proof":str(IP),"proof_created":False,"control":str(IC),
 "granted_groups":4,"attempted_groups":0,"unstarted_groups":4,"source_declarations":58,
 "compile_attempted":False,"metadata_attempted":False,"actual_metadata_observed":None,"runtime_tests_started":0,
 "independent_closure":archived["initial-admission/independent-peer.json"]["original"],
 "archived_closure":archived["initial-admission/independent-peer.json"]["target"],
 "root_acceptance":archived["initial-admission/root-acceptance.json"]["original"],
 "original_prepared_launch":initial_root["original_prepared_launch"],
 "reason":initial_root["failure"],"original_process_observation":initial_peer["process_observation"],
 "bounded_current_pins_verified":initial_root["root_verified_current_pins"],
 "full_source_vendor_compiler_seal_claim":False,
 "scope":"The unchanged first 300-second freshness guard rejected the initial driver before proof creation or native phases. Resolver/outer process activity is retained; this is distinct from the later fresh Retry1.",
 "runtime_started":False,"runtime_qualification":False,"qualification":False,"source_mutation_hold_released":False
}
build_record = {
 "name":"V37 Retry1 new4 complete fresh BuildQuery and independently accepted metadata",
 "status":"independently_closed_complete_fresh_build_query","candidate_head":BASIS,
 "job_id":BUILD_JOB,"proof":str(BP),"control":str(BC),
 "granted_groups":4,"attempted_groups":4,"unstarted_groups":0,
 "source_declarations":58,"actual_metadata_observed":61,
 "actual_metadata_by_group":[{"group":g,"actual":n} for g,n in zip(GROUPS,ACTUAL_COUNTS)],
