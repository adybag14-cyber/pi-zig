INITIAL_ROOT = E / "root-v37-new4-initial-admission-negative-acceptance-20261021.json"
INITIAL_ROOT_SHA = "913E5C1AD65C42FC084C63304A766105F810C7DDCE50C4109EFA441BAE04C91A"
