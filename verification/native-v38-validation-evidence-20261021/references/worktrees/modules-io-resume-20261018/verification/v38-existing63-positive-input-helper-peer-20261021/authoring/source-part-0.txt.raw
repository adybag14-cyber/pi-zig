 raw=p.read_bytes();need(len(raw)==row["bytes"]and sha(raw)==row["sha256"],"Current pin "+str(p))
 need(str(p)not in seen or seen[str(p)]==row,"One input version")
 seen[str(p)]=dict(row);return raw
