"""Independent static source/immutable-data review. Never evaluates the archive candidate or any prefix."""
from pathlib import Path
import ast,hashlib,json,subprocess
W=Path(r'C:\Users\adyba\pi-zig\worktrees\modules-io-resume-20261018')
S=Path(r'C:\Users\adyba\pi-zig\worktrees\sdk-owners-resume-20261018')
E=Path(r'C:\Users\adyba\pi-zig\evidence')
D=S/'verification/v38-partial-negative-progress-archive-preparer-sourceonly-20261022'
O=S/'verification/v38-progress-archive-preparer-sourceonly-20261021'
P=W/'verification/v38-partial-negative-progress-archive-independent-peer-20261022'
H='014062f2d139254acab4b985b4ae343db637166f'
inputs={};cache={}
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def norm(p):return str(p).replace('/','\\').casefold()
def pin(p,expected=None):
 p=Path(p)
 assert p.is_absolute()
 assert p.is_relative_to(E) or (p.is_relative_to(E.parent/'worktrees') and 'verification' in p.parts)
 k=norm(p)
 if k not in cache:
  b=p.read_bytes();cache[k]=b;inputs[k]={'path':str(p),'bytes':len(b),'sha256':sha(b)}
 b=cache[k];r=inputs[k]
 if expected:assert (len(b),sha(b))==expected,(r,expected)
 return r
def verify(r):
 q=pin(r['path'],(r['bytes'],r['sha256']))
 assert norm(q['path'])==norm(r['path'])
 return r
def body(p,expected=None):pin(p,expected);return cache[norm(p)]
def read(p,expected=None):return json.loads(body(p,expected))
def document(r):verify(r);return json.loads(cache[norm(r['path'])])
def enc(x):return (json.dumps(x,indent=2,ensure_ascii=False)+'\n').encode()
def put(p,value):
 b=enc(value);p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
 assert p.read_bytes()==b
 return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
oldpath=O/'candidate/Prepare-V38PositiveProgressAndValidationArchive-20261021.py'
newpath=D/'candidate/Prepare-V38PartialNegativeProgressAndValidationArchive-20261022.py'
old=body(oldpath,(51755,'00F55DC94CC4151370B837FCDB02FFE991A07AC75C05EFE3022C66D079BD5A77'))
new=body(newpath,(76267,'EE11C073C1D1CAD599D7F88B34B78133A5E3A90F68D1E1094D6AF77D7C5128AB'))
finite=read(D/'finite-source-adaptation.json',(71386,'4865C51ECA0AAE56C4DCBC726F85549EDCB9F911292E7EF0B16C69381E8C15C9'))
pin(D/'finite-source-check.py',(8186,'34B4C33C8E8EFAE5BCBCE8AC4CEA932C5CCDA1F31C5E4245CE5F8521D0F812CC'))
assert finite['original']==pin(oldpath) and finite['candidate']==pin(newpath)
assert len(finite['steps'])==finite['finite_edit_count']==39
state=old;changes=[]
for i,row in enumerate(finite['steps'],1):
 before,after=row['before'].encode(),row['after'].encode();at=row['offset']
 assert row['number']==i and state.count(before)==1 and state.find(before)==at
 assert len(before)==row['before_bytes'] and len(after)==row['after_bytes']
 assert sha(state)==row['before_state_sha256']
 left,right=state[:at],state[at+len(before):]
 assert sha(left)==row['unchanged_prefix_sha256'] and sha(right)==row['unchanged_suffix_sha256']
 successor=left+after+right
 assert sha(successor)==row['after_state_sha256']
 changes.append({'number':i,'label':row['label'],'before_state':sha(state),'after_state':sha(successor),
                 'before_bytes':len(before),'after_bytes':len(after),'unchanged_remainder':True})
 state=successor
assert state==new
for row in reversed(finite['steps']):
 before,after=row['before'].encode(),row['after'].encode();at=row['offset']
 assert sha(state)==row['after_state_sha256'] and state[at:at+len(after)]==after
 state=state[:at]+before+state[at+len(after):]
 assert sha(state)==row['before_state_sha256']
assert state==old
ot,nt=ast.parse(old.decode()),ast.parse(new.decode())
def functions(raw,tree):
 ls=raw.splitlines(keepends=True)
 return {n.name:(n,b''.join(ls[n.lineno-1:n.end_lineno])) for n in tree.body if isinstance(n,ast.FunctionDef)}
of,nf=functions(old,ot),functions(new,nt)
assert len(of)==22 and len(nf)==28
helpers=[]
for name,(node,b) in of.items():
 nn,a=nf[name];assert a==b
 helpers.append({'name':name,'bytes':len(b),'sha256':sha(b),'old_lines':[node.lineno,node.end_lineno],'new_lines':[nn.lineno,nn.end_lineno]})
assert helpers==finite['unchanged_helpers']
added=set(nf)-set(of)
assert added=={'retained_pin','selected_observed','check_existing63_buildquery','check_existing63_prelaunch','check_existing63_partial_negative','check_existing63_negative_cohort'}
assert len(finite['unchanged_regions'])==10
for r in finite['unchanged_regions']:
 b=old[r['old_offset']:r['old_offset']+r['bytes']]
 a=new[r['new_offset']:r['new_offset']+r['bytes']]
 assert b==a and sha(b)==r['sha256'] and old.count(b)==new.count(b)==1
for r in finite['new_helpers']:
 n,b=nf[r['name']]
 assert r=={'name':r['name'],'bytes':len(b),'sha256':sha(b),'lines':[n.lineno,n.end_lineno]}
def literal(tree,name):
 xs=[n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets)]
 assert len(xs)==1
 return ast.literal_eval(xs[0])
for key,count in [('CONFIG_KEYS',18),('COPY_KEYS',11),('ROW_KEYS',5)]:
 assert literal(ot,key)==literal(nt,key) and len(literal(nt,key))==count
assert literal(ot,'HEAD')==literal(nt,'HEAD')==H
assert literal(nt,'PHASES')==('new4-buildquery','new4-runtime','existing63-buildquery','existing63-runtime-prelaunch','existing63-runtime')
assert literal(nt,'ORIGINAL63_SUFFIXES')==('20261021-153711','20261022-133427','20261022-134223')
assert literal(nt,'increments')=={'integrated_source_units':0,'preserved_attempts':7,'retained_recent_native_negatives':1,'execution_checkpoint_history':1}
assert literal(nt,'replaced')==literal(ot,'replaced')|{'retained_recent_native_negatives'}
assert len(literal(nt,'replaced'))==8 and literal(nt,'added')=={'v38_validation_and_archive_checkpoint'}
assert [ast.dump(n) for n in ot.body if isinstance(n,(ast.Import,ast.ImportFrom))]==[ast.dump(n) for n in nt.body if isinstance(n,(ast.Import,ast.ImportFrom))]
assert not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('exec','eval','compile','__import__') for n in ast.walk(nt))
