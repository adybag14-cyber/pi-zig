progress=json.loads(oldprogress);assert enc(progress)==oldprogress
def lists(v,path=()):
 if isinstance(v,list):
  yield path,v
  for i,x in enumerate(v):yield from lists(x,path+(i,))
 elif isinstance(v,dict):
  for k,x in v.items():yield from lists(x,path+(k,))
