assert source.count('OUT.mkdir()')==1 and source.index('OUT.mkdir()')>source.index('require(git("cat-file","blob",HEAD+":"+PROGRESS)==old_raw')
assert 'all(p["phase"] in COMPRESSIBLE_PHASES' in source
assert 'COMPRESSIBLE_PHASES = tuple(p for p in PHASES if p!="existing63-runtime-prelaunch")' in source
assert source.count('check_positive("new4",NEW4,58,0)')==1 and 'check_positive("existing63"' not in source
assert 'new4 = check_positive("new4",NEW4,58,0)\noriginal63 = check_existing63_negative_cohort()' in source
assert 'increments = {"integrated_source_units":0,"preserved_attempts":7,"retained_recent_native_negatives":1,"execution_checkpoint_history":1}' in source
