tree=ast.parse(src); lines=src.splitlines(keepends=True)
old_tree=ast.parse(prior); old_lines=prior.splitlines(keepends=True)
defs=[n for n in tree.body if isinstance(n,ast.FunctionDef)]
assert len(defs)==22 and not any(isinstance(n,(ast.AsyncFunctionDef,ast.Try)) for n in ast.walk(tree))
def body(ls,n): return b"".join(ls[n.lineno-1:n.end_lineno])
old_defs={n.name:n for n in old_tree.body if isinstance(n,ast.FunctionDef)}
helpers=[]
for n in defs:
    b=body(lines,n); o=old_defs.get(n.name); ob=body(old_lines,o) if o else None
    helpers.append({"name":n.name,"first_line":n.lineno,"last_line":n.end_lineno,"bytes":len(b),"sha256":sha(b),"same_named_prior_helper":None if o is None else {"first_line":o.lineno,"last_line":o.end_lineno,"bytes":len(ob),"sha256":sha(ob),"full_raw_bytes_equal":ob==b}})
assert helpers==account["source_accounting"]["functions"]
assert [x["name"] for x in helpers if x["same_named_prior_helper"] and x["same_named_prior_helper"]["full_raw_bytes_equal"]]==["sha","relative","gzip_bytes"]
starts=[1,140,208,291,405,432,481,572,673,len(lines)+1]
regions=[{"first_line":a,"last_line":b-1,"bytes":len(b"".join(lines[a-1:b-1])),"sha256":sha(b"".join(lines[a-1:b-1]))} for a,b in zip(starts,starts[1:])]
assert regions==account["source_accounting"]["full_file_disjoint_regions"] and sum(r["bytes"] for r in regions)==len(src)
const={}
for n in tree.body:
    if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
        try: const[n.targets[0].id]=ast.literal_eval(n.value)
        except (ValueError,TypeError): pass
assert const["HEAD"]==HEAD
