"""Independent static source peer of the inert V38 archive preparer.
Reads source as bytes/AST and immutable evidence as data. Never evaluates the
candidate, any extracted body/prefix, its gzip/progress construction, or config.
Only this fresh review proof is written; Git reads use the modules-io worktree.
"""
import ast, hashlib, json, os, re, subprocess
from pathlib import Path, PureWindowsPath

W=Path(r"C:\Users\adyba\pi-zig\worktrees\modules-io-resume-20261018")
E=Path(r"C:\Users\adyba\pi-zig\evidence")
S=Path(r"C:\Users\adyba\pi-zig\worktrees\sdk-owners-resume-20261018\verification\v38-progress-archive-preparer-sourceonly-20261021")
D=W/"verification/v38-progress-archive-preparer-peer-sourceonly-20261022"
HEAD="014062f2d139254acab4b985b4ae343db637166f"
inputs={}; cache={}
def sha(b): return hashlib.sha256(b).hexdigest().upper()
def enc(v): return (json.dumps(v,indent=2,ensure_ascii=False)+"\n").encode()
def read(p,n=None,h=None):
    p=Path(p); k=str(p).casefold()
    assert p.is_absolute() and (p.is_relative_to(E) or (p.is_relative_to(E.parent/"worktrees") and "verification" in p.parts)),str(p)
    b=cache.get(k)
    if b is None: b=p.read_bytes(); cache[k]=b
    if n is not None: assert len(b)==n,(str(p),len(b),n)
    if h is not None: assert sha(b)==h,(str(p),sha(b),h)
    inputs[k]={"path":str(p),"bytes":len(b),"sha256":sha(b)}
    return b
def pinned(q):
    assert set(q)=={"path","bytes","sha256"},q
    return read(q["path"],q["bytes"],q["sha256"])
def obj(q): return json.loads(pinned(q))
def pin(p): return inputs[str(Path(p)).casefold()]
def git(*args):
    q=subprocess.run(["git","--no-optional-locks","-c","core.fsmonitor=false","-C",str(W),*args],capture_output=True,env={**os.environ,"GIT_OPTIONAL_LOCKS":"0"})
    assert q.returncode==0,q.stderr.decode(errors="replace")
    return q.stdout
