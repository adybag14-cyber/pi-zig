 'cfg["expected_output_paths"]==sorted(target_names)',
 'require(len({n.casefold() for n in target_names})==len(target_names)',
 'git("check-attr","--source="+HEAD,"-z","--stdin",*attributes',
 'value in (b"unset",b"unspecified")',
 'require(path.read_bytes()==value,"original input changed before staging")',
 'require(config_path.read_bytes()==config_raw and self_path.read_bytes()==self_raw',
