# Recompute source field/gate admission accounting against original objects.
objects={"bq":[bq],"rt":[rt],"value":[bq,rt],"build":[build],"metadata":[md],"runtime":[runtime],"build_result":[br],"runtime_result":[rr],"audit_cfg":[cfg],"accepted":md["groups"],"observed":runtime["observed_groups"],"canonical":canon,"job":jobs,"review":[review],"matrix":[matrix],"plan":[plan]}
positive=next(n for n in defs if n.name=="check_positive")
fields=set(); booleans=[]
for n in ast.walk(positive):
    if isinstance(n,ast.Subscript) and isinstance(n.value,ast.Name) and isinstance(n.slice,ast.Constant) and isinstance(n.slice.value,str) and n.value.id in objects:
        fields.add((n.value.id,n.slice.value)); assert all(n.slice.value in v for v in objects[n.value.id])
    if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=="flags":
        role=n.args[0].id
        for k in n.keywords:
            value=k.value
            keys=const["COMMON_TRUE"]+ast.literal_eval(value.right) if isinstance(value,ast.BinOp) else ast.literal_eval(value)
            for key in keys:
                expect=k.arg=="true"; assert all(v[key] is expect for v in objects[role]),(role,key,expect)
                booleans.append((role,key,expect,n.lineno))
assert len(fields)==104 and len(booleans)==40
