rechecked_before_proof":True},"scope":{"source_only":True,"candidate_or_prefix_executed":False,"candidate_helpers_evaluated":False,"source_checker_executed":True,"projected_progress_created":False,"projected_progress_inverse_executed":False,"gzip_executed":False,"archive_or_intake_manifest_created":False,"configuration_issued":False,"Main_or_index_accessed":False,"native_execution_authorized":False,"source_mutation_hold_released":False,"application_qualified":False},"input_pins":sorted(inputs.values(),key=lambda q:q["path"].casefold())}
