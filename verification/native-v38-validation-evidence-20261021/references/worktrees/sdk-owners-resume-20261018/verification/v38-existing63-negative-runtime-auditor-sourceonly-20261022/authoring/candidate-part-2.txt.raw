 require(admission["status"]=="admitted" and probe["phase"]=="runtime" and probe["free_kib"]>=16777216 and probe["minimum_kib"]==16777216 and probe["native"]==[] and probe["native_roots"]==0 and 0<=created-utc_ticks(probe["utc"])<10*10000000,"Original fresh serial sixteen GiB native admission")
 require(absent["status"]=="closed" and absent["phase"]=="runtime" and absent["global_native"]==[],"Original complete phase process absence")
 for e in (absent["evidence"],phase["evidence"],r["absence"]["owners"][number]["evidence"]):
  require(e["valid"] is True and e["evidence_errors"]==[] and e["owner"]["pid"]==owner["pid"] and utc_ticks(e["owner"]["created_utc"])==created and utc_ticks(e["owner"]["completed_utc"])==completed and e["owner"]["exit_code"]==owner["exit_code"] and e["current_owner_pid_present"]==0 and e["current_owned_descendants"]==[] and e["absence_error"] is None and e["canonical_results"]==canonical,"Actual phase terminal identity, canonical observation and original absence")
