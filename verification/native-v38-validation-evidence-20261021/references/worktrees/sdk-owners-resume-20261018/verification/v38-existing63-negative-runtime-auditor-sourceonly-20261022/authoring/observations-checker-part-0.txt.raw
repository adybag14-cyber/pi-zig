 owner=read(gp/"runtime.json");canonical=read(gp/"runtime.results.json")
 stream=raw(gp/"runtime.stdout.bin");err=raw(gp/"runtime.stderr.log")
 offset=0;tags=[];results=[]
 while offset<len(stream):
  assert offset+8<=len(stream)
  tag,size=struct.unpack_from("<II",stream,offset);offset+=8
