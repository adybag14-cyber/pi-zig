inputs={}
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def raw(p,expected=None):
 p=Path(p)
 assert p.is_relative_to(E)or p.is_relative_to(BASE/"worktrees"),str(p)
 b=p.read_bytes();q=dict(path=str(p),bytes=len(b),sha256=sha(b))
 if expected is not None:assert q["sha256"]==expected,(str(p),q["sha256"],expected)
 assert str(p)not in inputs or inputs[str(p)]==q
 inputs[str(p)]=q
 return b
def read(p,expected=None):return json.loads(raw(p,expected))
def pin(p,expected=None):raw(p,expected);return inputs[str(Path(p))]
def stamp(value):
 import re
 match=re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(Z|[+-]\d\d:\d\d)",value)
 assert match is not None
 moment=datetime.datetime.fromisoformat(match[1]+("+00:00"if match[3]=="Z"else match[3]))
 delta=moment-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
 return (delta.days*86400+delta.seconds)*10000000+int((match[2]or"").ljust(7,"0"))
def save(p,value):
 b=(json.dumps(value,indent=2)+"\n").encode()
 with p.open("xb")as f:f.write(b)
 assert p.read_bytes()==b
 return dict(path=str(p),bytes=len(b),sha256=sha(b))
