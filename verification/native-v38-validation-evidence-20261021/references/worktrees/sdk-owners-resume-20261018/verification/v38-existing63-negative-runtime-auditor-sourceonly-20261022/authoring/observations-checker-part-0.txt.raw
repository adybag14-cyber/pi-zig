  elif tag==5:assert size==0 and len(tags)%2==0
  elif tag==4:
   assert size==12 and len(tags)%2==1 and tags[-2]==5
   index,flags=struct.unpack("<IQ",payload);assert index==len(results)
   assert flags==(1 if i==16 and index==22 else 0)
   results.append(dict(index=index,flags=flags,passed=flags==0))
