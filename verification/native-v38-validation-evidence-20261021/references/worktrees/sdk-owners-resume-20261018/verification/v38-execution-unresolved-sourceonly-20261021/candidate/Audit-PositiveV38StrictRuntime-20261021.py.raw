   require(item["parent_created_utc_ticks"]==created+621355968000000000 and item["child_created_utc_ticks"]==utc_ticks(observed["CreationDate"])+621355968000000000,"Independent exact UTC100ns ancestry conversion")
   require(utc_ticks(observed["CreationDate"])<created-10,"Only proven preexisting child instances may be excluded")
 expected_error="Native test protocol did not report every selected test passing without logs/leaks" if want["failed"] else None
