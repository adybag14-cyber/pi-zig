 require((gp/"runtime.stderr.log").read_bytes()==b"","Original strict successful runtime stderr must be empty")
 raw=(gp/"runtime.stdout.bin").read_bytes();offset=0;tags=[];results=[]
 while offset<len(raw):
  require(len(raw)-offset>=8,"Complete raw-wire frame header")
  tag,size=struct.unpack_from("<II",raw,offset);offset+=8
