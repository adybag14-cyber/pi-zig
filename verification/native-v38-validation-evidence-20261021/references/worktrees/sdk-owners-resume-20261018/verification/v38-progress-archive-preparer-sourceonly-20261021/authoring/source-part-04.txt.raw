      declared_groups=63,declared_controls=1249,actual_metadata_observed=original63["actual_metadata_count"],**copy.deepcopy(original63["buildquery"])),
 dict(name="V38 original63 accepted strict runtime",source_head=HEAD,batch="existing63",
      declared_groups=63,declared_controls=1249,actual_metadata_observed=original63["actual_metadata_count"],**copy.deepcopy(original63["runtime"])),
]
