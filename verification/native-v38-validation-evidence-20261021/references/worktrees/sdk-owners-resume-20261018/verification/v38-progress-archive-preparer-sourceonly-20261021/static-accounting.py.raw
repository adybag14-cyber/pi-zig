HEAD="014062f2d139254acab4b985b4ae343db637166f"
SHA="00F55DC94CC4151370B837FCDB02FFE991A07AC75C05EFE3022C66D079BD5A77"
inputs={}
def h(b):return hashlib.sha256(b).hexdigest().upper()
def enc(d):return (json.dumps(d,indent=2,ensure_ascii=False)+"\n").encode()
def read(p,n=None,s=None):
 p=Path(p);assert p.is_absolute() and not p.is_relative_to(E.parent/"main")
 b=p.read_bytes()
 if n is not None:assert len(b)==n,(str(p),len(b),n)
 if s is not None:assert h(b)==s,(str(p),h(b),s)
 inputs[str(p).casefold()]={"path":str(p),"bytes":len(b),"sha256":h(b)}
 return b
def obj(p,n=None,s=None):return json.loads(read(p,n,s))
def bypin(q):
 assert set(q)=={"path","bytes","sha256"}
 return obj(q["path"],q["bytes"],q["sha256"])
def pk(p):return inputs[str(Path(p)).casefold()]
source=read(P,51755,SHA)
tree=ast.parse(source)
source_lines=source.splitlines(keepends=True)
prior=read(POL,75644,"079CE8663FFA9C337F5AC04D41E4222E6B2EFB9B39E5B459F6F4E460F9AC790D")
prior_tree=ast.parse(prior);prior_lines=prior.splitlines(keepends=True)
defs=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))]
assert len(defs)==22
assert all(isinstance(n,ast.FunctionDef) for n in defs)
def block(lines,n):return b"".join(lines[n.lineno-1:n.end_lineno])
old_defs={n.name:n for n in prior_tree.body if isinstance(n,ast.FunctionDef)}
helpers=[]
for n in defs:
 b=block(source_lines,n);o=old_defs.get(n.name);ob=block(prior_lines,o) if o else None
 helpers.append({"name":n.name,"first_line":n.lineno,"last_line":n.end_lineno,"bytes":len(b),"sha256":h(b),"same_named_prior_helper":None if o is None else {"first_line":o.lineno,"last_line":o.end_lineno,"bytes":len(ob),"sha256":h(ob),"full_raw_bytes_equal":ob==b}})
literal_names=("HEAD","BRANCH_REF","PROGRESS","ARCHIVE","MANIFEST_TARGET","BASIS_SHA","MATRIX_SHA","NEW4","CONFIG_KEYS","COPY_KEYS","ROW_KEYS","PHASES","COMMON_TRUE")
constants={}
for n in tree.body:
 if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in literal_names:
  try:constants[n.targets[0].id]=ast.literal_eval(n.value)
  except (ValueError,TypeError):pass
assert len(constants["CONFIG_KEYS"])==18 and len(constants["COPY_KEYS"])==11 and len(constants["ROW_KEYS"])==5
assert constants["HEAD"]==HEAD and len(constants["NEW4"])==4 and len(constants["PHASES"])==4
known=obj(MD/"observed-evidence-inventory.json",338781,"CDFBB34E737011ADD26B7560E5011DC55CADA2803D749B0E1C0263E5954FADED")
plan=obj(MD/"progress-patch-plan.json",56327,"183647A8C0D250DBDD0747CD8E1220B415E9F205737092D4D13AF1DD0D730412")
handoff=obj(MD/"handoff.json",5242,"E75BE89E1B57F32B72B896C35B5106A2069BE672192FCA2623BB1BA723D95187")
assert known["candidate_head"]==plan["candidate_head"]==handoff["candidate_head"]==HEAD
assert known["source_file_versions"]==len(known["rows"])==314 and len(known["direct_pin_relationships"])==183
assert plan["history_prefix_count"]==len(plan["nested_history_prefix_basis"])==181
rows=known["rows"];index={r["original"]["path"].casefold():r["original"] for r in rows};assert len(index)==314
for row in rows:
 q=row["original"];read(q["path"],q["bytes"],q["sha256"])
for edge in known["direct_pin_relationships"]:
 d=bypin(edge["document"])
 for item in edge["json_path"]:d=d[item]
 expected=edge["exact_referenced_pin"]
 assert {k:d[k] for k in ("path","bytes","sha256")}==expected
 assert index[expected["path"].casefold()]==expected
def known_obj(p):
 q=index[str(Path(p)).casefold()];return bypin(q)
def list_records(v,p=()):
 found=[]
 if isinstance(v,list):
  found.append({"path":list(p),"length":len(v),"canonical_sha256":h(enc(v))})
  for i,x in enumerate(v):found+=list_records(x,p+(i,))
 elif isinstance(v,dict):
  for k,x in v.items():found+=list_records(x,p+(k,))
 return found
q=subprocess.run(["git","--no-optional-locks","-c","core.fsmonitor=false","-C",str(W),"cat-file","blob",HEAD+":verification/port-roadmap-resume-20261018/progress.json"],capture_output=True)
assert q.returncode==0,q.stderr
old_raw=q.stdout;assert len(old_raw)==554689 and h(old_raw)=="BEB78B96C31D97681B3F1858AAD303939CEECCB9AD772D73BEE4923034EAC028"
assert hashlib.sha1(b"blob "+str(len(old_raw)).encode()+b"\0"+old_raw).hexdigest()=="ec7a71bd873c789fcb42918501816357c599d2a6"
old=json.loads(old_raw);assert enc(old)==old_raw
assert list_records(old)==plan["nested_history_prefix_basis"]
assert len(list_records(old))==181
assert {k:len(old[k]) for k in plan["preserved_top_level_history_lengths"]}==plan["preserved_top_level_history_lengths"]
