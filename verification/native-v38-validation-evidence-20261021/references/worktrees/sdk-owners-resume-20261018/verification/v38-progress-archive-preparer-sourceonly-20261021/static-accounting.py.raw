"""Static V38 archive source and known-evidence accounting only.
Never imports, compiles, executes or extracts executable candidate code.
Never creates progress, gzip, a copy plan, a Root configuration or Main output.
"""
import ast, hashlib, json, re, subprocess, sys
from pathlib import Path
