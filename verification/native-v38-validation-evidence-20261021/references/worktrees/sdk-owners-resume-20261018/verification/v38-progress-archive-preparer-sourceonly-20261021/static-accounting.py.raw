rt=bypin(plan["known_new4"]["runtime_root_acceptance"])
build=bypin(bq["independent_closure"]);metadata=bypin(bq["metadata_acceptance"]);runtime=bypin(rt["independent_runtime_closure"])
br=bypin(bq["build_result"]);rr=bypin(rt["runtime_result"]);ac=bypin(rt["audit_configuration"])
groups=constants["NEW4"];counts=[19,4,24,14]
bc=Path(bq["independent_closure"]["path"]).parent;bp=Path(bq["build_result"]["path"]).parent
rc=Path(rt["independent_runtime_closure"]["path"]).parent;rp=Path(rt["runtime_result"]["path"]).parent
canon=[known_obj(rp/"groups"/g/"runtime.results.json") for g in groups]
jobs=[known_obj(p/"independent-observed-job-status.json")["data"] for p in (bc,rc)]
prep=E/"combined-native-batch-v38-new4-prepared-20261021"
review=known_obj(prep/"preparation-review.json");matrix=known_obj(prep/"groups.json")
objects={"bq":[bq],"rt":[rt],"value":[bq,rt],"build":[build],"metadata":[metadata],"runtime":[runtime],"build_result":[br],"runtime_result":[rr],"audit_cfg":[ac],"accepted":metadata["groups"],"observed":runtime["observed_groups"],"canonical":canon,"job":jobs,"review":[review],"matrix":[matrix],"plan":[plan]}
positive=next(n for n in defs if n.name=="check_positive")
fields={};unbound=[]
for n in ast.walk(positive):
 if isinstance(n,ast.Subscript) and isinstance(n.value,ast.Name):
  if isinstance(n.slice,ast.Constant) and isinstance(n.slice.value,str):
   name,key=n.value.id,n.slice.value
   if name in objects:fields.setdefault((name,key),[]).append(n.lineno)
   else:unbound.append({"variable":name,"key":key,"line":n.lineno})
  elif not isinstance(n.slice,ast.Constant):
   unbound.append({"variable":n.value.id,"dynamic_index":ast.unparse(n.slice),"line":n.lineno})
field_records=[]
for (name,key),lines in sorted(fields.items()):
 values=objects[name]
 assert all(key in x for x in values),(name,key)
 samples=[x[key] for x in values]
 shape=[{"type":type(x).__name__,"value":x if isinstance(x,(str,int,float,bool,type(None))) else None,"items":len(x) if isinstance(x,(dict,list)) else None} for x in samples]
 field_records.append({"role":name,"field":key,"source_lines":sorted(set(lines)),"selected_objects":len(values),"present_in_every_selected_object":True,"observed_shape":shape})
flag_records=[]
for n in ast.walk(positive):
 if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=="flags":
  name=n.args[0].id
  for k in n.keywords:
   if isinstance(k.value,ast.BinOp):
    assert isinstance(k.value.op,ast.Add) and isinstance(k.value.left,ast.Name) and k.value.left.id=="COMMON_TRUE"
    keys=constants["COMMON_TRUE"]+ast.literal_eval(k.value.right)
   else:keys=ast.literal_eval(k.value)
   expect=k.arg=="true"
   for key in keys:
    assert all(o[key] is expect for o in objects[name]),(name,key,expect)
    flag_records.append({"role":name,"field":key,"source_line":n.lineno,"required_boolean":expect,"all_selected_values_equal":True})
