manifest = {
 "schema":1,"status":"exact_v38_positive_progress_archive_intake_unissued",
 "comparison_head":HEAD,"path_count_including_manifest":len(manifest_rows)+1,
 "rows":manifest_rows,"manifest_target":MANIFEST_TARGET,
 "source_build_paths":0,"existing_progress_replacements":1,
