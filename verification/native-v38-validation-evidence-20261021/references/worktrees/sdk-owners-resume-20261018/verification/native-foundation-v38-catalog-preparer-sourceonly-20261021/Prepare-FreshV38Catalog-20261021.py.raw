# Only one preparation-path literal changes in each accepted metadata auditor.
copies = [
 ("Run-CombinedNativeBatch.ps1",DRIVER),
 ("Get-ModelsNativeCandidates.ps1",CLASSIFIER),
 ("process-ancestry-peer-modules.json","F16CA88D4FB3E66B1B2A907526740FE038CBAA43C1FF70288E4680B7F0D55531"),
