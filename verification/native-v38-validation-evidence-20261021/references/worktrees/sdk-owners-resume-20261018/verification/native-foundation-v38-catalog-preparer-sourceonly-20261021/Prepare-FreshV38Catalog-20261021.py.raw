auditors = {}
for key,out in OUTS.items():
    old = OLDS[key]
    auditor_path = old/"Audit-CombinedNativeBatch.py"
    size,digest = AUDITORS[key]
    exact(auditor_path,digest,size)
    original = auditor_path.read_bytes()
    old_literal = old.relative_to(B).as_posix().encode()
    literal = out.relative_to(B).as_posix().encode()
    assert original.count(old_literal) == 1 and literal not in original
    raw = original.replace(old_literal,literal)
    assert raw.count(literal) == 1 and raw.replace(literal,old_literal) == original
    auditors[key] = (raw,old_literal,literal)
assert all(not out.exists() for out in OUTS.values())
