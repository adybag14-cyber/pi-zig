def sha(raw):
    return hashlib.sha256(raw).hexdigest().upper()
def h(path):
    return sha(path.read_bytes())
def read(path):
    return json.loads(path.read_bytes().decode("utf-8-sig"))
def pin(path):
    raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=sha(raw))
def exact(path, digest, size=None):
    row = pin(path)
    assert row["sha256"] == digest, str(path)
    if size is not None:
        assert row["bytes"] == size, str(path)
    return row
def put(path, value):
    with path.open("xb") as f:
        f.write((json.dumps(value, indent=2) + "\n").encode())
def git(*args):
    return subprocess.check_output(["git", *args], cwd=M)
def declared(raw):
    return re.findall(r'^test "([^"]+)"', raw.decode("utf-8"), re.M)
def relative(name):
    assert isinstance(name, str) and re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", name), name
    assert not PurePosixPath(name).is_absolute()
    for part in name.split("/"):
        assert part not in (".", "..") and not part.endswith((".", " ")), name
        assert part.split(".")[0].upper() not in {"CON", "PRN", "AUX", "NUL", *["COM"+str(i) for i in range(1,10)], *["LPT"+str(i) for i in range(1,10)]}, name
    return name
def state():
    assert git("rev-parse", "HEAD").decode().strip() == HEAD
    assert git("branch", "--show-current").decode().strip() == "work/pi-zig-consolidated-20261016"
    assert git("status", "--porcelain") == b""
def blob_id(raw):
    return hashlib.sha1(b"blob " + str(len(raw)).encode() + b"\0" + raw).hexdigest()
trees = {}
def tree(commit):
    if commit not in trees:
        entries = {}
        aliases = {}
        for item in git("ls-tree", "-r", "-z", commit).split(b"\0"):
            if not item:
                continue
            meta, raw_name = item.split(b"\t", 1)
            mode, kind, oid = meta.decode().split()
            name = raw_name.decode("utf-8")
            assert name.lower() not in aliases or aliases[name.lower()] == name
            aliases[name.lower()] = name
            entries[name] = (mode, kind, oid)
        trees[commit] = entries
    return trees[commit]
def committed(commit, name, raw):
    assert tree(commit).get(name) in [("100644", "blob", blob_id(raw)), ("100755", "blob", blob_id(raw))], (commit, name)
def changed(a, b):
    return {p.decode("utf-8") for p in git("diff", "--name-only", "-z", a, b).split(b"\0") if p}


# The exact future head, two committed intakes and accepted negative closure
# are admitted only through a specifically reviewed, hash-bound Root config.
assert len(sys.argv) == 3, "Root configuration path and exact SHA-256 required"
config_path = Path(sys.argv[1])
exact(config_path, sys.argv[2])
cfg = read(config_path)
assert cfg["status"] == "root_reviewed_specific_v38_catalog_preparation"
assert cfg["catalog_preparation_authorized"] is True
assert cfg["native_execution_authorized"] is False
assert cfg["preparer_sha256"] == h(Path(__file__))
HEAD = cfg["candidate_head"]
assert re.fullmatch(r"[0-9a-f]{40}",HEAD) and HEAD != PREVIOUS_HEAD
assert cfg["previous_head"] == PREVIOUS_HEAD
assert cfg["partition"] == {"new4":4,"regression63":63,"declarations":[58,1249],"union_groups":67,"union_declarations":1307}
assert cfg["preparation_directories"] == {k:str(v) for k,v in OUTS.items()}
assert cfg["fixtures"] == SOURCE_IMAGES
assert cfg["actual_metadata_count"] is None
assert all(cfg[k] is False for k in ("execution_authority","runtime_authority","qualification"))
state()
provenance = {}
def proof(key, path, digest, size=None):
    provenance[key] = exact(path,digest,size)
    return read(path)
def configured(key, row):
    assert set(row) == {"path","bytes","sha256"}
    path = Path(row["path"])
    assert path.is_absolute() and path.resolve().is_relative_to(B.resolve())
    assert re.fullmatch(r"[0-9A-F]{64}",row["sha256"]) and isinstance(row["bytes"],int) and row["bytes"] > 0
    return proof(key,path,row["sha256"],row["bytes"])
provenance["root_configuration"] = pin(config_path)
prior_reviews = {}
historical_source_rebindings = []
for key,old in OLDS.items():
    size,digest = REVIEWS[key]
    review = proof("prior_v37_"+key+"_preparation",old/"preparation-review.json",digest,size)
    prior_reviews[key] = review
    assert review["candidate_head"] == PREVIOUS_HEAD and review["batch"] == key
    assert review["status"] == "source_only_fresh_batch_prepared"
    assert all(review[k] is False for k in ("execution_authority","runtime_authority","qualification"))
    assert review["catalog_groups"] == 117 and review["catalog_declarations"] == 2013
    assert review["actual_metadata_count"] is None and review["prior_metadata_transferred"] is False
    for role in ("driver","matrix","auditor","classifier","combined_build_source_peer","metadata_auditor_adaptation","source_dependency_inventory","exact_intake_inventory","complete_partition"):
        row = review[role]
        assert Path(row["path"]).parent.resolve() == old.resolve(),(key,role)
        provenance["prior_v37_"+key+"_"+role] = exact(Path(row["path"]),row["sha256"],row["bytes"])
    for name,row in review["provenance"].items():
        if name == "progress":
            continue
        if Path(row["path"]).resolve() == (M/OWNER).resolve():
            assert name == "fixture_unchanged_root_native-node-file-handle-owner"
            before = SOURCE_IMAGES[OWNER]
            assert row["sha256"] == before["before_sha256"] and row["bytes"] == before["before_bytes"]
            snapshot = CORRECTION/"original"/OWNER
            rebound = exact(snapshot,row["sha256"],row["bytes"])
            assert snapshot.read_bytes() == git("show",PREVIOUS_HEAD+":"+OWNER)
            provenance["v37_"+key+"_"+name] = rebound
            historical_source_rebindings.append(dict(batch=key,role=name,original=row,immutable_snapshot=rebound,raw_commit=PREVIOUS_HEAD,exact_original_bytes=True))
        else:
            provenance["v37_"+key+"_"+name] = exact(Path(row["path"]),row["sha256"],row["bytes"])
    assert review["driver"]["sha256"] == DRIVER and review["classifier"]["sha256"] == CLASSIFIER
    assert review["matrix"]["sha256"] == MATRIX
    assert (review["auditor"]["bytes"],review["auditor"]["sha256"]) == AUDITORS[key]
