# A complete exact two-commit chain admits two test/support sources and archival evidence.
# Every donor, raw predecessor, committed blob and final checkout is verified.
assert len(cfg["phase_pins"]) == 2
phase_reports,latest,aliases,overlaps = [],{},{},[]
previous = PREVIOUS_HEAD
for phase_index,item in enumerate(cfg["phase_pins"]):
    assert set(item) == {"phase","manifest","receipt","release","commit","path_count"}
    phase,commit,path_count = item["phase"],item["commit"],item["path_count"]
    assert re.fullmatch(r"[0-9a-f]{40}",commit) and isinstance(path_count,int) and path_count > 1
    manifest = configured(phase+"_manifest",item["manifest"])
    receipt = configured(phase+"_receipt",item["receipt"])
    release = configured(phase+"_release",item["release"])
    manifest_path = Path(item["manifest"]["path"])
    assert receipt["status"] == "exact_source_intake_committed" and receipt["phase"] == phase
    assert receipt["before_head"] == previous and receipt["after_head"] == commit
    assert Path(receipt["manifest"]).resolve() == manifest_path.resolve()
    assert receipt["manifest_sha256"] == item["manifest"]["sha256"] and receipt["release_sha256"] == item["release"]["sha256"]
    assert receipt["path_count"] == path_count
    assert receipt["staged_and_committed_bytes_match"] is True and receipt["clean_worktree"] is True
    assert receipt["native_execution_authorized"] is False and receipt["application_qualified"] is False
    assert release["native_execution_authorized"] is False
    assert git("rev-parse",commit+"^").decode().strip() == previous
    target_manifest = relative(manifest.get("target_manifest",manifest.get("manifest_target")))
    rows = copy.deepcopy(manifest["rows"])
    assert len(rows)+1 == path_count
    rows.append(dict(target=target_manifest,source=str(manifest_path),bytes=item["manifest"]["bytes"],sha256=item["manifest"]["sha256"],before=None,role="exact_manifest"))
    targets = set()
    for row in rows:
        target = relative(row["target"])
        assert target not in targets
        targets.add(target)
        assert target.lower() not in aliases or aliases[target.lower()] == target,target
        aliases[target.lower()] = target
        assert target in SOURCE_IMAGES or target.startswith("verification/"),target
        source = Path(row["source"]).resolve()
        assert source.is_relative_to(B.resolve())
        raw = source.read_bytes()
        assert sha(raw) == row["sha256"] and len(raw) == row["bytes"],str(source)
        committed(commit,target,raw)
        before = row["before"]
        if before is None:
            assert target not in tree(previous),(phase,target,"new target existed")
        else:
            assert target in tree(previous),(phase,target,"missing predecessor")
            previous_raw = git("cat-file","blob",tree(previous)[target][2])
            assert len(previous_raw) == before["bytes"] and sha(previous_raw) == before["sha256"],(phase,target)
        if target in latest:
            assert target == PROGRESS
            assert before is not None and before["sha256"] == latest[target]["sha256"] and before["bytes"] == latest[target]["bytes"]
            overlaps.append(dict(phase=phase,path=target,before=before["sha256"],after=row["sha256"]))
        latest[target] = dict(row,phase=phase)
    assert changed(previous,commit) == targets,phase
    if phase_index == 0:
        assert phase == "fixture"
        assert {n for n in targets if not n.startswith("verification/")} == set(SOURCE_IMAGES)
        assert PROGRESS not in targets
        for name,image in SOURCE_IMAGES.items():
            assert latest[name]["before"] == dict(bytes=image["before_bytes"],sha256=image["before_sha256"])
            assert latest[name]["sha256"] == image["after_sha256"] and latest[name]["bytes"] == image["after_bytes"]
        assert {n for n in targets if n in tree(previous)} == set(SOURCE_IMAGES)
    else:
        assert phase == "progress"
        assert all(n.startswith("verification/") for n in targets) and PROGRESS in targets
        assert {n for n in targets if n in tree(previous)} == {PROGRESS}
        assert latest[PROGRESS]["sha256"] == cfg["progress"]["sha256"] and latest[PROGRESS]["bytes"] == cfg["progress"]["bytes"]
    phase_reports.append(dict(phase=phase,before_head=previous,after_head=commit,path_count=path_count,all_donor_and_commit_bytes_exact=True,all_raw_preimages_exact=True))
    previous = commit
assert previous == HEAD and not overlaps
assert changed(PREVIOUS_HEAD,HEAD) == set(latest)
for target,row in latest.items():
    exact(M/target,row["sha256"],row["bytes"])
    committed(HEAD,target,(M/target).read_bytes())
source_union = {n:r for n,r in latest.items() if not n.startswith("verification/")}
assert set(source_union) == set(SOURCE_IMAGES)
for name,image in SOURCE_IMAGES.items():
    exact(M/name,image["after_sha256"],image["after_bytes"])
