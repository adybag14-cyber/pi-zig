# Old source pins never rehash a later checkout at a historical path.
fixture_proposal = proof("fixture_runtime_correction",CORRECTION/"proposal.json","2933A7AB4CCC196984FC27419B3E4A64DCCEB99B0834734AA7B357EE1280C7FC",21669)
causal_proof = proof("fixture_runtime_causal_proof",CORRECTION/"causal-proof.json","39DF95F9780D1A663A6CAC9542B1F7656AAD5EE6CDCCD4761219142295E81C5D",83979)
authority = proof("fixture_selected_authority",CORRECTION/"authority-inputs-v2.json","B97468E1DD34137C80A6199BABE6E227FEBDB5BD3FD0654B31EA3F05CF8C123F",16810)
proof("fixture_preserved_authority_predecessor",CORRECTION/"authority-inputs.json","940ED7F295FDE2A6D4F2F7770B7041E15F810B2A3D6C8FF8CCA8B5079A1B7727",16810)
assert cfg["source_proposal"] == provenance["fixture_runtime_correction"]
assert cfg["causal_source_proof"] == provenance["fixture_runtime_causal_proof"]
assert fixture_proposal["main_basis"] == causal_proof["main_basis"] == PREVIOUS_HEAD
assert fixture_proposal["finite_edits"] == 8 and fixture_proposal["declared_controls"] == 58
assert fixture_proposal["actual_metadata_prediction"] is None
assert all(fixture_proposal[k] is False for k in ("native_execution","compiler_execution","Main_written","candidate_execution"))
assert [r["relative_path"] for r in fixture_proposal["files"]] == list(SOURCE_IMAGES)
fixture_bytes = {}
selected_files = []
hunk_count = 0
for row in fixture_proposal["files"]:
    name = row["relative_path"]
    image = SOURCE_IMAGES[name]
    for role in ("original","candidate"):
        source = row[role]
        provenance["fixture_"+role+"_"+Path(name).stem] = exact(Path(source["path"]),source["sha256"],source["bytes"])
    before = Path(row["original"]["path"]).read_bytes()
    after = Path(row["candidate"]["path"]).read_bytes()
    assert row["current"] == dict(path=str(M/name),bytes=image["before_bytes"],sha256=image["before_sha256"])
    assert row["original"]["bytes"] == image["before_bytes"] and row["original"]["sha256"] == image["before_sha256"]
    assert row["candidate"]["bytes"] == image["after_bytes"] and row["candidate"]["sha256"] == image["after_sha256"]
    assert before == git("show",PREVIOUS_HEAD+":"+name) and after == (M/name).read_bytes()
    work = before
    for edit in row["edits"]:
        old,new = edit["old"].encode(),edit["new"].encode()
        offset = edit["offset"]
        assert sha(work) == edit["before_sha256"] and work[offset:offset+len(old)] == old
        work = work[:offset]+new+work[offset+len(old):]
        assert sha(work) == edit["after_sha256"]
    assert work == after
    for edit in reversed(row["edits"]):
        old,new = edit["old"].encode(),edit["new"].encode()
        offset = edit["offset"]
        assert work[offset:offset+len(new)] == new
        work = work[:offset]+old+work[offset+len(new):]
    assert work == before and row["full_inverse_exact"] is True
    assert declared(before) == declared(after) == row["named_controls_exact"]
    for token in ("import","embedFile","cInclude","cDefine","cUndef"):
        pattern = rb"@"+token.encode()+rb"\s*\(([^)]*)\)"
        assert re.findall(pattern,before) == re.findall(pattern,after)
        assert before.count(b"@"+token.encode()) == after.count(b"@"+token.encode())
    fixture_bytes[name] = dict(original=before,candidate=after)
    hunk_count += len(row["edits"])
    selected_files.append(dict(relative_path=name,original=row["original"],candidate=row["candidate"],finite_edits=len(row["edits"])))
