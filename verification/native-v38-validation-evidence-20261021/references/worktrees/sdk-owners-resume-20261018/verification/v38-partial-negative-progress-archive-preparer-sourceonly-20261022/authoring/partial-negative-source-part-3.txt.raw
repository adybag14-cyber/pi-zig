 demotions")
    failed = []
    for number,group in enumerate(existing63[:17]):
        gp = rp/"groups"/group
        canonical = doc(gp/"runtime.results.json")
        observed,accepted = runtime["observed_groups"][number],metadata["groups"][number]
        n,fail = ORIGINAL63_COUNTS[number],int(number==16)
        expected = [{"index":i,"flags":int(number==16 and i==22),"passed":not(number==16 and i==22)} for i in range(n)]
        require(canonical["expected"]==canonical["started"]==canonical["completed"]==n and
                canonical["failed_or_skipped_or_logged_or_leaked"]==fail and canonical["status"]==("failed" if fail else "passed"),"all original canonical partial counts")
        require(canonical["results"]==expected,"exact320 zero flags andsingle flag1")
        expected_named = [dict(row,name=accepted["tests"][i]) for i,row in enumerate(expected)]
        require(observed["results"]==expected_named and observed["started"]==observed["completed"]==n and
                observed["failed"]==fail and observed["original_group_status"]==result["groups"][number]["status"],"all321 actual names and demotions")
        require(observed["canonical"]==archived_pin(gp/"runtime.results.json"),"exact original canonical bytes")
        require((len(raw(gp/"runtime.stderr.log"))==0)==(number<16),"retain first16 empty andfailed nonempty stderr")
        for row in expected_named:
            if not row["passed"]:
                failed.append(dict(group=group,**{k:row[k] for k in ("index","flags","name")}))
    require(failed==root["failed_tests"]==runtime["observed_failed_tests"] and root["failed_indices"]==[22],"actual sole failure identity retained")
    require(len(runtime["original_attempted_group_files"])==238,"all238 original group files")
    for key in ("original_receipts","original_attempted_group_files","original_outer_outputs"):
        for row in runtime[key]:
            retained_pin(row)
    require(runtime["original_root_partial_observation"]==root["original_root_observation"],"exact original Root partial observation")
    audit_cfg = document(root["audit_configuration"])
    require(len(audit_cfg)==52 and audit_cfg["candidate_head"]==HEAD and audit_cfg["batch"]=="existing63" and
            audit_cfg["auditor_sha256"]==root["independent_negative_auditor"]["sha256"] and
            audit_cfg["actual_metadata_count"]==1285 and audit_cfg["runtime_result_sha256"]==root["runtime_result"]["sha256"],"original exact52-field negative audit contract")
    audit_job = document(root["audit_job_observation"])["data"]
    require(audit_job["status"]=="succeeded" and audit_job["exitCode"]==0 and audit_job["runnerAlive"] is False and
            type(audit_job["runnerProcessInstance"]) is str and re.fullmatch(r"[0-9]+",audit_job["runnerProcessInstance"]),"successful audit-only job exact100ns string")
    job = doc(rc/"independent-observed-job-status.json")["data"]
    require(job["status"]=="failed" and job["exitCode"]==1 and job["runnerAlive"] is False and
            job["id"]=="job-op-a17015be461f2f37aa27a1fb9d09260c7b06385213ec73ce3381b74d5007b063" and
            job["runnerProcessInstance"]=="134371501570189138","original native failed job exact100ns string")
    return {
      "status":runtime["status"],"root_acceptance":root_pin,"closure":root["independent_negative_closure"],
      "result":root["runtime_result"],"audit_configuration":root["audit_configuration"],
      "observed_started":321,"observed_completed":321,"observed_failed":1,"observed_passed":320,"not_started":964,
      "native_owner_count":17,"actual_process_intervals_closed":20,"granted_groups":63,"attempted_groups":17,
      "unstarted_groups":46,"not_started_groups":copy.deepcopy(existing63[17:]),
      "failed_tests":copy.deepcopy(failed),"original_group_statuses":["partial_batch_not_admissible"]*16+["failed"],
      "negative_closure_accepted":True,"original_strict_failures_preserved":True,
      "positive_group_acceptance":False,"selected_native_runtime_accepted":False,
      "product_qualification":False,"runtime_qualification":False,"source_mutation_hold_released":False}

