payloads,roles,preimages,payload_aliases = {},{},{},set()
def add(target,value,role,before=None):
    target = relative(target)
    require(target==PROGRESS or target.startswith(ARCHIVE+"/"),"staged progress/archive only")
    require(target!=MANIFEST_TARGET and target.casefold() not in payload_aliases,"unique staged target")
    payload_aliases.add(target.casefold())
    payloads[target],roles[target],preimages[target] = value,role,before
    return pin(OUT/"projected"/target,value)

archive_rows,seal_mappings = [],[]
for row in rows:
    if row["representation"]=="raw_byte_exact":
        target = row["proposed_archive_relative_path"]
        require(len(target_owners[target.casefold()])==1,"no raw target alias")
        out_pin = add(target,raw(row["original"]["path"]),"immutable_original_bytes")
        archive_rows.append({"original":row["original"],"target":target,"projected":out_pin})
represented = set()
for pair in copy_plan["bookend_plans"]:
    index = PHASES.index(pair["phase"])
    require(pair["compressed_pin"] is None and pair["compression_executed"] is False,"unexecuted exact phase gzip mapping")
    proof = Path(membership[index]["proof"])
    require(pair["originals"]==[archived_pin(proof/"before.json"),archived_pin(proof/"final.json")],"both original bookend pins")
    before,final = raw(proof/"before.json"),raw(proof/"final.json")
    require(before==final and pair["byte_identical_verified"] is True,"only byte-identical bookend pairs compressed")
    seal = decode(before)
    require(seal["candidate_head"]==HEAD and seal["clean"] is True and seal["errors"]==[],"original complete clean source seal")
    counts = {k:len(seal[k]) for k in ("source","tree","vendor","compiler","controls")}
    require(counts==pair["seal_counts"] and counts["vendor"]==1489 and counts["compiler"]==19546,"all actual seal counts")
    target = pair["proposed_archive_relative_path"]
    require(target==ARCHIVE+"/"+PHASES[index]+"/proof/before-and-final.json.gz","exact gzip target")
    same = target_owners[target.casefold()]
    require(len(same)==2 and [r["original"] for r in same]==pair["originals"],"each gzip represents exactly the two observed originals")
    require(all(r["representation"]=="proposed_lossless_gzip_identical_bookend_pair" and r["proposed_archive_relative_path"]==target for r in same),"only explicit pair aliases")
    require(pair["future_parameters"]=={"filename":"","mtime":0,"compresslevel":9,"header_hex":"1f8b08000000000002ff"},"fixed accepted gzip recipe")
    compressed = gzip_bytes(before)
    require(compressed[:10]==bytes.fromhex("1f8b08000000000002ff"),"accepted deterministic gzip header")
    require(gzip.decompress(compressed)==before==final and gzip_bytes(before)==compressed,"two-source roundtrip and repeated encoding exact")
    out_pin = add(target,compressed,"lossless_identical_original_bookend_pair")
    represented.update(r["original"]["path"].casefold() for r in same)
    seal_mappings.append({"phase":pair["phase"],"originals":pair["originals"],"target":target,"projected":out_pin,
                          "seal_counts":counts,"complete_two_source_roundtrip":True,
                          "deterministic_second_encoding_equal":True,"gzip":{"filename":"","mtime":0,"compresslevel":9,"header_hex":compressed[:10].hex()}})
require(represented=={r["original"]["path"].casefold() for r in rows if r["representation"]=="proposed_lossless_gzip_identical_bookend_pair"},"no unrepresented original input")

# Any future phase not explicitly selected for equal-pair gzip retains both raw originals.
for m in membership:
