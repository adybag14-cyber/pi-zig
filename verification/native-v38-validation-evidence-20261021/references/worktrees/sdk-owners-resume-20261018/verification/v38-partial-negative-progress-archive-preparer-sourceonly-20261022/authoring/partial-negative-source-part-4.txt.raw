V38 retains separately accepted fresh BuildQuery metadata for new4(61) and original63(1285) on014062. "
 "The unchanged original new4 strict runtime is accepted. Original63 first had a zero-native prelaunch freshness rejection, "
 "then a closed strict partial native failure:17 of63 groups ran,321 tests completed,320 passed, one failed, and964 tests in46 groups were unstarted. "
 "The first16 group results remain partial_batch_not_admissible, not independently accepted. "
 "Seven observed attempts are appended, including three non-native negatives; only the actual partial native failure extends native-negative history. "
 "All original catalog/auditor/helper/preparer/static evidence and the complete old checkpoint are retained; inspection-only negatives add no validation attempts. "
 "Metadata is recorded per original cohort and never transferred to another head. This proposal changes only progress and adds immutable evidence. "
 "Application qualification, bridge removal, publication and new source/native authority remain false.")
updated["v38_validation_and_archive_checkpoint"] = {
 "schema":1,"recorded_utc":now,"source_head_at_record":HEAD,
 "new4":copy.deepcopy(new4),"original63":copy.deepcopy(original63),
 "non_native_negatives":copy.deepcopy(negative_records),
 "observed_selected_groups":67,"source_declarations":1307,
 "observed_actual_metadata_total":new4["actual_metadata_count"]+original63["actual_metadata_count"],
 "separate_grants_preserved":True,"group_cap_unchanged":64,
 "prior_progress_archive":ARCHIVE+"/prior-progress.json.raw","archive_prefix":ARCHIVE,
 "full_prior_checkpoint_appended":True,"complete_historical_list_prefixes_preserved":True,
 "selected_native_runtime_accepted_for_this_head":False,"new4_selected_native_runtime_accepted":True,
 "original63_partial_runtime_negative_closed":True,"original63_prelaunch_zero_native_negative_preserved":True,
 "metadata_transferred_to_another_head":False,
 "runtime_qualification":False,"application_qualification":False,"production_bridge_removed":False,
 "published_release":False,"source_mutation_hold_released":False,"native_execution_authorized":False,
}
replaced = {"current_source_head_at_record","updated_utc","record_note","current_execution_checkpoint",
            "next_native_batch","preserved_attempts","execution_checkpoint_history","retained_recent_native_negatives"}
added = {"v38_validation_and_archive_checkpoint"}
require(added.isdisjoint(old) and set(updated)==set(old)|added,"one exact new progress field")
for key in old:
    if key not in replaced:
        require(updated[key]==old[key],"unrelated old progress field changed")
require(updated["integrated_source_units"]==old["integrated_source_units"],"no source/product intake")
require(updated["retained_recent_native_negatives"][:-1]==old["retained_recent_native_negatives"] and
        updated["retained_recent_native_negatives"][-1]==native_negative_record,"only actual partial native failure extends native-negative history")
require(updated["execution_checkpoint_history"][-1]==old["current_execution_checkpoint"],"complete old checkpoint appended")
increments = {"integrated_source_units":0,"preserved_attempts":7,"retained_recent_native_negatives":1,"execution_checkpoint_history":1}
for key,length in old_lengths.items():
    require(updated[key][:length]==old[key] and len(updated[key])==length+increments[key],"exact top-level history prefix/count")
list_checks = []
for path,items in list_paths(old):
    current = get(updated,path)
    require(isinstance(current,list) and current[:len(items)]==items,"every historical nested list prefix")
    list_checks.append({"path":list(path),"old_length":len(items),"new_length":len(current),"unchanged_prefix_sha256":sha(encode(items))})
require(len(list_checks)==181,"all181 nested prefixes checked")
inverse = copy.deepcopy(updated)
for key in added:
    del inverse[key]
for key in replaced:
    inverse[key] = copy.deepcopy(old[key])
require(inverse==old and encode(inverse)==old_raw,"complete structural and554689-byte raw inverse")
progress_pin = add(PROGRESS,encode(updated),"only_existing_progress_replacement",{"bytes":554689,"sha256":BASIS_SHA})
add(ARCHIVE+"/prior-progress.json.raw",old_raw,"exact_immutable_Git_progress_preimage")

# These deterministic preparation records are separate from the exact observed copy list.
auxiliary = [
 ("supplemental-preservation-inputs.json",fixed("preservation"),exact(fixed("preservation"))),
 ("partial-observed-inventory.json",fixed("inventory"),exact(fixed("inventory"))),
 ("partial-progress-plan.json",fixed("plan"),exact(fixed("plan"))),
 ("inert-plan-handoff.json",fixed("handoff"),exact(fixed("handoff"))),
 ("prior-accepted-policy.py",fixed("policy"),exact(fixed("policy"))),
 ("preparer.py",pin(self_path,self_raw),self_raw),
 ("root-issued-configuration.json",pin(config_path,config_raw),config_raw),
 ("root-source-acceptance.json",cfg["source_review"],exact(cfg["source_review"])),
 ("root-final-copy-plan.json",cfg["final_copy_plan"],exact(cfg["final_copy_plan"])),
]
for name,source,raw_bytes in auxiliary:
    target = ARCHIVE+"/preparation/"+name+".raw"
    out_pin = add(target,raw_bytes,"exact_preparation_input_bytes")
    archive_rows.append({"original":source,"target":target,"projected":out_pin})
history_report = {
 "schema":1,"status":"complete181_historical_prefixes_and_progress_raw_inverse_verified",
 "basis_head":HEAD,"basis_progress":{"bytes":554689,"sha256":BASIS_SHA},
 "prior_progress_archive":ARCHIVE+"/prior-progress.json.raw","projected_progress":progress_pin,
 "replaced_top_level_keys":sorted(replaced),"added_top_level_keys":sorted(added),
 "old_top_level_history_lengths":old_lengths,"new_top_level_history_lengths":{k:len(updated[k]) for k in old_lengths},
 "nested_historical_lists_checked":181,"nested_list_checks":list_checks,
 "complete_old_checkpoint_appended":True,"old_checkpoint_sha256":sha(encode(old["current_execution_checkpoint"])),
 "complete_structural_inverse":True,"complete_raw_byte_inverse":True,
 "inverse_method":"Remove only the one added key and restore only the eight replaced keys from the archived raw basis; indent2 ensure_ascii=false UTF8 plusLF reproduces all554689 original bytes.",
 "source_build_paths":0,"native_negative_history_prefix_unchanged":True,
 "native_negative_records_added":1,"non_native_negative_records":3,"observed_attempts_added":7,"qualification":False,
}
add(ARCHIVE+"/history-preservation.json",encode(history_report),"complete_progress_inverse_and_history_proof")
add(ARCHIVE+"/seal-archive-map.json",encode(seal_mappings),"lossless_observed_two_source_bookend_mappings")
archive_index = {
 "schema":1,"status":"exact_closed_v38_new4_positive_and_original63_partial_negative_archive",
 "candidate_head":HEAD,"original_partial_inventory":fixed("inventory"),"final_copy_plan":cfg["final_copy_plan"],
 "known_input_versions_retained":314,"all_selected_observed_input_versions":len(rows),
 "raw_archive_files":archive_rows,"compressed_original_bookends":seal_mappings,
 "represented_original_bookend_files":10,"compressed_bookend_pairs":len(seal_mappings),
 "separately_archived_raw_bookend_files":10-2*len(seal_mappings),
 "prelaunch_bookend_files_retained_raw":2,"maximum_selected_equal_pair_gzip_count":4,
 "cache_files_archived":0,"native_binary_files_archived":0,
 "raw_original100ns_bytes_and_strings_unchanged":True,
 "original_execution_authority_is_historical_not_reusable":True,
 "original_files_modified":False,"native_execution_authorized":False,
 "main_intake_authorized":False,"source_mutation_hold_released":False,"qualification":False,
}
add(ARCHIVE+"/archive-index.json",encode(archive_index),"complete_exact_raw_and_gzip_archive_mapping")
manifest_rows = [
 {"target":target,"source":str(OUT/"projected"/target),"bytes":len(payloads[target]),
  "sha256":sha(payloads[target]),"before":preimages[target],"role":roles[target]}
 for target in sorted(payloads)
]
require([r["target"] for r in manifest_rows if r["before"] is not None]==[PROGRESS],"only old progress replaced")
manifest = {
 "schema":1,"status":"exact_v38_partial_negative_progress_archive_intake_unissued",
 "comparison_head":HEAD,"path_count_including_manifest":len(manifest_rows)+1,
 "rows":manifest_rows,"manifest_target":MANIFEST_TARGET,
 "source_build_paths":0,"existing_progress_replacements":1,
 "all314_known_inputs_retained":True,"all181_nested_prefixes_and_full_progress_inverse_verified":True,
 "final_copy_plan":cfg["final_copy_plan"],"source_review":cfg["source_review"],
 "complete_original63_buildquery_success_verified":True,"original63_partial_runtime_negative_closed":True,
 "original63_zero_native_prelaunch_negative_preserved":True,"all_original_negatives_preserved":True,
 "main_worktree_collision_check_deferred_to_separate_exact_intake":True,
 "main_applied":False,"source_mutation_hold_released":False,"main_intake_authorized":False,
 "native_execution_authorized":False,"application_qualified":False,"production_bridge_removed":False,"published_release":False,
 "scope":"Only one exact progress replacement and new immutable evidence. No source/build/native/index/cache action. Root must independently review this complete proposal and separately release any Main intake.",
}
manifest_raw = encode(manifest)
all_targets = [(r["target"],payloads[r["target"]]) for r in manifest_rows]+[(MANIFEST_TARGET,manifest_raw)]
target_names = [n for n,_ in all_targets]
require(isinstance(cfg["expected_output_paths"],list) and cfg["expected_output_paths"]==sorted(target_names),"Root exact final output/copy membership")
require(len({n.casefold() for n in target_names})==len(target_names),"complete Windows target aliases")
entries,entry_aliases = {},set()
for item in git("ls-tree","-r","-z",HEAD).split(b"\0"):
    if item:
        meta,name = item.split(b"\t",1)
        mode,kind,oid = meta.decode().split()
        name = name.decode("utf-8")
        require(name.casefold() not in entry_aliases,"committed Windows aliases")
        entry_aliases.add(name.casefold())
        entries[name] = (mode,kind,oid)
require(not any(n.casefold()==ARCHIVE.casefold() or n.casefold().startswith(ARCHIVE.casefold()+"/") for n in entries),"new archive absent from immutable committed basis")
old_oid = hashlib.sha1(b"blob "+str(len(old_raw)).encode()+b"\0"+old_raw).hexdigest()
require(entries[PROGRESS] in (("100644","blob",old_oid),("100755","blob",old_oid)),"exact committed progress preimage")
for target,_ in all_targets:
    relative(target)
    require(target==PROGRESS or target.casefold() not in entry_aliases,"new committed archive targets")
# Attribute inspection reads the frozen Git tree through W; it creates no index.
attributes = ("text","eol","filter","working-tree-encoding","ident")
attr_raw = git("check-attr","--source="+HEAD,"-z","--stdin",*attributes,
               input=b"\0".join(n.encode("utf-8") for n in target_names)+b"\0")
attr_parts = attr_raw.split(b"\0")
require(attr_parts[-1]==b"" and len(attr_parts)-1==3*len(attributes)*len(target_names),"complete frozen-tree attribute result")
for index,target in enumerate(target_names):
    off = index*3*len(attributes)
    for j,attribute in enumerate(attributes):
        name,key,value = attr_parts[off+3*j:off+3*j+3]
        require(name==target.encode() and key==attribute.encode() and value in (b"unset",b"unspecified"),"no Git byte conversion on archive/progress targets")
frozen_ref()
require(not OUT.exists(),"final create-only stage gate")
for path,value in originals.values():
    require(path.read_bytes()==value,"original input changed before staging")
require(config_path.read_bytes()==config_raw and self_path.read_bytes()==self_raw,"source/config unchanged")
require(git("cat-file","blob",HEAD+":"+PROGRESS)==old_raw,"immutable progress unchanged")

# The only writes start here, below every acceptance, history and exact-copy gate.
OUT.mkdir()
for row in manifest_rows:
    path = inside(row["source"])
    require(path.is_relative_to(OUT),"staged output containment")
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open("xb") as f:
        f.write(payloads[row["target"]])
    require(path.read_bytes()==payloads[row["target"]],"exact staged output")
with (OUT/"manifest.json").open("xb") as f:
    f.write(manifest_raw)
require((OUT/"manifest.json").read_bytes()==manifest_raw,"exact complete manifest")
frozen_ref()
for path,value in originals.values():
    require(path.read_bytes()==value,"original input changed after staging")
require(config_path.read_bytes()==config_raw and self_path.read_bytes()==self_raw,"source/config unchanged after staging")
review = {
 "schema":1,"status":"source_only_exact_v38_partial_negative_progress_archive_prepared",
 "candidate_head":HEAD,"prepared_utc":now,"preparer":pin(self_path,self_raw),
 "root_configuration":pin(config_path,config_raw),"source_review":cfg["source_review"],
 "manifest":pin(OUT/"manifest.json",manifest_raw),"commit_paths":len(all_targets),
 "projected_progress":progress_pin,"known_original_inputs":314,"observed_original_inputs":len(rows),
 "all181_historical_prefixes_preserved":True,"complete554689_byte_progress_inverse":True,
 "new4_actual_metadata":new4["actual_metadata_count"],"existing63_actual_metadata":original63["actual_metadata_count"],
 "original63_buildquery_accepted":True,"original63_partial_runtime_negative_closed":True,
 "original63_prelaunch_zero_native_negative_preserved":True,"all_original_evidence_raw_bytes_preserved":True,
 "compressed_bookend_pairs":len(seal_mappings),"represented_original_bookends":10,"gzip_full_roundtrips_and_second_encodings_verified":True,
 "frozen_tree_git_attributes_sha256":sha(attr_raw),"Main_and_index_not_accessed":True,
 "native_execution_authorized":False,"main_intake_authorized":False,
 "source_mutation_hold_released":False,"application_qualified":False,
 "production_bridge_removed":False,"published_release":False,
}
with (OUT/"preparation-review.json").open("xb") as f:
    f.write(encode(review))
print(json.dumps({"manifest":review["manifest"],"review":pin(OUT/"preparation-review.json",encode(review)),
                  "commit_paths":len(all_targets),"progress":progress_pin,
                  "Main_access":False,"native_execution":False,"configuration_issued":False}))
