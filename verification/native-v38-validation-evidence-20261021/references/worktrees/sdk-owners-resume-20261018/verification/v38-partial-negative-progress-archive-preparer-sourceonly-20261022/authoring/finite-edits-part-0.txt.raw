  {
    "label": "Separate negative contracts with unchanged positive helper",
    "before": "new4 = check_positive(\"new4\",NEW4,58,0)\noriginal63 = check_positive(\"existing63\",existing63,1249,2)",
    "after": "\ndef retained_pin(row):\n    require(archived_pin(row[\"path\"])==row,\"exact selected original retained\")\n    return raw(row[\"path\"])\n\ndef selected_observed(role):\n    row = preservation[\"role_pins\"][role]\n    retained_pin(row)\n    return row\n\ndef check_existing63_buildquery():\n    cohort = copy_plan[\"cohorts\"][\"existing63\"]\n    require(set(cohort)=={\"buildquery_root_acceptance\",\"prelaunch_root_negative\",\"runtime_negative_root_acceptance\"},\"exact original63 acceptance roles\")\n    bq_pin = selected_observed(\"existing63_buildquery_root\")\n    require(cohort[\"buildquery_root_acceptance\"]==bq_pin,\"actual original63 BQ acceptance\")\n    bq = document(bq_pin)\n    groups,counts,actual = existing63,ORIGINAL63_COUNTS,1285\n    require(bq[\"status\"]==\"root_accepted_complete_fresh_v38_existing63_buildquery\" and bq[\"reviewer\"]==\"Root\",\"original63 Root complete BQ acceptance\")\n    require(bq[\"candidate_head\"]==HEAD and bq[\"batch\"]==\"existing63\" and bq[\"groups\"]==groups,\"exact original63 BQ identity/order\")\n    require(bq[\"declared_groups\"]==63 and bq[\"declared_controls\"]==1249 and\n            bq[\"actual_metadata_count\"]==actual and bq[\"actual_group_counts\"]==counts and sum(counts)==actual,\"actual original63 metadata vector\")\n    flags(bq,true=(\"complete_buildquery_accepted\",\"complete_source_and_current_directory_seals\",\"all_original_terminal0_owner_gates_passed\"),\n          false=(\"runtime_started\",\"runtime_execution_authorized\",\"qualification\",\"source_mutation_hold_released\"))\n    require(bq[\"native_owner_count\"]==126 and bq[\"actual_process_intervals_closed\"]==129 and bq[\"actual_tests_started\"]==0,\"complete original63 BQ owners\")\n    bp,bc = Path(membership[2][\"proof\"]),Path(membership[2][\"control\"])\n    for key,path in {\"build_result\":bp/\"result.json\",\"build_final\":bp/\"final.json\",\n                     \"metadata_acceptance\":bc/\"independent-metadata-acceptance.json\",\n                     \"independent_closure\":bc/\"independent-current-seals-and-owners.json\"}.items():\n        require(bq[key]==archived_pin(path),\"original63 BQ exact parent pin \"+key)\n    build,metadata = document(bq[\"independent_closure\"]),document(bq[\"metadata_acceptance\"])\n    result = doc(bp/\"result.json\")\n    require(build[\"status\"]==\"independently_closed_complete_fresh_build_query\" and build[\"candidate_head\"]==HEAD,\"original63 positive independent BQ\")\n    flags(build,true=COMMON_TRUE+(\"all_original_terminal0_owner_gates_passed\",),\n          false=(\"runtime_started\",\"qualification\",\"cache_seeded\",\"source_mutation_hold_released\"))\n    require(build[\"granted_groups\"]==build[\"attempted_groups\"]==63 and build[\"unstarted_groups\"]==0,\"all63 BQ groups closed\")\n    require(build[\"native_owner_count\"]==126 and len(build[\"actual_process_intervals\"])==129 and build[\"actual_tests_started\"]==0,\"all129 BQ process intervals\")\n    require(build[\"actual_metadata_count\"]==actual and [g[\"group\"] for g in build[\"groups\"]]==groups and\n            [g[\"actual_metadata_count\"] for g in build[\"groups\"]]==counts,\"complete original63 BQ metadata\")\n    require(metadata[\"status\"]==\"independently_accepted_combined_native_batch_metadata\" and metadata[\"accepted\"] is True and metadata[\"candidate_head\"]==HEAD,\"original63 accepted raw metadata\")\n    flags(metadata,false=(\"runtime_started\",\"runtime_qualification\"))\n    require([g[\"group\"] for g in metadata[\"groups\"]]==groups and [g[\"actual_count\"] for g in metadata[\"groups\"]]==counts,\"exact63 accepted metadata groups\")\n    require(all(len(g[\"tests\"])==n for g,n in zip(metadata[\"groups\"],counts)),\"complete1285 actual metadata names\")\n    require(build[\"metadata_acceptance\"]==bq[\"metadata_acceptance\"] and\n            metadata[\"build_result_sha256\"]==bq[\"build_result\"][\"sha256\"] and\n            metadata[\"build_source_seal_sha256\"]==bq[\"build_final\"][\"sha256\"],\"original63 BQ metadata/source linkage\")\n    require(result[\"status\"]==\"passed_build_query_batch\" and result[\"mode\"]==\"BuildQuery\" and result[\"candidate_head\"]==HEAD,\"original63 raw BQ success\")\n    require([g[\"group\"] for g in result[\"groups\"]]==groups and all(g[\"status\"]==\"passed_build_query\" for g in result[\"groups\"]),\"complete63 original BQ results\")\n    job = doc(bc/\"independent-observed-job-status.json\")[\"data\"]\n    require(job[\"status\"]==\"succeeded\" and job[\"exitCode\"]==0 and job[\"runnerAlive\"] is False and\n            type(job[\"runnerProcessInstance\"]) is str and re.fullmatch(r\"[0-9]+\",job[\"runnerProcessInstance\"]),\"original63 successful job decimal100ns identity\")\n    prep = E/\"combined-native-batch-v38-regression63-prepared-20261021\"\n    review,matrix = doc(prep/\"preparation-review.json\"),doc(prep/\"groups.json\")\n    require(review[\"candidate_head\"]==HEAD and review[\"selected_group_names\"]==groups and\n            review[\"selected_groups\"]==63 and review[\"selected_declarations\"]==1249,\"exact prepared original63\")\n    require(review[\"actual_metadata_count\"] is None and archived_pin(prep/\"groups.json\")[\"sha256\"]==MATRIX_SHA,\"original63 source declarations do not predict metadata\")\n    require(len(matrix[\"groups\"])==117 and sum(len(g[\"required_named\"]) for g in matrix[\"groups\"])==2013 and\n            len(matrix[\"whole_tree_dependency_pins\"])==576,\"whole accepted shared catalog\")\n    return bq_pin,bq,metadata,{\n      \"status\":build[\"status\"],\"root_acceptance\":bq_pin,\"closure\":bq[\"independent_closure\"],\n      \"metadata_acceptance\":bq[\"metadata_acceptance\"],\"result\":bq[\"build_result\"],\n      \"native_owner_count\":126,\"actual_tests_started\":0,\"runtime_qualification\":False}\n\ndef check_existing63_prelaunch(bq_pin):\n    root_pin = selected_observed(\"existing63_prelaunch_root\")\n    require(copy_plan[\"cohorts\"][\"existing63\"][\"prelaunch_root_negative\"]==root_pin,\"exact initial admission negative\")\n    root = document(root_pin)\n    pc,pp = Path(membership[3][\"control\"]),Path(membership[3][\"proof\"])\n    require(root[\"status\"]==\"preserved_v38_existing63_runtime_prelaunch_grant_freshness_negative\" and\n            root[\"reviewer\"]==\"Root\" and root[\"candidate_head\"]==HEAD and root[\"batch\"]==\"existing63\",\"Root exact prelaunch rejection\")\n    require(root[\"classification\"]==\"strict_runtime_admission_failure_before_any_native_owner_or_test\" and\n            root[\"runtime_control\"]==str(pc) and root[\"runtime_proof\"]==str(pp),\"exact prelaunch phase\")\n    require(root[\"buildquery_acceptance_preserved\"]==bq_pin,\"prelaunch exact accepted BQ parent\")\n    reason = \"Initial grant must be within300seconds before first child launch\"\n    require(root[\"reason\"]==reason and root[\"declared_groups\"]==63 and root[\"admission_attempted_groups\"]==1 and\n            root[\"unstarted_groups\"]==62 and root[\"native_owners_started\"]==root[\"native_tests_started\"]==0,\"Root classified zero-native admission failure\")\n    require(root[\"initial_grant_max_age_seconds\"]==300 and root[\"group_native_timeout_seconds\"]==120,\"unchanged admission/native limits\")\n    flags(root,true=(\"source_bookends_byte_equal\",\"original_result_preserved\"),\n          false=(\"diagnostic_continue\",\"native_test_failure\",\"product_qualification\",\"source_mutation_hold_released\"))\n    for key,path in {\"runtime_launch\":pc/\"runtime-launch.json\",\"runtime_grant\":pc/\"root-grant.json\",\n                     \"runtime_result\":pp/\"result.json\",\"before\":pp/\"before.json\",\"final\":pp/\"final.json\",\n                     \"outer\":pc/\"outer.json\",\"outer_absence\":pc/\"outer-absence.json\",\n                     \"terminal_observation\":pc/\"independent-observed-job-status.json\"}.items():\n        require(root[key]==archived_pin(path),\"all exact prelaunch original receipts \"+key)\n    result = doc(pp/\"result.json\")\n    require(result[\"status\"]==\"failed\" and result[\"mode\"]==\"RuntimeOnly\" and result[\"candidate_head\"]==HEAD and\n            result[\"group_manifest_sha256\"]==MATRIX_SHA,\"unchanged raw prelaunch result identity\")\n    require(result[\"errors\"]==[reason] and len(result[\"groups\"])==1 and result[\"groups\"][0][\"group\"]==existing63[0],\"exact one attempted admission\")\n    flags(result,true=(\"postseal\",\"controller_environment_restored\",\"runtime_requested\"),\n          false=(\"all_groups_closed\",\"product_qualified\",\"cache_seeded\"))\n    first = result[\"groups\"][0]\n    require(first[\"status\"]==\"failed\" and first[\"errors\"]==[reason] and first[\"phases\"]=={} and\n            first[\"attempted_phases\"]==[\"runtime\"] and first[\"owned_started_phases\"]==[],\"original no-owner phase state\")\n    flags(first,false=(\"runtime_owner_launch_attempted\",\"actual_runtime_owner_started\"))\n    require(first[\"native_selected_tests_started\"] is None,\"retain raw null distinct from Root classified zero\")\n    require(result[\"absence\"]=={\"native_roots\":[],\"owners\":[]} and len(result[\"admission_probes\"])==1,\"original no native owner admission evidence\")\n    require(raw(pp/\"before.json\")==raw(pp/\"final.json\"),\"original prelaunch bookends equal\")\n    for name in (\"before.json\",\"final.json\"):\n        require(row_by_path[str(pp/name).casefold()][\"representation\"]==\"raw_byte_exact\",\"both prelaunch seals retained raw\")\n    job = document(root[\"terminal_observation\"])[\"data\"]\n    require(job[\"status\"]==\"failed\" and job[\"exitCode\"]==1 and job[\"runnerAlive\"] is False and\n            job[\"id\"]==\"job-op-0975772fcc8e984e84c4d255a0b9805571c22200314b7111deb9a88e5824bc0c\" and\n            job[\"runnerProcessInstance\"]==\"134371499352045058\",\"original prelaunch failed job and exact100ns string\")\n    return {\n      \"name\":\"V38 original63 initial runtime prelaunch grant freshness negative\",\n      \"status\":root[\"status\"],\"source_head\":HEAD,\"batch\":\"existing63\",\"root_acceptance\":root_pin,\n      \"result\":root[\"runtime_result\"],\"buildquery_parent\":bq_pin,\"native_failure\":False,\n      \"admission_attempted_groups\":1,\"groups_without_admission\":62,\n      \"raw_native_selected_tests_started\":None,\"classified_native_owners_started\":0,\"classified_native_tests_started\":0,\n      \"accepted_metadata\":1285,\"all_native_tests_unstarted\":1285,\n      \"original_job_observation\":root[\"terminal_observation\"],\"original_evidence_unchanged\":True,\n      \"new_native_execution_authorized\":False,\"source_mutation_hold_released\":False,\"product_qualification\":False}\n\ndef check_existing63_partial_negative(bq_pin,bq,metadata):\n    root_pin = selected_observed(\"existing63_negative_root\")\n    require(copy_plan[\"cohorts\"][\"existing63\"][\"runtime_negative_root_acceptance\"]==root_pin,\"actual original63 partial-negative acceptance\")\n    root = document(root_pin)\n    rc,rp = Path(membership[4][\"control\"]),Path(membership[4][\"proof\"])\n    require(root[\"status\"]==\