PINS={};RAW={};JSONS={}
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def guard(p):
 p=Path(p);q=str(p.resolve()).casefold()
 assert not q.startswith(str(B/"main").casefold()+"\\") and q!=str(B/"main").casefold(),"Main access prohibited"
 assert any(p.resolve().is_relative_to(root.resolve()) for root in (E,SDK,MOD)),str(p)
 return p
def raw(p,size=None,h=None):
 p=guard(p);key=str(p)
 if key not in RAW:
  b=p.read_bytes();RAW[key]=b;PINS[key]=dict(path=key,bytes=len(b),sha256=sha(b))
 b=RAW[key]
 assert size is None or len(b)==size,(key,"size",len(b),size)
 assert h is None or sha(b)==h.upper(),(key,"hash",sha(b),h)
 return b
def obj(p,size=None,h=None):
 b=raw(p,size,h);k=str(Path(p))
 if k not in JSONS:JSONS[k]=json.loads(b)
 return JSONS[k]
def pcheck(row):
 b=raw(row["path"],row.get("bytes"),row["sha256"]);return PINS[str(Path(row["path"]))]
def pins_in(v):
 if isinstance(v,dict):
  if {"path","sha256"}<=set(v) and isinstance(v["path"],str) and isinstance(v["sha256"],str):yield v
  for w in v.values():yield from pins_in(w)
 elif isinstance(v,list):
  for w in v:yield from pins_in(w)
def bodies(b):
 lines=b.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno]) for n in ast.parse(b).body if isinstance(n,ast.FunctionDef)}
def ticks(text):
 m=re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(Z|[+-]\d\d:\d\d)",text)
 assert m,text
 whole=datetime.datetime.fromisoformat(m[1]+("+00:00" if m[3]=="Z" else m[3])).astimezone(datetime.timezone.utc)
 delta=whole-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
 return (delta.days*86400+delta.seconds)*10000000+int((m[2] or "").ljust(7,"0"))
def same_owner(a,b):
 assert set(a)==set(b)
 for k in a:
  if k in ("created_utc","completed_utc"):assert ticks(a[k])==ticks(b[k]),k
  elif k=="live_identity":
   assert set(a[k])==set(b[k])
   for z in a[k]:
    if z=="created_utc":assert ticks(a[k][z])==ticks(b[k][z])
    else:assert a[k][z]==b[k][z],z
  else:assert a[k]==b[k],k
def write_new(p,value):
 data=(json.dumps(value,indent=2)+"\n").encode()
 with p.open("xb")as f:f.write(data)
 assert p.read_bytes()==data
 return dict(path=str(p),bytes=len(data),sha256=sha(data))
