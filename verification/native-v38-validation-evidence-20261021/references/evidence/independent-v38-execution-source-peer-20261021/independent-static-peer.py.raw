prior_agg=doc(agg["prior_accepted_source_authorities"][1])
for row in prior_agg["helper_critical_regions"]:
 raw=olds[4][row["candidate_offset"]:row["candidate_offset"]+row["bytes"]]
 require(sha(raw)==row["sha256"]and len(raw)==row["bytes"]and bodies[4].count(raw)==1,"complete prior helper critical interval")
 r=dict(name=row["name"],baseline_offset=row["candidate_offset"],candidate_offset=bodies[4].index(raw),bytes=len(raw),sha256=sha(raw),byte_identical=True)
 critical.append(r)
require(critical==agg["helper_critical_regions"],"three exact accepted helper critical regions")
additional=[]
for i,first,last,label in ((2,130,None,"BQ complete artifact/raw metadata/serial/current-owner closure tail"),(3,161,297,"Runtime complete seals/artifacts/raw wire/UTC100ns original and current owners")):
 ob=olds[i].splitlines(keepends=True);nb=bodies[i].splitlines(keepends=True)
 a=b"".join(ob[first-1:last]);b=b"".join(nb[first-1:last])
 require(a==b and len(a)>10000,"complete unchanged audit executable region")
 additional.append(dict(kind=kinds[i],name=label,first_line=first,last_line=last,bytes=len(a),sha256=sha(a),byte_identical=True))
for v in (hand,agg,bindings):
 for key in ("target_executed","prefix_executed","constructor_executed","auditor_executed","helper_executed","native_executed","Main_written","execution_configuration_issued","execution_authority","runtime_authority","source_mutation_hold_released","qualification"):
  require(v[key] is False,"source-only evidence has no "+key)
require(hand["finite_validation"]["total_literal_edits"]==71 and hand["finite_validation"]["unchanged_full_line_helpers"]==37,"handoff finite totals")
# Repeat only the exact read pin set to close the static snapshot, without any
# original candidate process, compiler, native owner probe, or Main inspection.
for row in list(seen.values()):read(row)
checker=actual(__file__)
report=dict(schema=1,status="independently_verified_unresolved_v38_execution_source_adapters",reviewer="/root/handover_review",checker=checker,packet_handoff=HAND,aggregate_finite_proof=AGG,binding_contract=BIND,accepted_predecessor_root_review=hand["accepted_predecessor_root_review"],sources=sources,total_literal_edits=71,string_literal_edits=67,numeric_source_size_edits=4,all_complete_raw_forward_and_inverses_exact=True,all_intermediate_hashes_exact=True,all_untouched_fragments_and_nonconstant_structure_exact=True,unchanged_full_line_helpers=37,helper_critical_regions=critical,additional_unchanged_audit_regions=additional,future_bindings=slot_rows,first_four_unresolved_bindings=9,helper_actual_only_bindings=17,new4_groups=4,new4_declared_controls=58,existing_groups=63,existing_declared_controls=1249,catalog_groups=117,catalog_declared_controls=2013,maximum_selected_groups=64,strict_gate_constants=required_fixed,runtime_strict_gate_keys=list(rt_keys),required_new_source_review="v38_execution_bound_source_review",preserved_v36_history_keys=bindings["preserved_fixed_v36_history_keys"],preserved_v37_history_keys=bindings["preserved_new_v37_history_keys"],runtime_root_review_is_string=True,runtime_constructor_source_review_is_distinct_pin=True,actual_future_head=None,actual_future_matrix=None,actual_future_job=None,actual_future_metadata_count=None,actual_future_runtime_outcome=None,observed_input_helper_scope="new4 only; existing63 requires separately reviewed adaptation",input_versions=len(seen),inputs=sorted(seen.values(),key=lambda r:r["path"].casefold()),source_only=True,target_executed=False,prefix_executed=False,constructor_executed=False,auditor_executed=False,helper_executed=False,catalog_preparer_executed=False,native_executed=False,Main_written=False,index_written=False,execution_configuration_issued=False,execution_authority=False,runtime_authority=False,source_mutation_hold_released=False,qualification=False)
out=O/"source-proof.json";require(not out.exists(),"proof is create-only")
raw=(json.dumps(report,indent=2)+"\n").encode("ascii")
with out.open("xb")as f:f.write(raw)
require(out.read_bytes()==raw,"own proof exact readback")
print(json.dumps(dict(status=report["status"],proof=actual(out),checker=checker,source_count=5,finite_edits=71,helpers=37,critical_regions=3,additional_regions=2,input_versions=len(seen),future_bindings=26,target_executed=False)))
