def permitted(t,source_index):
 # Independently derive the finite change from the accepted original token,
 # without using the candidate token or author's proposed replacement.
 if t["kind"]=="STRING":
  if t["text"] in special:return special[t["text"]]
  return t["text"].replace("V37","V38").replace("v37","v38").replace("-Retry1-","-").replace("-retry1-","-")
 if t["kind"]=="NUMBER":
  return ({2:{"10109":"10095"},3:{"12513":"12499"},4:{"10109":"10095","37268":"37254"}}.get(source_index,{})).get(t["text"],t["text"])
 return t["text"]
