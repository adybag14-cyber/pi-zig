Reads immutable source, finite proofs and provenance. AST/token inspection only:
no candidate is imported, evaluated, executed, or partially executed. The only
write is this directory's create-only source-proof.json after every assertion.
"""
from pathlib import Path
import ast, hashlib, io, json, re, sys, tokenize
