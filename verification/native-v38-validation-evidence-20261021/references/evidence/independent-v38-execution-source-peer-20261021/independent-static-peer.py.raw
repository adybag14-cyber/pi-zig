seen={}
def sha(data):return hashlib.sha256(data).hexdigest().upper()
def require(value,reason):
 if not value:raise AssertionError(reason)
def actual(path):
 path=Path(path); data=path.read_bytes()
 return dict(path=str(path),bytes=len(data),sha256=sha(data))
def read(row):
 require(set(row)=={"path","bytes","sha256"},"exact source pin shape")
 require(type(row["bytes"])is int and row["bytes"]>0 and re.fullmatch(r"[0-9A-F]{64}",row["sha256"]),"issued immutable source pin")
 p=Path(row["path"]); data=p.read_bytes()
 require((len(data),sha(data))==(row["bytes"],row["sha256"]),"pin: "+str(p))
 key=str(p).casefold(); prior=seen.get(key)
 require(prior is None or prior==row,"no path aliases or conflicting current versions")
 seen[key]=dict(row)
 return data
def doc(row):return json.loads(read(row))
def fixed(name,size,digest):return dict(path=str(D/name),bytes=size,sha256=digest)
def check_nested(value):
 if isinstance(value,dict):
  if set(value)=={"path","bytes","sha256"} and type(value["bytes"])is int and isinstance(value["sha256"],str):read(value)
  else:
   for v in value.values():check_nested(v)
 elif isinstance(value,list):
  for v in value:check_nested(v)
def tok(data):
 require(data.isascii(),"ASCII source permits exact token-to-byte spans")
 lines=data.splitlines(keepends=True); offsets=[0]
 for line in lines:offsets.append(offsets[-1]+len(line))
 def at(pos):return offsets[max(0,pos[0]-1)]+pos[1]
 return [dict(kind=tokenize.tok_name[t.type],text=t.string,start=at(t.start),end=at(t.end),line=t.start[0]) for t in tokenize.tokenize(io.BytesIO(data).readline)]
def functions(data):
 lines=data.splitlines(keepends=True); result=[]
 for n in ast.walk(ast.parse(data.decode("ascii"))):
  if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)):
   b=b"".join(lines[n.lineno-1:n.end_lineno])
   result.append((n.name,n.lineno,n.end_lineno,b))
 return result
class RemoveValues(ast.NodeTransformer):
 def visit_Constant(self,node):
  node.value=None
  return node
def structural(data):return ast.dump(RemoveValues().visit(ast.parse(data.decode("ascii"))),include_attributes=False)
def assigned(tree,name):
 rows=[n.value for n in tree.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and n.targets[0].id==name]
 require(len(rows)==1,"one assignment "+name)
 return rows[0]
