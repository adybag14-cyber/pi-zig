INPUTS={};CACHE={}
def sha(raw):return hashlib.sha256(raw).hexdigest().upper()
def encode(value):return (json.dumps(value,indent=2)+"\n").encode()
def key(p):return str(Path(p).resolve()).casefold()
def admit(path,size=None,digest=None):
 p=Path(path);assert p.is_absolute() and p.resolve().is_relative_to(B.resolve()),p
 k=key(p)
 if k not in CACHE:
  raw=p.read_bytes();CACHE[k]=raw;INPUTS[k]=dict(path=str(p),bytes=len(raw),sha256=sha(raw))
 raw=CACHE[k];r=INPUTS[k]
 assert size is None or r["bytes"]==size,(p,size,r["bytes"])
 assert digest is None or r["sha256"]==digest,(p,digest,r["sha256"])
 return raw
def pin(path):admit(path);return INPUTS[key(path)]
def pinned(row):return admit(row["path"],row["bytes"],row["sha256"])
def read(path):return json.loads(admit(path).decode("utf-8-sig"))
def obj(row):return json.loads(pinned(row).decode("utf-8-sig"))
def git(*args,input=None):
 env=os.environ.copy();env["GIT_OPTIONAL_LOCKS"]="0"
 p=subprocess.run(["git","--no-optional-locks","-C",str(M),*args],input=input,stdout=subprocess.PIPE,stderr=subprocess.PIPE,env=env,check=True)
 return p.stdout
