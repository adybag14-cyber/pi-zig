+JSValue JS_PiNewNativeAsyncGeneratorFunction(JSContext *ctx,
+    JSPiAsyncGeneratorFactory *factory, JSPiAsyncGeneratorResume *resume,
+    JSValueConst captures, const char *name, int length)
+{
+    JSFunctionBytecode *b;
+    JSValue function, prototype;
+    size_t offset = (sizeof(*b) + 7) & ~(size_t)7;
+    if (JS_HasException(ctx))
+        return JS_EXCEPTION;
+    if (!factory || !resume || length < 0 || length > UINT16_MAX)
+        return JS_ThrowTypeError(ctx, "Invalid native generator function definition");
+    b = js_mallocz(ctx, offset + sizeof(JSValue));
+    if (!b)
+        return JS_EXCEPTION;
+    JS_REF_COUNT(b) = 1;
+    b->realm = JS_DupContext(ctx);
+    b->is_strict_mode = b->has_simple_parameter_list = true;
+    b->func_kind = JS_FUNC_ASYNC_GENERATOR;
+    b->defined_arg_count = length;
+    b->cpool = (JSValue *)((uint8_t *)b + offset);
+    b->cpool_count = 1;
+    b->cpool[0] = js_dup(captures);
+    b->native_async_generator_factory = factory;
+    b->native_async_generator_resume = resume;
+    add_gc_object(ctx->rt, &b->header, JS_GC_OBJ_TYPE_FUNCTION_BYTECODE);
+    b->func_name = JS_NewAtom(ctx, name ? name : "");
+    if (b->func_name == JS_ATOM_NULL) {
+        JS_FreeValue(ctx, JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b));
+        return JS_EXCEPTION;
+    }
+    /* Real closure machinery selects the generator-function class, creates
+       name/length and its own writable, nonenumerable/nonconfigurable prototype.
+       No constructor bit, forwarding yield*, generated source or bytecode. */
+    function = js_closure(ctx, JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b), NULL, NULL);
+    if (JS_IsException(function))
+        return function;
+    /* js_closure's old prototype define is unchecked. Validate that this new
+       native API never returns a partially initialized function after OOM. */
+    if (JS_HasException(ctx))
+        return js_pi_generator_discard_pending(ctx, function);
+    prototype = JS_GetProperty(ctx, function, JS_ATOM_prototype);
+    if (JS_IsException(prototype)) {
+        return js_pi_generator_discard_pending(ctx, function);
+    }
+    JS_FreeValue(ctx, prototype);
+    return function;
+}
