+/* Genuine native async-generator FUNCTION. The factory captures parameter
+   state only (owned return), before body entry; resume uses the existing C3
+   generator instance queue. All inputs borrowed, result owned, same-runtime
+   owner-thread context. Callback exceptions obey the standard C API contract.
+   The real VM closure/class/creation realm/own prototype machinery is used;
+   native metadata has no serializable bytecode or fabricated source position. */
+typedef JSValue JSPiAsyncGeneratorFactory(JSContext *ctx, JSValueConst captures,
+    JSValueConst this_obj, int argc, JSValueConst *argv);
+JS_EXTERN JSValue JS_PiNewNativeAsyncGeneratorFunction(JSContext *ctx,
+    JSPiAsyncGeneratorFactory *factory, JSPiAsyncGeneratorResume *resume,
+    JSValueConst captures, const char *name, int length);
+
 /* Both prototype getters return an owned reference from this context. */
 JS_EXTERN JSValue JS_PiGetAsyncGeneratorPrototype(JSContext *ctx);
 JS_EXTERN JSValue JS_PiGetAsyncGeneratorFunctionPrototype(JSContext *ctx);
