    {
      "specification": 50,
      "occurrence": 1,
      "label": "Both source donor/current/committed preimages and unchanged imports/control names",
      "offset": 21381,
      "old": "        require(row[\"before\"][\"bytes\"]==OLD_FIXTURE_BYTES and row[\"before\"][\"sha256\"]==OLD_FIXTURE,\"fixture predecessor pin\")\n        before = git(\"show\",BASIS+\":\"+target)\n        require(len(before)==OLD_FIXTURE_BYTES and sha(before)==OLD_FIXTURE,\"fixture original committed preimage\")\n        require(len(current)==NEW_FIXTURE_BYTES and sha(current)==NEW_FIXTURE,\"selected fixture bytes\")\n        fixture_before = before\nrequire(fixture_before is not None,\"actual fixture preimage admitted\")\nfor token in (b\"import\",b\"embedFile\",b\"cInclude\",b\"cDefine\",b\"cUndef\"):\n    pattern = rb\"@\"+token+rb\"\\s*\\(([^)]*)\\)\"\n    require(re.findall(pattern,fixture_before)==re.findall(pattern,fixture_current[FIXTURE]),\"fixture literal dependency invocations unchanged\")\n    require(fixture_before.count(b\"@\"+token)==fixture_current[FIXTURE].count(b\"@\"+token),\"fixture dependency invocation count unchanged\")",
      "new": "        require(row[\"before\"]==OLD_FIXTURES[target],\"exact fixture predecessor pin\")\n        before = git(\"show\",BASIS+\":\"+target)\n        require({\"bytes\":len(before),\"sha256\":sha(before)}==OLD_FIXTURES[target],\"fixture original committed preimage\")\n        require({\"bytes\":len(current),\"sha256\":sha(current)}==NEW_FIXTURES[target],\"selected fixture bytes\")\n        fixture_before[target] = before\nrequire(set(fixture_before)==set(FIXTURES),\"both actual fixture preimages admitted\")\nfor target,before in fixture_before.items():\n    current = fixture_current[target]\n    for token in (b\"import\",b\"embedFile\",b\"cInclude\",b\"cDefine\",b\"cUndef\"):\n        pattern = rb\"@\"+token+rb\"\\s*\\(([^)]*)\\)\"\n        require(re.findall(pattern,before)==re.findall(pattern,current),\"fixture literal dependency invocations unchanged: \"+target)\n        require(before.count(b\"@\"+token)==current.count(b\"@\"+token),\"fixture dependency invocation count unchanged: \"+target)\n    require(re.findall(rb'\\btest\\s+\"([^\"]*)\"\\s*\\{',before)==re.findall(rb'\\btest\\s+\"([^\"]*)\"\\s*\\{',current),\"all exact named test declarations unchanged: \"+target)",
      "before_sha256": "567C95BABA0A965F43AFC84C1B78CB372F51678EE262F02BA483B13FA36595D3",
