      "label": "Both exact frozen source preimages",
      "offset": 1143,
      "old": "OLD_FIXTURE = \"EEDD73ADC5B2F260B07DD3877658FABE2C11A6AAC2BF4216E17E7328E27CA47F\"\nOLD_FIXTURE_BYTES = 33152",
      "new": "OLD_FIXTURES = {\n FIXTURES[0]:{\"bytes\":28378,\"sha256\":\"93D00DE989F6F675E862A61FB93BE2EF91FD6FC7D85CC59FC769CB4842543422\"},\n FIXTURES[1]:{\"bytes\":33152,\"sha256\":\"EEDD73ADC5B2F260B07DD3877658FABE2C11A6AAC2BF4216E17E7328E27CA47F\"},\n}",
