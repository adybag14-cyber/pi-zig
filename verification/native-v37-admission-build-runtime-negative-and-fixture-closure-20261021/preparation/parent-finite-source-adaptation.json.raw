      "label": "Agreed two-file Root source acceptance contract",
      "offset": 27789,
      "old": "require(acceptance[\"status\"]==\"root_and_independent_peer_accepted_bounded_fixture_resource_correction\",\"fixture source acceptance\")\nrequire(acceptance[\"candidate_head\"]==BASIS and acceptance[\"target\"]==FIXTURE,\"accepted fixture basis\")\nrequire(acceptance[\"original\"][\"sha256\"]==OLD_FIXTURE and acceptance[\"original\"][\"bytes\"]==OLD_FIXTURE_BYTES,\"accepted old fixture\")\nrequire(acceptance[\"selected_fixture\"][\"sha256\"]==NEW_FIXTURE and acceptance[\"selected_fixture\"][\"bytes\"]==NEW_FIXTURE_BYTES,\"accepted selected fixture\")",
      "new": "require(acceptance[\"status\"]==\"root_and_independent_peer_accepted_bounded_filehandle_runtime_fixture_corrections\",\"fixture source acceptance\")\nrequire(acceptance[\"candidate_head\"]==BASIS,\"accepted two-file fixture basis\")",
