    {
      "specification": 46,
      "occurrence": 1,
      "label": "Exact planned fixture manifest and archive identities replace unresolved scope",
      "offset": 10901,
      "old": "FIXTURE_MANIFEST = inside(Path(cfg[\"fixture_source\"][\"manifest\"][\"path\"]),E)\nFIXTURE_ARCHIVE = relative(cfg[\"fixture_archive_target_prefix\"])\nrequire(FIXTURE_MANIFEST.parent.parent==E and FIXTURE_MANIFEST.name==\"manifest.json\",\"one exact Root-selected future fixture manifest under evidence\")\nrequire(FIXTURE_ARCHIVE.startswith(\"verification/native-v37-\") and \"/\" not in FIXTURE_ARCHIVE[len(\"verification/\"):],\"bounded separate V37 fixture archive\")",
      "new": "FIXTURE_MANIFEST = E / \"pending-v37-filehandle-runtime-fixtures-main-intake-20261021/manifest.json\"\nFIXTURE_ARCHIVE = \"verification/native-v37-build-runtime-negative-and-fixture-closure-20261021\"\nrequire(cfg[\"fixture_source\"][\"manifest\"][\"path\"]==str(FIXTURE_MANIFEST) and cfg[\"fixture_archive_target_prefix\"]==FIXTURE_ARCHIVE,\"fixed exact future fixture manifest and separate archive\")",
      "before_sha256": "2534230BB3118E88A028FDD3ACA0064DD2128E14CD9066EE62CFE5A2C5F573FD",
      "after_sha256": "CACCFF4D958D9F40426192D63BC2D692EE2AB69BE94A7EB7CADF086917CE534C"
    },
    {
      "specification": 47,
      "occurrence": 1,
      "label": "Both selected fixture postimages exact Root inputs",
      "offset": 12437,
      "old": "require(set(cfg[\"fixture_after\"])=={\"bytes\",\"sha256\"},\"exact forthcoming fixture after pin\")\nNEW_FIXTURE_BYTES,NEW_FIXTURE = cfg[\"fixture_after\"][\"bytes\"],cfg[\"fixture_after\"][\"sha256\"]\nrequire(type(NEW_FIXTURE_BYTES) is int and NEW_FIXTURE_BYTES>0 and re.fullmatch(r\"[0-9A-F]{64}\",NEW_FIXTURE) and NEW_FIXTURE!=OLD_FIXTURE,\"actual changed fixture bytes required\")",
      "new": "NEW_FIXTURES = cfg[\"fixtures_after\"]\nrequire(set(NEW_FIXTURES)==set(FIXTURES),\"both exact selected fixture postimages required\")\nfor target,row in NEW_FIXTURES.items():\n    require(set(row)=={\"bytes\",\"sha256\"} and type(row[\"bytes\"]) is int and row[\"bytes\"]>0 and re.fullmatch(r\"[0-9A-F]{64}\",row[\"sha256\"]) and row[\"sha256\"]!=OLD_FIXTURES[target][\"sha256\"],\"exact changed fixture bytes required: \"+target)",
      "before_sha256": "CACCFF4D958D9F40426192D63BC2D692EE2AB69BE94A7EB7CADF086917CE534C",
      "after_sha256": "7681C76A505ACF5D13BCC0E7F705E2C2FE4C8264C64300FBEF39066823631FCB"
    },
    {
      "specification": 48,
      "occurrence": 1,
      "label": "Two and only two existing test/support replacements",
      "offset": 20440,
      "old": "require([r[\"target\"] for r in fixture_rows if r[\"before\"] is not None]==[FIXTURE],\"one fixture replacement\")\nrequire(all(n==FIXTURE or n.startswith(FIXTURE_ARCHIVE+\"/\") for n in names),\"fixture intake scope\")",
      "new": "require(sorted(r[\"target\"] for r in fixture_rows if r[\"before\"] is not None)==sorted(FIXTURES),\"exactly two reviewed test/support replacements\")\nrequire(all(n in FIXTURES or n.startswith(FIXTURE_ARCHIVE+\"/\") for n in names),\"fixture intake scope\")",
      "before_sha256": "7681C76A505ACF5D13BCC0E7F705E2C2FE4C8264C64300FBEF39066823631FCB",
