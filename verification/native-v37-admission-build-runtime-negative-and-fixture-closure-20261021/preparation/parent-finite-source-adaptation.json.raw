      "occurrence": 1,
      "label": "Preserve historical root list exactly and add selected corrected current roots",
      "offset": 55795,
      "old": "for row in next_plan[\"new_source_roots\"]:\n    require(row[\"actual_metadata_count\"] is None,\"future four-root actual metadata unknown\")\n    current = (M/relative(row[\"source_root\"])).read_bytes()\n    require(sha(current)==row[\"sha256\"],\"unchanged four-root source\")\n    committed(current_tree,row[\"source_root\"],current)\nnext_plan[\"status\"] = \"preparing_fresh_v37_complete_disjoint_batches\"",
      "new": "require(\"selected_current_source_roots\" not in next_plan,\"new selected-current root list was absent\")\nselected_current_roots = copy.deepcopy(next_plan[\"new_source_roots\"])\nfor historical,row in zip(next_plan[\"new_source_roots\"],selected_current_roots):\n    require(row[\"actual_metadata_count\"] is None,\"future four-root actual metadata unknown\")\n    target = relative(row[\"source_root\"])\n    current = (M/target).read_bytes()\n    if target in FIXTURES:\n        require(target==FIXTURES[0] and historical[\"sha256\"]==OLD_FIXTURES[target][\"sha256\"] and sha(current)==NEW_FIXTURES[target][\"sha256\"],\"only the exact reviewed owner test root pin changes\")\n        row[\"sha256\"] = NEW_FIXTURES[target][\"sha256\"]\n    else:\n        require(sha(current)==historical[\"sha256\"],\"other three complete root sources unchanged\")\n    committed(current_tree,target,current)\nnext_plan[\"selected_current_source_roots\"] = selected_current_roots\nnext_plan[\"new_source_roots_are_original_historical_pins\"] = True\nnext_plan[\"status\"] = \"preparing_fresh_v38_complete_disjoint_batches\"",
      "before_sha256": "372BAA7877ECB2E99F58001CB404E4A950A818A2ADB815CC9BCC911BC1BA8AA8",
