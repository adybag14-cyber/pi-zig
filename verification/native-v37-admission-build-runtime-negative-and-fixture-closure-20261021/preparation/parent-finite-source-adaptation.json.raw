    {
      "specification": 30,
      "occurrence": 1,
      "label": "Admit initial failure independently from later successful retry",
      "offset": 29290,
      "old": "# Read both accepted historical phases.\n# Read both accepted historical phases. This preparation never reruns either audit.",
      "new": "\n# Retain the independently closed initial admission rejection as its own attempt.\ninitial_root = read_json(exact(INITIAL_ROOT,INITIAL_ROOT_SHA,INITIAL_ROOT_BYTES))\ninitial_peer = read_json(exact(INITIAL_PEER,INITIAL_PEER_SHA,INITIAL_PEER_BYTES))\nrequire(archived[\"initial-admission/root-acceptance.json\"][\"original\"]==raw_pin(INITIAL_ROOT,originals[str(INITIAL_ROOT)]),\"initial Root receipt archived exactly\")\nrequire(archived[\"initial-admission/independent-peer.json\"][\"original\"]==raw_pin(INITIAL_PEER,originals[str(INITIAL_PEER)]),\"initial independent closure archived exactly\")\nrequire(initial_root[\"status\"]==\"root_accepted_original_v37_new4_initial_admission_negative\" and initial_peer[\"status\"]==\"independently_closed_initial_admission_negative_before_proof_creation\",\"two exact initial-admission closure authorities\")\nfor record in (initial_root,initial_peer):\n    require(record[\"candidate_head\"]==BASIS and record[\"original_job_id\"]==INITIAL_JOB,\"initial closure original identity\")\n    require(record[\"original_control\"]==str(IC) and record[\"original_proof\"]==str(IP),\"initial closure original directories\")\n    require(record[\"failure\"][\"reason\"]==\"Initial grant must be within300seconds before first child launch\",\"original unchanged freshness rejection\")\n    require(record[\"failure\"][\"source_line\"]==44 and record[\"failure\"][\"first_call_line\"]==45 and record[\"failure\"][\"maximum_seconds\"]==300,\"unchanged initial freshness guard\")\n    require(record[\"failure\"][\"driver_sha256\"]==\"1DD3A9D27FA7B54F9383F325792A9E5259C66C32FA6C601F21216B4DBB483601\",\"unchanged strict driver\")\n    require(record[\"failure\"][\"terminal_job_status\"]==record[\"failure\"][\"terminal_outer_status\"]==\"failed\" and record[\"failure\"][\"terminal_job_exit_code\"]==record[\"failure\"][\"terminal_outer_exit_code\"]==1,\"initial failed terminal observations retained\")\n    for key in (\"full_source_vendor_compiler_seal_claim\",\"build_acceptance\",\"runtime_authority\",\"native_execution_authorized\",\"application_qualified\"):\n        require(record[key] is False,\"initial admission negative cannot imply build/runtime qualification\")\nrequire(initial_root[\"negative_accepted\"] is True and initial_root[\"proof_absent\"] is True and initial_root[\"all_groups_unattempted\"] is True,\"Root accepted only pre-proof negative\")\nrequire(initial_root[\"declared_groups\"]==4 and initial_root[\"declared_controls\"]==58 and initial_root[\"actual_metadata_count\"] is None,\"initial count separation\")\nrequire(initial_root[\"source_mutation_hold_released\"] is False and initial_peer[\"retry_authorized\"] is False,\"historical initial closure has no successor authority\")\nrequire(initial_root[\"independent_peer\"]==raw_pin(INITIAL_PEER,originals[str(INITIAL_PEER)]),\"Root exact initial independent peer\")\nfor root_role,peer_role,archive_name in (\n (\"independent_proof\",\"decisive_proof\",\"source-audit.json\"),\n (\"independent_checker\",\"source_audit\",\"source-audit.py\"),\n (\"full_job_tool_observation\",\"full_job_tool_observation\",\"job-tool-observation.json\"),\n (\"process_observation\",\"fresh_process_observation\",\"process-observation.json\"),\n):\n    require(initial_root[root_role]==initial_peer[peer_role]==archived[\"initial-admission/\"+archive_name][\"original\"],\"complete initial original closure proof archived: \"+root_role)\nfor role,name in ((\"fresh_process_query\",\"process-query.ps1\"),(\"process_query_tool_metadata\",\"process-query-tool-metadata.json\")):\n    require(initial_peer[role]==archived[\"initial-admission/\"+name][\"original\"],\"initial exact independent process-query evidence retained\")\nrequire(initial_root[\"failure\"]==initial_peer[\"failure\"],\"initial exact failure authority agreement\")\nrequire(initial_root[\"original_control_exact_names\"]==initial_peer[\"original_control_members\"]==sorted(r[0] for r in inventory[\"initial_admission\"][\"control_files\"]),\"initial exact original control names\")\nrequire(initial_peer[\"process_observation\"][\"original_pids_present\"]==initial_peer[\"process_observation\"][\"original_direct_children_present\"]==initial_peer[\"process_observation\"][\"native_candidates\"]==[],\"historically closed initial original instances\")\nrequire(initial_peer[\"process_observation\"][\"all_five_classifier_conditions_and_pattern_equal\"] is True and initial_peer[\"process_observation\"][\"runner_instance_preserved_as_string\"] is True,\"initial process evidence retains original identity and classifier\")\nrequire([g[\"group\"] for g in initial_peer[\"groups\"]]==GROUPS and [g[\"declared_controls\"] for g in initial_peer[\"groups\"]]==[18,3,24,13],\"all four initial unattempted groups\")\nfor group in initial_peer[\"groups\"]:\n    require(group[\"actual_metadata_count\"] is None and all(group[k] is False for k in (\"compile_attempted\",\"metadata_attempted\",\"runtime_attempted\")),\"initial metadata remains unobserved and no native phase attempted\")\ninitial_outer = read_json(originals[str(IC/\"outer.json\")])\nrequire(initial_outer[\"status\"]==\"failed\" and initial_outer[\"exit_code\"]==1 and initial_outer[\"timed_out\"] is False,\"initial retained outer failed without timeout\")\nrequire(originals[str(IC/\"outer.stdout.bin\")]==b\"\",\"initial driver emitted no build result\")\nrequire(b\"Initial grant must be within300seconds before first child launch\" in originals[str(IC/\"outer.stderr.log\")],\"actual original stderr freshness rejection retained\")\nrequire(initial_root[\"original_prepared_launch\"]==initial_peer[\"original_prepared_launch\"]==archived[\"initial-admission/buildquery-launch.json\"][\"original\"],\"old prepared launch remains separate from Retry1\")\n\n# Read both accepted Retry1 phases. This preparation never reruns any audit.",
      "before_sha256": "382C2A77B1127EE1202F9A8B3E46C03F7BB9A00F029A779D76E5E1CC253EF0B2",
      "after_sha256": "EE55913E990CBF2DE66F1EB351A9A610527ABC38824F1D9CB4A06FEABA29A638"
    },
