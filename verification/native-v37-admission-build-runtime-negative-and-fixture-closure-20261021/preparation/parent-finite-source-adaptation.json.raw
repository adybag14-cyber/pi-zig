    {
      "specification": 52,
      "occurrence": 1,
      "label": "Derive both exact selected bodies from pinned accepted proposal and replay all eight edits",
      "offset": 29058,
      "old": "selected_raw = configured(acceptance[\"selected_fixture\"])\nrequire(selected_raw==fixture_current[FIXTURE],\"Root accepted fixture donor equals actual committed bytes\")",
      "new": "proposal = read_json(configured(acceptance[\"source_proposal\"]))\nrequire(proposal[\"main_basis\"]==BASIS and proposal[\"finite_edits\"]==cfg[\"fixture_finite_hunks\"],\"accepted proposal basis and finite edit total\")\nrequire([r[\"relative_path\"] for r in proposal[\"files\"]]==list(FIXTURES),\"accepted proposal exact two-file order\")\nproposal_edits = 0\nfor row in proposal[\"files\"]:\n    target = row[\"relative_path\"]\n    before = configured(row[\"original\"])\n    after = configured(row[\"candidate\"])\n    require(before==fixture_before[target] and after==fixture_current[target],\"Root accepted original/projected donors equal actual committed bytes: \"+target)\n    replay = before\n    for edit in row[\"edits\"]:\n        old_bytes,new_bytes = edit[\"old\"].encode(),edit[\"new\"].encode()\n        offset = edit[\"offset\"]\n        require(sha(replay)==edit[\"before_sha256\"] and replay[offset:offset+len(old_bytes)]==old_bytes,\"proposal exact finite source preimage\")\n        replay = replay[:offset]+new_bytes+replay[offset+len(old_bytes):]\n        require(sha(replay)==edit[\"after_sha256\"],\"proposal finite source intermediate hash\")\n    require(replay==after,\"proposal complete source forward\")\n    for edit in reversed(row[\"edits\"]):\n        old_bytes,new_bytes = edit[\"old\"].encode(),edit[\"new\"].encode()\n        offset = edit[\"offset\"]\n        require(replay[offset:offset+len(new_bytes)]==new_bytes,\"proposal exact inverse span\")\n        replay = replay[:offset]+old_bytes+replay[offset+len(new_bytes):]\n    require(replay==before and row[\"full_inverse_exact\"] is True,\"proposal complete raw source inverse\")\n    proposal_edits += len(row[\"edits\"])\nrequire(proposal_edits==cfg[\"fixture_finite_hunks\"],\"every accepted finite correction edit retained\")",
      "before_sha256": "799F82962DC20F65485CA48F91BCD56AC2255CA371B899B4E3388FCD838B62CE",
      "after_sha256": "EF84F223096DB76CF6D6B2BD58BD1E70EE7F890150F2106E7F4DD471BEF53CC9"
    },
