"""Independent source/byte/AST review. Does not import or execute any reviewed preparer or prefix."""
from pathlib import Path
import ast,hashlib,json,re,subprocess
B=Path(r"C:\Users\adyba\pi-zig");M=B/"main";D=B/"evidence/v37-progress-negative-archive-sourceonly-20261021"
OUT=B/"worktrees/modules-io-resume-20261018/verification/v37-progress-archive-preparer-peer-20261021"
