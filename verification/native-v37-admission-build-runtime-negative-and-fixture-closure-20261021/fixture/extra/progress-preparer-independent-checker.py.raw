memo={}
def sha(raw):return hashlib.sha256(raw).hexdigest().upper()
def record(path,raw):return {"path":str(path),"bytes":len(raw),"sha256":sha(raw)}
def read(path,size=None,digest=None):
 p=Path(path);assert p.resolve().is_relative_to(B.resolve()) and p.is_file() and not p.is_symlink()
 raw=p.read_bytes()
 if size is not None:assert len(raw)==size,str(p)
 if digest is not None:assert sha(raw)==digest,str(p)
 prior=memo.get(str(p));assert prior is None or prior==raw
 memo[str(p)]=raw
 return raw
def pinned(row):return read(row["path"],row["bytes"],row["sha256"])
def obj(path,size=None,digest=None):return json.loads(read(path,size,digest))
def git(*args):return subprocess.check_output(["git","--no-optional-locks","-c","core.fsmonitor=false",*args],cwd=M)
def state():
 assert git("rev-parse","HEAD").decode().strip()==HEAD
 assert git("branch","--show-current").decode().strip()=="work/pi-zig-consolidated-20261016"
 assert git("status","--porcelain=v1","--untracked-files=all")==b""
