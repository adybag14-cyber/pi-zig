def allpins(x):
 if isinstance(x,dict):
  if {"path","bytes","sha256"}<=set(x) and x["path"] is not None:yield x
  else:
   for z in x.values():yield from allpins(z)
 elif isinstance(x,list):
  for z in x:yield from allpins(z)
