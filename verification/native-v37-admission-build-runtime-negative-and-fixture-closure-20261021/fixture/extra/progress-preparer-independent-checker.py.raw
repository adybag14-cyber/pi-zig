s=json.loads(pinned(f["specifications"]))
assert f["baseline"]["sha256"]=="BC45FAAFF6F34876F644173DFA2815EAD7BF74E4F1DFE02CFA884CE9C03C8DDF"
assert f["candidate"]["sha256"]=="F40C2032692492E98D61D3B8F72275C56B5C23708C9FAEF50221127D8FA3BD71"
assert v["candidate"]["sha256"]=="079CE8663FFA9C337F5AC04D41E4222E6B2EFB9B39E5B459F6F4E460F9AC790D"
old=pinned(f["baseline"]);mid=pinned(f["candidate"]);new=pinned(v["candidate"])
assert s["baseline"]==f["baseline"] and all(s["candidate"][k]==f["candidate"][k] for k in ("path","bytes","sha256"))
assert len(s["specifications"])==f["source_specification_count"]==83
x=old;steps=[]
for i,e in enumerate(s["specifications"]):
 a=e["old"].encode();b=e["new"].encode();assert x.count(a)==e["count"]
 offsets=[];start=0
 for occurrence in range(e["count"]):
  off=x.index(a,start);offsets.append(off);start=off+len(a)
 shift=0
 for occurrence,off in enumerate(offsets):
  off+=shift;before=sha(x);assert x[off:off+len(a)]==a
  x=x[:off]+b+x[off+len(a):]
  steps.append({"specification":i+1,"occurrence":occurrence+1,"label":e["label"],"offset":off,"old":e["old"],"new":e["new"],"before_sha256":before,"after_sha256":sha(x)})
  shift+=len(b)-len(a)
assert steps==f["steps"] and len(steps)==84 and x==mid
for e in reversed(steps):
 a=e["old"].encode();b=e["new"].encode();off=e["offset"]
 assert sha(x)==e["after_sha256"] and x[off:off+len(b)]==b
 x=x[:off]+a+x[off+len(b):];assert sha(x)==e["before_sha256"]
assert x==old
a=v["edit"]["old"].encode();b=v["edit"]["new"].encode();off=v["offset"]
assert mid.count(a)==1 and mid.index(a)==off
assert mid[:off]+b+mid[off+len(a):]==new and new[:off]+a+new[off+len(b):]==mid
outer=json.loads(pinned(v["actual_original_outer"]))
assert sorted(outer)==v["actual_original_outer_keys"] and "timed_out" not in outer
assert outer["status"]=="failed" and outer["exit_code"]==1 and outer["error"]=="Owned terminal failed: "+outer["executable"] and outer["timeout_seconds"]==1800
def funcs(raw):
 lines=raw.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno]) for n in ast.parse(raw).body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}
fs=[funcs(z) for z in (old,mid,new)]
assert all(set(z)==set(fs[0]) for z in fs)
assert [k for k in fs[0] if fs[0][k]!=fs[2][k]]==["original_inventory"]
