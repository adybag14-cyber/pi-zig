seen={}
def digest(raw): return hashlib.sha256(raw).hexdigest().upper()
def pin(path,size=None,sha=None):
 p=Path(path);raw=p.read_bytes()
 row={'path':str(p),'bytes':len(raw),'sha256':digest(raw)}
 if size is not None: assert len(raw)==size,('size',str(p),len(raw),size)
 if sha is not None: assert row['sha256']==sha.upper(),('hash',str(p))
 key=str(p).lower()
 if key in seen: assert seen[key]==row,('input changed',str(p))
 seen[key]=row
 return raw
def json_read(p,size=None,sha=None): return json.loads(pin(p,size,sha))
def collect_pin_objects(value):
 if isinstance(value,dict):
  if {'path','sha256'}<=value.keys() and value['path'] and value['sha256']:
   pin(value['path'],value.get('bytes'),value['sha256'])
  for v in value.values(): collect_pin_objects(v)
 elif isinstance(value,list):
  for v in value: collect_pin_objects(v)
def git(*args):
 r=subprocess.run(['git','--no-optional-locks','-c','core.fsmonitor=false','-C',str(MAIN),*args],capture_output=True,check=True,timeout=30)
 assert not r.stderr,r.stderr.decode(errors='replace')
 return r.stdout
def main_state():
 head=git('rev-parse','HEAD').decode().strip()
 branch=git('branch','--show-current').decode().strip()
 status=git('status','--porcelain=v1','--untracked-files=all')
 assert head==HEAD and branch=='work/pi-zig-consolidated-20261016'
 assert status==b'',status
 return {'head':head,'branch':branch,'status_porcelain_bytes':0}
def ticks(stamp):
 m=re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(Z|[+-]\d\d:\d\d)',stamp)
 assert m,stamp
 whole=dt.datetime.fromisoformat(m[1]+('+00:00' if m[3]=='Z' else m[3])).astimezone(dt.timezone.utc)
 delta=whole-dt.datetime(1601,1,1,tzinfo=dt.timezone.utc)
 return (delta.days*86400+delta.seconds)*10000000+int((m[2] or '').ljust(7,'0'))
def decimal_seconds(value):
 whole,fraction=divmod(value,10000000)
 return str(whole)+'.'+str(fraction).zfill(7)
