 assert grant[k] is None,k
old_grant_raw=pin(adapt['original_grant']['path'],adapt['original_grant']['bytes'],adapt['original_grant']['sha256'])
old_grant=json.loads(old_grant_raw)
forward=copy.deepcopy(old_grant)
assert len(adapt['field_changes'])==36
for edit in adapt['field_changes']:
 k=edit['key'];assert (k in forward)==edit['old_present']
 assert forward.get(k)==edit['before']
 forward[k]=copy.deepcopy(edit['after'])
assert forward==grant
inverse=copy.deepcopy(grant)
for edit in reversed(adapt['field_changes']):
 k=edit['key'];assert inverse[k]==edit['after']
 if edit['old_present']: inverse[k]=copy.deepcopy(edit['before'])
 else: del inverse[k]
assert inverse==old_grant
assert (json.dumps(inverse,indent=2)+'\n').encode()==old_grant_raw
