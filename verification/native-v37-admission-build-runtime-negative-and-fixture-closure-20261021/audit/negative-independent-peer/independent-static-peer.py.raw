x=json.loads(INPUT.read_bytes());checked={}
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def pin(p):
 p=Path(p);raw=p.read_bytes();return dict(path=str(p),bytes=len(raw),sha256=sha(raw))
def checked_raw(row):
 assert pin(row["path"])==row,row
 checked[row["path"]]=row
 return Path(row["path"]).read_bytes()
def read_pin(row):return json.loads(checked_raw(row).decode("utf-8-sig"))
def hash_read(path,expected):
 row=pin(path);assert row["sha256"]==expected,(str(path),row["sha256"],expected);checked[str(path)]=row
 return Path(path).read_bytes()
def verify_rows(value):
 if isinstance(value,dict):
  if {"path","bytes","sha256"}<=set(value) and isinstance(value["path"],str) and isinstance(value["sha256"],str):
   checked_raw({k:value[k]for k in ("path","bytes","sha256")})
  for v in value.values():verify_rows(v)
 elif isinstance(value,list):
  for v in value:verify_rows(v)
def ticks(value):
 m=re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(Z|[+-]\d\d:\d\d)",value);assert m
 dt=datetime.datetime.fromisoformat(m[1]+("+00:00"if m[3]=="Z"else m[3]))
 span=dt-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
 return (span.days*86400+span.seconds)*10000000+int((m[2]or"").ljust(7,"0"))
old=checked_raw(x["baseline"]);new=checked_raw(x["candidate"]);cfgraw=checked_raw(x["configuration"])
cfg=json.loads(cfgraw);finite=read_pin(x["finite_proof"]);priorraw=checked_raw(x["baseline_configuration"]);prior=json.loads(priorraw)
closure=read_pin(x["accepted_baseline_closure"])
assert finite["baseline"]==x["baseline"] and finite["candidate"]==x["candidate"]
assert finite["specifications"]==x["allowed_specifications"] and len(finite["specifications"])==34 and len(finite["steps"])==39
cur=old;steps=[];ordinal=0
for spec in x["allowed_specifications"]:
 a=spec["before"].encode();b=spec["after"].encode();assert cur.count(a)==spec["occurrences"],spec["label"]
 for occ in range(1,spec["occurrences"]+1):
  pos=cur.index(a);step=finite["steps"][ordinal]
  assert step==dict(label=spec["label"],occurrence=occ,offset=pos,before=spec["before"],after=spec["after"],before_bytes=len(cur),before_sha256=sha(cur),after_bytes=len(cur)-len(a)+len(b),after_sha256=sha(cur[:pos]+b+cur[pos+len(a):]))
  cur=cur[:pos]+b+cur[pos+len(a):];steps.append(step);ordinal+=1
assert cur==new and ordinal==39
for s in reversed(steps):
 p=s["offset"];a=s["after"].encode();b=s["before"].encode()
 assert len(cur)==s["after_bytes"] and sha(cur)==s["after_sha256"] and cur[p:p+len(a)]==a
 cur=cur[:p]+b+cur[p+len(a):];assert sha(cur)==s["before_sha256"] and len(cur)==s["before_bytes"]
assert cur==old
def functions(data):
 lines=data.splitlines(keepends=True)
 return {n.name:b"".join(lines[n.lineno-1:n.end_lineno])for n in ast.parse(data).body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}
