def nonliteral(data):
 return [(t.type,"<literal>"if t.type in(tokenize.STRING,tokenize.NUMBER)else t.string)for t in tokenize.generate_tokens(io.StringIO(data.decode()).readline)]
assert nonliteral(adjusted)==nonliteral(new)
def structural(data):
 tree=ast.parse(data)
 for n in ast.walk(tree):
  if isinstance(n,ast.Constant):n.value="<constant>"
 return ast.dump(tree,include_attributes=False)
