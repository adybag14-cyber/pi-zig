+JSJSONParseErrorHook *JS_PiSetJSONParseErrorHook(JSContext *ctx,
+                                             JSJSONParseErrorHook *hook)
+{
+    JSJSONParseErrorHook *previous = ctx->pi_json_parse_error_hook;
+    ctx->pi_json_parse_error_hook = hook;
+    return previous;
