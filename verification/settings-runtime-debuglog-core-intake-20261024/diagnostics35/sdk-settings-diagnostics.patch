+fn hasBody(s: *Scope, binding: c.JSValue, key: c.JSValue) !c.JSValue {
+    const seen = try SeenFrame.read(s, binding);
+    const has = try v.get(s, seen, "has");
+    return v.boolean(s, v.truthy(s, try v.call(s, has, seen, &.{key})));
