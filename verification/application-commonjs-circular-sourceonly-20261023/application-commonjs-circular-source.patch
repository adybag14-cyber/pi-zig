+fn createBody(s: *Scope, module: c.JSValue, k_evaluated: c.JSValue) !c.JSValue {
+    try s.pending();
+    if (!c.JS_IsNumber(k_evaluated)) return error.ActualModuleWrapEvaluatedStatusRequired;
