+test "native AI HTTP ready bytes and EOF wait for complete Promise checkpoints" {
+    const fixture = @import("../ai/http_fixture.zig");
+    const server = try fixture.PlanServer.init(std.testing.allocator, std.testing.io, &.{.{ .path = "/checkpoint", .body = "wire" }});
+    defer server.deinit();
+    const url = try server.url(std.testing.allocator, "/checkpoint");
+    defer std.testing.allocator.free(url);
+    const engine = try em.Engine.init(std.testing.allocator, .{ .host_await_timeout_ms = 10000 });
+    defer engine.deinit();
+    engine.native_io = std.testing.io;
+    const transport = try open(engine, .{ .url = url, .method = .GET, .payload = "", .headers = &.{}, .timeout_ms = 2000, .framing = .bytes }, c.pi_js_undefined());
+    defer engine.freeValue(transport);
+    const worker = (try stateFor(engine)).jobs.items[0].worker;
+    const deadline = std.Io.Clock.awake.now(std.testing.io).toMilliseconds() + 2000;
+    // Observe actual worker completion without publishing a VM response. The
+    // ready head, bytes and terminal state are then genuinely available when
+    // each Promise chain runs, independent of socket or machine timing.
+    while (!worker.finished.load(.acquire)) {
+        const epoch = engine.native_owner_signal.observe();
+        if (worker.finished.load(.acquire)) break;
+        const remaining = deadline - std.Io.Clock.awake.now(std.testing.io).toMilliseconds();
+        if (remaining <= 0) return error.HttpCheckpointWorkerDidNotFinish;
+        _ = try engine.native_owner_signal.waitAfter(std.testing.io, epoch, .{ .duration = .{ .raw = .fromMilliseconds(@intCast(remaining)), .clock = .awake } });
+    }
+    var scope: Scope = .{ .engine = engine };
+    defer scope.deinit();
+    const global = try scope.own(c.JS_GetGlobalObject(engine.context));
+    try scope.put(global, "checkpointRequest", transport);
+    const module = try engine.evalModule(
+        \\const order=[];function chain(label){Promise.resolve().then(()=>order.push(label+'1')).then(()=>order.push(label+'2')).then(()=>order.push(label+'3'))}
+        \\chain('head');await checkpointRequest.ready;order.push('ready');chain('byte');const bytes=await checkpointRequest.events.next();if(bytes.done||bytes.value.type!=='bytes')throw Error('missing wire bytes');order.push('bytes');chain('end');if(!(await checkpointRequest.events.next()).done)throw Error('missing EOF');order.push('eof');if(JSON.stringify(order)!==JSON.stringify(['head1','head2','head3','ready','byte1','byte2','byte3','bytes','end1','end2','end3','eof']))throw Error(JSON.stringify(order));export const done=true;
+    , "native-http-promise-checkpoint.mjs");
+    engine.freeValue(module);
+    try server.finish();
+}
