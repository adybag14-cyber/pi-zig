  "edits": [
    {
      "before": "        try self.base().engine.bindFunction(\"actualCustomNread\", readNread, 0);\n",
      "after": "        try self.base().engine.bindFunction(\"actualCustomNread\", readNread, 0);\n        try self.base().engine.bindFunction(\"actualStopCustomRead\", stopRead, 0);\n",
      "why": "Bind the actual FileHandle ReadStop body for the guest EOF callback.",
      "input_sha256": "987E4A70D1DB8BE81C5E69AD5B5568E5B1BB7D6FE6A8622D7B34C2BE167F0BFC",
      "output_sha256": "76D4A513D2F060A84ED24B4309B396105B189484FEB149CDA90028CF4EF5DB9C"
    },
    {
      "before": "fn expectBuffer(actual: uv.uv_buf_t, pointer: usize, length: usize) !void {",
      "after": "fn stopRead(context: ?*c.JSContext, _: c.JSValue,\n    _: c_int, _: [*c]c.JSValue) callconv(.c) c.JSValue\n{\n    const f = selectedBase(context.?);\n    const handle = f.handle() catch |err| return callable.failure(f.engine, err, 0);\n    return c.JS_NewInt32(context.?, handle.readStop());\n}\nfn expectBuffer(actual: uv.uv_buf_t, pointer: usize, length: usize) !void {",
      "why": "The selected native control calls the genuine owner, without synthetic state mutation.",
      "input_sha256": "76D4A513D2F060A84ED24B4309B396105B189484FEB149CDA90028CF4EF5DB9C",
      "output_sha256": "42EB71C5907C0B4D2FCC36680743CC24A35A17E05A63634D819C89B4070F71EC"
    },
    {
      "before": "    try std.testing.expectEqual(@as(u32, 0), f.base().env().streamBaseField(.array_buffer_offset).*);",
      "after": "    try std.testing.expectEqual(@as(i32, 0), f.base().env().streamBaseField(.array_buffer_offset).*);",
      "why": "Match the actual Environment Int32Array field type.",
      "input_sha256": "42EB71C5907C0B4D2FCC36680743CC24A35A17E05A63634D819C89B4070F71EC",
      "output_sha256": "9D43A80A59361F2DE9CDA65E7F80330144788E90D24FF4C439E671319659B8A9"
    },
    {
      "before": "    // The real file contains ABCDEFGH. Bound the native FileHandle to those\n    // eight bytes; its existing read engine emits the final EOF synchronously.\n    const handle = try f.base().handle();\n    handle.read_state.read_length = 8;",
      "after": "    // The real file contains ABCDEFGH. Two physical reads consume its bytes;\n    // a third reaches real EOF and the guest callback invokes actual ReadStop.\n    const handle = try f.base().handle();",
      "why": "Use real descriptor EOF and real owner stopping, without altering native length fields.",
      "input_sha256": "9D43A80A59361F2DE9CDA65E7F80330144788E90D24FF4C439E671319659B8A9",
      "output_sha256": "ACED4F9EC72AF981C12EAACACE10887EC62E932C9C2218A64F596ACA52E7E6AC"
    },
    {
      "before": "    try f.onread(\"(function(value){customReads.push(actualCustomNread());customArguments.push(value);return customReads.length===1?customSecond:undefined;})\");",
      "after": "    try f.onread(\"(function(value){const nread=actualCustomNread();customReads.push(nread);customArguments.push(value);if(nread<0)actualStopCustomRead();return customReads.length===1?customSecond:undefined;})\");",
      "why": "Stop the actual live read state after EOF to avoid a further native restart.",
      "input_sha256": "ACED4F9EC72AF981C12EAACACE10887EC62E932C9C2218A64F596ACA52E7E6AC",
      "output_sha256": "314AF3C30DCED8372C3DD34B72589FD34A1C4D82F36F6CAE107D9B1F5BD42ADE"
    },
    {
      "before": "    try std.testing.expectEqual(@as(usize, 2), f.base().read_begins);\n    try std.testing.expectEqual(@as(usize, 2), f.base().read_ends);",
      "after": "    try std.testing.expectEqual(@as(usize, 3), f.base().read_begins);\n    try std.testing.expectEqual(@as(usize, 3), f.base().read_ends);",
      "why": "Observe all three real native requests/completions, including EOF.",
      "input_sha256": "314AF3C30DCED8372C3DD34B72589FD34A1C4D82F36F6CAE107D9B1F5BD42ADE",
      "output_sha256": "A25266B23890A16FB72533F68A040EA8AE81B0F6D20AD178AA1D6037E50F30C2"
    }
  ],
