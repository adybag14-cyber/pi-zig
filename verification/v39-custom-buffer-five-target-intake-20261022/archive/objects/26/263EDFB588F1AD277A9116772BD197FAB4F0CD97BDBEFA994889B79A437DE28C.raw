  "insert_before": "        const node_one_byte_string = b.addTest(.{",
  "insert": "        const node_custom_buffer_listener = b.addTest(.{\n            .root_module = b.createModule(.{ .root_source_file = b.path(\"src/native_node_custom_buffer_listener_test.zig\"), .target = target, .optimize = optimize }),\n            .filters = &.{\"native CustomBuffer listener\"}, .use_llvm = use_llvm,\n        });\n        linkQuickJs(b, node_custom_buffer_listener.root_module, quickjs, sqlite_lib_dir);\n        linkTypeScriptParser(b, node_custom_buffer_listener.root_module, typescript_parser);\n        linkSqlite(node_custom_buffer_listener.root_module, sqlite_lib_dir, sqlite_library);\n        node_custom_buffer_listener.root_module.addImport(\"catalog_tool\", catalog_tool);\n        node_custom_buffer_listener.root_module.addIncludePath(b.path(\"vendor/node-v24.13.0/uv/include\"));\n        node_custom_buffer_listener.root_module.addIncludePath(b.path(\"src/extensions\"));\n        node_custom_buffer_listener.root_module.linkLibrary(network);\n        // This target owns one TLS implementation and one V8 fatal owner.\n        // The selected network library contains neither translation unit.\n        node_custom_buffer_listener.root_module.addCSourceFile(.{\n            .file = b.path(\"src/extensions/native_node_diagnostic_context.c\"),\n            .flags = &.{\"-std=gnu11\"},\n        });\n        node_custom_buffer_listener.root_module.addCSourceFiles(.{\n            .files = &.{\n                \"src/extensions/native_v8_base_fatal.cpp\",\n                \"src/extensions/native_node_one_byte_string_diagnostics.cpp\",\n                \"src/extensions/native_node_custom_buffer_listener_allocation.cpp\",\n            },\n            .flags = &.{ \"-std=gnu++20\", \"-fno-exceptions\", \"-fno-rtti\", \"-fno-strict-aliasing\" },\n        });\n        if (target.result.os.tag == .windows) {\n            node_custom_buffer_listener.root_module.linkSystemLibrary(\"advapi32\", .{});\n            node_custom_buffer_listener.root_module.linkSystemLibrary(\"userenv\", .{});\n        }\n        b.step(\"build-native-node-custom-buffer-listener\", \"Install 15 actual CustomBuffer controls without execution\").dependOn(&b.addInstallArtifact(node_custom_buffer_listener, .{ .dest_sub_path = b.fmt(\"native-node-custom-buffer-listener{s}\", .{if (target.result.os.tag == .windows) \".exe\" else \"\"}) }).step);\n",
