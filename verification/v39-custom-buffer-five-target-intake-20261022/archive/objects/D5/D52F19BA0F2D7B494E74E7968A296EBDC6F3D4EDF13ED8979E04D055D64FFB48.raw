        const node_custom_buffer_listener = b.addTest(.{
            .root_module = b.createModule(.{ .root_source_file = b.path("src/native_node_custom_buffer_listener_test.zig"), .target = target, .optimize = optimize }),
            .filters = &.{"native CustomBuffer listener"}, .use_llvm = use_llvm,
        });
        linkQuickJs(b, node_custom_buffer_listener.root_module, quickjs, sqlite_lib_dir);
        linkTypeScriptParser(b, node_custom_buffer_listener.root_module, typescript_parser);
        linkSqlite(node_custom_buffer_listener.root_module, sqlite_lib_dir, sqlite_library);
        node_custom_buffer_listener.root_module.addImport("catalog_tool", catalog_tool);
        node_custom_buffer_listener.root_module.addIncludePath(b.path("vendor/node-v24.13.0/uv/include"));
        node_custom_buffer_listener.root_module.addIncludePath(b.path("src/extensions"));
        node_custom_buffer_listener.root_module.linkLibrary(network);
        // This target owns one TLS implementation and one V8 fatal owner.
