  "root_semantic_review": [
    "Original Node CustomBuffer OnAllocate/OnRead and already-admitted UseUserBuffer preserve branch, base-only comparison, callback, base-then-native-length replacement and initial unsigned-int narrowing order.",
    "Native allocation scope retains independent memory-domain prefix ownership; Listener destructor unlinks before free and unlinked storage may retire after Engine teardown without an Engine root.",
    "Callback self-destruction is permitted only on original no-replacement paths; subsequent cleanup uses retained local Environment/Scope and no stream/listener access.",
    "Real Shutdown reporter selected directly; borrowed view/backing storage has no listener-owned JS root or allocation entitlement.",
    "One install-only build insertion links existing shared diagnostic and native memory owners; only the allocation TU is newly direct compiled.",
    "All three complete production files and fifteen complete controls read, all78 mapped original/host/selected excerpts read, complete author source-checker read as text; no proposed checker executed."
  ],
  "scope_limitations": [
    "Full public FileHandle/StreamBase prototype publication and runtime-owned FunctionTemplate identity.",
    "Full WriteWrap completion and worker/transfer/bootstrap assembly.",
    "V8 on-heap TypedArray materialization allocation policy.",
    "Production tracing clock/platform/Agent integration and hook-policy bootstrap.",
    "Compiler, metadata, runtime, cross-platform or product qualification."
  ],
  "caller_obligations": [
    "Real entry/receiver/VM admission already completed.",
    "Stream/environment/Engine valid for synchronous operation; caller-owned native view and storage remain valid through native I/O.",
    "No dereference after caller detaches, shrinks or retires backing; valid nonzero buffer required by real I/O.",
    "A nonundefined replacement result must be returned while listener is alive; undefined/empty/null-negative branches allow self-destruction.",
    "An unlinked orphan after Engine teardown may only retire its allocation, not be read or reused."
  ],
