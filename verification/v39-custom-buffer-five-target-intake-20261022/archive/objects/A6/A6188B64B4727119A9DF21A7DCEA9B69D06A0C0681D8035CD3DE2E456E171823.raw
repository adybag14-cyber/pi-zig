//! Actual Node v24.13 internal/fs/promises fsCall declaration.
//! The private caller uses the genuine handle symbol properties, actual rest
//! array/spread/call operations, one intrinsic Await and Source finally.
//! Inputs are the original bindings from the completed FileHandle bootstrap.
const v = @import("native_public_values.zig");
const c = v.c;
const af = v.af;
const Scope = v.Scope;
const Engine = v.em.Engine;
const Frame = @import("native_public_lexical_frame.zig").Frame(enum { rest, err });

pub const Inputs = struct {
    assert_function: c.JSValue,
    error_constructor: c.JSValue,
    safe_array_iterator: c.JSValue,
    refs: c.JSValue,
    close_reason: c.JSValue,
    ref: c.JSValue,
    unref: c.JSValue,
};
const Import = enum { assert_function, error_constructor, safe_array_iterator, refs, close_reason, ref, unref };
fn imported(roots: []const c.JSValue, comptime field: Import) c.JSValue {
    return roots[@intFromEnum(field)];
}
fn expression(engine: *Engine, comptime body: anytype, args: anytype) !c.JSValue {
    var scope: Scope = .{ .engine = engine };
    return v.owned.finishValue(&scope, @call(.auto, body, .{&scope} ++ args));
}
fn statement(engine: *Engine, comptime body: anytype, args: anytype) !void {
    var scope: Scope = .{ .engine = engine };
    return v.owned.finishVoid(&scope, @call(.auto, body, .{&scope} ++ args));
}
fn value(scope: *Scope, comptime body: anytype, args: anytype) !c.JSValue {
    return v.own(scope, try expression(scope.engine, body, args));
}
fn immediatePredicate(engine: *Engine, comptime body: anytype, args: anytype) !bool {
    // The body returns an immediate Boolean before its expression retires.
    const result = try expression(engine, body, args);
    defer engine.freeValue(result);
    return c.JS_ToBool(engine.context, result) == 1;
}
fn restArray(scope: *Scope, args: []const c.JSValue) !c.JSValue {
    const rest = args[@min(args.len, 2)..];
    var boundary: v.guest.Boundary = .{ .engine = scope.engine };
    try boundary.begin();
    const result = try boundary.finishValue(scope, c.JS_PiCreateRestArray(
        scope.engine.context, @intCast(rest.len), @constCast(rest.ptr)));
    return v.duplicate(scope, result);
}
fn hasReferences(scope: *Scope, handle: c.JSValue, symbol: c.JSValue) !c.JSValue {
    return v.boolean(scope, !c.JS_IsUndefined(try v.key(scope, handle, symbol)));
}
fn assertHandle(scope: *Scope, handle: c.JSValue, roots: []const c.JSValue) !void {
    const predicate = try value(scope, hasReferences, .{handle, imported(roots, .refs)});
    _ = try v.call(scope, imported(roots, .assert_function), c.pi_js_undefined(), &.{
        predicate, try v.text(scope, "handle must be an instance of FileHandle"),
    });
}
fn isClosed(scope: *Scope, handle: c.JSValue) !c.JSValue {
    const fd = try v.get(scope, handle, "fd");
    return v.boolean(scope, v.equal(scope, fd, c.JS_NewInt32(scope.engine.context, -1)));
}
fn closeReason(scope: *Scope, handle: c.JSValue, symbol: c.JSValue) !c.JSValue {
    const reason = try v.key(scope, handle, symbol);
    return v.duplicate(scope, if (v.nullish(reason)) try v.text(scope, "file closed") else reason);
}
fn closedError(scope: *Scope, handle: c.JSValue, roots: []const c.JSValue) !c.JSValue {
    const reason = try value(scope, closeReason, .{handle, imported(roots, .close_reason)});
    return v.duplicate(scope, try v.construct(scope, imported(roots, .error_constructor), &.{reason}));
}
fn errorCode(scope: *Scope, err: c.JSValue) !void {
    try v.set(scope, err, "code", try v.text(scope, "EBADF"));
}
fn functionName(scope: *Scope, function: c.JSValue) !c.JSValue {
    return v.duplicate(scope, try v.get(scope, function, "name"));
}
fn errorSyscall(scope: *Scope, err: c.JSValue, function: c.JSValue) !void {
    try v.set(scope, err, "syscall", try value(scope, functionName, .{function}));
}
fn raise(scope: *Scope, reason: c.JSValue) !c.JSValue {
    var boundary: v.guest.Boundary = .{ .engine = scope.engine };
    try boundary.begin();
    return boundary.finishValue(scope, c.JS_Throw(scope.engine.context, v.duplicate(scope, reason)));
}
fn discardSymbolMethod(scope: *Scope, handle: c.JSValue, symbol: c.JSValue) !void {
    const method = try v.key(scope, handle, symbol);
    _ = try v.call(scope, method, handle, &.{});
}
fn safeIterator(scope: *Scope, constructor: c.JSValue, rest: c.JSValue) !c.JSValue {
    return v.duplicate(scope, try v.construct(scope, constructor, &.{rest}));
}
fn appendArguments(scope: *Scope, argument_array: c.JSValue, rest: c.JSValue,
    iterator_constructor: c.JSValue) !void
{
    const iterable = try value(scope, safeIterator, .{iterator_constructor, rest});
    var position: u32 = 1;
    var boundary: v.guest.Boundary = .{ .engine = scope.engine };
    try boundary.begin();
    try boundary.finishStatus(c.JS_PiArrayAppend(
        scope.engine.context, argument_array, &position, iterable));
}
fn invokeBody(scope: *Scope, function: c.JSValue, handle: c.JSValue,
    rest: c.JSValue, iterator_constructor: c.JSValue) !c.JSValue
{
    // The Source spread creates its intrinsic argument array before evaluating
    // new SafeArrayIterator(args). The constructor expression completes before
    // the real OP_append iterator operation begins.
    const argument_array = try v.array(scope);
    try v.index(scope, argument_array, 0, handle);
    try statement(scope.engine, appendArguments, .{argument_array, rest, iterator_constructor});
    var call: v.guest.Boundary = .{ .engine = scope.engine };
    try call.begin();
    const result = try call.finishValue(scope, c.JS_PiCallArray(
        scope.engine.context, function, c.pi_js_undefined(), argument_array));
    return v.duplicate(scope, result);
}
fn tryBody(scope: *Scope, function: c.JSValue, handle: c.JSValue,
    frame: *Frame, roots: []const c.JSValue) !c.JSValue
{
    try statement(scope.engine, discardSymbolMethod, .{handle, imported(roots, .ref)});
    return expression(scope.engine, invokeBody, .{
        function, handle, frame.get(.rest), imported(roots, .safe_array_iterator),
    });
}
fn attemptCall(engine: *Engine, function: c.JSValue, handle: c.JSValue,
    frame: *Frame, roots: []const c.JSValue) !af.Action
{
    var scope: Scope = .{ .engine = engine };
    const outcome: anyerror!af.Action = if (tryBody(&scope, function, handle, frame, roots)) |result|
        .{ .returned = result } else |err| err;
    return v.owned.finishAction(&scope, outcome);
}
fn attemptFinally(engine: *Engine, handle: c.JSValue, symbol: c.JSValue) !af.Action {
    var scope: Scope = .{ .engine = engine };
    const outcome: anyerror!af.Action = if (discardSymbolMethod(&scope, handle, symbol)) |_|
        .{ .returned = c.pi_js_undefined() } else |err| err;
    return v.owned.finishAction(&scope, outcome);
}
fn payload(action: af.Action) c.JSValue {
    return switch (action) { .returned, .thrown, .awaited => |item| item };
}
fn afterFinally(engine: *Engine, handle: c.JSValue, symbol: c.JSValue,
    incoming: af.Action) !af.Action
{
    // Source finally has its own abrupt-completion precedence. The incoming
    // result stays owned while it executes; C435 is used only for retirement.
    const finished = attemptFinally(engine, handle, symbol) catch |err| {
        var failure = v.owned.Completion.initAction(engine, @as(anyerror!af.Action, err));
        failure.release(payload(incoming));
        return failure.finishAction();
    };
    switch (finished) {
        .returned => |unused| {
            var selected = v.owned.Completion.initAction(engine, incoming);
            selected.release(unused);
            return selected.finishAction();
        },
        .thrown => |reason| {
            var selected = v.owned.Completion.initAction(engine, .{ .thrown = reason });
            selected.release(payload(incoming));
            return selected.finishAction();
        },
        .awaited => unreachable,
    }
}
fn advance(scope: *Scope, args: []const c.JSValue, roots: []const c.JSValue,
    state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action
{
    const handle = v.arg(args, 1);
    if (completion == .start) {
        const frame = try Frame.createAsync(scope);
        af.replaceState(scope.engine, state, v.duplicate(scope, frame.owner));
        try frame.take(.rest, expression(scope.engine, restArray, .{args}));
        try statement(scope.engine, assertHandle, .{handle, roots});
        if (try immediatePredicate(scope.engine, isClosed, .{handle})) {
            try frame.take(.err, expression(scope.engine, closedError, .{handle, roots}));
            try statement(scope.engine, errorCode, .{frame.get(.err)});
            try statement(scope.engine, errorSyscall, .{frame.get(.err), v.arg(args, 0)});
            return .{ .thrown = try expression(scope.engine, raise, .{frame.get(.err)}) };
        }
        const result = try attemptCall(scope.engine, v.arg(args, 0), handle, frame, roots);
        return switch (result) {
            .returned => |promise| .{ .awaited = promise },
            .thrown => afterFinally(scope.engine, handle, imported(roots, .unref), result),
            .awaited => unreachable,
        };
    }
    const result: af.Action = if (completion == .rejected)
        .{ .thrown = v.duplicate(scope, input) } else .{ .returned = v.duplicate(scope, input) };
    return afterFinally(scope.engine, handle, imported(roots, .unref), result);
}
fn body(engine: *Engine, _: c.JSValue, args: []const c.JSValue, roots: []const c.JSValue,
    state: *c.JSValue, completion: af.Completion, input: c.JSValue) !af.Action
{
    if (completion == .rejected)
        try @import("native_async_body.zig").enterRejectedContinuation(engine);
    var scope: Scope = .{ .engine = engine };
    return v.owned.finishAction(&scope, advance(&scope, args, roots, state, completion, input));
}
fn createBody(scope: *Scope, inputs: Inputs) !c.JSValue {
    var roots: [@typeInfo(Inputs).@"struct".fields.len]c.JSValue = undefined;
    inline for (@typeInfo(Inputs).@"struct".fields, 0..) |field, index|
        roots[index] = @field(inputs, field.name);
    const function = try v.own(scope, try af.createResumableWithClose(
        scope.engine, "fsCall", 2, body, &roots, Frame.closeAtAsyncTerminal));
    return v.duplicate(scope, function);
}
pub fn create(engine: *Engine, inputs: Inputs) !c.JSValue {
    return expression(engine, createBody, .{inputs});
}
