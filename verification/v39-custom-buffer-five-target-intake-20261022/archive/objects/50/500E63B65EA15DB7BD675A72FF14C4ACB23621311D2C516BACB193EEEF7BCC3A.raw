 "src/extensions/native_node_diagnostic_context.h","src/extensions/native_node_diagnostic_context.hpp","src/extensions/native_node_diagnostic_context.c"]:
 p=S/"dependencies"/rel;overlay[rel]=row(p);checked(overlay[rel])
 if "native_v8_base_fatal" not in rel:assert baseline(rel)[0]==checked(overlay[rel])
