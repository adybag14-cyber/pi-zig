HEAD="79c19fc30c886e85b71aca75d1a025397db04fec"
def sha(b):return hashlib.sha256(b).hexdigest().upper()
def jp(o):return (json.dumps(o,indent=2,ensure_ascii=True)+"\n").encode()
def row(p,b=None):
 p=Path(p);b=p.read_bytes() if b is None else b
 return {"path":str(p),"bytes":len(b),"sha256":sha(b)}
pins={}
def checked(r):
 p=Path(r["path"]);b=p.read_bytes()
 assert len(b)==r["bytes"] and sha(b)==r["sha256"],str(p)
 pins[str(p)]=r;return b
def load(p,h=None):
 r=row(p)
 if h:assert r["sha256"]==h
 return json.loads(checked(r))
def apply(b,edits,reverse=False):
 for e in reversed(edits) if reverse else edits:
  old=e["after" if reverse else "before"].encode();new=e["before" if reverse else "after"].encode()
  assert b.count(old)==1,(old[:120],b.count(old));b=b.replace(old,new,1)
 return b
