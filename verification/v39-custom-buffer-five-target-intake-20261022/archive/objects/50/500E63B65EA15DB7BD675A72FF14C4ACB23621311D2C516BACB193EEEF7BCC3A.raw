proc=subprocess.Popen(["git","-C",str(M),"cat-file","--batch"],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
rawcache={}
def baseline(rel):
 if rel not in rawcache:
  proc.stdin.write((HEAD+":"+rel+"\n").encode());proc.stdin.flush()
  header=proc.stdout.readline().decode().strip()
  assert not header.endswith(" missing"),rel
  oid,kind,size=header.split();assert kind=="blob"
  b=proc.stdout.read(int(size));assert len(b)==int(size) and proc.stdout.read(1)==b"\n"
  rawcache[rel]=(b,oid)
 return rawcache[rel]
overlay={};layering=[]
for entry in shared["files"]:
 rel=entry["relative_path"];b=checked(entry["original"]);out=checked(entry["projected"])
 assert baseline(rel)[0]==b,rel
 es=[x for x in shared["edits"] if x["path"]==rel]
 assert apply(b,es)==out and apply(out,es,True)==b
 overlay[rel]=entry["projected"]
 layering.append({"target":rel,"base":entry["original"],"selected":entry["projected"],"edits":len(es),"full_inverse_exact":True})
assert checked(successor["original"])==checked(overlay[successor["relative_path"]])
assert apply(checked(successor["original"]),successor["edits"])==checked(successor["projected"])
assert apply(checked(successor["projected"]),successor["edits"],True)==checked(successor["original"])
overlay[successor["relative_path"]]=successor["projected"]
for item in shutdown["source_build_paths"]:
 rel=item["relative_path"]
 if rel=="build.zig":continue
 if item.get("selected_preimage") is None:
  checked(item["selected"]);overlay[rel]=item["selected"]
 else:assert checked(overlay[rel])==checked(item["selected"]),rel
vm_composition=[]
for item in combined["files"]:
 rel=item["relative_path"];before=checked(item["common_predecessor"])
 assert baseline(rel)[0]==before
 buf=[{"before":e["old_text"],"after":e["new_text"]} for e in raw["edits"] if e["path"]==rel]
 latin=[e for e in shared["edits"] if e["path"]==rel]
 if rel==successor["relative_path"]:latin=latin+successor["edits"]
 a=apply(apply(before,latin),buf);b=apply(apply(before,buf),latin)
 assert a==b==checked(item["combined"])
 assert apply(apply(a,buf,True),latin,True)==before
 assert apply(apply(b,latin,True),buf,True)==before
 assert apply(checked(overlay[rel]),buf)==a
 overlay[rel]=item["combined"]
 vm_composition.append({"target":rel,"common":item["common_predecessor"],"selected":item["combined"],"raw_edits":len(buf),"latin_edits":len(latin),"both_orders_and_inverses_exact":True})
