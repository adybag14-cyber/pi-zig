assert baseline(rel)[0]==base
b=base
for e in reversed(p["identifier_token_edits"]):
 off=e["old_offset"];old=e["before"].encode()
 assert b[off:off+len(old)]==old
 b=b[:off]+e["after"].encode()+b[off+len(old):]
assert b==after_alpha
inv=b
for e in reversed(p["identifier_token_edits"]):
 off=e["new_offset"];old=e["after"].encode()
 assert inv[off:off+len(old)]==old
 inv=inv[:off]+e["before"].encode()+inv[off+len(old):]
assert inv==base
before=q["phase_hunk"]["before"].encode();after=q["phase_hunk"]["after"].encode()
selected_fixture=checked(phase["projected_fixture"])
assert after_alpha.count(before)==1 and after_alpha.replace(before,after)==selected_fixture
assert selected_fixture.replace(after,before)==after_alpha
overlay[rel]=phase["projected_fixture"]
for item in component["production"]:overlay[item["target"]]=item["snapshot"];checked(item["snapshot"])
control="src/native_node_custom_buffer_listener_test.zig";overlay[control]=component["controls"];checked(component["controls"])
overlay["build.zig"]=build["projected"];checked(build["projected"])
old_build=checked(build["base"]);new_build=checked(build["projected"]);block=build["insert"].encode()
assert sha(block)==build["insert_sha256"]
anchor=build["insert_before"].encode()
assert old_build.count(anchor)==1 and old_build.replace(anchor,block+anchor)==new_build
assert new_build.count(block)==1 and new_build.replace(block,b"")==old_build
cache={}
def get(rel):
 rel=posixpath.normpath(rel);assert not rel.startswith("../") and not rel.startswith("/")
 if rel not in cache:
  if rel in overlay:
   b=checked(overlay[rel]);entry={"relative_path":rel,"origin":"selected immutable snapshot","source":overlay[rel],"bytes":len(b),"sha256":sha(b)}
  else:
   b,oid=baseline(rel);entry={"relative_path":rel,"origin":"immutable raw Git blob","repository":str(M),"commit":HEAD,"git_blob":oid,"bytes":len(b),"sha256":sha(b)}
  cache[rel]=(b,entry)
 return cache[rel]
modules=set();embeds=set();edges=[];external=set();todo=[control]
named={"catalog_tool":"tools/catalog.zig","native_icu_api":"src/extensions/icu/native_icu_api.zig"}
while todo:
 rel=todo.pop()
 if rel in modules:continue
 modules.add(rel);text=get(rel)[0].decode("utf-8")
 for name in re.findall(r'@import\s*\(\s*"([^"]+)"\s*\)',text):
  if name.endswith(".zig"):dest=posixpath.normpath(posixpath.join(posixpath.dirname(rel),name))
  elif name in named:dest=named[name]
  else:external.add(name);continue
  edges.append({"from":rel,"literal":name,"to":dest});todo.append(dest)
 for name in re.findall(r'@embedFile\s*\(\s*"([^"]+)"\s*\)',text):
  dest=posixpath.normpath(posixpath.join(posixpath.dirname(rel),name));get(dest);embeds.add(dest)
assert external<=set(["std","builtin"])
names=re.findall(r'^test "([^"]+)"',get(control)[0].decode(),re.M)
assert len(names)==15 and all(n.startswith("native CustomBuffer listener") for n in names)
anonymous=[]
for rel in sorted(modules):
 count=len(re.findall(r"^\s*test\s*\{",get(rel)[0].decode(),re.M))
 if count:
