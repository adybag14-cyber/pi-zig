{
  "schema": "pi-zig-application-print-owner-source-only-intake-v2",
  "created_utc": "2026-10-24",
  "source_basis_head": "65fac9975b25e9a5e4c00d7d7bca499aae1275c0",
  "status": "immutable_v2_source_with_carrier_authentication_correction_pending_root_peer",
  "scope": "Bind the actual public print module to the genuine application/auth/frontend owner using existing native output guard and cached native shell. No policy or guest callback is supplied by the caller.",
  "production_changes": [
    "Auth Owner.createPrintMode validates the real owner/stream lease, enters the existing native invocation boundary, owns all concrete guard fields and runtime carrier before any guest read, then calls the unchanged native public print constructor with the actual shell. The shell carrier must exactly match the retained real cached shell owner.",
    "Application Owner.createPrintMode validates its existing input owner and delegates to its own auth owner; canonical Module prerequisite remains unchanged.",
    "Existing genuine aggregate-owner callable profile checks the exported real async function. It still requires actual frontend/loader/config/canonical Module inputs and is not replaced by a fake successful graph."
  ],
  "retained_semantics": [
    "Existing per-Engine public print module cache/body unchanged.",
    "Original stdout takeover/restore remains at the real Source mode transition; construction does not take over output.",
    "Recorded body outcome precedes Scope retirement; ordinary pending, typed native fatal, and cleanup precedence use the existing completion/invocation machinery.",
    "No self fields are read after the guest-mutable shell read, which can reenter retirement.",
    "Frontend capabilities remain borrowed; retaining JS roots does not own or extend a native frontend pointer."
  ],
