  "exact_source_excerpts": [
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\native_node_file_handle_owner_test_support.zig",
        "bytes": 33411,
        "sha256": "DAAFD9A8B6FFFC0FD3971749F8A9515EA066BE81AEA90B44ADA397A70E76488B"
      },
      "first_line": 9,
      "last_line": 33,
      "bytes": 1353,
      "sha256": "51A504E82FC83AFCAC57927ADFDA9B6D058E6DFC7D2C0544A976080DC5BEFE59",
      "text": "pub const a = @import(\"extensions/native_node_argument_values.zig\");\npub const em = a.v.em;\npub const c = a.c;\npub const native = @import(\"extensions/native_node_async_wrap_state.zig\");\npub const callbacks = @import(\"extensions/native_node_callback_scope.zig\");\npub const templates = @import(\"extensions/native_node_async_wrap.zig\");\npub const binding = @import(\"extensions/native_node_fs_binding_data.zig\");\npub const owner = @import(\"extensions/native_node_file_handle_owner.zig\");\npub const Handle = owner.Handle;\nconst providers = @import(\"extensions/native_node_async_providers.zig\");\nconst stream = @import(\"extensions/native_node_stream_base.zig\");\nconst managed = @import(\"extensions/native_node_managed_buffers.zig\");\nconst callable = @import(\"extensions/native_node_module_callable.zig\");\npub const fs_io = @import(\"extensions/native_node_fs_request_io.zig\");\npub const fs_promise = @import(\"extensions/native_node_fs_request_promise.zig\");\nconst fs_read = @import(\"extensions/native_node_file_handle_read_binding.zig\");\npub const uv = fs_io.uv;\npub const immediate = @import(\"extensions/native_node_native_immediates.zig\");\npub const phase = @import(\"extensions/native_immediates.zig\");\npub const physical = @cImport({\n    @cUndef(\"_FORTIFY_SOURCE\");\n    @cDefine(\"_FORTIFY_SOURCE\", \"0\");\n    @cInclude(\"uv.h\");\n    @cInclude(\"fcntl.h\");\n});\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\native_node_file_handle_owner_test.zig",
        "bytes": 28576,
        "sha256": "03327CE42A03D3F6FCACFB1BD74CE7B2C8833BD00396BADD02EC561A1E3B2EE6"
      },
      "first_line": 6,
      "last_line": 24,
      "bytes": 834,
      "sha256": "BEC1EA959339EF14E4AC6B5FF140DC6E38CB4549D9D1BF8C34CF167054A852F9",
      "text": "const std = @import(\"std\");\nconst support = @import(\"native_node_file_handle_owner_test_support.zig\");\nconst a = support.a;\nconst c = support.c;\nconst uv = support.uv;\nconst physical = support.physical;\nconst Fixture = support.Fixture;\nconst File = support.File;\nconst Handle = support.Handle;\n\n// Avoid libuv Windows' fd <= 2 close branch and any recycled real descriptor.\nconst invalid_descriptor: c_int = std.math.maxInt(c_int);\n\nfn expectClosed(f: *Fixture, descriptor: c_int) !void {\n    const handle = try f.handle();\n    try std.testing.expect(handle.read_state.closed and !handle.read_state.closing);\n    try std.testing.expectEqual(@as(c_int, -1), handle.getFD());\n    try std.testing.expect(!handle.isAlive() and !handle.isClosing());\n    try std.testing.expectEqual(@as(c_int, physical.UV_EBADF), File.status(descriptor));\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\native_node_file_handle_owner_test.zig",
        "bytes": 28576,
        "sha256": "03327CE42A03D3F6FCACFB1BD74CE7B2C8833BD00396BADD02EC561A1E3B2EE6"
      },
      "first_line": 188,
      "last_line": 198,
      "bytes": 717,
      "sha256": "E104F9C26795F56960B2793D2397713BDB9BC1451DA19F28306E7CBC65872EB5",
      "text": "    try f.pumpIo();\n    try expectClosed(&f, invalid_descriptor);\n    try expectDrainedClose(&f, actual);\n    try std.testing.expectEqual(@as(i64, physical.UV_EBADF), uv.pi_uv_fs_request_info(actual).result);\n    try std.testing.expectEqual(c.JS_PROMISE_REJECTED, c.JS_PromiseState(f.engine.context, promise));\n    const reason = c.JS_PromiseResult(f.engine.context, promise);\n    defer f.engine.freeValue(reason);\n    try f.expose(\"ownerRejected\", reason);\n    try f.expose(\"ownerEBADF\", c.JS_NewInt32(f.engine.context, physical.UV_EBADF));\n    try f.expect(\"ownerRejected instanceof Error && ownerRejected.code === 'EBADF' && \" ++\n        \"ownerRejected.errno === ownerEBADF && ownerRejected.syscall === 'close'\");\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\extensions\\native_node_fs_request_io.zig",
        "bytes": 15469,
        "sha256": "B6792DCB053DDC2CFBC26350D9AD580CC5419CF3BDBEB595AF1F19B0922AF996"
      },
      "first_line": 4,
      "last_line": 15,
      "bytes": 598,
      "sha256": "7E574DC4686365AAA3579CED3621006435A2E000D54EB6088AD1CD7FBE3EE4A3",
      "text": "const std = @import(\"std\");\nconst a = @import(\"native_node_argument_values.zig\");\nconst callbacks = @import(\"native_node_callback_scope.zig\");\nconst request_state = @import(\"native_node_request_state.zig\");\nconst requests = @import(\"native_node_fs_request_promise.zig\");\nconst after_scope = @import(\"native_node_fs_after_scope.zig\");\nconst shared_service = @import(\"native_node_uv_service.zig\");\nconst env_io = @import(\"native_env_io.zig\");\nconst Completion = @import(\"native_sdk_owned_completion.zig\").Completion;\nconst c = a.c;\npub const uv = shared_service.uv;\npub const Engine = a.v.em.Engine;\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\extensions\\native_node_uv_service.zig",
        "bytes": 8937,
        "sha256": "CDA7A2AEBD9B752E38521E72A33F4BEE3A7A7453AA8DA38F33F04A61D0E369D5"
      },
      "first_line": 4,
      "last_line": 13,
      "bytes": 475,
      "sha256": "B7E41280843A823C0B6AB9FB8CDC93DAD99D8B142598120BA8AE82052ED24E4B",
      "text": "const std = @import(\"std\");\nconst em = @import(\"engine.zig\");\nconst a = @import(\"native_node_argument_values.zig\");\nconst env = @import(\"native_env_io.zig\");\nconst wake = @import(\"native_owner_wake.zig\");\nconst completion_wake = @import(\"native_owner_completion.zig\");\nconst Completion = @import(\"native_sdk_owned_completion.zig\").Completion;\nconst c = em.c;\npub const uv = @cImport({ @cInclude(\"native_uv_tcp.h\"); @cInclude(\"native_uv_fs.h\"); });\nconst service_tag: u8 = 0;\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\extensions\\native_uv_tcp.h",
        "bytes": 5344,
        "sha256": "B6F8D5269B8EF9DC9964E7F356EF1A23DBB483FB9B485C2C6D77D464816B4F45"
      },
      "first_line": 1,
      "last_line": 14,
      "bytes": 494,
      "sha256": "C190745447A774CC8469F62413D081A03004F1DA3F7D14D650B5A09262F2EC39",
      "text": "/* Real Node v24.13.0 libuv TCP transport. No JS/Engine pointers cross this ABI.\n * Every function except retain/release and error names runs on the owning host\n * thread. uv_* handle operations run only on the service's native loop thread.\n * All negative statuses are the actual libuv status, including UV_ENOMEM.\n */\n#ifndef PI_NATIVE_UV_TCP_H\n#define PI_NATIVE_UV_TCP_H\n#include <stddef.h>\n#include <stdint.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\ntypedef struct PiUvService PiUvService;\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\src\\extensions\\native_uv_fs.h",
        "bytes": 6334,
        "sha256": "23B85BBB1BD8395D1D5085BE0797F06CE2C323DAACF366F5CF3B587D06EACA6D"
      },
      "first_line": 1,
      "last_line": 30,
      "bytes": 1089,
      "sha256": "2BE5BC22EAB60AE2B772B5BEED2B7FEAE8771EE9739F420AC5C89AB6B4A76739",
      "text": "/* Typed real filesystem operations on the one native UV service.\n * Asynchronous uv_fs_t and the loop remain private to their actual owner.\n * The selected synchronous close borrows its caller's native stack uv_fs_t.\n * No JS value, Engine pointer or guest callback is accepted by this API. */\n#ifndef PI_NATIVE_UV_FS_H\n#define PI_NATIVE_UV_FS_H\n#include \"native_uv_tcp.h\"\n#include \"quickjs.h\"\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\ntypedef struct PiUvFsRequest PiUvFsRequest;\nenum PiUvFsKind { PI_UV_FS_UNASSIGNED = 0, PI_UV_FS_READ, PI_UV_FS_OPEN, PI_UV_FS_CLOSE };\ntypedef struct PiUvFsInfo {\n    int kind;\n    int64_t result; /* actual uv_fs_t::result, never a synthesized Promise value */\n    const char *path; /* borrowed until request_cleanup */\n    int accepted;\n    int cleaned;\n} PiUvFsInfo;\ntypedef struct PiUvFsPreparationInfo {\n    int kind;\n    int accepted;\n    int cleaned;\n    int completed;\n} PiUvFsPreparationInfo;\n\n/* Allocate the native request storage during the original ReqWrap allocation,\n * before its actual constructor/init hooks and SetReturnValue. A proven\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\vendor\\node-v24.13.0\\uv\\include\\uv.h",
        "bytes": 72810,
        "sha256": "FDDEC8C096616675B4578D85222663C8624DCE3EE67F5BE1C33BA83EB02A827C"
      },
      "first_line": 54,
      "last_line": 62,
      "bytes": 148,
      "sha256": "164F7ACBF1D936F9CDF8C997101043449671532F7F5E5BD0473D3E97C982DF62",
      "text": "#endif /* UV_EXTERN */\n\n#include \"uv/errno.h\"\n#include \"uv/version.h\"\n#include <stddef.h>\n#include <stdio.h>\n#include <stdint.h>\n#include <math.h>\n\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\vendor\\node-v24.13.0\\uv\\include\\uv.h",
        "bytes": 72810,
        "sha256": "FDDEC8C096616675B4578D85222663C8624DCE3EE67F5BE1C33BA83EB02A827C"
      },
      "first_line": 90,
      "last_line": 101,
      "bytes": 960,
      "sha256": "C52613DEC768BB601E7DD3EC1EEDBC35856AFE761F038FA7B80860DA16515DE1",
      "text": "  XX(EAI_MEMORY, \"out of memory\")                                             \\\n  XX(EAI_NODATA, \"no address\")                                                \\\n  XX(EAI_NONAME, \"unknown node or service\")                                   \\\n  XX(EAI_OVERFLOW, \"argument buffer overflow\")                                \\\n  XX(EAI_PROTOCOL, \"resolved protocol is unknown\")                            \\\n  XX(EAI_SERVICE, \"service not available for socket type\")                    \\\n  XX(EAI_SOCKTYPE, \"socket type not supported\")                               \\\n  XX(EALREADY, \"connection already in progress\")                              \\\n  XX(EBADF, \"bad file descriptor\")                                            \\\n  XX(EBUSY, \"resource busy or locked\")                                        \\\n  XX(ECANCELED, \"operation canceled\")                                         \\\n  XX(ECHARSET, \"invalid Unicode character\")                                   \\\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\raw\\vendor\\node-v24.13.0\\uv\\include\\uv.h",
        "bytes": 72810,
        "sha256": "FDDEC8C096616675B4578D85222663C8624DCE3EE67F5BE1C33BA83EB02A827C"
      },
      "first_line": 193,
      "last_line": 198,
      "bytes": 135,
      "sha256": "2FC69727B599C49167AEAF59AFDB31ADAB0FE9AF5FAE0095097515CEB464C7D0",
      "text": "typedef enum {\n#define XX(code, _) UV_ ## code = UV__ ## code,\n  UV_ERRNO_MAP(XX)\n#undef XX\n  UV_ERRNO_MAX = UV__EOF - 1\n} uv_errno_t;\n"
    },
