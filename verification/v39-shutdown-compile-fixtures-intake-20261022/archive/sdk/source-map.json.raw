      "bytes": 197,
      "sha256": "D002F840FFD30AF3955EEF7F734813439F27E6A79F8742531CA7D99C5998B9C9",
      "text": "# define UV__EALREADY UV__ERR(EALREADY)\n#else\n# define UV__EALREADY (-4084)\n#endif\n\n#if defined(EBADF) && !defined(_WIN32)\n# define UV__EBADF UV__ERR(EBADF)\n#else\n# define UV__EBADF (-4083)\n#endif\n"
    },
