  "exact_toolchain_excerpts": [
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\toolchain\\zig-x86_64-windows-0.16.0\\doc\\langref.html",
        "bytes": 983945,
        "sha256": "095DAA2D9F1262FB8BC00AFBB44D386F20363FD930E400BF703A8BC4255A4FFD"
      },
      "start_offset": 285177,
      "end_offset": 286117,
      "contained_excerpt": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\zig\\tuples.html.raw",
        "bytes": 940,
        "sha256": "DDD4B5F88B837A796E6817C48CFCE106D5FDD391B9C9B9B8AC5E7D5FB4F4935F"
      },
      "text": "Tuples \u00a7\n\n      \n      Anonymous structs can be created without specifying field names, and are referred to as \"tuples\". An empty tuple looks like .{} and can be seen in one of the Hello World examples.\n      \n      \n      The fields are implicitly named using numbers starting from 0. Because their names are integers,\n      they cannot be accessed with . syntax without also wrapping them in\n      @\"\". Names inside @\"\" are always recognised as\n      identifiers.\n      \n      \n      Like arrays, tuples have a .len field, can be indexed (provided the index is comptime-known)\n      and work with the ++ and ** operators. They can also be iterated over with inline for.\n      \n      "
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\toolchain\\zig-x86_64-windows-0.16.0\\doc\\langref.html",
        "bytes": 983945,
        "sha256": "095DAA2D9F1262FB8BC00AFBB44D386F20363FD930E400BF703A8BC4255A4FFD"
      },
      "start_offset": 159412,
      "end_offset": 160855,
      "contained_excerpt": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\zig\\arrays.html.raw",
        "bytes": 1443,
        "sha256": "AD5A6B43D63E0FAE55F53CA7E7F17A5DD4B05874989F75AA84DF784E6C8A2494"
      },
      "text": "Arrays \u00a7\n\n      test_arrays.zigconst expectEqual = @import(\"std\").testing.expectEqual;\nconst assert = @import(\"std\").debug.assert;\nconst mem = @import(\"std\").mem;\n\n// array literal\nconst message = [_]u8{ 'h', 'e', 'l', 'l', 'o' };\n\n// alternative initialization using result location\nconst alt_message: [5]u8 = .{ 'h', 'e', 'l', 'l', 'o' };\n\ncomptime {\n    assert(mem.eql(u8, &message, &alt_message));\n}\n\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\toolchain\\zig-x86_64-windows-0.16.0\\doc\\langref.html",
        "bytes": 983945,
        "sha256": "095DAA2D9F1262FB8BC00AFBB44D386F20363FD930E400BF703A8BC4255A4FFD"
      },
      "start_offset": 384561,
      "end_offset": 385846,
      "contained_excerpt": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\authority\\zig\\runtime_for.html.raw",
        "bytes": 1285,
        "sha256": "401A4542BCB1E75A158C4B879E7B6D68344AB620BDA6BAD9A21C2ED77AC13BD0"
      },
      "text": "for \u00a7\n\n      test_for.zigconst expectEqual = @import(\"std\").testing.expectEqual;\n\ntest \"for basics\" {\n    const items = [_]i32{ 4, 5, 3, 4, 0 };\n    var sum: i32 = 0;\n\n    // For loops iterate over slices and arrays.\n    for (items) |value| {\n        // Break and continue are supported.\n        if (value == 0) {\n            continue;\n        }\n        sum += value;\n    }\n    try expectEqual(16, sum);\n\n    "
    }
  ],
  "conclusions": [
    {
      "error": "missing UV_EBADF in transport C import",
      "cause": "Shutdown t.uv aliases base_support.uv -> fs_io.uv -> shared_service.uv, whose C import contains only native_uv_tcp.h and native_uv_fs.h. Neither declares UV_EBADF.",
      "correction": "Select existing public base_support.physical, which includes uv.h. Its UV_ERRNO_MAP enum defines UV_EBADF = UV__EBADF. The existing owner tests already use that namespace; no integer is substituted and no new import is introduced.",
      "preserved": "Exact c_int cast/equality/actual result, maxInt(c_int) descriptor, error sign checks, AfterClose state and retirement assertions."
    },
    {
      "error": "runtime tuple field index must be comptime-known",
      "cause": "The inferred .{...} value has tuple semantics; the pinned Zig reference requires compile-time tuple indexing.",
      "correction": "The three mutable fields are all ?c.JSValue. Explicit [_]*?c.JSValue constructs a fixed three-element runtime array; ordinary for iterates those pointers.",
      "preserved": "Same observed_request/error_key/oncomplete_key order; same optional test/null-before-free body; stopIo drains before freeing and base.deinit follows; no new ownership or allocation."
    }
  ],
  "static_only": true,
  "compiler_executed": false
}
