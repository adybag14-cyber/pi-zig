      "bytes": 1192,
      "sha256": "256AEA975494642202C79600E22EAABF915430BEEDFBC5C03FBF661615674404",
      "text": "//! Build unchanged Node v24.13.0 libuv/llhttp and shared TCP/file I/O owners.\n//! SOURCE-MANIFEST.json pins every imported byte. No source generator is run.\nconst std = @import(\"std\");\nconst uv_root = \"vendor/node-v24.13.0/uv\";\nconst llhttp_root = \"vendor/node-v24.13.0/llhttp\";\n\npub fn add(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode,\n    native_memory: ?*std.Build.Step.Compile) *std.Build.Step.Compile {\n    const library = b.addLibrary(.{\n        .name = \"pi-node-network\",\n        .linkage = .static,\n        .root_module = b.createModule(.{ .target = target, .optimize = optimize, .link_libc = true, .link_libcpp = native_memory != null }),\n    });\n    const module = library.root_module;\n    module.addIncludePath(b.path(uv_root ++ \"/include\"));\n    module.addIncludePath(b.path(uv_root ++ \"/src\"));\n    module.addIncludePath(b.path(llhttp_root ++ \"/include\"));\n    module.addIncludePath(b.path(\"src/extensions\"));\n    module.addIncludePath(b.path(\"vendor/quickjs\"));\n    const flags: []const []const u8 = switch (target.result.os.tag) {\n        .windows => &.{ \"-std=gnu11\", \"-D_WIN32_WINNT=0x0602\", \"-D_GNU_SOURCE\", \"-fno-strict-aliasing\" },\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\original\\src\\native_node_stream_shutdown_test.zig",
        "bytes": 17039,
        "sha256": "CC33A8145F289FA2E054E9547170E3D9EFBE6A1422CA5D20FFE53303F86C4B2F"
      },
      "first_line": 100,
      "last_line": 115,
      "bytes": 777,
      "sha256": "5868E0B95ED95D9178DB7D9091C33746DAFDDC6D7A92AB75E70B21543B213263",
      "text": "    try f.expectRetired(wrapper);\n}\n\ntest \"native Stream shutdown real accepted bad descriptor still performs AfterClose and reports negative status\" {\n    var f: Fixture = undefined; try f.init(); defer f.deinit();\n    const handle = try f.create(std.math.maxInt(c_int));\n    const wrapper = try f.request(); defer f.base.engine.freeValue(wrapper);\n    try f.publishRequest(wrapper);\n    try std.testing.expectEqual(@as(c_int, 0), try f.run(wrapper));\n    try f.base.pumpIo();\n    try std.testing.expectEqual(@as(c_int, t.uv.UV_EBADF), f.end_result);\n    try std.testing.expect(handle.read_state.closed and handle.read_state.fd == -1);\n    try f.base.expect(\"shutdownCalls.length===1 && shutdownCalls[0][1]<0 && shutdownCalls[0][4]===1\");\n    try f.expectRetired(wrapper);\n}\n\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\original\\src\\native_node_stream_shutdown_test_support.zig",
        "bytes": 10312,
        "sha256": "3FFA7C6EE88B974CA17EB03972ED4CBD14E5702E19D0DF351B72EDF8BD6D21C3"
      },
      "first_line": 16,
      "last_line": 23,
      "bytes": 261,
      "sha256": "27402C7D605FDC48B609E4281DD2F7139A9EE9E4627BB1E0ABBA5439A2FC04FA",
      "text": "pub const Fixture = struct {\n    base: base_support.Fixture = undefined,\n    base_ready: bool = false,\n    error_key: ?c.JSValue = null,\n    oncomplete_key: ?c.JSValue = null,\n    observed_request: ?c.JSValue = null,\n    begins: usize = 0,\n    ends: usize = 0,\n"
    },
    {
      "source": {
        "path": "C:\\Users\\adyba\\pi-zig\\worktrees\\sdk-owners-resume-20261018\\verification\\v39-shutdown-compile-fixtures-sourceonly-20261022\\original\\src\\native_node_stream_shutdown_test_support.zig",
        "bytes": 10312,
        "sha256": "3FFA7C6EE88B974CA17EB03972ED4CBD14E5702E19D0DF351B72EDF8BD6D21C3"
      },
      "first_line": 136,
      "last_line": 154,
      "bytes": 666,
      "sha256": "63FAE24147639D576795560A89EEDC3D69D6442F58E18AFA8DBFF79C243A73A7",
      "text": "        const handle = try self.base.handle();\n        handle.stream.virtuals.error_string = errorString;\n        handle.stream.virtuals.clear_error = clearError;\n        self.message_available = true;\n    }\n    pub fn deinit(self: *Fixture) void {\n        if (!self.base_ready) return;\n        self.base.stopIo(); // drains every accepted callback while keys live\n        for (.{ &self.observed_request, &self.error_key, &self.oncomplete_key }) |slot| {\n            if (slot.*) |value| {\n                slot.* = null;\n                self.base.engine.freeValue(value);\n            }\n        }\n        self.base.deinit();\n        self.base_ready = false;\n    }\n};\n\n"
    }
  ],
