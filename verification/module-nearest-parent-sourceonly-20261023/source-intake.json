  "required_private_api": {
    "getNearestParentPackageJSON": "(engine, actual Registry, NativeInputs, primitive String argument slice) -> owned JSValue or original native error",
    "getNearestParentPackageJSONType": "same required actual inputs; returns intrinsic native type or undefined",
    "native_inputs": "Required PiNodePermission and PiNodePermissionEnvironment borrow; exact Engine context, actual paths/private Map/trace/per-process Debug operations. Borrow lasts through synchronous return and Error setter reentry.",
    "lifetime": "Typed BindingData weak lookup is followed by retention of its actual wrapper before native path work. Stable cache-owned Config stays valid through serialization; invalid local Config remains owned through native Error code setter and throw.",
    "assembly_boundary": "Unified native Environment/bootstrap and private callback registration remain caller work. No owner acquisition or public Module publication is invented here."
  },
