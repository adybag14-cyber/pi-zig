    "install_only_target": "build-native-node-module-nearest-parent",
    "root": "src/native_node_module_nearest_parent_test.zig",
    "filter": "native module nearest",
    "windows_executable": "native-node-module-nearest-parent.exe",
    "declared_tests": [
      "native module nearest returns closest native Config as fresh intrinsic arrays and a direct type",
      "native module nearest restores only the native trailing separator before the first parent",
      "native module nearest stops at node_modules before probing that package or any ancestor",
      "native module nearest enabled native Permission denies before even a cached package is returned",
      "native module nearest permits an actual subtree then stops before reading a denied ancestor",
      "native module nearest keeps a negative child read cached when that physical file appears",
      "native module nearest invalid Config stays uncached through native Error setter reentry",
      "native module nearest namespace leaf uses actual private drive Map and preserves native POSIX spelling"
    ],
