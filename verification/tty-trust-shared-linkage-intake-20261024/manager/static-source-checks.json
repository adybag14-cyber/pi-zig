  "source_test_declarations": 20,
  "test_names": [
    "native project trust manager shares one complete four-export evaluation between actual owner entries",
    "native project trust manager path options feed the real Store and retain physical lock ownership",
    "native project trust manager captures every shared named import once in original source order",
    "native project trust manager warm creation never rereads captured named import members",
    "native project trust manager retains one captured filesystem function for resources and Store",
    "native project trust manager preserves the live default lockfile member after shared capture",
    "native project trust manager ordinary named mutation before capture reaches every original consumer",
    "native project trust manager complete exports survive retirement of their actual host handle",
    "native project trust manager all genuine provider roots survive retirement inside carrier Get",
    "native project trust manager rejects a foreign runtime before getter access or publication",
    "native project trust manager rejects a foreign platform before descendant access or publication",
    "native project trust manager authenticates every publicly mutable child module carrier",
    "native project trust manager ordinary pending carrier stops all subsequent Gets and publication",
    "native project trust manager actual fatal carrier survives provider root retirement",
    "native project trust manager ordinary named getter failure preserves reason and permits clean retry",
    "native project trust manager cold named getter reentry cannot publish a partial evaluation",
